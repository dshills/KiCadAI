    "unbounded_dynamic_lookup": "reject_plan",
    "unmapped_outcome_affecting_consumer": "reject_plan",
    "independent_separable_effect": "count_as_capability_member",
    "atoms_and_members_count_against_all_budgets": true,
    "changed_gap_outside_selection_or_closure": "retire"
