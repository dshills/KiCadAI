      {"id": "output_transistor", "ref": "Q2", "role": "bjt", "symbol": "Transistor_BJT:Q_NPN_CBE", "value": "BC547", "footprint": "Package_TO_SOT_THT:TO-92_Inline", "pins": [{"number": "1", "name": "C"}, {"number": "2", "name": "B"}, {"number": "3", "name": "E"}]},
      {"id": "load", "ref": "R2", "role": "resistor", "symbol": "Device:R", "value": "4.7k", "footprint": "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal", "pins": [{"number": "1"}, {"number": "2"}]},
      {"id": "output", "ref": "J2", "role": "output_connector", "symbol": "Connector_Generic:Conn_01x02", "value": "CURRENT OUTPUT", "footprint": "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical", "pins": [{"number": "1", "name": "IOUT"}, {"number": "2", "name": "GND"}]}
