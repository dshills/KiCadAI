{
  "schema": "kicadai.schematic.ir.v1",
  "version": 1,
  "metadata": {
    "name": "voltage_divider",
    "title": "Resistive Voltage Divider",
    "description": "Two equal resistors divide a 9 V input to approximately 4.5 V with no load.",
    "paper": "A4"
  },
  "circuit": {
    "components": [
      {"id": "input", "ref": "#PWR01", "role": "power_symbol", "symbol": "power:+9V", "value": "+9V", "pins": [{"number": "1", "name": "+9V", "offset_x_mm": 0, "offset_y_mm": 0}]},
      {"id": "supply_flag", "ref": "#FLG01", "role": "power_symbol", "symbol": "power:PWR_FLAG", "value": "PWR_FLAG", "pins": [{"number": "1", "name": "PWR_FLAG", "offset_x_mm": 0, "offset_y_mm": 0}]},
      {"id": "upper_resistor", "ref": "R1", "role": "resistor", "symbol": "Device:R", "value": "10k", "footprint": "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal", "pins": [{"number": "1"}, {"number": "2"}]},
      {"id": "lower_resistor", "ref": "R2", "role": "resistor", "symbol": "Device:R", "value": "10k", "footprint": "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal", "pins": [{"number": "1"}, {"number": "2"}]},
      {"id": "output", "ref": "TP1", "role": "testpoint", "symbol": "Connector:TestPoint", "value": "VOUT = 4.5 V", "footprint": "TestPoint:TestPoint_THTPad_D1.5mm_Drill0.7mm", "pins": [{"number": "1", "name": "VOUT", "offset_x_mm": 0, "offset_y_mm": 0}]},
      {"id": "ground", "ref": "#PWR02", "role": "ground_symbol", "symbol": "power:GND", "value": "GND", "pins": [{"number": "1", "name": "GND", "offset_x_mm": 0, "offset_y_mm": 0}]},
      {"id": "ground_flag", "ref": "#FLG02", "role": "ground_symbol", "symbol": "power:PWR_FLAG", "value": "PWR_FLAG", "pins": [{"number": "1", "name": "PWR_FLAG", "offset_x_mm": 0, "offset_y_mm": 0}]}
    ],
    "nets": [
      {"name": "+9V", "role": "power_pos", "connect": ["input.1", "upper_resistor.1", "supply_flag.1"], "label": "+9V", "use_label": false},
      {"name": "VOUT", "role": "signal", "connect": ["upper_resistor.2", "lower_resistor.1", "output.1"], "label": "VOUT = 4.5 V"},
      {"name": "GND", "role": "ground", "connect": ["lower_resistor.2", "ground.1", "ground_flag.1"], "label": "GND", "use_label": false}
    ]
  },
  "layout": {
    "flow": "left_to_right",
    "origin": "centered",
    "groups": [
      {"id": "input", "label": "Input", "role": "input_stage", "members": ["input", "supply_flag"], "rank": 0, "side": "left"},
      {"id": "divider", "label": "Divider", "role": "processing_stage", "members": ["upper_resistor", "lower_resistor", "ground", "ground_flag"], "rank": 1},
      {"id": "output", "label": "Output", "role": "output_stage", "members": ["output"], "rank": 2, "side": "right"}
    ],
    "placements": [],
    "lanes": {"power": "top", "ground": "bottom", "signals": "middle"},
    "rules": {"positive_power_top": false, "ground_bottom": false, "center_on_page": true, "prefer_labels_for_long_nets": false, "avoid_wire_crossings": true, "min_group_spacing_mm": 8, "min_component_spacing_mm": 5}
  },
  "policy": {
    "repair": {"allow_ref_assignment": false, "allow_label_insertion": true, "allow_group_spacing_adjustment": false, "allow_symbol_substitution": false, "allow_pin_guessing": false},
    "acceptance": "readable"
  }
}
