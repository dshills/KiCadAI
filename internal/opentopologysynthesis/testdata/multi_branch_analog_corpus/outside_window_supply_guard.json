{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "outside_window_supply_guard",
    "title": "Outside-window supply guard",
    "description": "Assert a guard output below a lower input limit and above an upper input limit while clearing it throughout the acceptable interval."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "logic_supply", "kind": "supply", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.03, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "logic_supply"},
      {"id": "monitored_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.65, "max_voltage_v": 3.3, "input_impedance_min_ohm": 120000}},
      {"id": "guard_asserted", "kind": "digital", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3}}
    ],
    "operating_cases": [
      {"id": "below_range", "conditions": [{"axis": "input_voltage", "target": "monitored_input", "min": 0, "max": 0.9, "unit": "V"}]},
      {"id": "accepted_range", "conditions": [{"axis": "input_voltage", "target": "monitored_input", "min": 1.25, "max": 2.05, "unit": "V"}]},
      {"id": "above_range", "conditions": [{"axis": "input_voltage", "target": "monitored_input", "min": 2.4, "max": 3.3, "unit": "V"}]},
      {"id": "threshold_sweep", "conditions": [{"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 3.6, "unit": "V"}, {"axis": "input_voltage", "target": "monitored_input", "min": 0, "max": 3.3, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "lower_threshold", "metric": "lower_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "guard_asserted"}, "min": 1, "max": 1.2, "unit": "V", "operating_cases": ["threshold_sweep"]},
      {"id": "upper_threshold", "metric": "upper_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "guard_asserted"}, "min": 2.15, "max": 2.35, "unit": "V", "operating_cases": ["threshold_sweep"]},
      {"id": "below_is_asserted", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "guard_asserted"}, "min": 2.6, "unit": "V", "operating_cases": ["below_range"]},
      {"id": "accepted_is_clear", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "guard_asserted"}, "max": 0.4, "unit": "V", "operating_cases": ["accepted_range"]},
      {"id": "above_is_asserted", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "guard_asserted"}, "min": 2.6, "unit": "V", "operating_cases": ["above_range"]},
      {"id": "guard_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "guard_asserted"}, "max": 0.00015, "unit": "s", "operating_cases": ["threshold_sweep"], "critical": true}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 60, "max_height_mm": 42}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
