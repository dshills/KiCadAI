{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "precision_low_voltage_rail",
    "title": "Precision low-voltage rail",
    "description": "Produce a stable 3.3 volt rail from a varying higher-voltage input across line, load, startup, and ambient conditions."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "source_supply", "kind": "supply", "min_voltage_v": 7.5, "nominal_voltage_v": 9, "max_voltage_v": 11, "max_current_a": 0.2, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "source_power", "kind": "power", "direction": "sink", "domain": "source_supply"},
      {"id": "enable", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.3, "default_state": "high"}},
      {"id": "regulated_rail", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 3.15, "nominal_voltage_v": 3.3, "max_voltage_v": 3.45, "max_current_a": 0.08}}
    ],
    "operating_cases": [
      {"id": "line_load_temperature", "conditions": [{"axis": "supply_voltage", "target": "source_supply", "min": 7.5, "max": 11, "unit": "V"}, {"axis": "load_current", "target": "regulated_rail", "min": 0.01, "max": 0.08, "unit": "A"}, {"axis": "ambient_temperature", "target": "regulated_rail", "min": -10, "max": 55, "unit": "degC"}]},
      {"id": "power_start", "conditions": [{"axis": "supply_voltage", "target": "source_supply", "min": 0, "max": 9, "unit": "V"}, {"axis": "load_current", "target": "regulated_rail", "min": 0.04, "max": 0.04, "unit": "A"}], "events": [{"id": "apply_source", "kind": "startup", "target": "source_power", "trigger_time_s": 0.001, "initial": 0, "applied": 9, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "rail_voltage", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "regulated_rail"}, "min": 3.23, "max": 3.37, "unit": "V", "operating_cases": ["line_load_temperature"]},
      {"id": "line_change", "metric": "line_regulation", "analysis": "dc_sweep", "excitation": {"kind": "domain", "id": "source_supply"}, "observation": {"kind": "port", "id": "regulated_rail"}, "max": 0.045, "unit": "V", "operating_cases": ["line_load_temperature"]},
      {"id": "load_change", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "regulated_rail"}, "max": 0.08, "unit": "V", "operating_cases": ["line_load_temperature"]},
      {"id": "startup_peak", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "regulated_rail"}, "max": 0.22, "unit": "V", "operating_cases": ["power_start"], "critical": true},
      {"id": "loop_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "regulated_rail"}, "min": 52, "unit": "deg", "operating_cases": ["line_load_temperature"], "critical": true},
      {"id": "junction_limit", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 120, "unit": "degC", "operating_cases": ["line_load_temperature"], "critical": true},
      {"id": "area_margin", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["line_load_temperature"], "critical": true}
    ],
    "constraints": {"max_components": 22, "max_width_mm": 68, "max_height_mm": 48}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
