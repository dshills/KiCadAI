{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "adjustable_voltage_regulation",
    "title": "Adjustable voltage regulation",
    "description": "Produce a stable adjustable output voltage from a higher unregulated input across the declared line, load, startup, and temperature range."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "input_supply", "kind": "supply", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 0.25, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_supply"},
      {"id": "adjust", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.9, "nominal_voltage_v": 1, "max_voltage_v": 1.1}},
      {"id": "output_power", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1}}
    ],
    "operating_cases": [
      {"id": "light_load", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 9, "max": 15, "unit": "V"}, {"axis": "input_voltage", "target": "adjust", "min": 1, "max": 1, "unit": "V"}, {"axis": "load_current", "target": "output_power", "min": 0.005, "max": 0.005, "unit": "A"}]},
      {"id": "rated_load", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 9, "max": 15, "unit": "V"}, {"axis": "input_voltage", "target": "adjust", "min": 1, "max": 1, "unit": "V"}, {"axis": "load_current", "target": "output_power", "min": 0.1, "max": 0.1, "unit": "A"}]},
      {"id": "startup", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 0, "max": 12, "unit": "V"}, {"axis": "load_current", "target": "output_power", "min": 0.05, "max": 0.05, "unit": "A"}]}
    ],
    "behavioral_requirements": [
      {"id": "regulated_voltage", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "output_power"}, "min": 4.9, "max": 5.1, "unit": "V", "operating_cases": ["light_load", "rated_load"]},
      {"id": "line_variation", "metric": "line_regulation", "analysis": "dc_sweep", "excitation": {"kind": "domain", "id": "input_supply"}, "observation": {"kind": "port", "id": "output_power"}, "max": 0.05, "unit": "V", "operating_cases": ["light_load", "rated_load"]},
      {"id": "load_variation", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "output_power"}, "max": 0.1, "unit": "V", "operating_cases": ["light_load", "rated_load"]},
      {"id": "startup_overshoot", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "output_power"}, "max": 0.25, "unit": "V", "operating_cases": ["startup"], "critical": true},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["rated_load"], "critical": true}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 65, "max_height_mm": 45}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
