{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "sensor_conditioner",
    "title": "Low-level sensor conditioner",
    "description": "Scale and bandwidth-limit a low-level sensor signal for a downstream converter while preserving input loading and noise limits."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.05, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "sensor_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.1, "nominal_voltage_v": 0.25, "max_voltage_v": 0.4, "input_impedance_min_ohm": 500000}},
      {"id": "conditioned_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0.9, "nominal_voltage_v": 2.5, "max_voltage_v": 4.1}}
    ],
    "operating_cases": [
      {"id": "conversion_load", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 4.75, "max": 5.25, "unit": "V"}, {"axis": "load_resistance", "target": "conditioned_output", "min": 100000, "max": 1000000, "unit": "ohm"}, {"axis": "load_capacitance", "target": "conditioned_output", "min": 1e-11, "max": 2e-10, "unit": "F"}]}
    ],
    "behavioral_requirements": [
      {"id": "signal_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "sensor_input"}, "observation": {"kind": "port", "id": "conditioned_output"}, "min": 9.5, "max": 10.5, "unit": "ratio", "operating_cases": ["conversion_load"]},
      {"id": "output_center", "metric": "output_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "sensor_input"}, "observation": {"kind": "port", "id": "conditioned_output"}, "min": 2.4, "max": 2.6, "unit": "V", "operating_cases": ["conversion_load"]},
      {"id": "bandwidth", "metric": "cutoff_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "sensor_input"}, "observation": {"kind": "port", "id": "conditioned_output"}, "min": 1800, "max": 2200, "unit": "Hz", "operating_cases": ["conversion_load"]},
      {"id": "integrated_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "conditioned_output"}, "max": 0.001, "unit": "V", "operating_cases": ["conversion_load"]},
      {"id": "stability", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "conditioned_output"}, "min": 50, "unit": "deg", "operating_cases": ["conversion_load"], "critical": true}
    ],
    "constraints": {"max_components": 16, "max_width_mm": 55, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
