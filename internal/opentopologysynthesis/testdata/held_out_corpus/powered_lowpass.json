{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "powered_lowpass",
    "title": "Powered low-pass signal path",
    "description": "Pass low-frequency input content with controlled gain while attenuating content above the requested corner and driving the declared load."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 10.8, "nominal_voltage_v": 12, "max_voltage_v": 13.2, "max_current_a": 0.08, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -1, "nominal_voltage_v": 0, "max_voltage_v": 1, "input_impedance_min_ohm": 50000}},
      {"id": "output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -2.5, "nominal_voltage_v": 0, "max_voltage_v": 2.5}}
    ],
    "operating_cases": [
      {"id": "rated_load", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 10.8, "max": 13.2, "unit": "V"}, {"axis": "load_resistance", "target": "output", "min": 10000, "max": 100000, "unit": "ohm"}, {"axis": "load_capacitance", "target": "output", "min": 0, "max": 5e-10, "unit": "F"}]}
    ],
    "behavioral_requirements": [
      {"id": "passband_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "output"}, "min": 1.9, "max": 2.1, "unit": "ratio", "operating_cases": ["rated_load"]},
      {"id": "corner_frequency", "metric": "cutoff_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "output"}, "min": 900, "max": 1100, "unit": "Hz", "operating_cases": ["rated_load"]},
      {"id": "high_frequency_attenuation", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "output"}, "max": 0.25, "unit": "ratio", "frequency_hz": 10000, "operating_cases": ["rated_load"]},
      {"id": "stability", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output"}, "min": 50, "unit": "deg", "operating_cases": ["rated_load"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "output"}, "max": 0.002, "unit": "s", "operating_cases": ["rated_load"]}
    ],
    "constraints": {"max_components": 14, "max_width_mm": 55, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
