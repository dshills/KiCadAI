{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "voltage_window_monitor",
    "title": "Voltage-window monitor",
    "description": "Assert an alert when the monitored input is below a lower limit or above an upper limit and deassert it while the input remains inside the valid window."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.05, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "monitored_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 2.5, "max_voltage_v": 5}},
      {"id": "alert", "kind": "digital", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5}}
    ],
    "operating_cases": [
      {"id": "below_window", "conditions": [{"axis": "input_voltage", "target": "monitored_input", "min": 0, "max": 1.8, "unit": "V"}]},
      {"id": "inside_window", "conditions": [{"axis": "input_voltage", "target": "monitored_input", "min": 2.2, "max": 3.8, "unit": "V"}]},
      {"id": "above_window", "conditions": [{"axis": "input_voltage", "target": "monitored_input", "min": 4.2, "max": 5, "unit": "V"}]},
      {"id": "full_sweep", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 4.5, "max": 5.5, "unit": "V"}, {"axis": "input_voltage", "target": "monitored_input", "min": 0, "max": 5, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "lower_limit", "metric": "lower_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "alert"}, "min": 1.9, "max": 2.1, "unit": "V", "operating_cases": ["full_sweep"]},
      {"id": "upper_limit", "metric": "upper_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "alert"}, "min": 3.9, "max": 4.1, "unit": "V", "operating_cases": ["full_sweep"]},
      {"id": "below_alert", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "alert"}, "min": 4, "unit": "V", "operating_cases": ["below_window"]},
      {"id": "inside_clear", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "alert"}, "max": 0.5, "unit": "V", "operating_cases": ["inside_window"]},
      {"id": "above_alert", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "alert"}, "min": 4, "unit": "V", "operating_cases": ["above_window"]},
      {"id": "response_time", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "alert"}, "max": 0.0001, "unit": "s", "operating_cases": ["full_sweep"]}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 60, "max_height_mm": 45}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
