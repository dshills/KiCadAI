{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "hysteretic_detector",
    "title": "Hysteretic detector",
    "description": "Indicate whether an input has crossed a rising threshold and retain the indicated state until it crosses a lower falling threshold."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.05, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 2.9, "max_voltage_v": 5}},
      {"id": "indication", "kind": "digital", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5}}
    ],
    "operating_cases": [
      {"id": "slow_ramp", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 4.5, "max": 5.5, "unit": "V"}, {"axis": "input_voltage", "target": "input", "min": 0, "max": 5, "unit": "V"}]},
      {"id": "power_on_low_input", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 0, "max": 5, "unit": "V"}, {"axis": "input_voltage", "target": "input", "min": 0.5, "max": 0.5, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "rising_point", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "indication"}, "min": 3, "max": 3.2, "unit": "V", "operating_cases": ["slow_ramp"]},
      {"id": "falling_point", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "indication"}, "min": 2.7, "max": 2.9, "unit": "V", "operating_cases": ["slow_ramp"]},
      {"id": "threshold_separation", "metric": "hysteresis", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "indication"}, "min": 0.2, "max": 0.5, "unit": "V", "operating_cases": ["slow_ramp"]},
      {"id": "response_time", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "input"}, "observation": {"kind": "port", "id": "indication"}, "max": 0.0001, "unit": "s", "operating_cases": ["slow_ramp"]},
      {"id": "startup_state", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "indication"}, "max": 0.5, "unit": "V", "operating_cases": ["power_on_low_input"], "critical": true}
    ],
    "constraints": {"max_components": 12, "max_width_mm": 45, "max_height_mm": 35}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
