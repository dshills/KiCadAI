{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "adjustable_current_output",
    "title": "Adjustable current output",
    "description": "Deliver a load current proportional to an external setpoint while remaining regulated across the declared supply and load range."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 10.8, "nominal_voltage_v": 12, "max_voltage_v": 13.2, "max_current_a": 0.3, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "setpoint", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.5, "nominal_voltage_v": 1, "max_voltage_v": 2}},
      {"id": "output", "kind": "analog_current", "direction": "source", "domain": "ground", "electrical": {"max_current_a": 0.22}}
    ],
    "operating_cases": [
      {"id": "low_command", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 10.8, "max": 13.2, "unit": "V"}, {"axis": "input_voltage", "target": "setpoint", "min": 0.5, "max": 0.5, "unit": "V"}, {"axis": "load_resistance", "target": "output", "min": 10, "max": 100, "unit": "ohm"}]},
      {"id": "high_command", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 10.8, "max": 13.2, "unit": "V"}, {"axis": "input_voltage", "target": "setpoint", "min": 2, "max": 2, "unit": "V"}, {"axis": "load_resistance", "target": "output", "min": 10, "max": 40, "unit": "ohm"}]}
    ],
    "behavioral_requirements": [
      {"id": "command_ratio", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "setpoint"}, "observation": {"kind": "port", "id": "output"}, "min": 0.095, "max": 0.105, "unit": "A/V", "operating_cases": ["low_command", "high_command"]},
      {"id": "low_current", "metric": "output_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "output"}, "min": 0.0475, "max": 0.0525, "unit": "A", "operating_cases": ["low_command"]},
      {"id": "high_current", "metric": "output_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "output"}, "min": 0.19, "max": 0.21, "unit": "A", "operating_cases": ["high_command"]},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "setpoint"}, "observation": {"kind": "port", "id": "output"}, "max": 0.001, "unit": "s", "operating_cases": ["high_command"]},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["high_command"], "critical": true}
    ],
    "constraints": {"max_components": 14, "max_width_mm": 55, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
