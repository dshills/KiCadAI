{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "continuous_conduction_audio_stage",
    "title": "Low-power continuous-conduction audio stage",
    "description": "Drive a resistive loudspeaker load with low distortion and a deliberately high standing current across the audio band."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 22, "nominal_voltage_v": 24, "max_voltage_v": 26, "max_current_a": 0.75, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "audio_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -0.45, "nominal_voltage_v": 0, "max_voltage_v": 0.45, "input_impedance_min_ohm": 47000}},
      {"id": "speaker_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -4, "nominal_voltage_v": 0, "max_voltage_v": 4, "max_current_a": 0.5}}
    ],
    "operating_cases": [
      {"id": "nominal_audio", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 24, "max": 24, "unit": "V"}, {"axis": "load_resistance", "target": "speaker_output", "min": 8, "max": 8, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "speaker_output", "min": 25, "max": 25, "unit": "degC"}]},
      {"id": "supply_and_thermal_corners", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 22, "max": 26, "unit": "V"}, {"axis": "load_resistance", "target": "speaker_output", "min": 8, "max": 16, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "speaker_output", "min": 0, "max": 50, "unit": "degC"}, {"axis": "model_corner", "target": "speaker_output", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "speaker_output", "min": 0, "max": 0, "unit": "ratio"}]}
    ],
    "behavioral_requirements": [
      {"id": "closed_loop_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "min": 8.5, "max": 10.5, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["nominal_audio", "supply_and_thermal_corners"]},
      {"id": "audio_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "min": 30000, "unit": "Hz", "operating_cases": ["nominal_audio"]},
      {"id": "output_swing", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "min": 3.7, "max": 4.2, "unit": "V", "frequency_hz": 1000, "operating_cases": ["nominal_audio"]},
      {"id": "load_power", "metric": "output_power", "analysis": "transient", "observation": {"kind": "port", "id": "speaker_output"}, "min": 0.75, "max": 1.05, "unit": "W", "frequency_hz": 1000, "operating_cases": ["nominal_audio"]},
      {"id": "standing_current", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "power"}, "min": 0.38, "max": 0.55, "unit": "A", "operating_cases": ["nominal_audio", "supply_and_thermal_corners"], "critical": true},
      {"id": "audio_distortion", "metric": "total_harmonic_distortion", "analysis": "distortion", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "max": 1.0, "unit": "%", "frequency_hz": 1000, "operating_cases": ["nominal_audio"]},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 115, "unit": "degC", "operating_cases": ["supply_and_thermal_corners"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.2, "unit": "ratio", "operating_cases": ["supply_and_thermal_corners"], "critical": true}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 90, "max_height_mm": 60}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
