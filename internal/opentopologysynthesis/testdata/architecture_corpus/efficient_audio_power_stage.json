{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "efficient_audio_power_stage",
    "title": "Efficient low-distortion audio power stage",
    "description": "Drive a resistive loudspeaker load to several watts with low idle current, low crossover distortion, and stable feedback."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply_positive", "kind": "supply", "min_voltage_v": 16, "nominal_voltage_v": 18, "max_voltage_v": 20, "max_current_a": 1.5, "source": "external"},
      {"id": "supply_negative", "kind": "supply", "min_voltage_v": -20, "nominal_voltage_v": -18, "max_voltage_v": -16, "max_current_a": 1.5, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power_positive", "kind": "power", "direction": "sink", "domain": "supply_positive"},
      {"id": "power_negative", "kind": "power", "direction": "sink", "domain": "supply_negative"},
      {"id": "audio_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -0.85, "nominal_voltage_v": 0, "max_voltage_v": 0.85, "input_impedance_min_ohm": 22000}},
      {"id": "speaker_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -8, "nominal_voltage_v": 0, "max_voltage_v": 8, "max_current_a": 1}}
    ],
    "operating_cases": [
      {"id": "rated_audio", "conditions": [{"axis": "supply_voltage", "target": "supply_positive", "min": 18, "max": 18, "unit": "V"}, {"axis": "supply_voltage", "target": "supply_negative", "min": -18, "max": -18, "unit": "V"}, {"axis": "load_resistance", "target": "speaker_output", "min": 8, "max": 8, "unit": "ohm"}, {"axis": "load_capacitance", "target": "speaker_output", "min": 0, "max": 1e-7, "unit": "F"}, {"axis": "ambient_temperature", "target": "speaker_output", "min": 25, "max": 25, "unit": "degC"}]},
      {"id": "load_and_thermal_corners", "conditions": [{"axis": "supply_voltage", "target": "supply_positive", "min": 16, "max": 20, "unit": "V"}, {"axis": "supply_voltage", "target": "supply_negative", "min": -20, "max": -16, "unit": "V"}, {"axis": "load_resistance", "target": "speaker_output", "min": 6, "max": 16, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "speaker_output", "min": 0, "max": 50, "unit": "degC"}, {"axis": "model_corner", "target": "speaker_output", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "speaker_output", "min": 0, "max": 0, "unit": "ratio"}]}
    ],
    "behavioral_requirements": [
      {"id": "closed_loop_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "min": 9.5, "max": 10.5, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["rated_audio", "load_and_thermal_corners"]},
      {"id": "audio_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "min": 50000, "unit": "Hz", "operating_cases": ["rated_audio"]},
      {"id": "output_swing", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "min": 7.6, "max": 8.4, "unit": "V", "frequency_hz": 1000, "operating_cases": ["rated_audio"]},
      {"id": "load_power", "metric": "output_power", "analysis": "transient", "observation": {"kind": "port", "id": "speaker_output"}, "min": 3.6, "max": 4.4, "unit": "W", "frequency_hz": 1000, "operating_cases": ["rated_audio"]},
      {"id": "idle_current", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "circuit", "id": "total_supply_current"}, "min": 0.025, "max": 0.12, "unit": "A", "operating_cases": ["rated_audio", "load_and_thermal_corners"], "critical": true},
      {"id": "audio_distortion", "metric": "total_harmonic_distortion", "analysis": "distortion", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "speaker_output"}, "max": 0.5, "unit": "%", "frequency_hz": 1000, "operating_cases": ["rated_audio"]},
      {"id": "feedback_stability", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "speaker_output"}, "min": 50, "unit": "deg", "operating_cases": ["rated_audio", "load_and_thermal_corners"], "critical": true},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["load_and_thermal_corners"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.2, "unit": "ratio", "operating_cases": ["load_and_thermal_corners"], "critical": true}
    ],
    "constraints": {"max_components": 32, "max_width_mm": 110, "max_height_mm": 70}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
