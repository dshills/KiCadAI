{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "mains_notch_filter",
    "title": "Mains-frequency notch filter",
    "description": "Reject a narrow mains-frequency interference band while preserving nearby sensor signals with high input impedance and low added noise."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply_positive", "kind": "supply", "min_voltage_v": 11, "nominal_voltage_v": 12, "max_voltage_v": 13, "max_current_a": 0.05, "source": "external"},
      {"id": "supply_negative", "kind": "supply", "min_voltage_v": -13, "nominal_voltage_v": -12, "max_voltage_v": -11, "max_current_a": 0.05, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power_positive", "kind": "power", "direction": "sink", "domain": "supply_positive"},
      {"id": "power_negative", "kind": "power", "direction": "sink", "domain": "supply_negative"},
      {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -1, "nominal_voltage_v": 0, "max_voltage_v": 1, "input_impedance_min_ohm": 100000}},
      {"id": "filtered_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -1, "nominal_voltage_v": 0, "max_voltage_v": 1}}
    ],
    "operating_cases": [
      {"id": "measurement_load", "conditions": [{"axis": "supply_voltage", "target": "supply_positive", "min": 11, "max": 13, "unit": "V"}, {"axis": "supply_voltage", "target": "supply_negative", "min": -13, "max": -11, "unit": "V"}, {"axis": "load_resistance", "target": "filtered_output", "min": 100000, "max": 1000000, "unit": "ohm"}, {"axis": "load_capacitance", "target": "filtered_output", "min": 1e-11, "max": 2e-10, "unit": "F"}, {"axis": "tolerance_corner", "target": "filtered_output", "min": 0, "max": 0, "unit": "ratio"}]}
    ],
    "behavioral_requirements": [
      {"id": "notch_depth", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "filtered_output"}, "max": 0.05, "unit": "ratio", "frequency_hz": 60, "operating_cases": ["measurement_load"], "critical": true},
      {"id": "lower_passband", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "filtered_output"}, "min": 0.85, "max": 1.1, "unit": "ratio", "frequency_hz": 20, "operating_cases": ["measurement_load"]},
      {"id": "upper_passband", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "filtered_output"}, "min": 0.85, "max": 1.1, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["measurement_load"]},
      {"id": "input_loading", "metric": "input_impedance", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "signal_input"}, "min": 100000, "unit": "ohm", "frequency_hz": 60, "operating_cases": ["measurement_load"]},
      {"id": "integrated_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "filtered_output"}, "max": 0.0002, "unit": "V", "operating_cases": ["measurement_load"]},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "filtered_output"}, "max": 0.15, "unit": "s", "operating_cases": ["measurement_load"]},
      {"id": "stable_output", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "filtered_output"}, "min": 50, "unit": "deg", "operating_cases": ["measurement_load"], "critical": true},
      {"id": "supply_current", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "circuit", "id": "total_supply_current"}, "max": 0.02, "unit": "A", "operating_cases": ["measurement_load"]}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
