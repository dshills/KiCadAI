{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "low_noise_adjustable_voltage_output",
    "title": "Low-noise adjustable voltage output",
    "description": "Produce command-dependent low-noise output levels from a varying higher-voltage source across line, load, startup, fault, and temperature conditions."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "input_supply", "kind": "supply", "min_voltage_v": 6, "nominal_voltage_v": 9, "max_voltage_v": 12, "max_current_a": 0.4, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_supply"},
      {"id": "voltage_command", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.8, "nominal_voltage_v": 1, "max_voltage_v": 1.2}},
      {"id": "quiet_output", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 3.2, "nominal_voltage_v": 4.15, "max_voltage_v": 5.1, "max_current_a": 0.15}}
    ],
    "operating_cases": [
      {"id": "low_setting", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 6, "max": 12, "unit": "V"}, {"axis": "input_voltage", "target": "voltage_command", "min": 0.8, "max": 0.8, "unit": "V"}, {"axis": "load_current", "target": "quiet_output", "min": 0.005, "max": 0.15, "unit": "A"}, {"axis": "load_capacitance", "target": "quiet_output", "min": 0.000001, "max": 0.000047, "unit": "F"}, {"axis": "ambient_temperature", "target": "quiet_output", "min": -10, "max": 60, "unit": "degC"}, {"axis": "model_corner", "target": "quiet_output", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "quiet_output", "min": 0, "max": 0, "unit": "ratio"}]},
      {"id": "high_setting", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 7, "max": 12, "unit": "V"}, {"axis": "input_voltage", "target": "voltage_command", "min": 1.2, "max": 1.2, "unit": "V"}, {"axis": "load_current", "target": "quiet_output", "min": 0.005, "max": 0.15, "unit": "A"}, {"axis": "load_capacitance", "target": "quiet_output", "min": 0.000001, "max": 0.000047, "unit": "F"}, {"axis": "ambient_temperature", "target": "quiet_output", "min": -10, "max": 60, "unit": "degC"}, {"axis": "model_corner", "target": "quiet_output", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "quiet_output", "min": 0, "max": 0, "unit": "ratio"}]},
      {"id": "startup", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 0, "max": 9, "unit": "V"}, {"axis": "input_voltage", "target": "voltage_command", "min": 1.2, "max": 1.2, "unit": "V"}, {"axis": "load_current", "target": "quiet_output", "min": 0.05, "max": 0.05, "unit": "A"}], "events": [{"id": "apply_input", "kind": "startup", "target": "input_power", "trigger_time_s": 0.001, "initial": 0, "applied": 9, "unit": "V"}]},
      {"id": "shorted_output", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 12, "max": 12, "unit": "V"}, {"axis": "input_voltage", "target": "voltage_command", "min": 1.2, "max": 1.2, "unit": "V"}, {"axis": "load_current", "target": "quiet_output", "min": 0.15, "max": 0.15, "unit": "A"}, {"axis": "ambient_temperature", "target": "quiet_output", "min": 60, "max": 60, "unit": "degC"}], "events": [{"id": "apply_short", "kind": "short_circuit", "target": "quiet_output", "trigger_time_s": 0.005, "initial": 0.15, "applied": 2, "unit": "A"}]}
    ],
    "behavioral_requirements": [
      {"id": "high_output", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "quiet_output"}, "min": 4.95, "max": 5.05, "unit": "V", "operating_cases": ["high_setting"]},
      {"id": "line_change", "metric": "line_regulation", "analysis": "dc_sweep", "excitation": {"kind": "domain", "id": "input_supply"}, "observation": {"kind": "port", "id": "quiet_output"}, "max": 0.03, "unit": "V", "operating_cases": ["low_setting", "high_setting"]},
      {"id": "load_change", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "quiet_output"}, "max": 0.05, "unit": "V", "operating_cases": ["low_setting", "high_setting"]},
      {"id": "low_output", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "quiet_output"}, "min": 3.25, "max": 3.35, "unit": "V", "operating_cases": ["low_setting"]},
      {"id": "noise_limit", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "quiet_output"}, "max": 0.0001, "unit": "V_rms", "operating_cases": ["low_setting", "high_setting"], "critical": true},
      {"id": "phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "quiet_output"}, "min": 55, "unit": "deg", "operating_cases": ["low_setting", "high_setting"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.4, "unit": "ratio", "operating_cases": ["high_setting", "shorted_output"], "critical": true},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["high_setting", "shorted_output"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "startup", "observation": {"kind": "port", "id": "quiet_output"}, "max": 0.02, "unit": "s", "operating_cases": ["startup"], "critical": true},
      {"id": "short_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "quiet_output"}, "max": 0.25, "unit": "A", "operating_cases": ["shorted_output"], "critical": true},
      {"id": "startup_peak", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "quiet_output"}, "max": 0.2, "unit": "V", "operating_cases": ["startup"], "critical": true}
    ],
    "constraints": {"max_components": 28, "max_width_mm": 80, "max_height_mm": 55}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
