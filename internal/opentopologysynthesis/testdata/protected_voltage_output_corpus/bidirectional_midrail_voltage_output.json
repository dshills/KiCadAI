{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bidirectional_midrail_voltage_output",
    "title": "Bidirectional midrail voltage output",
    "description": "Hold a quiet six-volt virtual rail while sourcing and sinking load current across line, capacitive-load, startup, fault, and temperature conditions."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "input_supply", "kind": "supply", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 0.6, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_supply"},
      {"id": "midrail_enable", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5, "default_state": "high"}},
      {"id": "midrail_output", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 5.9, "nominal_voltage_v": 6, "max_voltage_v": 6.1, "max_current_a": 0.1}}
    ],
    "operating_cases": [
      {"id": "bidirectional_load", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 10, "max": 14, "unit": "V"}, {"axis": "input_voltage", "target": "midrail_enable", "min": 5, "max": 5, "unit": "V"}, {"axis": "load_current", "target": "midrail_output", "min": -0.1, "max": 0.1, "unit": "A"}, {"axis": "load_capacitance", "target": "midrail_output", "min": 0.000001, "max": 0.0001, "unit": "F"}, {"axis": "ambient_temperature", "target": "midrail_output", "min": -10, "max": 60, "unit": "degC"}, {"axis": "model_corner", "target": "midrail_output", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "midrail_output", "min": 0, "max": 0, "unit": "ratio"}]},
      {"id": "startup", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 0, "max": 12, "unit": "V"}, {"axis": "input_voltage", "target": "midrail_enable", "min": 5, "max": 5, "unit": "V"}, {"axis": "load_current", "target": "midrail_output", "min": 0, "max": 0, "unit": "A"}], "events": [{"id": "apply_input", "kind": "startup", "target": "input_power", "trigger_time_s": 0.001, "initial": 0, "applied": 12, "unit": "V"}]},
      {"id": "short_to_low", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 14, "max": 14, "unit": "V"}, {"axis": "input_voltage", "target": "midrail_enable", "min": 5, "max": 5, "unit": "V"}, {"axis": "load_current", "target": "midrail_output", "min": 0.1, "max": 0.1, "unit": "A"}, {"axis": "ambient_temperature", "target": "midrail_output", "min": 60, "max": 60, "unit": "degC"}], "events": [{"id": "pull_low", "kind": "short_circuit", "target": "midrail_output", "trigger_time_s": 0.005, "initial": 0.1, "applied": 2, "unit": "A"}]},
      {"id": "short_to_high", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 14, "max": 14, "unit": "V"}, {"axis": "input_voltage", "target": "midrail_enable", "min": 5, "max": 5, "unit": "V"}, {"axis": "load_current", "target": "midrail_output", "min": -0.1, "max": -0.1, "unit": "A"}, {"axis": "ambient_temperature", "target": "midrail_output", "min": 60, "max": 60, "unit": "degC"}], "events": [{"id": "pull_high", "kind": "short_circuit", "target": "midrail_output", "trigger_time_s": 0.005, "initial": -0.1, "applied": -2, "unit": "A"}]}
    ],
    "behavioral_requirements": [
      {"id": "line_change", "metric": "line_regulation", "analysis": "dc_sweep", "excitation": {"kind": "domain", "id": "input_supply"}, "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.05, "unit": "V", "operating_cases": ["bidirectional_load"]},
      {"id": "load_change", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.08, "unit": "V", "operating_cases": ["bidirectional_load"]},
      {"id": "midpoint_accuracy", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "midrail_output"}, "min": 5.95, "max": 6.05, "unit": "V", "operating_cases": ["bidirectional_load"]},
      {"id": "noise_limit", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.0002, "unit": "V_rms", "operating_cases": ["bidirectional_load"], "critical": true},
      {"id": "phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "midrail_output"}, "min": 55, "unit": "deg", "operating_cases": ["bidirectional_load"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.4, "unit": "ratio", "operating_cases": ["bidirectional_load", "short_to_low", "short_to_high"], "critical": true},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["bidirectional_load", "short_to_low", "short_to_high"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "startup", "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.03, "unit": "s", "operating_cases": ["startup"], "critical": true},
      {"id": "short_high_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.2, "unit": "A", "operating_cases": ["short_to_high"], "critical": true},
      {"id": "short_low_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.2, "unit": "A", "operating_cases": ["short_to_low"], "critical": true},
      {"id": "startup_peak", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "midrail_output"}, "max": 0.2, "unit": "V", "operating_cases": ["startup"], "critical": true}
    ],
    "constraints": {"max_components": 32, "max_width_mm": 90, "max_height_mm": 65}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
