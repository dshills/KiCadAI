{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "startup_safe_high_side_current_source",
    "title": "Startup-safe high-side current source",
    "description": "Source a command-programmed load current across supply and load variation while requiring an explicit permit and fault-dominant shutdown."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "supply", "kind": "supply", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 0.2, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "setpoint", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0.6, "max_voltage_v": 1, "input_impedance_min_ohm": 100000}},
      {"id": "permit", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.3, "default_state": "low"}},
      {"id": "fault", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 3.3, "default_state": "low"}},
      {"id": "current_output", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"max_current_a": 0.09}}
    ],
    "operating_cases": [
      {
        "id": "permitted_regulation",
        "conditions": [
          {"axis": "supply_voltage", "target": "supply", "min": 9, "max": 15, "unit": "V"},
          {"axis": "input_voltage", "target": "setpoint", "min": 0.2, "max": 1, "unit": "V"},
          {"axis": "input_voltage", "target": "permit", "min": 3.3, "max": 3.3, "unit": "V"},
          {"axis": "input_voltage", "target": "fault", "min": 0, "max": 0, "unit": "V"},
          {"axis": "load_resistance", "target": "current_output", "min": 10, "max": 70, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "current_output", "min": 0, "max": 60, "unit": "degC"}
        ]
      },
      {
        "id": "unpermitted_startup",
        "conditions": [
          {"axis": "supply_voltage", "target": "supply", "min": 0, "max": 12, "unit": "V"},
          {"axis": "input_voltage", "target": "setpoint", "min": 1, "max": 1, "unit": "V"},
          {"axis": "input_voltage", "target": "permit", "min": 0, "max": 0, "unit": "V"},
          {"axis": "input_voltage", "target": "fault", "min": 0, "max": 0, "unit": "V"},
          {"axis": "load_resistance", "target": "current_output", "min": 47, "max": 47, "unit": "ohm"}
        ],
        "events": [
          {"id": "apply_supply_without_permit", "kind": "startup", "target": "power", "trigger_time_s": 0.001, "initial": 0, "applied": 12, "unit": "V"}
        ]
      },
      {
        "id": "fault_shutdown",
        "conditions": [
          {"axis": "supply_voltage", "target": "supply", "min": 12, "max": 12, "unit": "V"},
          {"axis": "input_voltage", "target": "setpoint", "min": 1, "max": 1, "unit": "V"},
          {"axis": "input_voltage", "target": "permit", "min": 3.3, "max": 3.3, "unit": "V"},
          {"axis": "input_voltage", "target": "fault", "min": 0, "max": 3.3, "unit": "V"},
          {"axis": "load_resistance", "target": "current_output", "min": 2, "max": 2, "unit": "ohm"}
        ],
        "events": [
          {"id": "assert_fault", "kind": "input_step", "target": "fault", "trigger_time_s": 0.002, "initial": 0, "applied": 3.3, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "command_accuracy", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "setpoint"}, "observation": {"kind": "port", "id": "current_output"}, "min": 0.076, "max": 0.084, "unit": "A/V", "operating_cases": ["permitted_regulation"]},
      {"id": "rated_current", "metric": "output_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "current_output"}, "min": 0.076, "max": 0.084, "unit": "A", "operating_cases": ["permitted_regulation"]},
      {"id": "startup_off", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "current_output"}, "max": 0.001, "unit": "A", "operating_cases": ["unpermitted_startup"], "critical": true},
      {"id": "fault_disconnect", "metric": "off_state_current", "analysis": "transient", "excitation": {"kind": "port", "id": "fault"}, "observation": {"kind": "port", "id": "current_output"}, "max": 0.002, "unit": "A", "operating_cases": ["fault_shutdown"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "setpoint"}, "observation": {"kind": "port", "id": "current_output"}, "max": 0.001, "unit": "s", "operating_cases": ["permitted_regulation"]},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["permitted_regulation", "fault_shutdown"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["permitted_regulation", "fault_shutdown"], "critical": true}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
