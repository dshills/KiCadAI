{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "autonomous_square_wave_source", "title": "Enabled autonomous square-wave source", "description": "Generate a repeatable rail-referenced square waveform after enable with bounded frequency, duty cycle, transition time, startup, and loading."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "logic_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.03, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "power", "kind": "power", "direction": "sink", "domain": "logic_supply"}, {"id": "enable", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 5.25, "default_state": "low"}}, {"id": "waveform_output", "kind": "digital", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 2.5, "max_voltage_v": 5.25, "max_current_a": 0.005}}],
    "operating_cases": [{"id": "enabled_corners", "conditions": [{"axis": "input_voltage", "target": "enable", "min": 3.5, "max": 5.25, "unit": "V"}, {"axis": "load_capacitance", "target": "waveform_output", "min": 0, "max": 1e-9, "unit": "F"}, {"axis": "ambient_temperature", "target": "waveform_output", "min": 0, "max": 60, "unit": "degC"}], "events": [{"id": "enable_step", "kind": "input_step", "target": "enable", "trigger_time_s": 0.001, "initial": 0, "applied": 5, "unit": "V"}]}, {"id": "supply_corners", "conditions": [{"axis": "supply_voltage", "target": "logic_supply", "min": 4.75, "max": 5.25, "unit": "V"}, {"axis": "load_resistance", "target": "waveform_output", "min": 10000, "max": 100000, "unit": "ohm"}]}],
    "behavioral_requirements": [{"id": "oscillation_rate", "metric": "oscillation_frequency", "analysis": "transient", "observation": {"kind": "port", "id": "waveform_output"}, "min": 900, "max": 1100, "unit": "Hz", "operating_cases": ["enabled_corners", "supply_corners"], "critical": true}, {"id": "duty_balance", "metric": "duty_cycle", "analysis": "transient", "observation": {"kind": "port", "id": "waveform_output"}, "min": 40, "max": 60, "unit": "%", "operating_cases": ["enabled_corners", "supply_corners"]}, {"id": "output_span", "metric": "output_swing", "analysis": "transient", "observation": {"kind": "port", "id": "waveform_output"}, "min": 4, "unit": "V_pp", "operating_cases": ["enabled_corners", "supply_corners"]}, {"id": "rising_transition", "metric": "rise_time", "analysis": "transient", "observation": {"kind": "port", "id": "waveform_output"}, "max": 0.00005, "unit": "s", "operating_cases": ["enabled_corners"]}, {"id": "falling_transition", "metric": "fall_time", "analysis": "transient", "observation": {"kind": "port", "id": "waveform_output"}, "max": 0.00005, "unit": "s", "operating_cases": ["enabled_corners"]}, {"id": "startup_limit", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "waveform_output"}, "max": 0.5, "unit": "V", "operating_cases": ["enabled_corners"]}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 100, "unit": "degC", "operating_cases": ["enabled_corners"], "critical": true}],
    "constraints": {"max_components": 14, "max_width_mm": 55, "max_height_mm": 45}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
