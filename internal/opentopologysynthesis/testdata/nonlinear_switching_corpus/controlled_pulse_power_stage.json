{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "controlled_pulse_power_stage", "title": "Controlled pulse power stage", "description": "Translate a logic pulse command into a low-loss load waveform with bounded transition time, leakage, current stress, temperature, and safe operating margin."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "logic_supply", "kind": "supply", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.05, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 1, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "logic_power", "kind": "power", "direction": "sink", "domain": "logic_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "pulse_command", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 3.6, "default_state": "low"}}, {"id": "load_output", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 6, "max_voltage_v": 14, "max_current_a": 0.75}}],
    "operating_cases": [{"id": "nominal_pulses", "conditions": [{"axis": "input_voltage", "target": "pulse_command", "min": 0, "max": 3.3, "unit": "V"}, {"axis": "load_resistance", "target": "load_output", "min": 16, "max": 24, "unit": "ohm"}, {"axis": "load_inductance", "target": "load_output", "min": 0, "max": 0.002, "unit": "H"}], "events": [{"id": "command_high", "kind": "input_step", "target": "pulse_command", "trigger_time_s": 0.00001, "initial": 0, "applied": 3.3, "unit": "V"}]}, {"id": "electrical_corners", "conditions": [{"axis": "supply_voltage", "target": "load_supply", "min": 10, "max": 14, "unit": "V"}, {"axis": "ambient_temperature", "target": "load_output", "min": -10, "max": 70, "unit": "degC"}, {"axis": "model_corner", "target": "load_output", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "load_output", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "pulse_duty_transfer", "metric": "duty_cycle", "analysis": "transient", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_output"}, "min": 45, "max": 55, "unit": "%", "frequency_hz": 20000, "operating_cases": ["nominal_pulses", "electrical_corners"]}, {"id": "on_state_loss", "metric": "on_state_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_output"}, "max": 0.25, "unit": "V", "operating_cases": ["nominal_pulses", "electrical_corners"]}, {"id": "off_state_leakage", "metric": "off_state_current", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_output"}, "max": 0.0001, "unit": "A", "operating_cases": ["nominal_pulses", "electrical_corners"]}, {"id": "rising_transition", "metric": "rise_time", "analysis": "transient", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_output"}, "max": 0.000002, "unit": "s", "frequency_hz": 20000, "operating_cases": ["nominal_pulses"]}, {"id": "falling_transition", "metric": "fall_time", "analysis": "transient", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_output"}, "max": 0.000002, "unit": "s", "frequency_hz": 20000, "operating_cases": ["nominal_pulses"]}, {"id": "peak_load_current", "metric": "peak_current", "analysis": "electrothermal", "observation": {"kind": "port", "id": "load_output"}, "max": 0.9, "unit": "A", "frequency_hz": 20000, "operating_cases": ["electrical_corners"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 110, "unit": "degC", "frequency_hz": 20000, "operating_cases": ["electrical_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "frequency_hz": 20000, "operating_cases": ["electrical_corners"], "critical": true}],
    "constraints": {"max_components": 16, "max_width_mm": 65, "max_height_mm": 50}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
