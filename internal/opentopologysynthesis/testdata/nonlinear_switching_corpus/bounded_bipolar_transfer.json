{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "bounded_bipolar_transfer", "title": "Bounded bipolar signal transfer", "description": "Pass small bipolar inputs with low error while bounding either output polarity during overdrive and transient conditions."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "positive_limit", "kind": "supply", "min_voltage_v": 1.9, "nominal_voltage_v": 2, "max_voltage_v": 2.1, "max_current_a": 0.02, "source": "external"}, {"id": "negative_limit", "kind": "supply", "min_voltage_v": -2.1, "nominal_voltage_v": -2, "max_voltage_v": -1.9, "max_current_a": 0.02, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "positive_reference", "kind": "power", "direction": "sink", "domain": "positive_limit"}, {"id": "negative_reference", "kind": "power", "direction": "sink", "domain": "negative_limit"}, {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -8, "nominal_voltage_v": 0, "max_voltage_v": 8, "input_impedance_min_ohm": 10000}}, {"id": "bounded_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -2.3, "nominal_voltage_v": 0, "max_voltage_v": 2.3, "max_current_a": 0.005}}],
    "operating_cases": [{"id": "linear_region", "conditions": [{"axis": "input_voltage", "target": "signal_input", "min": -0.5, "max": 0.5, "unit": "V"}, {"axis": "load_resistance", "target": "bounded_output", "min": 10000, "max": 100000, "unit": "ohm"}]}, {"id": "negative_overdrive", "conditions": [{"axis": "input_voltage", "target": "signal_input", "min": -8, "max": -6, "unit": "V"}, {"axis": "ambient_temperature", "target": "bounded_output", "min": -20, "max": 70, "unit": "degC"}]}, {"id": "positive_overdrive", "conditions": [{"axis": "input_voltage", "target": "signal_input", "min": 6, "max": 8, "unit": "V"}, {"axis": "ambient_temperature", "target": "bounded_output", "min": -20, "max": 70, "unit": "degC"}]}],
    "behavioral_requirements": [{"id": "linear_accuracy", "metric": "voltage_gain", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "bounded_output"}, "min": 0.95, "max": 1.05, "unit": "ratio", "operating_cases": ["linear_region"]}, {"id": "negative_bound", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "bounded_output"}, "min": -2.3, "max": -1.7, "unit": "V", "operating_cases": ["negative_overdrive"]}, {"id": "positive_bound", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "bounded_output"}, "min": 1.7, "max": 2.3, "unit": "V", "operating_cases": ["positive_overdrive"]}, {"id": "transient_bound", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "bounded_output"}, "max": 2.35, "unit": "V", "operating_cases": ["negative_overdrive", "positive_overdrive"]}, {"id": "signal_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "bounded_output"}, "min": 100000, "unit": "Hz", "operating_cases": ["linear_region"]}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 100, "unit": "degC", "operating_cases": ["negative_overdrive", "positive_overdrive"], "critical": true}],
    "constraints": {"max_components": 12, "max_width_mm": 50, "max_height_mm": 40}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
