{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "bipolar_magnitude_transfer", "title": "Low-level bipolar magnitude transfer", "description": "Produce a positive output proportional to either polarity of a low-level input while retaining bandwidth, settling, and noise limits."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "positive_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.05, "source": "external"}, {"id": "negative_supply", "kind": "supply", "min_voltage_v": -5.25, "nominal_voltage_v": -5, "max_voltage_v": -4.75, "max_current_a": 0.05, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "positive_power", "kind": "power", "direction": "sink", "domain": "positive_supply"}, {"id": "negative_power", "kind": "power", "direction": "sink", "domain": "negative_supply"}, {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -0.6, "nominal_voltage_v": 0, "max_voltage_v": 0.6, "input_impedance_min_ohm": 50000}}, {"id": "magnitude_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0.3, "max_voltage_v": 0.65, "max_current_a": 0.002}}],
    "operating_cases": [{"id": "negative_input", "conditions": [{"axis": "input_voltage", "target": "signal_input", "min": -0.5, "max": -0.5, "unit": "V"}, {"axis": "load_resistance", "target": "magnitude_output", "min": 10000, "max": 100000, "unit": "ohm"}]}, {"id": "positive_input", "conditions": [{"axis": "input_voltage", "target": "signal_input", "min": 0.5, "max": 0.5, "unit": "V"}, {"axis": "load_resistance", "target": "magnitude_output", "min": 10000, "max": 100000, "unit": "ohm"}]}, {"id": "zero_crossing", "conditions": [{"axis": "input_voltage", "target": "signal_input", "min": -0.02, "max": 0.02, "unit": "V"}, {"axis": "ambient_temperature", "target": "magnitude_output", "min": 0, "max": 50, "unit": "degC"}]}],
    "behavioral_requirements": [{"id": "negative_accuracy", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "magnitude_output"}, "min": 0.49, "max": 0.51, "unit": "V", "operating_cases": ["negative_input"]}, {"id": "positive_accuracy", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "magnitude_output"}, "min": 0.49, "max": 0.51, "unit": "V", "operating_cases": ["positive_input"]}, {"id": "zero_crossing_error", "metric": "output_voltage", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "magnitude_output"}, "max": 0.02, "unit": "V", "operating_cases": ["zero_crossing"]}, {"id": "signal_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "magnitude_output"}, "min": 20000, "unit": "Hz", "operating_cases": ["positive_input", "negative_input"]}, {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "magnitude_output"}, "max": 0.0001, "unit": "s", "operating_cases": ["positive_input", "negative_input"]}, {"id": "output_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "magnitude_output"}, "max": 0.001, "unit": "V_rms", "operating_cases": ["zero_crossing"]}],
    "constraints": {"max_components": 20, "max_width_mm": 65, "max_height_mm": 50}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
