{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "windowed_heating_power_control", "title": "Windowed heating power control", "description": "Observe a temperature-related signal and apply heating power only within a bounded interval, remain stable near both boundaries, start inactive, respond promptly, and satisfy leakage, temperature, and safe operating limits."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "control_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1, "source": "external"}, {"id": "heater_supply", "kind": "supply", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 28, "max_current_a": 2, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "control_power", "kind": "power", "direction": "sink", "domain": "control_supply"}, {"id": "heater_power", "kind": "power", "direction": "sink", "domain": "heater_supply"}, {"id": "temperature_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.2, "nominal_voltage_v": 2.5, "max_voltage_v": 4.8, "input_impedance_min_ohm": 100000}}, {"id": "heating_output", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 12, "max_voltage_v": 28, "max_current_a": 1.5}}],
    "operating_cases": [{"id": "window_sweep", "conditions": [{"axis": "input_voltage", "target": "temperature_input", "min": 0.2, "max": 4.8, "unit": "V"}, {"axis": "load_resistance", "target": "heating_output", "min": 18, "max": 40, "unit": "ohm"}], "events": [{"id": "enter_window", "kind": "input_step", "target": "temperature_input", "trigger_time_s": 0.005, "initial": 0.5, "applied": 2.5, "unit": "V"}]}, {"id": "window_corners", "conditions": [{"axis": "supply_voltage", "target": "heater_supply", "min": 18, "max": 28, "unit": "V"}, {"axis": "ambient_temperature", "target": "heating_output", "min": -20, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "temperature_input", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "lower_entry", "metric": "lower_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "temperature_input"}, "observation": {"kind": "port", "id": "heating_output"}, "min": 1.15, "max": 1.25, "unit": "V", "operating_cases": ["window_sweep", "window_corners"], "critical": true}, {"id": "upper_exit", "metric": "upper_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "temperature_input"}, "observation": {"kind": "port", "id": "heating_output"}, "min": 3.75, "max": 3.85, "unit": "V", "operating_cases": ["window_sweep", "window_corners"], "critical": true}, {"id": "boundary_stability", "metric": "hysteresis", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "heating_output"}, "min": 0.08, "max": 0.2, "unit": "V", "operating_cases": ["window_sweep"]}, {"id": "active_current", "metric": "output_current", "analysis": "transient", "observation": {"kind": "port", "id": "heating_output"}, "min": 0.5, "max": 1.2, "unit": "A", "operating_cases": ["window_sweep", "window_corners"]}, {"id": "window_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "temperature_input"}, "observation": {"kind": "port", "id": "heating_output"}, "max": 0.003, "unit": "s", "operating_cases": ["window_sweep"]}, {"id": "inactive_leakage", "metric": "off_state_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "heating_output"}, "max": 0.0001, "unit": "A", "operating_cases": ["window_sweep"]}, {"id": "inactive_start", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "heating_output"}, "max": 0.03, "unit": "A", "operating_cases": ["window_sweep"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 115, "unit": "degC", "operating_cases": ["window_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.3, "unit": "ratio", "operating_cases": ["window_corners"], "critical": true}],
    "constraints": {"max_components": 28, "max_width_mm": 80, "max_height_mm": 60}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
