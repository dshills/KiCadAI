{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "inductive_load_current_control", "title": "Inductive load current control", "description": "Translate a logic pulse command into controlled current for an energy-storing load while bounding on loss, off leakage, transitions, startup current, temperature, and safe operating margin."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "logic_supply", "kind": "supply", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.08, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 30, "max_current_a": 2, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "logic_power", "kind": "power", "direction": "sink", "domain": "logic_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "pulse_command", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 3.6, "default_state": "low"}}, {"id": "load_current", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 12, "max_voltage_v": 30, "max_current_a": 1.5}}],
    "operating_cases": [{"id": "pulse_operation", "conditions": [{"axis": "load_resistance", "target": "load_current", "min": 18, "max": 35, "unit": "ohm"}, {"axis": "load_inductance", "target": "load_current", "min": 0.01, "max": 0.08, "unit": "H"}], "events": [{"id": "command_high", "kind": "input_step", "target": "pulse_command", "trigger_time_s": 0.0001, "initial": 0, "applied": 3.3, "unit": "V"}]}, {"id": "stress_corners", "conditions": [{"axis": "supply_voltage", "target": "load_supply", "min": 18, "max": 30, "unit": "V"}, {"axis": "ambient_temperature", "target": "load_current", "min": -20, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "load_current", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "pulse_transfer", "metric": "duty_cycle", "analysis": "transient", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_current"}, "min": 35, "max": 65, "unit": "%", "frequency_hz": 1000, "operating_cases": ["pulse_operation", "stress_corners"]}, {"id": "active_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "load_current"}, "min": 0.5, "max": 1.2, "unit": "A", "frequency_hz": 1000, "operating_cases": ["pulse_operation", "stress_corners"], "critical": true}, {"id": "on_state_loss", "metric": "on_state_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_current"}, "max": 0.5, "unit": "V", "operating_cases": ["pulse_operation"]}, {"id": "off_state_leakage", "metric": "off_state_current", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_current"}, "max": 0.0001, "unit": "A", "operating_cases": ["pulse_operation"]}, {"id": "release_time", "metric": "fall_time", "analysis": "transient", "observation": {"kind": "port", "id": "load_current"}, "max": 0.0005, "unit": "s", "frequency_hz": 1000, "operating_cases": ["pulse_operation"]}, {"id": "startup_bound", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "load_current"}, "max": 0.05, "unit": "A", "operating_cases": ["pulse_operation"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 115, "unit": "degC", "frequency_hz": 1000, "operating_cases": ["stress_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.3, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["stress_corners"], "critical": true}],
    "constraints": {"max_components": 24, "max_width_mm": 80, "max_height_mm": 60}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
