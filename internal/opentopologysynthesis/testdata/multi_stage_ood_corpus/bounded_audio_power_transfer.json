{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "bounded_audio_power_transfer", "title": "Bounded audio power transfer", "description": "Increase a small bipolar audio signal, deliver useful low-distortion power to a low-impedance load, limit excessive peaks, retain bandwidth and low noise, settle cleanly, and remain within temperature and safe operating bounds."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "positive_supply", "kind": "supply", "min_voltage_v": 20, "nominal_voltage_v": 24, "max_voltage_v": 28, "max_current_a": 2.5, "source": "external"}, {"id": "negative_supply", "kind": "supply", "min_voltage_v": -28, "nominal_voltage_v": -24, "max_voltage_v": -20, "max_current_a": 2.5, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "positive_power", "kind": "power", "direction": "sink", "domain": "positive_supply"}, {"id": "negative_power", "kind": "power", "direction": "sink", "domain": "negative_supply"}, {"id": "audio_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -0.8, "nominal_voltage_v": 0, "max_voltage_v": 0.8, "input_impedance_min_ohm": 22000}}, {"id": "audio_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -16, "nominal_voltage_v": 0, "max_voltage_v": 16, "max_current_a": 2.2}}],
    "operating_cases": [{"id": "nominal_audio", "conditions": [{"axis": "input_voltage", "target": "audio_input", "min": -0.5, "max": 0.5, "unit": "V"}, {"axis": "load_resistance", "target": "audio_output", "min": 8, "max": 8, "unit": "ohm"}], "events": [{"id": "audio_step", "kind": "input_step", "target": "audio_input", "trigger_time_s": 0.002, "initial": 0, "applied": 0.25, "unit": "V"}]}, {"id": "audio_corners", "conditions": [{"axis": "supply_voltage", "target": "positive_supply", "min": 20, "max": 28, "unit": "V"}, {"axis": "load_resistance", "target": "audio_output", "min": 4, "max": 8, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "audio_output", "min": 0, "max": 55, "unit": "degC"}, {"axis": "tolerance_corner", "target": "audio_input", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "audio_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "audio_output"}, "min": 18, "max": 22, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["nominal_audio", "audio_corners"], "critical": true}, {"id": "audio_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "audio_output"}, "min": 20000, "unit": "Hz", "operating_cases": ["nominal_audio", "audio_corners"]}, {"id": "delivered_power", "metric": "output_power", "analysis": "distortion", "observation": {"kind": "port", "id": "audio_output"}, "min": 8, "max": 20, "unit": "W", "frequency_hz": 1000, "operating_cases": ["nominal_audio", "audio_corners"], "critical": true}, {"id": "harmonic_limit", "metric": "total_harmonic_distortion", "analysis": "distortion", "observation": {"kind": "port", "id": "audio_output"}, "max": 0.5, "unit": "%", "frequency_hz": 1000, "operating_cases": ["nominal_audio", "audio_corners"]}, {"id": "noise_limit", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "audio_output"}, "max": 0.002, "unit": "V_rms", "operating_cases": ["nominal_audio"]}, {"id": "peak_bound", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "audio_output"}, "max": 16, "unit": "V", "operating_cases": ["nominal_audio", "audio_corners"], "critical": true}, {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "audio_input"}, "observation": {"kind": "port", "id": "audio_output"}, "max": 0.001, "unit": "s", "operating_cases": ["nominal_audio"]}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 115, "unit": "degC", "frequency_hz": 1000, "operating_cases": ["audio_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.3, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["audio_corners"], "critical": true}],
    "constraints": {"max_components": 32, "max_width_mm": 100, "max_height_mm": 75}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
