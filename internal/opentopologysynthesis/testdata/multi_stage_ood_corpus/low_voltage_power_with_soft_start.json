{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "low_voltage_power_with_soft_start", "title": "Low-voltage power with soft start", "description": "Deliver a regulated low-voltage output from a variable higher supply when enabled, limit startup current and overshoot, reject line and load change, maintain efficiency and ripple bounds, and remain thermally safe."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "input_supply", "kind": "supply", "min_voltage_v": 12, "nominal_voltage_v": 18, "max_voltage_v": 24, "max_current_a": 1.5, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_supply"}, {"id": "enable", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 5, "default_state": "low"}}, {"id": "regulated_output", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 4.8, "nominal_voltage_v": 5, "max_voltage_v": 5.2, "max_current_a": 1}}],
    "operating_cases": [{"id": "enabled_load", "conditions": [{"axis": "load_current", "target": "regulated_output", "min": 0.1, "max": 0.8, "unit": "A"}, {"axis": "load_capacitance", "target": "regulated_output", "min": 0.00001, "max": 0.0001, "unit": "F"}], "events": [{"id": "enable_step", "kind": "input_step", "target": "enable", "trigger_time_s": 0.002, "initial": 0, "applied": 5, "unit": "V"}]}, {"id": "line_load_corners", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 12, "max": 24, "unit": "V"}, {"axis": "load_current", "target": "regulated_output", "min": 0.05, "max": 1, "unit": "A"}, {"axis": "ambient_temperature", "target": "regulated_output", "min": -20, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "regulated_output", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "regulated_voltage", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "regulated_output"}, "min": 4.85, "max": 5.15, "unit": "V", "operating_cases": ["enabled_load", "line_load_corners"], "critical": true}, {"id": "line_stability", "metric": "line_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.08, "unit": "V", "operating_cases": ["line_load_corners"]}, {"id": "load_stability", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.1, "unit": "V", "operating_cases": ["line_load_corners"]}, {"id": "output_ripple_limit", "metric": "output_ripple", "analysis": "transient", "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.05, "unit": "V", "operating_cases": ["enabled_load", "line_load_corners"]}, {"id": "conversion_efficiency", "metric": "conversion_efficiency", "analysis": "transient", "observation": {"kind": "port", "id": "regulated_output"}, "min": 82, "unit": "%", "operating_cases": ["enabled_load", "line_load_corners"]}, {"id": "startup_time", "metric": "settling_time", "analysis": "startup", "excitation": {"kind": "port", "id": "enable"}, "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.02, "unit": "s", "operating_cases": ["enabled_load"]}, {"id": "startup_current_limit", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "input_power"}, "max": 1.2, "unit": "A", "operating_cases": ["enabled_load"], "critical": true}, {"id": "startup_overshoot", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.2, "unit": "V", "operating_cases": ["enabled_load"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 110, "unit": "degC", "operating_cases": ["line_load_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["line_load_corners"], "critical": true}],
    "constraints": {"max_components": 28, "max_width_mm": 80, "max_height_mm": 60}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
