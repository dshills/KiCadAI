{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "undervoltage_load_permission", "title": "Undervoltage load permission", "description": "Observe a battery-level input, permit load power only above a rising bound, remove it below a lower bound, retain stable state between bounds, start disconnected, and remain within delay, leakage, temperature, and safe operating limits."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "battery_supply", "kind": "supply", "min_voltage_v": 8, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 2, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "battery_power", "kind": "power", "direction": "sink", "domain": "battery_supply"}, {"id": "battery_level", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 8, "nominal_voltage_v": 12, "max_voltage_v": 15, "input_impedance_min_ohm": 100000}}, {"id": "permitted_output", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 1.5}}],
    "operating_cases": [{"id": "battery_sweep", "conditions": [{"axis": "input_voltage", "target": "battery_level", "min": 8, "max": 15, "unit": "V"}, {"axis": "load_resistance", "target": "permitted_output", "min": 10, "max": 50, "unit": "ohm"}], "events": [{"id": "battery_recovery", "kind": "input_step", "target": "battery_level", "trigger_time_s": 0.005, "initial": 9, "applied": 13, "unit": "V"}]}, {"id": "battery_corners", "conditions": [{"axis": "supply_voltage", "target": "battery_supply", "min": 8, "max": 15, "unit": "V"}, {"axis": "ambient_temperature", "target": "permitted_output", "min": -20, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "battery_level", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "recovery_bound", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "battery_level"}, "observation": {"kind": "port", "id": "permitted_output"}, "min": 11.7, "max": 12.1, "unit": "V", "operating_cases": ["battery_sweep", "battery_corners"], "critical": true}, {"id": "disconnect_bound", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "battery_level"}, "observation": {"kind": "port", "id": "permitted_output"}, "min": 10.2, "max": 10.6, "unit": "V", "operating_cases": ["battery_sweep", "battery_corners"], "critical": true}, {"id": "stable_window", "metric": "hysteresis", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "permitted_output"}, "min": 1.1, "max": 1.9, "unit": "V", "operating_cases": ["battery_sweep"]}, {"id": "active_loss", "metric": "on_state_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "permitted_output"}, "max": 0.3, "unit": "V", "operating_cases": ["battery_sweep", "battery_corners"]}, {"id": "disconnected_leakage", "metric": "off_state_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "permitted_output"}, "max": 0.0001, "unit": "A", "operating_cases": ["battery_sweep"]}, {"id": "recovery_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "battery_level"}, "observation": {"kind": "port", "id": "permitted_output"}, "max": 0.005, "unit": "s", "operating_cases": ["battery_sweep"]}, {"id": "disconnected_start", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "permitted_output"}, "max": 0.5, "unit": "V", "operating_cases": ["battery_sweep"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 110, "unit": "degC", "operating_cases": ["battery_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["battery_corners"], "critical": true}],
    "constraints": {"max_components": 24, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
