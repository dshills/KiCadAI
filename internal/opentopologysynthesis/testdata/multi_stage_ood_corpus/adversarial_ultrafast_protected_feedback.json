{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "adversarial_ultrafast_protected_feedback", "title": "Ultra-fast protected feedback", "description": "Translate a precision command into several amperes of controlled output with radio-frequency response, nanosecond transitions, low ripple, calm startup, and strong temperature and safe operating margins."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "control_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.2, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 42, "nominal_voltage_v": 48, "max_voltage_v": 54, "max_current_a": 6, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "control_power", "kind": "power", "direction": "sink", "domain": "control_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "precision_command", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1, "max_voltage_v": 2, "input_impedance_min_ohm": 100000}}, {"id": "controlled_output", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 24, "max_voltage_v": 54, "max_current_a": 5}}],
    "operating_cases": [{"id": "ultrafast_envelope", "conditions": [{"axis": "input_voltage", "target": "precision_command", "min": 0.2, "max": 1.8, "unit": "V"}, {"axis": "supply_voltage", "target": "load_supply", "min": 42, "max": 54, "unit": "V"}, {"axis": "load_current", "target": "controlled_output", "min": 2, "max": 5, "unit": "A"}, {"axis": "ambient_temperature", "target": "controlled_output", "min": 25, "max": 70, "unit": "degC"}], "events": [{"id": "command_step", "kind": "input_step", "target": "precision_command", "trigger_time_s": 0.00000001, "initial": 0.2, "applied": 1.8, "unit": "V"}]}],
    "behavioral_requirements": [{"id": "command_transfer", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "precision_command"}, "observation": {"kind": "port", "id": "controlled_output"}, "min": 2.45, "max": 2.55, "unit": "A/V", "operating_cases": ["ultrafast_envelope"], "critical": true}, {"id": "response_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "precision_command"}, "observation": {"kind": "port", "id": "controlled_output"}, "min": 100000000, "unit": "Hz", "operating_cases": ["ultrafast_envelope"], "critical": true}, {"id": "rise_time", "metric": "rise_time", "analysis": "transient", "excitation": {"kind": "port", "id": "precision_command"}, "observation": {"kind": "port", "id": "controlled_output"}, "max": 0.000000002, "unit": "s", "operating_cases": ["ultrafast_envelope"], "critical": true}, {"id": "output_ripple_limit", "metric": "output_ripple", "analysis": "transient", "observation": {"kind": "port", "id": "controlled_output"}, "max": 0.005, "unit": "A", "operating_cases": ["ultrafast_envelope"]}, {"id": "startup_bound", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "controlled_output"}, "max": 0.05, "unit": "A", "operating_cases": ["ultrafast_envelope"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 100, "unit": "degC", "operating_cases": ["ultrafast_envelope"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.5, "unit": "ratio", "operating_cases": ["ultrafast_envelope"], "critical": true}],
    "constraints": {"max_components": 20, "max_width_mm": 45, "max_height_mm": 35}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
