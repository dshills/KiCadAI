  "project": {"name": "adversarial_high_voltage_sensor_power", "title": "High-voltage sensed power output", "description": "Observe a high-energy source across one reference, report its level and deliver regulated low-voltage power across a separate reference while preserving low error, calm startup, low ripple, temperature, and safe operating bounds."},
  "requirements": {
