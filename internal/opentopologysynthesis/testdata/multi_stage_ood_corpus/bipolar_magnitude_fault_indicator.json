{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "bipolar_magnitude_fault_indicator", "title": "Bipolar magnitude fault indicator", "description": "Observe either polarity of a precision input, declare a fault when its magnitude exceeds a bound, remain quiet near zero, and satisfy delay, noise, startup, temperature, and safe operating limits."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "positive_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.08, "source": "external"}, {"id": "negative_supply", "kind": "supply", "min_voltage_v": -5.25, "nominal_voltage_v": -5, "max_voltage_v": -4.75, "max_current_a": 0.08, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "positive_power", "kind": "power", "direction": "sink", "domain": "positive_supply"}, {"id": "negative_power", "kind": "power", "direction": "sink", "domain": "negative_supply"}, {"id": "bipolar_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -2, "nominal_voltage_v": 0, "max_voltage_v": 2, "input_impedance_min_ohm": 100000}}, {"id": "fault_output", "kind": "digital", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 5, "max_current_a": 0.01, "default_state": "low"}}],
    "operating_cases": [{"id": "magnitude_sweep", "conditions": [{"axis": "input_voltage", "target": "bipolar_input", "min": -2, "max": 2, "unit": "V"}, {"axis": "load_resistance", "target": "fault_output", "min": 10000, "max": 100000, "unit": "ohm"}], "events": [{"id": "positive_fault", "kind": "input_step", "target": "bipolar_input", "trigger_time_s": 0.001, "initial": 0, "applied": 1.5, "unit": "V"}]}, {"id": "precision_corners", "conditions": [{"axis": "ambient_temperature", "target": "fault_output", "min": -20, "max": 70, "unit": "degC"}, {"axis": "supply_voltage", "target": "positive_supply", "min": 4.75, "max": 5.25, "unit": "V"}, {"axis": "tolerance_corner", "target": "bipolar_input", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "positive_fault_bound", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "bipolar_input"}, "observation": {"kind": "port", "id": "fault_output"}, "min": 0.95, "max": 1.05, "unit": "V", "operating_cases": ["magnitude_sweep", "precision_corners"], "critical": true}, {"id": "negative_fault_bound", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "bipolar_input"}, "observation": {"kind": "port", "id": "fault_output"}, "min": -1.05, "max": -0.95, "unit": "V", "operating_cases": ["magnitude_sweep", "precision_corners"], "critical": true}, {"id": "fault_high", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "fault_output"}, "min": 4.5, "unit": "V", "operating_cases": ["magnitude_sweep"]}, {"id": "quiet_low", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "fault_output"}, "max": 0.3, "unit": "V", "operating_cases": ["magnitude_sweep"]}, {"id": "fault_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "bipolar_input"}, "observation": {"kind": "port", "id": "fault_output"}, "max": 0.0001, "unit": "s", "operating_cases": ["magnitude_sweep"]}, {"id": "quiet_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "fault_output"}, "max": 0.005, "unit": "V_rms", "operating_cases": ["precision_corners"]}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 100, "unit": "degC", "operating_cases": ["precision_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["precision_corners"], "critical": true}],
    "constraints": {"max_components": 24, "max_width_mm": 70, "max_height_mm": 55}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
