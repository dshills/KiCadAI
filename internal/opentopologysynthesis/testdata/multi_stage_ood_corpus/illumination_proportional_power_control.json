{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "illumination_proportional_power_control", "title": "Illumination-proportional power control", "description": "Convert an illumination signal into proportional load current with bounded ripple, prompt settling, calm startup, low quiescent demand, and safe temperature and operating margin across supply and load corners."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "control_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 1, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "control_power", "kind": "power", "direction": "sink", "domain": "control_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "illumination_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.1, "nominal_voltage_v": 1, "max_voltage_v": 2, "input_impedance_min_ohm": 50000}}, {"id": "power_output", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 6, "max_voltage_v": 15, "max_current_a": 0.7}}],
    "operating_cases": [{"id": "illumination_range", "conditions": [{"axis": "input_voltage", "target": "illumination_input", "min": 0.1, "max": 2, "unit": "V"}, {"axis": "load_resistance", "target": "power_output", "min": 15, "max": 40, "unit": "ohm"}], "events": [{"id": "illumination_step", "kind": "input_step", "target": "illumination_input", "trigger_time_s": 0.002, "initial": 0.2, "applied": 1.5, "unit": "V"}]}, {"id": "power_corners", "conditions": [{"axis": "supply_voltage", "target": "load_supply", "min": 9, "max": 15, "unit": "V"}, {"axis": "ambient_temperature", "target": "power_output", "min": -10, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "illumination_input", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "proportional_transfer", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "illumination_input"}, "observation": {"kind": "port", "id": "power_output"}, "min": 0.29, "max": 0.31, "unit": "A/V", "operating_cases": ["illumination_range", "power_corners"], "critical": true}, {"id": "load_stability", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "power_output"}, "max": 0.02, "unit": "A", "operating_cases": ["illumination_range", "power_corners"]}, {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "illumination_input"}, "observation": {"kind": "port", "id": "power_output"}, "max": 0.002, "unit": "s", "operating_cases": ["illumination_range"]}, {"id": "output_ripple_limit", "metric": "output_ripple", "analysis": "transient", "observation": {"kind": "port", "id": "power_output"}, "max": 0.01, "unit": "A", "operating_cases": ["illumination_range", "power_corners"]}, {"id": "startup_bound", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "power_output"}, "max": 0.03, "unit": "A", "operating_cases": ["illumination_range"], "critical": true}, {"id": "quiet_demand", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "control_power"}, "max": 0.02, "unit": "A", "operating_cases": ["power_corners"]}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 110, "unit": "degC", "operating_cases": ["power_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["power_corners"], "critical": true}],
    "constraints": {"max_components": 26, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
