{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "ambient_tracking_airflow_control", "title": "Ambient tracking airflow control", "description": "Observe an ambient signal and apply load power above a rising threshold, remove it below a lower threshold, remain stable between thresholds, and stay within startup, delay, temperature, and safe operating bounds."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "control_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.08, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 1, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "control_power", "kind": "power", "direction": "sink", "domain": "control_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "ambient_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0.4, "nominal_voltage_v": 1.5, "max_voltage_v": 2.6, "input_impedance_min_ohm": 50000}}, {"id": "airflow_output", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 6, "max_voltage_v": 14, "max_current_a": 0.8}}],
    "operating_cases": [{"id": "threshold_sweep", "conditions": [{"axis": "input_voltage", "target": "ambient_input", "min": 0.4, "max": 2.6, "unit": "V"}, {"axis": "load_resistance", "target": "airflow_output", "min": 15, "max": 30, "unit": "ohm"}], "events": [{"id": "ambient_rise", "kind": "input_step", "target": "ambient_input", "trigger_time_s": 0.01, "initial": 1.2, "applied": 2.2, "unit": "V"}]}, {"id": "environment_corners", "conditions": [{"axis": "supply_voltage", "target": "load_supply", "min": 10, "max": 14, "unit": "V"}, {"axis": "ambient_temperature", "target": "airflow_output", "min": -10, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "ambient_input", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "rising_decision", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "ambient_input"}, "observation": {"kind": "port", "id": "airflow_output"}, "min": 1.75, "max": 1.85, "unit": "V", "operating_cases": ["threshold_sweep", "environment_corners"], "critical": true}, {"id": "falling_decision", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "ambient_input"}, "observation": {"kind": "port", "id": "airflow_output"}, "min": 1.35, "max": 1.45, "unit": "V", "operating_cases": ["threshold_sweep", "environment_corners"], "critical": true}, {"id": "decision_memory", "metric": "hysteresis", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "airflow_output"}, "min": 0.3, "max": 0.5, "unit": "V", "operating_cases": ["threshold_sweep"]}, {"id": "active_current", "metric": "output_current", "analysis": "transient", "observation": {"kind": "port", "id": "airflow_output"}, "min": 0.35, "max": 0.8, "unit": "A", "operating_cases": ["threshold_sweep", "environment_corners"]}, {"id": "response_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "ambient_input"}, "observation": {"kind": "port", "id": "airflow_output"}, "max": 0.002, "unit": "s", "operating_cases": ["threshold_sweep"]}, {"id": "quiet_start", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "airflow_output"}, "max": 0.02, "unit": "A", "operating_cases": ["threshold_sweep"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 110, "unit": "degC", "operating_cases": ["environment_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["environment_corners"], "critical": true}],
    "constraints": {"max_components": 24, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
