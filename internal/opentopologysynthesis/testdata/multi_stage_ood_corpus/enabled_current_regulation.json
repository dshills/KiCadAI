{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "enabled_current_regulation", "title": "Enabled current regulation", "description": "Translate an analog command into regulated load current while enabled, remove current when disabled, reject supply and load variation, start calmly, settle promptly, and remain within temperature and safe operating bounds."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "control_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 1.2, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "control_power", "kind": "power", "direction": "sink", "domain": "control_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "current_command", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1, "max_voltage_v": 2, "input_impedance_min_ohm": 50000}}, {"id": "enable", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 5, "default_state": "low"}}, {"id": "regulated_current", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 6, "max_voltage_v": 15, "max_current_a": 1}}],
    "operating_cases": [{"id": "command_range", "conditions": [{"axis": "input_voltage", "target": "current_command", "min": 0.2, "max": 1.8, "unit": "V"}, {"axis": "load_resistance", "target": "regulated_current", "min": 5, "max": 10, "unit": "ohm"}], "events": [{"id": "enable_step", "kind": "input_step", "target": "enable", "trigger_time_s": 0.002, "initial": 0, "applied": 5, "unit": "V"}]}, {"id": "regulation_corners", "conditions": [{"axis": "supply_voltage", "target": "load_supply", "min": 9, "max": 15, "unit": "V"}, {"axis": "ambient_temperature", "target": "regulated_current", "min": -20, "max": 70, "unit": "degC"}, {"axis": "tolerance_corner", "target": "current_command", "min": 0, "max": 0, "unit": "ratio"}]}],
    "behavioral_requirements": [{"id": "command_transfer", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "current_command"}, "observation": {"kind": "port", "id": "regulated_current"}, "min": 0.48, "max": 0.52, "unit": "A/V", "operating_cases": ["command_range", "regulation_corners"], "critical": true}, {"id": "line_stability", "metric": "line_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "regulated_current"}, "max": 0.015, "unit": "A", "operating_cases": ["regulation_corners"]}, {"id": "load_stability", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "regulated_current"}, "max": 0.02, "unit": "A", "operating_cases": ["command_range", "regulation_corners"]}, {"id": "disabled_current", "metric": "off_state_current", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "enable"}, "observation": {"kind": "port", "id": "regulated_current"}, "max": 0.0001, "unit": "A", "operating_cases": ["command_range"], "critical": true}, {"id": "enable_settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "enable"}, "observation": {"kind": "port", "id": "regulated_current"}, "max": 0.001, "unit": "s", "operating_cases": ["command_range"]}, {"id": "startup_bound", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "regulated_current"}, "max": 0.05, "unit": "A", "operating_cases": ["command_range"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 110, "unit": "degC", "operating_cases": ["regulation_corners"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.3, "unit": "ratio", "operating_cases": ["regulation_corners"], "critical": true}],
    "constraints": {"max_components": 28, "max_width_mm": 80, "max_height_mm": 60}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
