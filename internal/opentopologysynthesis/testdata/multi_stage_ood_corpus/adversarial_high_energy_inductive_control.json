{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "adversarial_high_energy_inductive_control", "title": "High-energy inductive current control", "description": "Demand rapid controlled current in a high-energy load at elevated ambient temperature while requiring a compact area, low loss, calm startup, low peak stress, and unusually large safe operating margin."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "logic_supply", "kind": "supply", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.1, "source": "external"}, {"id": "load_supply", "kind": "supply", "min_voltage_v": 54, "nominal_voltage_v": 60, "max_voltage_v": 66, "max_current_a": 18, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "logic_power", "kind": "power", "direction": "sink", "domain": "logic_supply"}, {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_supply"}, {"id": "pulse_command", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 3.6, "default_state": "low"}}, {"id": "load_current", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 30, "max_voltage_v": 66, "max_current_a": 15}}],
    "operating_cases": [{"id": "energy_stress", "conditions": [{"axis": "supply_voltage", "target": "load_supply", "min": 54, "max": 66, "unit": "V"}, {"axis": "load_current", "target": "load_current", "min": 12, "max": 15, "unit": "A"}, {"axis": "load_inductance", "target": "load_current", "min": 0.08, "max": 0.2, "unit": "H"}, {"axis": "ambient_temperature", "target": "load_current", "min": 75, "max": 85, "unit": "degC"}], "events": [{"id": "command_step", "kind": "input_step", "target": "pulse_command", "trigger_time_s": 0.00001, "initial": 0, "applied": 3.3, "unit": "V"}]}],
    "behavioral_requirements": [{"id": "pulse_transfer", "metric": "duty_cycle", "analysis": "transient", "excitation": {"kind": "port", "id": "pulse_command"}, "observation": {"kind": "port", "id": "load_current"}, "min": 45, "max": 55, "unit": "%", "frequency_hz": 100000, "operating_cases": ["energy_stress"]}, {"id": "rapid_rise", "metric": "rise_time", "analysis": "transient", "observation": {"kind": "port", "id": "load_current"}, "max": 0.000002, "unit": "s", "frequency_hz": 100000, "operating_cases": ["energy_stress"], "critical": true}, {"id": "low_active_loss", "metric": "on_state_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "load_current"}, "max": 0.2, "unit": "V", "operating_cases": ["energy_stress"]}, {"id": "calm_start", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "load_current"}, "max": 0.1, "unit": "A", "operating_cases": ["energy_stress"], "critical": true}, {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 90, "unit": "degC", "frequency_hz": 100000, "operating_cases": ["energy_stress"], "critical": true}, {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 2.5, "unit": "ratio", "frequency_hz": 100000, "operating_cases": ["energy_stress"], "critical": true}],
    "constraints": {"max_components": 16, "max_width_mm": 45, "max_height_mm": 35}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
