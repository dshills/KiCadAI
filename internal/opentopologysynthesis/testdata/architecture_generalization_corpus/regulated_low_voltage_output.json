{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "regulated_low_voltage_output",
    "title": "Regulated low-voltage power output",
    "description": "Produce a stable five-volt output from a varying higher-voltage source across load, startup, and ambient conditions."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "input_supply", "kind": "supply", "min_voltage_v": 8, "nominal_voltage_v": 10, "max_voltage_v": 12, "max_current_a": 0.25, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_supply"},
      {"id": "enable", "kind": "digital", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5, "default_state": "high"}},
      {"id": "regulated_output", "kind": "power", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1}}
    ],
    "operating_cases": [
      {"id": "line_and_load", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 8, "max": 12, "unit": "V"}, {"axis": "load_current", "target": "regulated_output", "min": 0.005, "max": 0.1, "unit": "A"}, {"axis": "ambient_temperature", "target": "regulated_output", "min": 0, "max": 50, "unit": "degC"}]},
      {"id": "startup", "conditions": [{"axis": "supply_voltage", "target": "input_supply", "min": 0, "max": 10, "unit": "V"}, {"axis": "load_current", "target": "regulated_output", "min": 0.05, "max": 0.05, "unit": "A"}], "events": [{"id": "apply_power", "kind": "startup", "target": "input_power", "trigger_time_s": 0.001, "initial": 0, "applied": 10, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "regulated_voltage", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "regulated_output"}, "min": 4.9, "max": 5.1, "unit": "V", "operating_cases": ["line_and_load"]},
      {"id": "line_variation", "metric": "line_regulation", "analysis": "dc_sweep", "excitation": {"kind": "domain", "id": "input_supply"}, "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.05, "unit": "V", "operating_cases": ["line_and_load"]},
      {"id": "load_variation", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.1, "unit": "V", "operating_cases": ["line_and_load"]},
      {"id": "startup_peak", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "regulated_output"}, "max": 0.25, "unit": "V", "operating_cases": ["startup"], "critical": true},
      {"id": "dynamic_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "regulated_output"}, "min": 50, "unit": "deg", "operating_cases": ["line_and_load"], "critical": true},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["line_and_load"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.2, "unit": "ratio", "operating_cases": ["line_and_load"], "critical": true}
    ],
    "constraints": {"max_components": 22, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
