      {"id": "output_peak", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "signal_output"}, "min": 4.9, "max": 5.1, "unit": "V", "frequency_hz": 1000, "operating_cases": ["rated"]},
