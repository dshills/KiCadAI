{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "adversarial_inconsistent_standing_current", "title": "Adversarial standing-current envelope", "description": "Demand large quiescent supply current and rail-level signal transfer from sources whose declared current capability is substantially lower."},
