    "operating_cases": [{"id": "rated", "conditions": [{"axis": "supply_voltage", "target": "supply_positive", "min": 4.8, "max": 5.2, "unit": "V"}, {"axis": "supply_voltage", "target": "supply_negative", "min": -5.2, "max": -4.8, "unit": "V"}, {"axis": "load_resistance", "target": "signal_output", "min": 25, "max": 25, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "signal_output", "min": 25, "max": 50, "unit": "degC"}]}],
    "behavioral_requirements": [
