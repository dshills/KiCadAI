{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "protected_programmable_current_output", "title": "Protected programmable current output", "description": "Deliver load current proportional to a control voltage across load and supply variation while bounding startup current, temperature, and safe operating margin."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "supply", "kind": "supply", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 0.3, "source": "external"}],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "current_command", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1, "max_voltage_v": 2, "input_impedance_min_ohm": 50000}},
      {"id": "load_current", "kind": "controlled_current", "direction": "source", "domain": "ground", "electrical": {"max_current_a": 0.2}}
    ],
    "operating_cases": [
      {"id": "programmed_load", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 10, "max": 14, "unit": "V"}, {"axis": "input_voltage", "target": "current_command", "min": 0.25, "max": 2, "unit": "V"}, {"axis": "load_resistance", "target": "load_current", "min": 10, "max": 40, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "load_current", "min": 0, "max": 50, "unit": "degC"}]},
      {"id": "current_regulation", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 10, "max": 14, "unit": "V"}, {"axis": "input_voltage", "target": "current_command", "min": 1, "max": 1, "unit": "V"}, {"axis": "load_resistance", "target": "load_current", "min": 10, "max": 40, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "load_current", "min": 0, "max": 50, "unit": "degC"}]},
      {"id": "startup", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 0, "max": 12, "unit": "V"}, {"axis": "input_voltage", "target": "current_command", "min": 1, "max": 1, "unit": "V"}, {"axis": "load_resistance", "target": "load_current", "min": 20, "max": 20, "unit": "ohm"}], "events": [{"id": "apply_power", "kind": "startup", "target": "power", "trigger_time_s": 0.001, "initial": 0, "applied": 12, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "command_slope", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "current_command"}, "observation": {"kind": "port", "id": "load_current"}, "min": 0.095, "max": 0.105, "unit": "A/V", "operating_cases": ["programmed_load"]},
      {"id": "rated_current", "metric": "output_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "load_current"}, "min": 0.095, "max": 0.105, "unit": "A", "operating_cases": ["programmed_load"]},
      {"id": "load_variation", "metric": "output_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "load_current"}, "min": 0.095, "max": 0.105, "unit": "A", "operating_cases": ["current_regulation"]},
      {"id": "startup_limit", "metric": "startup_current", "analysis": "startup", "observation": {"kind": "port", "id": "load_current"}, "max": 0.13, "unit": "A", "operating_cases": ["startup"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "current_command"}, "observation": {"kind": "port", "id": "load_current"}, "max": 0.001, "unit": "s", "operating_cases": ["programmed_load"]},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["programmed_load"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 1.25, "unit": "ratio", "operating_cases": ["programmed_load"], "critical": true}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
