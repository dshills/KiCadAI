{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "adversarial_unstable_dynamic_envelope", "title": "Adversarial dynamic-response envelope", "description": "Demand extreme closed-loop speed and settling into a strongly reactive load while also requiring unusually large dynamic margin."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "supply", "kind": "supply", "min_voltage_v": 4.8, "nominal_voltage_v": 5, "max_voltage_v": 5.2, "max_current_a": 0.02, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"}, {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -0.1, "nominal_voltage_v": 0, "max_voltage_v": 0.1, "input_impedance_min_ohm": 100000}}, {"id": "signal_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -1.1, "nominal_voltage_v": 0, "max_voltage_v": 1.1}}],
    "operating_cases": [{"id": "reactive_load", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 4.8, "max": 5.2, "unit": "V"}, {"axis": "load_resistance", "target": "signal_output", "min": 100, "max": 100, "unit": "ohm"}, {"axis": "load_capacitance", "target": "signal_output", "min": 0.00001, "max": 0.00001, "unit": "F"}]}],
    "behavioral_requirements": [
      {"id": "closed_loop_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "signal_output"}, "min": 9.9, "max": 10.1, "unit": "ratio", "frequency_hz": 1000000, "operating_cases": ["reactive_load"]},
      {"id": "bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "signal_output"}, "min": 100000000, "unit": "Hz", "operating_cases": ["reactive_load"]},
      {"id": "dynamic_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "signal_output"}, "min": 100, "unit": "deg", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "signal_output"}, "max": 0.00000001, "unit": "s", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "output_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "signal_output"}, "max": 0.000001, "unit": "V_rms", "operating_cases": ["reactive_load"]}
    ],
    "constraints": {"max_components": 12, "max_width_mm": 45, "max_height_mm": 35}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
