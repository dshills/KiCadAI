{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "low_current_voltage_converter", "title": "Low-current voltage converter", "description": "Convert a bipolar low-level input current into a bounded output voltage with defined gain, bandwidth, noise, settling, and input impedance."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "supply_positive", "kind": "supply", "min_voltage_v": 11, "nominal_voltage_v": 12, "max_voltage_v": 13, "max_current_a": 0.05, "source": "external"}, {"id": "supply_negative", "kind": "supply", "min_voltage_v": -13, "nominal_voltage_v": -12, "max_voltage_v": -11, "max_current_a": 0.05, "source": "external"}],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power_positive", "kind": "power", "direction": "sink", "domain": "supply_positive"},
      {"id": "power_negative", "kind": "power", "direction": "sink", "domain": "supply_negative"},
      {"id": "signal_current", "kind": "analog_current", "direction": "sink", "domain": "ground", "electrical": {"max_current_a": 0.00005}},
      {"id": "signal_voltage", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -5.25, "nominal_voltage_v": 0, "max_voltage_v": 5.25}}
    ],
    "operating_cases": [
      {"id": "rated_signal", "conditions": [{"axis": "input_current", "target": "signal_current", "min": -0.00005, "max": 0.00005, "unit": "A"}, {"axis": "load_resistance", "target": "signal_voltage", "min": 100000, "max": 1000000, "unit": "ohm"}, {"axis": "load_capacitance", "target": "signal_voltage", "min": 0, "max": 5e-11, "unit": "F"}]},
      {"id": "corners", "conditions": [{"axis": "supply_voltage", "target": "supply_positive", "min": 11, "max": 13, "unit": "V"}, {"axis": "supply_voltage", "target": "supply_negative", "min": -13, "max": -11, "unit": "V"}, {"axis": "input_current", "target": "signal_current", "min": -0.00005, "max": 0.00005, "unit": "A"}, {"axis": "model_corner", "target": "signal_voltage", "min": 0, "max": 0, "unit": "ratio"}, {"axis": "tolerance_corner", "target": "signal_voltage", "min": 0, "max": 0, "unit": "ratio"}]}
    ],
    "behavioral_requirements": [
      {"id": "current_to_voltage_gain", "metric": "transimpedance", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_current"}, "observation": {"kind": "port", "id": "signal_voltage"}, "min": 95000, "max": 105000, "unit": "V/A", "frequency_hz": 1000, "operating_cases": ["rated_signal", "corners"]},
      {"id": "signal_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_current"}, "observation": {"kind": "port", "id": "signal_voltage"}, "min": 20000, "unit": "Hz", "operating_cases": ["rated_signal"]},
      {"id": "input_impedance", "metric": "input_impedance", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_current"}, "observation": {"kind": "port", "id": "signal_current"}, "max": 100, "unit": "ohm", "frequency_hz": 1000, "operating_cases": ["rated_signal"]},
      {"id": "output_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "signal_voltage"}, "max": 0.001, "unit": "V_rms", "operating_cases": ["rated_signal"]},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_current"}, "observation": {"kind": "port", "id": "signal_voltage"}, "max": 0.0002, "unit": "s", "operating_cases": ["rated_signal"]},
      {"id": "dynamic_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "signal_voltage"}, "min": 55, "unit": "deg", "operating_cases": ["rated_signal", "corners"], "critical": true}
    ],
    "constraints": {"max_components": 16, "max_width_mm": 60, "max_height_mm": 45}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
