{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "adversarial_inadequate_safe_area", "title": "Adversarial high-energy load envelope", "description": "Demand repeated high-voltage and high-current load drive with a safe-operating margin beyond the reviewed evidence envelope."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "supply_positive", "kind": "supply", "min_voltage_v": 28, "nominal_voltage_v": 30, "max_voltage_v": 32, "max_current_a": 25, "source": "external"}, {"id": "supply_negative", "kind": "supply", "min_voltage_v": -32, "nominal_voltage_v": -30, "max_voltage_v": -28, "max_current_a": 25, "source": "external"}],
    "ports": [{"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}, {"id": "power_positive", "kind": "power", "direction": "sink", "domain": "supply_positive"}, {"id": "power_negative", "kind": "power", "direction": "sink", "domain": "supply_negative"}, {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -1, "nominal_voltage_v": 0, "max_voltage_v": 1, "input_impedance_min_ohm": 10000}}, {"id": "load_output", "kind": "analog_voltage", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -20, "nominal_voltage_v": 0, "max_voltage_v": 20, "max_current_a": 20}}],
    "operating_cases": [{"id": "pulse_load", "conditions": [{"axis": "supply_voltage", "target": "supply_positive", "min": 28, "max": 32, "unit": "V"}, {"axis": "supply_voltage", "target": "supply_negative", "min": -32, "max": -28, "unit": "V"}, {"axis": "load_resistance", "target": "load_output", "min": 1, "max": 1, "unit": "ohm"}, {"axis": "ambient_temperature", "target": "load_output", "min": 25, "max": 50, "unit": "degC"}]}],
    "behavioral_requirements": [
      {"id": "voltage_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "load_output"}, "min": 19.5, "max": 20.5, "unit": "ratio", "frequency_hz": 1000, "operating_cases": ["pulse_load"]},
      {"id": "output_peak", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "signal_input"}, "observation": {"kind": "port", "id": "load_output"}, "min": 19, "max": 21, "unit": "V", "frequency_hz": 1000, "operating_cases": ["pulse_load"]},
      {"id": "output_power", "metric": "output_power", "analysis": "transient", "observation": {"kind": "port", "id": "load_output"}, "min": 180, "max": 220, "unit": "W", "frequency_hz": 1000, "operating_cases": ["pulse_load"]},
      {"id": "safe_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "maximum_junction_temperature"}, "max": 100, "unit": "degC", "operating_cases": ["pulse_load"], "critical": true},
      {"id": "safe_operating_area", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "minimum_soa_margin"}, "min": 10, "unit": "ratio", "operating_cases": ["pulse_load"], "critical": true},
      {"id": "dynamic_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "load_output"}, "min": 60, "unit": "deg", "operating_cases": ["pulse_load"], "critical": true}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 80, "max_height_mm": 60}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
