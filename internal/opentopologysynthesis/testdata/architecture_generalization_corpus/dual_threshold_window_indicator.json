{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "dual_threshold_window_indicator", "title": "Dual-threshold voltage-window indicator", "description": "Assert an alert below a lower limit and above an upper limit while clearing it throughout the valid input window."},
  "requirements": {
    "domains": [{"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}, {"id": "supply", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.04, "source": "external"}],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "supply"},
      {"id": "sense_input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 2.5, "max_voltage_v": 5, "input_impedance_min_ohm": 100000}},
      {"id": "window_alert", "kind": "digital", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5}}
    ],
    "operating_cases": [
      {"id": "below", "conditions": [{"axis": "input_voltage", "target": "sense_input", "min": 0, "max": 1.6, "unit": "V"}]},
      {"id": "inside", "conditions": [{"axis": "input_voltage", "target": "sense_input", "min": 2, "max": 3, "unit": "V"}]},
      {"id": "above", "conditions": [{"axis": "input_voltage", "target": "sense_input", "min": 3.4, "max": 5, "unit": "V"}]},
      {"id": "sweep", "conditions": [{"axis": "supply_voltage", "target": "supply", "min": 4.5, "max": 5.5, "unit": "V"}, {"axis": "input_voltage", "target": "sense_input", "min": 0, "max": 5, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "lower_limit", "metric": "lower_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "sense_input"}, "observation": {"kind": "port", "id": "window_alert"}, "min": 1.7, "max": 1.9, "unit": "V", "operating_cases": ["sweep"]},
      {"id": "upper_limit", "metric": "upper_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "sense_input"}, "observation": {"kind": "port", "id": "window_alert"}, "min": 3.1, "max": 3.3, "unit": "V", "operating_cases": ["sweep"]},
      {"id": "below_asserted", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "window_alert"}, "min": 4, "unit": "V", "operating_cases": ["below"]},
      {"id": "inside_cleared", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "window_alert"}, "max": 0.5, "unit": "V", "operating_cases": ["inside"]},
      {"id": "above_asserted", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "window_alert"}, "min": 4, "unit": "V", "operating_cases": ["above"]},
      {"id": "response_time", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "sense_input"}, "observation": {"kind": "port", "id": "window_alert"}, "max": 0.0001, "unit": "s", "operating_cases": ["sweep"], "critical": true}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 65, "max_height_mm": 45}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
