{
  "schema": "kicadai.open-set-requirement.v6",
  "version": 6,
  "project": {
    "name": "current_limited_switched_load_system",
    "title": "Current-limited switched-load controller",
    "description": "Control a high-current load while measuring current, making a bounded overcurrent decision, disconnecting safely, and reporting the fault across logic and load-power domains."
  },
  "requirements": {
    "domains": [
      {
        "id": "load_12v",
        "kind": "supply",
        "min_voltage_v": 10,
        "nominal_voltage_v": 12,
        "max_voltage_v": 14,
        "max_current_a": 3,
        "source": "external"
      },
      {
        "id": "logic_5v",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.1,
        "source": "external"
      },
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground"
      },
      {
        "id": "load_power",
        "kind": "power",
        "direction": "sink",
        "domain": "load_12v"
      },
      {
        "id": "logic_power",
        "kind": "power",
        "direction": "sink",
        "domain": "logic_5v"
      },
      {
        "id": "enable",
        "kind": "digital_logic",
        "direction": "sink",
        "domain": "logic_5v",
        "control": {
          "function": "enable",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "deasserted"
        }
      },
      {
        "id": "load",
        "kind": "protected_output",
        "direction": "source",
        "domain": "load_12v"
      },
      {
        "id": "fault",
        "kind": "digital_logic",
        "direction": "source",
        "domain": "logic_5v",
        "control": {
          "function": "fault",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "asserted"
        }
      }
    ],
    "signals": [
      {
        "id": "measured_current",
        "kind": "analog_voltage",
        "domain": "ground"
      },
      {
        "id": "trip",
        "kind": "digital_logic",
        "domain": "logic_5v",
        "control": {
          "function": "fault",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "asserted"
        }
      },
      {
        "id": "permit",
        "kind": "digital_logic",
        "domain": "logic_5v",
        "control": {
          "function": "enable",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "deasserted"
        }
      }
    ],
    "objectives": [
      {
        "id": "measure",
        "capability": "current_sensing",
        "bindings": [
          {
            "role": "power",
            "port": "load_power"
          },
          {
            "role": "output",
            "signal": "measured_current",
            "direction": "source"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      },
      {
        "id": "decide",
        "capability": "threshold_detection",
        "bindings": [
          {
            "role": "input",
            "signal": "measured_current",
            "direction": "sink"
          },
          {
            "role": "output",
            "signal": "trip",
            "direction": "source"
          },
          {
            "role": "power",
            "port": "logic_power"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      },
      {
        "id": "coordinate",
        "capability": "safety_interlock",
        "bindings": [
          {
            "role": "enable",
            "port": "enable"
          },
          {
            "role": "fault",
            "signal": "trip",
            "direction": "sink"
          },
          {
            "role": "permit",
            "signal": "permit",
            "direction": "source"
          },
          {
            "role": "power",
            "port": "logic_power"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      },
      {
        "id": "switch",
        "capability": "load_switch",
        "bindings": [
          {
            "role": "control",
            "signal": "permit",
            "direction": "sink"
          },
          {
            "role": "logic_power",
            "port": "logic_power"
          },
          {
            "role": "power",
            "port": "load_power"
          },
          {
            "role": "output",
            "port": "load"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      },
      {
        "id": "indicate",
        "capability": "fault_indication",
        "bindings": [
          {
            "role": "input",
            "signal": "trip",
            "direction": "sink"
          },
          {
            "role": "output",
            "port": "fault"
          },
          {
            "role": "power",
            "port": "logic_power"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      }
    ],
    "operating_cases": [
      {
        "id": "overload",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "load_12v",
            "min": 10,
            "max": 14,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "logic_5v",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          },
          {
            "axis": "load_current",
            "target": "load",
            "min": 0,
            "max": 3,
            "unit": "A"
          },
          {
            "axis": "input_amplitude",
            "target": "enable",
            "min": 5,
            "max": 5,
            "unit": "V"
          },
          {
            "axis": "ambient_temperature",
            "target": "circuit",
            "min": -20,
            "max": 70,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "startup_safe",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "load_12v",
            "min": 10,
            "max": 14,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "logic_5v",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          },
          {
            "axis": "load_current",
            "target": "load",
            "min": 0,
            "max": 3,
            "unit": "A"
          },
          {
            "axis": "input_amplitude",
            "target": "enable",
            "min": 0,
            "max": 0,
            "unit": "V"
          },
          {
            "axis": "ambient_temperature",
            "target": "circuit",
            "min": -20,
            "max": 70,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "protected_operation",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "load_12v",
            "min": 10,
            "max": 14,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "logic_5v",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          },
          {
            "axis": "load_current",
            "target": "load",
            "min": 1,
            "max": 1,
            "unit": "A"
          },
          {
            "axis": "input_amplitude",
            "target": "enable",
            "min": 5,
            "max": 5,
            "unit": "V"
          },
          {
            "axis": "ambient_temperature",
            "target": "circuit",
            "min": -20,
            "max": 70,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "fault_step",
            "kind": "input_step",
            "target": {
              "kind": "signal",
              "id": "trip"
            },
            "trigger_time_s": 0.001,
            "duration_s": 0.02,
            "initial": 0,
            "applied": 5,
            "recovered": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "sense_gain",
        "metric": "transimpedance",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "signal",
          "id": "measured_current"
        },
        "min": 0.98,
        "max": 1.02,
        "unit": "V/A",
        "operating_cases": [
          "overload"
        ]
      },
      {
        "id": "trip_current",
        "metric": "threshold_current",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "signal",
          "id": "trip"
        },
        "min": 1.9,
        "max": 2.1,
        "unit": "A",
        "operating_cases": [
          "overload"
        ],
        "critical": true
      },
      {
        "id": "response",
        "metric": "protection_response_time",
        "analysis": "transient",
        "observation": {
          "kind": "signal",
          "id": "permit"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "protected_operation"
        ],
        "critical": true,
        "transition": "overload_disconnect"
      },
      {
        "id": "startup",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "load"
        },
        "max": 0.5,
        "unit": "V",
        "operating_cases": [
          "startup_safe"
        ],
        "critical": true
      }
    ],
    "control_transitions": [
      {
        "id": "overload_disconnect",
        "event": "fault_step",
        "target": {
          "kind": "signal",
          "id": "permit"
        },
        "trigger": {
          "kind": "signal",
          "id": "trip"
        },
        "from": "asserted",
        "to": "deasserted",
        "direction": "falling",
        "maximum_delay_s": 0.001,
        "dependencies": [
          {
            "target": {
              "kind": "port",
              "id": "enable"
            },
            "state": "asserted"
          },
          {
            "target": {
              "kind": "port",
              "id": "logic_power"
            },
            "state": "energized"
          }
        ]
      }
    ],
    "constraints": {
      "max_components": 41,
      "max_width_mm": 75,
      "max_height_mm": 52
    }
  },
  "acceptance": {
    "require_erc": true,
    "require_strict_drc": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_deterministic_replay": true,
    "require_contract_composition": true,
    "require_global_reasoning": true,
    "require_coverage_accounting": true,
    "require_alternatives": true,
    "require_fail_closed": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_hierarchical_decomposition": true,
    "require_interface_contracts": true,
    "require_shared_resource_planning": true,
    "require_deterministic_backtracking": true,
    "require_physical_partitioning": true,
    "require_end_to_end_traceability": true
  }
}
