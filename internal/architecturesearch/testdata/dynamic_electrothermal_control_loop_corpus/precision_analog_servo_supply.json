{
  "schema": "kicadai.open-set-requirement.v5",
  "version": 5,
  "project": {
    "name": "precision_analog_servo_supply",
    "title": "Precision analog servo supply",
    "description": "Regulate a low-noise analog rail with stable load-step response, bounded short-circuit stress, and verified hot-condition recovery."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "input_15v", "kind": "supply", "min_voltage_v": 13.5, "nominal_voltage_v": 15, "max_voltage_v": 16.5, "max_current_a": 1.2, "source": "external"},
      {"id": "regulated_5v", "kind": "supply", "min_voltage_v": 4.9, "nominal_voltage_v": 5, "max_voltage_v": 5.1, "max_current_a": 0.5, "source": "regulated_output"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_15v"},
      {"id": "output_power", "kind": "power", "direction": "source", "domain": "regulated_5v"}
    ],
    "signals": [
      {"id": "regulated_output", "kind": "power", "domain": "regulated_5v"},
      {"id": "sense", "kind": "analog_voltage", "domain": "ground"},
      {"id": "servo_control", "kind": "analog_control", "domain": "ground"}
    ],
    "objectives": [
      {"id": "regulate", "capability": "voltage_regulation", "bindings": [{"role": "input", "port": "input_power"}, {"role": "output", "signal": "regulated_output", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "sense_current", "capability": "current_sensing", "bindings": [{"role": "input", "signal": "regulated_output", "direction": "sink"}, {"role": "output", "signal": "sense", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "control", "capability": "analog_servo_control", "bindings": [{"role": "sense", "signal": "sense", "direction": "sink"}, {"role": "control", "signal": "servo_control", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "protect", "capability": "output_protection", "bindings": [{"role": "input", "signal": "regulated_output", "direction": "sink"}, {"role": "output", "port": "output_power"}, {"role": "control", "signal": "servo_control", "direction": "sink"}, {"role": "reference", "port": "ground"}]}
    ],
    "operating_cases": [
      {
        "id": "dynamic_load",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output_power", "min": -20, "max": 85, "unit": "degC"},
          {"axis": "load_current", "target": "output_power", "min": 0.01, "max": 0.5, "unit": "A"},
          {"axis": "load_capacitance", "target": "output_power", "min": 4.7e-6, "max": 0.0001, "unit": "F"},
          {"axis": "supply_voltage", "target": "input_15v", "min": 13.5, "max": 16.5, "unit": "V"},
          {"axis": "tolerance", "target": "all_components", "selection": "minimum_nominal_maximum"}
        ],
        "events": [
          {"id": "startup", "kind": "startup", "target": {"kind": "domain", "id": "input_15v"}, "trigger_time_s": 0, "duration_s": 0.02, "initial": 0, "applied": 15, "unit": "V"},
          {"id": "load_step", "kind": "load_step", "target": {"kind": "port", "id": "output_power"}, "trigger_time_s": 0.03, "duration_s": 0.02, "initial": 0.02, "applied": 0.5, "recovered": 0.02, "unit": "A"}
        ]
      },
      {
        "id": "hot_short_fault",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output_power", "min": 70, "max": 85, "unit": "degC"},
          {"axis": "cooling_mode", "target": "circuit", "selection": "blocked_airflow"},
          {"axis": "supply_voltage", "target": "input_15v", "min": 15, "max": 16.5, "unit": "V"}
        ],
        "events": [
          {"id": "blocked_airflow", "kind": "blocked_airflow", "target": {"kind": "circuit", "id": "circuit"}, "trigger_time_s": 0, "duration_s": 2, "initial": 1, "applied": 0.35, "recovered": 1, "unit": "ratio"},
          {"id": "short_fault", "kind": "short_circuit", "target": {"kind": "port", "id": "output_power"}, "trigger_time_s": 0.2, "duration_s": 0.05, "initial": 10, "applied": 0.01, "recovered": 10, "unit": "Ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "regulated_voltage", "metric": "dc_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "output_power"}, "min": 4.9, "max": 5.1, "unit": "V", "operating_cases": ["dynamic_load"], "critical": true},
      {"id": "loop_crossover", "metric": "loop_crossover_frequency", "analysis": "stability", "observation": {"kind": "port", "id": "output_power"}, "min": 1000, "max": 100000, "unit": "Hz", "operating_cases": ["dynamic_load"], "critical": true},
      {"id": "loop_gain_margin", "metric": "gain_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output_power"}, "min": 10, "unit": "dB", "operating_cases": ["dynamic_load"], "critical": true},
      {"id": "loop_phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output_power"}, "min": 50, "unit": "deg", "operating_cases": ["dynamic_load"], "critical": true},
      {"id": "load_step_recovery", "metric": "protection_recovery_time", "analysis": "transient", "observation": {"kind": "event", "id": "load_step"}, "max": 0.002, "unit": "s", "operating_cases": ["dynamic_load"], "critical": true},
      {"id": "peak_junction_temperature", "metric": "peak_junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "circuit"}, "max": 125, "unit": "degC", "operating_cases": ["dynamic_load", "hot_short_fault"], "critical": true},
      {"id": "transient_soa_margin", "metric": "transient_soa_margin", "analysis": "electrothermal", "observation": {"kind": "event", "id": "short_fault"}, "min": 1.2, "unit": "ratio", "operating_cases": ["hot_short_fault"], "critical": true}
    ],
    "constraints": {"max_components": 38, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true, "require_coverage_accounting": true,
    "require_alternatives": true, "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_hierarchical_decomposition": true,
    "require_interface_contracts": true, "require_shared_resource_planning": true, "require_deterministic_backtracking": true,
    "require_physical_partitioning": true, "require_end_to_end_traceability": true,
    "require_dynamic_model_provenance": true, "require_return_ratio_evidence": true,
    "require_dynamic_electrothermal_evidence": true, "require_event_coverage": true,
    "require_dynamic_architecture_selection": true, "require_bounded_dynamic_repair": true
  }
}
