{
  "schema": "kicadai.open-set-requirement.v5",
  "version": 5,
  "project": {
    "name": "protected_inductive_actuator_driver",
    "title": "Protected inductive actuator driver",
    "description": "Switch and protect an inductive actuator while limiting current, containing turn-off energy, and reporting persistent faults."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "load_24v", "kind": "supply", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 30, "max_current_a": 4, "source": "external"},
      {"id": "logic_5v", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1, "source": "external"}
    ],
    "ports": [
      {"id": "control", "kind": "digital_logic", "direction": "sink", "domain": "logic_5v"},
      {"id": "fault", "kind": "digital_logic", "direction": "source", "domain": "logic_5v"},
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "load", "kind": "switched_load", "direction": "source", "domain": "load_24v"},
      {"id": "load_power", "kind": "power", "direction": "sink", "domain": "load_24v"},
      {"id": "logic_power", "kind": "power", "direction": "sink", "domain": "logic_5v"}
    ],
    "signals": [
      {"id": "current_feedback", "kind": "analog_voltage", "domain": "logic_5v"},
      {"id": "limited_drive", "kind": "analog_control", "domain": "logic_5v"}
    ],
    "objectives": [
      {"id": "switch_load", "capability": "load_switch", "bindings": [{"role": "control", "signal": "limited_drive", "direction": "sink"}, {"role": "input", "port": "load_power"}, {"role": "output", "port": "load"}, {"role": "reference", "port": "ground"}]},
      {"id": "sense_current", "capability": "current_sensing", "bindings": [{"role": "input", "port": "load"}, {"role": "output", "signal": "current_feedback", "direction": "source"}, {"role": "power", "port": "logic_power"}, {"role": "reference", "port": "ground"}]},
      {"id": "limit_current", "capability": "safety_interlock", "bindings": [{"role": "command", "port": "control"}, {"role": "sense", "signal": "current_feedback", "direction": "sink"}, {"role": "control", "signal": "limited_drive", "direction": "source"}, {"role": "fault", "port": "fault"}, {"role": "reference", "port": "ground"}]},
      {"id": "contain_energy", "capability": "transient_protection", "bindings": [{"role": "protected", "port": "load"}, {"role": "reference", "port": "ground"}]}
    ],
    "operating_cases": [
      {
        "id": "rated_actuator",
        "conditions": [
          {"axis": "ambient_temperature", "target": "load", "min": -30, "max": 85, "unit": "degC"},
          {"axis": "load_current", "target": "load", "min": 0.2, "max": 3, "unit": "A"},
          {"axis": "load_inductance", "target": "load", "min": 0.002, "max": 0.08, "unit": "H"},
          {"axis": "supply_voltage", "target": "load_24v", "min": 18, "max": 30, "unit": "V"},
          {"axis": "tolerance", "target": "all_components", "selection": "minimum_nominal_maximum"}
        ],
        "events": [
          {"id": "turn_on", "kind": "input_step", "target": {"kind": "port", "id": "control"}, "trigger_time_s": 0.001, "duration_s": 0.02, "initial": 0, "applied": 5, "recovered": 0, "unit": "V"},
          {"id": "inductive_turn_off", "kind": "inductive_turn_off", "target": {"kind": "port", "id": "load"}, "trigger_time_s": 0.021, "duration_s": 0.01, "initial": 3, "applied": 0, "unit": "A"}
        ]
      },
      {
        "id": "faulted_actuator",
        "conditions": [
          {"axis": "ambient_temperature", "target": "load", "min": 50, "max": 85, "unit": "degC"},
          {"axis": "supply_voltage", "target": "load_24v", "min": 24, "max": 30, "unit": "V"}
        ],
        "events": [
          {"id": "overload", "kind": "overload", "target": {"kind": "port", "id": "load"}, "trigger_time_s": 0.005, "duration_s": 0.05, "initial": 1, "applied": 6, "recovered": 1, "unit": "A"},
          {"id": "short_fault", "kind": "short_circuit", "target": {"kind": "port", "id": "load"}, "trigger_time_s": 0.07, "duration_s": 0.01, "initial": 8, "applied": 0.01, "recovered": 8, "unit": "Ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "current_limit", "metric": "peak_device_current", "analysis": "transient", "observation": {"kind": "port", "id": "load"}, "max": 3.5, "unit": "A", "operating_cases": ["rated_actuator", "faulted_actuator"], "critical": true},
      {"id": "fault_response", "metric": "protection_response_time", "analysis": "transient", "observation": {"kind": "event", "id": "overload"}, "max": 0.001, "unit": "s", "operating_cases": ["faulted_actuator"], "critical": true},
      {"id": "inductive_clamp", "metric": "peak_device_voltage", "analysis": "transient", "observation": {"kind": "event", "id": "inductive_turn_off"}, "max": 55, "unit": "V", "operating_cases": ["rated_actuator"], "critical": true},
      {"id": "release_time", "metric": "protection_recovery_time", "analysis": "transient", "observation": {"kind": "event", "id": "inductive_turn_off"}, "max": 0.04, "unit": "s", "operating_cases": ["rated_actuator"], "critical": true},
      {"id": "switch_temperature", "metric": "peak_junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "circuit"}, "max": 135, "unit": "degC", "operating_cases": ["rated_actuator", "faulted_actuator"], "critical": true},
      {"id": "switch_soa_margin", "metric": "transient_soa_margin", "analysis": "electrothermal", "observation": {"kind": "event", "id": "short_fault"}, "min": 1.25, "unit": "ratio", "operating_cases": ["faulted_actuator"], "critical": true}
    ],
    "constraints": {"max_components": 34, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true, "require_coverage_accounting": true,
    "require_alternatives": true, "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_hierarchical_decomposition": true,
    "require_interface_contracts": true, "require_shared_resource_planning": true, "require_deterministic_backtracking": true,
    "require_physical_partitioning": true, "require_end_to_end_traceability": true,
    "require_dynamic_model_provenance": true, "require_return_ratio_evidence": true,
    "require_dynamic_electrothermal_evidence": true, "require_event_coverage": true,
    "require_dynamic_architecture_selection": true, "require_bounded_dynamic_repair": true
  }
}
