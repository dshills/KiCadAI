{
  "schema": "kicadai.open-set-requirement.v5",
  "version": 5,
  "project": {
    "name": "class_ab_dynamic_output_stage",
    "title": "Class-AB dynamic output stage",
    "description": "Drive a reactive audio load with stable low-distortion Class-AB behavior, bounded transient temperature, safe fault response, and controlled muting."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "negative_18v", "kind": "supply", "min_voltage_v": -19.8, "nominal_voltage_v": -18, "max_voltage_v": -16.2, "max_current_a": 2.5, "source": "external"},
      {"id": "positive_18v", "kind": "supply", "min_voltage_v": 16.2, "nominal_voltage_v": 18, "max_voltage_v": 19.8, "max_current_a": 2.5, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input", "kind": "analog_voltage", "direction": "sink", "domain": "ground"},
      {"id": "negative_power", "kind": "power", "direction": "sink", "domain": "negative_18v"},
      {"id": "output", "kind": "protected_output", "direction": "source", "domain": "ground"},
      {"id": "positive_power", "kind": "power", "direction": "sink", "domain": "positive_18v"}
    ],
    "signals": [
      {"id": "amplified", "kind": "analog_voltage", "domain": "ground"},
      {"id": "biased_drive", "kind": "analog_control", "domain": "ground"},
      {"id": "current_feedback", "kind": "analog_voltage", "domain": "ground"},
      {"id": "protected_audio", "kind": "analog_voltage", "domain": "ground"}
    ],
    "objectives": [
      {"id": "amplify", "capability": "signal_amplification", "bindings": [{"role": "input", "port": "input"}, {"role": "output", "signal": "amplified", "direction": "source"}, {"role": "positive_power", "port": "positive_power"}, {"role": "negative_power", "port": "negative_power"}, {"role": "reference", "port": "ground"}]},
      {"id": "bias", "capability": "class_ab_bias_control", "bindings": [{"role": "input", "signal": "amplified", "direction": "sink"}, {"role": "output", "signal": "biased_drive", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "drive", "capability": "class_ab_output_stage", "bindings": [{"role": "input", "signal": "biased_drive", "direction": "sink"}, {"role": "output", "signal": "protected_audio", "direction": "source"}, {"role": "positive_power", "port": "positive_power"}, {"role": "negative_power", "port": "negative_power"}, {"role": "reference", "port": "ground"}]},
      {"id": "sense_current", "capability": "current_sensing", "bindings": [{"role": "input", "signal": "protected_audio", "direction": "sink"}, {"role": "output", "signal": "current_feedback", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "protect", "capability": "output_protection", "bindings": [{"role": "input", "signal": "protected_audio", "direction": "sink"}, {"role": "sense", "signal": "current_feedback", "direction": "sink"}, {"role": "output", "port": "output"}, {"role": "reference", "port": "ground"}]},
      {"id": "mute", "capability": "mute_control", "bindings": [{"role": "protected", "port": "output"}, {"role": "reference", "port": "ground"}]}
    ],
    "operating_cases": [
      {
        "id": "reactive_audio_load",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output", "min": 0, "max": 50, "unit": "degC"},
          {"axis": "input_frequency", "target": "input", "min": 20, "max": 20000, "unit": "Hz"},
          {"axis": "load_capacitance", "target": "output", "min": 0, "max": 1e-6, "unit": "F"},
          {"axis": "load_resistance", "target": "output", "min": 4, "max": 8, "unit": "Ohm"},
          {"axis": "tolerance", "target": "all_components", "selection": "minimum_nominal_maximum"}
        ],
        "events": [
          {"id": "startup", "kind": "startup", "target": {"kind": "circuit", "id": "circuit"}, "trigger_time_s": 0, "duration_s": 0.5, "initial": 0, "applied": 1, "unit": "ratio"},
          {"id": "load_step", "kind": "load_step", "target": {"kind": "port", "id": "output"}, "trigger_time_s": 0.6, "duration_s": 0.2, "initial": 8, "applied": 4, "recovered": 8, "unit": "Ohm"},
          {"id": "shutdown", "kind": "shutdown", "target": {"kind": "circuit", "id": "circuit"}, "trigger_time_s": 1, "duration_s": 0.2, "initial": 1, "applied": 0, "unit": "ratio"}
        ]
      },
      {
        "id": "hot_fault",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output", "min": 40, "max": 60, "unit": "degC"},
          {"axis": "cooling_mode", "target": "circuit", "selection": "blocked_airflow"},
          {"axis": "load_resistance", "target": "output", "min": 4, "max": 4, "unit": "Ohm"}
        ],
        "events": [
          {"id": "blocked_airflow", "kind": "blocked_airflow", "target": {"kind": "circuit", "id": "circuit"}, "trigger_time_s": 0, "duration_s": 5, "initial": 1, "applied": 0.3, "recovered": 1, "unit": "ratio"},
          {"id": "short_fault", "kind": "short_circuit", "target": {"kind": "port", "id": "output"}, "trigger_time_s": 1, "duration_s": 0.05, "initial": 4, "applied": 0.05, "recovered": 4, "unit": "Ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "audio_power", "metric": "output_power", "analysis": "transient", "observation": {"kind": "port", "id": "output"}, "min": 15, "unit": "W", "operating_cases": ["reactive_audio_load"], "critical": true},
      {"id": "distortion", "metric": "total_harmonic_distortion", "analysis": "distortion", "observation": {"kind": "port", "id": "output"}, "max": 0.2, "unit": "%", "operating_cases": ["reactive_audio_load"], "critical": true},
      {"id": "gain_margin", "metric": "gain_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output"}, "min": 10, "unit": "dB", "operating_cases": ["reactive_audio_load"], "critical": true},
      {"id": "phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output"}, "min": 50, "unit": "deg", "operating_cases": ["reactive_audio_load"], "critical": true},
      {"id": "mute_voltage", "metric": "muted_output_voltage", "analysis": "transient", "observation": {"kind": "event", "id": "startup"}, "max": 0.1, "unit": "V", "operating_cases": ["reactive_audio_load"], "critical": true},
      {"id": "peak_output_temperature", "metric": "peak_junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "circuit"}, "max": 125, "unit": "degC", "operating_cases": ["reactive_audio_load", "hot_fault"], "critical": true},
      {"id": "short_fault_response", "metric": "protection_response_time", "analysis": "transient", "observation": {"kind": "event", "id": "short_fault"}, "max": 0.001, "unit": "s", "operating_cases": ["hot_fault"], "critical": true},
      {"id": "short_soa_margin", "metric": "transient_soa_margin", "analysis": "electrothermal", "observation": {"kind": "event", "id": "short_fault"}, "min": 1.2, "unit": "ratio", "operating_cases": ["hot_fault"], "critical": true}
    ],
    "constraints": {"max_components": 70, "max_width_mm": 150, "max_height_mm": 100}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true, "require_coverage_accounting": true,
    "require_alternatives": true, "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_hierarchical_decomposition": true,
    "require_interface_contracts": true, "require_shared_resource_planning": true, "require_deterministic_backtracking": true,
    "require_physical_partitioning": true, "require_end_to_end_traceability": true,
    "require_dynamic_model_provenance": true, "require_return_ratio_evidence": true,
    "require_dynamic_electrothermal_evidence": true, "require_event_coverage": true,
    "require_dynamic_architecture_selection": true, "require_bounded_dynamic_repair": true
  }
}
