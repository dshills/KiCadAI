{
  "schema": "kicadai.open-set-requirement.v5",
  "version": 5,
  "project": {
    "name": "efficient_step_down_power_stage",
    "title": "Efficient step-down power stage",
    "description": "Convert a variable high-voltage input to a regulated low-voltage rail with bounded ripple, stable control, transient recovery, and fault stress."
  },
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "input_24v", "kind": "supply", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 30, "max_current_a": 1.5, "source": "external"},
      {"id": "regulated_5v", "kind": "supply", "min_voltage_v": 4.85, "nominal_voltage_v": 5, "max_voltage_v": 5.15, "max_current_a": 2, "source": "converted_output"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_24v"},
      {"id": "output_power", "kind": "power", "direction": "source", "domain": "regulated_5v"}
    ],
    "signals": [
      {"id": "converted_output", "kind": "power", "domain": "regulated_5v"},
      {"id": "current_feedback", "kind": "analog_voltage", "domain": "ground"},
      {"id": "fault_state", "kind": "digital_logic", "domain": "regulated_5v"}
    ],
    "objectives": [
      {"id": "convert", "capability": "efficient_voltage_conversion", "bindings": [{"role": "input", "port": "input_power"}, {"role": "output", "signal": "converted_output", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "sense_current", "capability": "current_sensing", "bindings": [{"role": "input", "signal": "converted_output", "direction": "sink"}, {"role": "output", "signal": "current_feedback", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "protect_output", "capability": "output_protection", "bindings": [{"role": "input", "signal": "converted_output", "direction": "sink"}, {"role": "output", "port": "output_power"}, {"role": "sense", "signal": "current_feedback", "direction": "sink"}, {"role": "fault", "signal": "fault_state", "direction": "source"}, {"role": "reference", "port": "ground"}]},
      {"id": "limit_transients", "capability": "transient_protection", "bindings": [{"role": "fault", "signal": "fault_state", "direction": "sink"}, {"role": "protected", "port": "output_power"}, {"role": "reference", "port": "ground"}]}
    ],
    "operating_cases": [
      {
        "id": "conversion_range",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output_power", "min": -20, "max": 85, "unit": "degC"},
          {"axis": "load_current", "target": "output_power", "min": 0.05, "max": 2, "unit": "A"},
          {"axis": "supply_voltage", "target": "input_24v", "min": 18, "max": 30, "unit": "V"},
          {"axis": "tolerance", "target": "all_components", "selection": "minimum_nominal_maximum"}
        ],
        "events": [
          {"id": "startup", "kind": "startup", "target": {"kind": "domain", "id": "input_24v"}, "trigger_time_s": 0, "duration_s": 0.02, "initial": 0, "applied": 24, "unit": "V"},
          {"id": "input_step", "kind": "input_step", "target": {"kind": "domain", "id": "input_24v"}, "trigger_time_s": 0.03, "duration_s": 0.02, "initial": 18, "applied": 30, "recovered": 18, "unit": "V"},
          {"id": "load_step", "kind": "load_step", "target": {"kind": "port", "id": "output_power"}, "trigger_time_s": 0.06, "duration_s": 0.02, "initial": 0.1, "applied": 2, "recovered": 0.1, "unit": "A"}
        ]
      },
      {
        "id": "output_short",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output_power", "min": 50, "max": 85, "unit": "degC"},
          {"axis": "supply_voltage", "target": "input_24v", "min": 24, "max": 30, "unit": "V"}
        ],
        "events": [
          {"id": "short_fault", "kind": "short_circuit", "target": {"kind": "port", "id": "output_power"}, "trigger_time_s": 0.01, "duration_s": 0.02, "initial": 5, "applied": 0, "recovered": 5, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "conversion_efficiency", "metric": "conversion_efficiency", "analysis": "transient", "observation": {"kind": "circuit", "id": "circuit"}, "min": 82, "unit": "%", "operating_cases": ["conversion_range"], "critical": true},
      {"id": "output_ripple", "metric": "peak_to_peak_ripple", "analysis": "transient", "observation": {"kind": "port", "id": "output_power"}, "max": 0.05, "unit": "V", "operating_cases": ["conversion_range"], "critical": true},
      {"id": "regulated_output", "metric": "dc_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "output_power"}, "min": 4.85, "max": 5.15, "unit": "V", "operating_cases": ["conversion_range"], "critical": true},
      {"id": "loop_gain_margin", "metric": "gain_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output_power"}, "min": 8, "unit": "dB", "operating_cases": ["conversion_range"], "critical": true},
      {"id": "loop_phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output_power"}, "min": 50, "unit": "deg", "operating_cases": ["conversion_range"], "critical": true},
      {"id": "peak_switch_temperature", "metric": "peak_junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "circuit"}, "max": 135, "unit": "degC", "operating_cases": ["conversion_range", "output_short"], "critical": true},
      {"id": "short_soa_margin", "metric": "transient_soa_margin", "analysis": "electrothermal", "observation": {"kind": "event", "id": "short_fault"}, "min": 1.2, "unit": "ratio", "operating_cases": ["output_short"], "critical": true}
    ],
    "constraints": {"max_components": 42, "max_width_mm": 85, "max_height_mm": 60}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true, "require_coverage_accounting": true,
    "require_alternatives": true, "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_hierarchical_decomposition": true,
    "require_interface_contracts": true, "require_shared_resource_planning": true, "require_deterministic_backtracking": true,
    "require_physical_partitioning": true, "require_end_to_end_traceability": true,
    "require_dynamic_model_provenance": true, "require_return_ratio_evidence": true,
    "require_dynamic_electrothermal_evidence": true, "require_event_coverage": true,
    "require_dynamic_architecture_selection": true, "require_bounded_dynamic_repair": true
  }
}
