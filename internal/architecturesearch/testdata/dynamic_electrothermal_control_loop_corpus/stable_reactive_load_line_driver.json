{
  "schema": "kicadai.open-set-requirement.v5",
  "version": 5,
  "project": {
    "name": "stable_reactive_load_line_driver",
    "title": "Stable reactive-load line driver",
    "description": "Amplify a bounded analog input while remaining stable and recovering cleanly across resistive and capacitive output loads."
  },
  "requirements": {
    "domains": [
      {"id": "analog_12v", "kind": "supply", "min_voltage_v": 10.8, "nominal_voltage_v": 12, "max_voltage_v": 13.2, "max_current_a": 0.25, "source": "external"},
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "input", "kind": "analog_voltage", "direction": "sink", "domain": "ground", "electrical": {"min_voltage_v": -0.5, "max_voltage_v": 0.5, "input_impedance_min_ohm": 100000}},
      {"id": "output", "kind": "protected_output", "direction": "source", "domain": "ground", "electrical": {"min_voltage_v": -5, "max_voltage_v": 5, "max_source_current_ma": 50}},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "analog_12v"}
    ],
    "signals": [
      {"id": "band_limited", "kind": "analog_voltage", "domain": "ground"},
      {"id": "driven", "kind": "analog_voltage", "domain": "ground"}
    ],
    "objectives": [
      {"id": "amplify", "capability": "signal_amplification", "bindings": [{"role": "input", "signal": "band_limited", "direction": "sink"}, {"role": "output", "signal": "driven", "direction": "source"}, {"role": "power", "port": "power"}, {"role": "reference", "port": "ground"}]},
      {"id": "condition_bandwidth", "capability": "frequency_filter", "bindings": [{"role": "input", "port": "input"}, {"role": "output", "signal": "band_limited", "direction": "source"}, {"role": "power", "port": "power"}, {"role": "reference", "port": "ground"}]},
      {"id": "protect_output", "capability": "output_protection", "bindings": [{"role": "input", "signal": "driven", "direction": "sink"}, {"role": "output", "port": "output"}, {"role": "reference", "port": "ground"}]},
      {"id": "limit_transients", "capability": "transient_protection", "bindings": [{"role": "protected", "port": "output"}, {"role": "reference", "port": "ground"}]}
    ],
    "operating_cases": [
      {
        "id": "reactive_load",
        "conditions": [
          {"axis": "ambient_temperature", "target": "output", "min": -20, "max": 70, "unit": "degC"},
          {"axis": "load_capacitance", "target": "output", "min": 0, "max": 2.2e-8, "unit": "F"},
          {"axis": "load_resistance", "target": "output", "min": 200, "max": 100000, "unit": "Ohm"},
          {"axis": "supply_voltage", "target": "analog_12v", "min": 10.8, "max": 13.2, "unit": "V"},
          {"axis": "tolerance", "target": "all_passives", "selection": "minimum_nominal_maximum"}
        ],
        "events": [
          {"id": "command_step", "kind": "input_step", "target": {"kind": "port", "id": "input"}, "trigger_time_s": 0.001, "duration_s": 0.004, "initial": 0, "applied": 0.25, "recovered": 0, "unit": "V"},
          {"id": "reactive_load_step", "kind": "load_step", "target": {"kind": "port", "id": "output"}, "trigger_time_s": 0.002, "duration_s": 0.002, "initial": 100000, "applied": 200, "recovered": 100000, "unit": "Ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "closed_loop_gain", "metric": "voltage_gain", "analysis": "ac_sweep", "observation": {"kind": "port", "id": "output"}, "min": 9.5, "max": 10.5, "unit": "ratio", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "closed_loop_peaking", "metric": "closed_loop_peaking", "analysis": "stability", "observation": {"kind": "port", "id": "output"}, "max": 1.5, "unit": "dB", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "gain_margin", "metric": "gain_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output"}, "min": 10, "unit": "dB", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "port", "id": "output"}, "min": 55, "unit": "deg", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "settling", "metric": "settling_time", "analysis": "transient", "observation": {"kind": "event", "id": "command_step"}, "max": 0.00025, "unit": "s", "operating_cases": ["reactive_load"], "critical": true},
      {"id": "step_overshoot", "metric": "overshoot_voltage", "analysis": "transient", "observation": {"kind": "event", "id": "reactive_load_step"}, "max": 0.4, "unit": "V", "operating_cases": ["reactive_load"], "critical": true}
    ],
    "constraints": {"max_components": 30, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true, "require_coverage_accounting": true,
    "require_alternatives": true, "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_hierarchical_decomposition": true,
    "require_interface_contracts": true, "require_shared_resource_planning": true, "require_deterministic_backtracking": true,
    "require_physical_partitioning": true, "require_end_to_end_traceability": true,
    "require_dynamic_model_provenance": true, "require_return_ratio_evidence": true,
    "require_dynamic_electrothermal_evidence": true, "require_event_coverage": true,
    "require_dynamic_architecture_selection": true, "require_bounded_dynamic_repair": true
  }
}
