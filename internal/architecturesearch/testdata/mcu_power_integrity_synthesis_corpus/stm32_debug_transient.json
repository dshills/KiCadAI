{
  "schema": "kicadai.open-set-requirement.v1",
  "version": 1,
  "project": {"name": "debug_transient_controller", "title": "Debug transient controller", "description": "Select a debug-capable controller and calculate rail support from behavior-level transient constraints."},
  "requirements": {
    "domains": [
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "logic", "kind": "supply", "min_voltage_v": 3.15, "nominal_voltage_v": 3.3, "max_voltage_v": 3.45, "max_current_a": 0.2, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "logic_power", "kind": "power", "direction": "sink", "domain": "logic", "electrical": {"max_current_a": 0.2}},
      {"id": "sense", "kind": "analog_voltage", "direction": "sink", "domain": "logic", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3}},
      {"id": "alert", "kind": "digital_logic", "direction": "source", "domain": "logic", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "default_state": "inactive"}}
    ],
    "participants": [{
      "id": "controller", "capability": "programmable_controller", "domain": "logic",
      "required_ports": [{"id": "status", "kind": "digital_logic", "direction": "source"}],
      "constraints": [
        {"name": "programmable_interface", "relation": "required", "value": true},
        {"name": "programming_kind", "relation": "equal", "value": "swd"},
        {"name": "mcu_startup_current", "relation": "maximum", "value": 0.02, "unit": "A"},
        {"name": "mcu_transient_current_step", "relation": "maximum", "value": 0.015, "unit": "A"},
        {"name": "mcu_transient_duration", "relation": "maximum", "value": 0.00005, "unit": "s"},
        {"name": "mcu_local_transient_duration", "relation": "maximum", "value": 0.000001, "unit": "s"},
        {"name": "maximum_supply_ripple", "relation": "maximum", "value": 0.1, "unit": "V"},
        {"name": "maximum_supply_noise", "relation": "maximum", "value": 0.04, "unit": "V"},
        {"name": "mcu_brownout_voltage", "relation": "minimum", "value": 1.7, "unit": "V"},
        {"name": "power_source_impedance", "relation": "maximum", "value": 0.2, "unit": "Ohm"},
        {"name": "ambient_temperature_minimum", "relation": "minimum", "value": -40, "unit": "degC"},
        {"name": "ambient_temperature_maximum", "relation": "maximum", "value": 85, "unit": "degC"}
      ]
    }],
    "objectives": [{
      "id": "monitor", "capability": "threshold_detection",
      "bindings": [{"role": "power", "port": "logic_power"}, {"role": "reference", "port": "ground"}, {"role": "sense", "port": "sense"}, {"role": "output", "port": "alert"}],
      "constraints": [
        {"name": "threshold_voltage", "relation": "target", "value": 1.5, "unit": "V", "tolerance_percent": 2},
        {"name": "hysteresis_width", "relation": "target", "value": 0.2, "unit": "V", "tolerance_percent": 10},
        {"name": "output_polarity", "relation": "equal", "value": "active_low"},
        {"name": "propagation_delay", "relation": "maximum", "value": 10, "unit": "us"},
        {"name": "inactive_at_power_up", "relation": "required", "value": true}
      ]
    }],
    "constraints": {"max_components": 28, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {"require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
