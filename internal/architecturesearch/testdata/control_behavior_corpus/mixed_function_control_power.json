{
  "schema": "kicadai.open-set-requirement.v6",
  "version": 6,
  "project": {
    "name": "mixed_function_control_power",
    "title": "Mixed-function analog control and protected power",
    "description": "Condition an analog command, compare it with hysteresis, control a protected power output, and report fault state."
  },
  "requirements": {
    "domains": [
      {
        "id": "control_5v",
        "kind": "supply",
        "min_voltage_v": 4.5,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.5,
        "max_current_a": 0.15,
        "source": "external"
      },
      {
        "id": "load_24v",
        "kind": "supply",
        "min_voltage_v": 20,
        "nominal_voltage_v": 24,
        "max_voltage_v": 28,
        "max_current_a": 2,
        "source": "external"
      },
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground"
      },
      {
        "id": "control_power",
        "kind": "power",
        "direction": "sink",
        "domain": "control_5v"
      },
      {
        "id": "load_power",
        "kind": "power",
        "direction": "sink",
        "domain": "load_24v"
      },
      {
        "id": "command",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground"
      },
      {
        "id": "power_good",
        "kind": "digital_logic",
        "direction": "sink",
        "domain": "control_5v",
        "control": {
          "function": "power_good",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "deasserted"
        }
      },
      {
        "id": "load",
        "kind": "protected_output",
        "direction": "source",
        "domain": "load_24v"
      },
      {
        "id": "fault",
        "kind": "digital_logic",
        "direction": "source",
        "domain": "control_5v",
        "control": {
          "function": "fault",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "asserted"
        }
      }
    ],
    "signals": [
      {
        "id": "filtered",
        "kind": "analog_voltage",
        "domain": "ground"
      },
      {
        "id": "decision",
        "kind": "digital_logic",
        "domain": "control_5v",
        "control": {
          "function": "fault",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "asserted"
        }
      },
      {
        "id": "permit",
        "kind": "digital_logic",
        "domain": "control_5v",
        "control": {
          "function": "enable",
          "polarity": "active_high",
          "startup_state": "deasserted",
          "safe_state": "deasserted"
        }
      }
    ],
    "objectives": [
