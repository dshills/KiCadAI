    "behavioral_requirements": [
      {
        "id": "filter_cutoff",
        "metric": "cutoff_frequency",
        "analysis": "ac_sweep",
        "observation": {
          "kind": "signal",
          "id": "filtered"
        },
        "min": 80,
        "max": 120,
        "unit": "Hz",
        "operating_cases": [
