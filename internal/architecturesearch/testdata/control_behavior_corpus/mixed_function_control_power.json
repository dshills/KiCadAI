            "axis": "supply_voltage",
            "target": "load_24v",
            "min": 20,
            "max": 28,
            "unit": "V"
          },
          {
            "axis": "load_current",
            "target": "load",
            "min": 1,
            "max": 2,
            "unit": "A"
          },
          {
            "axis": "ambient_temperature",
            "target": "circuit",
            "min": -20,
            "max": 70,
            "unit": "degC"
          }
        ]
      },
      {
