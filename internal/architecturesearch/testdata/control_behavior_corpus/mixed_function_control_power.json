            "role": "fault",
            "signal": "decision",
            "direction": "sink"
          },
          {
            "role": "permit",
            "signal": "permit",
            "direction": "source"
          },
          {
            "role": "power",
            "port": "control_power"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      },
      {
        "id": "switch",
