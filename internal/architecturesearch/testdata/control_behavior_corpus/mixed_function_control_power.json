            "axis": "supply_voltage",
            "target": "control_5v",
            "min": 4.5,
            "max": 5.5,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "load_24v",
            "min": 20,
            "max": 28,
            "unit": "V"
          },
          {
            "axis": "load_current",
            "target": "load",
            "min": 1,
            "max": 1,
            "unit": "A"
