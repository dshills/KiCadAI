        "analysis": "transient",
        "observation": {
          "kind": "signal",
          "id": "permit"
        },
        "max": 0.01,
        "unit": "s",
        "operating_cases": [
          "protected_operation"
        ],
        "critical": true,
        "transition": "fault_disconnect"
      },
      {
        "id": "fault_recovery",
        "metric": "protection_recovery_time",
        "analysis": "transient",
        "observation": {
          "kind": "signal",
          "id": "permit"
        },
        "max": 0.01,
        "unit": "s",
        "operating_cases": [
          "protected_operation"
        ],
        "critical": true,
        "transition": "fault_recovery"
      },
      {
        "id": "rail_loss_response",
        "metric": "response_time",
        "analysis": "transient",
        "observation": {
          "kind": "signal",
          "id": "permit"
        },
        "max": 0.01,
        "unit": "s",
        "operating_cases": [
