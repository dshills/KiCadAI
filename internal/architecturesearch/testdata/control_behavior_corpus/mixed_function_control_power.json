          {
            "role": "power",
            "port": "load_power"
          },
          {
            "role": "output",
            "port": "load"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      },
      {
        "id": "fault_indicator",
        "capability": "fault_indication",
        "bindings": [
          {
            "role": "input",
            "signal": "decision",
            "direction": "sink"
          },
          {
            "role": "output",
            "port": "fault"
          },
          {
            "role": "power",
            "port": "control_power"
          },
          {
            "role": "reference",
            "port": "ground"
          }
        ]
      }
    ],
    "operating_cases": [
