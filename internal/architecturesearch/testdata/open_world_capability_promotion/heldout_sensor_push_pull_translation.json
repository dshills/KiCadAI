{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "heldout_sensor_push_pull_translation",
    "title": "Partial-power-down motion-sensor translation",
    "description": "Translate a four-megahertz push-pull motion-sensor signal from five volts to a 1.8-volt controller without back-powering an unpowered controller."
  },
  "requirements": {
    "domains": [
      {"id": "sensor_5v", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.05, "source": "external"},
      {"id": "controller_1v8", "kind": "supply", "min_voltage_v": 1.71, "nominal_voltage_v": 1.8, "max_voltage_v": 1.89, "max_current_a": 0.05, "source": "external"},
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "sensor_power", "kind": "power", "direction": "sink", "domain": "sensor_5v"},
      {"id": "controller_power", "kind": "power", "direction": "sink", "domain": "controller_1v8"},
      {"id": "enable", "kind": "digital_logic", "direction": "sink", "domain": "controller_1v8", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "default_state": "inactive"}},
      {
        "id": "sensor_signal", "kind": "digital_logic", "direction": "source", "domain": "sensor_5v",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 5, "frequency_max_hz": 4000000},
        "protocol": {"name": "motion", "mode": "push_pull", "max_frequency_hz": 4000000}
      },
      {
        "id": "controller_signal", "kind": "digital_logic", "direction": "sink", "domain": "controller_1v8",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "frequency_max_hz": 4000000, "default_state": "inactive"},
        "protocol": {"name": "motion", "mode": "push_pull", "max_frequency_hz": 4000000}
      }
    ],
    "objectives": [{
      "id": "translate_motion_signal",
      "capability": "logic_level_translation",
      "bindings": [
        {"role": "side_a", "port": "sensor_signal"},
        {"role": "side_b", "port": "controller_signal"},
        {"role": "power_a", "port": "sensor_power"},
        {"role": "power_b", "port": "controller_power"},
        {"role": "reference", "port": "ground"},
        {"role": "enable", "port": "enable"}
      ],
      "constraints": [
        {"name": "signaling_mode", "relation": "equal", "value": "push_pull"},
        {"name": "direction", "relation": "equal", "value": "unidirectional"},
        {"name": "channel_count", "relation": "minimum", "value": 1, "unit": "count"},
        {"name": "unpowered_backfeed_prevention", "relation": "required", "value": true}
      ]
    }],
    "operating_cases": [
      {
        "id": "powered_translation",
        "conditions": [
          {"axis": "supply_voltage", "target": "sensor_5v", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "supply_voltage", "target": "controller_1v8", "min": 1.71, "max": 1.89, "unit": "V"},
          {"axis": "load_capacitance", "target": "controller_signal", "min": 5e-12, "max": 45e-12, "unit": "F"}
        ]
      },
      {
        "id": "controller_supply_loss",
        "conditions": [
          {"axis": "supply_voltage", "target": "sensor_5v", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "supply_voltage", "target": "controller_1v8", "min": 0, "max": 0, "unit": "V"},
          {"axis": "load_capacitance", "target": "controller_signal", "min": 5e-12, "max": 45e-12, "unit": "F"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "logic_high", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "controller_signal"}, "min": 1.2, "max": 1.89, "unit": "V", "operating_cases": ["powered_translation"], "critical": true},
      {"id": "rise", "metric": "rise_time", "analysis": "transient", "observation": {"kind": "port", "id": "controller_signal"}, "max": 250e-9, "unit": "s", "operating_cases": ["powered_translation"], "critical": true},
      {"id": "startup", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "controller_signal"}, "max": 1.89, "unit": "V", "operating_cases": ["controller_supply_loss"], "critical": true}
    ],
    "constraints": {"max_components": 12, "max_width_mm": 45, "max_height_mm": 32}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true,
    "require_connectivity": true, "require_writer_correctness": true,
    "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true,
    "require_coverage_accounting": true, "require_alternatives": true,
    "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true
  }
}
