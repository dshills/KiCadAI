{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "heldout_analog_clock_fanout",
    "title": "Three-input sample-clock fanout",
    "description": "Generate a one-megahertz sampling reference for three receiver-equivalent inputs with bounded aggregate loading and monotonic settling."
  },
  "requirements": {
    "domains": [
      {"id": "logic_3v3", "kind": "supply", "min_voltage_v": 3.15, "nominal_voltage_v": 3.3, "max_voltage_v": 3.45, "max_current_a": 0.05, "source": "external"},
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "power", "kind": "power", "direction": "sink", "domain": "logic_3v3", "electrical": {"max_current_a": 0.05}},
      {
        "id": "sample_clock",
        "kind": "digital_logic",
        "direction": "source",
        "domain": "logic_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "max_source_current_ma": 4, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "clock", "mode": "single_ended", "max_frequency_hz": 1000000}
      }
    ],
    "objectives": [{
      "id": "generate_sample_clock",
      "capability": "clock_generation",
      "bindings": [
        {"role": "output", "port": "sample_clock"},
        {"role": "power", "port": "power"},
        {"role": "reference", "port": "ground"}
      ],
      "constraints": [
        {"name": "output_frequency", "relation": "target", "value": 1000000, "unit": "Hz", "tolerance_percent": 0.01},
        {"name": "clock_fanout", "relation": "minimum", "value": 3},
        {"name": "maximum_rms_jitter", "relation": "maximum", "value": 1e-9, "unit": "s"},
        {"name": "maximum_startup_time", "relation": "maximum", "value": 0.005, "unit": "s"}
      ]
    }],
    "operating_cases": [{
      "id": "rated",
      "conditions": [
        {"axis": "supply_voltage", "target": "logic_3v3", "min": 3.15, "max": 3.45, "unit": "V"},
        {"axis": "load_capacitance", "target": "sample_clock", "min": 54e-12, "max": 54e-12, "unit": "F"},
        {"axis": "ambient_temperature", "target": "circuit", "min": -20, "max": 70, "unit": "degC"}
      ]
    }],
    "behavioral_requirements": [
      {"id": "logic_high", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "sample_clock"}, "min": 2.4, "unit": "V", "operating_cases": ["rated"], "critical": true},
      {"id": "rise", "metric": "rise_time", "analysis": "transient", "observation": {"kind": "port", "id": "sample_clock"}, "max": 120e-9, "unit": "s", "operating_cases": ["rated"], "critical": true},
      {"id": "fall", "metric": "fall_time", "analysis": "transient", "observation": {"kind": "port", "id": "sample_clock"}, "max": 120e-9, "unit": "s", "operating_cases": ["rated"], "critical": true},
      {"id": "startup", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "sample_clock"}, "max": 3.45, "unit": "V", "operating_cases": ["rated"], "critical": true}
    ],
    "constraints": {"max_components": 12, "max_width_mm": 45, "max_height_mm": 32}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true,
    "require_connectivity": true, "require_writer_correctness": true,
    "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true,
    "require_coverage_accounting": true, "require_alternatives": true,
    "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true
  }
}
