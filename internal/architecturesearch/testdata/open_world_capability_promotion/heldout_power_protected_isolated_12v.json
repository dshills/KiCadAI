{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "heldout_power_protected_isolated_12v",
    "title": "Protected isolated twelve-volt rail",
    "description": "Generate an isolated twelve-volt, 250-milliamp rail from an industrial 24-volt source with bounded inrush, short-circuit protection, remote shutdown, and a proved output-discharge path."
  },
  "requirements": {
    "domains": [
      {"id": "input_24v", "kind": "supply", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 36, "max_current_a": 0.4, "source": "external"},
      {"id": "isolated_12v", "kind": "supply", "min_voltage_v": 11.88, "nominal_voltage_v": 12, "max_voltage_v": 12.12, "max_current_a": 0.25, "source": "isolated_rail"},
      {"id": "input_ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "output_ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "input_ground", "kind": "reference", "direction": "bidirectional", "domain": "input_ground"},
      {"id": "output_ground", "kind": "reference", "direction": "bidirectional", "domain": "output_ground"},
      {"id": "input_power", "kind": "power", "direction": "sink", "domain": "input_24v", "electrical": {"max_current_a": 0.4}},
      {"id": "isolated_output", "kind": "power", "direction": "source", "domain": "isolated_12v", "electrical": {"min_voltage_v": 11.88, "max_voltage_v": 12.12, "max_source_current_ma": 250}},
      {"id": "shutdown", "kind": "digital_logic", "direction": "sink", "domain": "input_24v", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5, "default_state": "inactive"}}
    ],
    "signals": [
      {"id": "isolated_rail", "kind": "power", "domain": "isolated_12v", "electrical": {"min_voltage_v": 11.88, "max_voltage_v": 12.12, "max_source_current_ma": 250}}
    ],
    "objectives": [
      {
        "id": "generate_isolated_rail",
        "capability": "voltage_regulation",
        "bindings": [
          {"role": "input", "port": "input_power"},
          {"role": "output", "signal": "isolated_rail", "direction": "source"},
          {"role": "reference", "port": "output_ground"},
          {"role": "shutdown", "port": "shutdown"}
        ],
        "constraints": [
          {"name": "isolation_required", "relation": "required", "value": true},
          {"name": "output_voltage", "relation": "target", "value": 12, "unit": "V", "tolerance_percent": 1},
          {"name": "isolation_working_voltage", "relation": "minimum", "value": 1000, "unit": "V"},
          {"name": "maximum_inrush_current", "relation": "maximum", "value": 0.3, "unit": "A"},
          {"name": "shutdown_discharge_voltage", "relation": "maximum", "value": 2, "unit": "V"},
          {"name": "shutdown_discharge_time", "relation": "maximum", "value": 0.5, "unit": "s"}
        ]
      },
      {
        "id": "protect_isolated_output",
        "capability": "transient_protection",
        "bindings": [
          {"role": "input", "signal": "isolated_rail", "direction": "sink"},
          {"role": "output", "port": "isolated_output"},
          {"role": "reference", "port": "output_ground"}
        ],
        "constraints": [
          {"name": "esd_contact", "relation": "minimum", "value": 8000, "unit": "V"}
        ]
      }
    ],
    "operating_cases": [{
      "id": "rated",
      "conditions": [
        {"axis": "supply_voltage", "target": "input_24v", "min": 18, "max": 36, "unit": "V"},
        {"axis": "load_current", "target": "isolated_12v", "min": 0.02, "max": 0.25, "unit": "A"},
        {"axis": "ambient_temperature", "target": "circuit", "min": -20, "max": 70, "unit": "degC"}
      ]
    }],
    "behavioral_requirements": [
      {"id": "rail_voltage", "metric": "dc_voltage", "analysis": "dc_operating_point", "observation": {"kind": "domain", "id": "isolated_12v"}, "min": 11.88, "max": 12.12, "unit": "V", "operating_cases": ["rated"], "critical": true},
      {"id": "startup", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "signal", "id": "isolated_rail"}, "max": 12.6, "unit": "V", "operating_cases": ["rated"], "critical": true},
      {"id": "thermal", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "domain", "id": "isolated_12v"}, "max": 85, "unit": "degC", "operating_cases": ["rated"], "critical": true}
    ],
    "constraints": {"max_components": 16, "max_width_mm": 70, "max_height_mm": 45}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true,
    "require_connectivity": true, "require_writer_correctness": true,
    "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true,
    "require_coverage_accounting": true, "require_alternatives": true,
    "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true
  }
}
