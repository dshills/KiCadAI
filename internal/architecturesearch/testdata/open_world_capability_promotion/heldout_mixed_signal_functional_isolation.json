{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "heldout_mixed_signal_functional_isolation",
    "title": "Default-low isolated control and fault link",
    "description": "Send a sixteen-channel push-pull control word and return one fault channel across a one-kilovolt functional-isolation boundary with independent startup and default-low supply-loss behavior."
  },
  "requirements": {
    "domains": [
      {"id": "side_a_3v3", "kind": "supply", "min_voltage_v": 3.15, "nominal_voltage_v": 3.3, "max_voltage_v": 3.45, "max_current_a": 0.1, "source": "external"},
      {"id": "side_b_5v", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1, "source": "external"},
      {"id": "side_a_ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "side_b_ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "side_a_ground", "kind": "reference", "direction": "bidirectional", "domain": "side_a_ground"},
      {"id": "side_b_ground", "kind": "reference", "direction": "bidirectional", "domain": "side_b_ground"},
      {"id": "side_a_power", "kind": "power", "direction": "sink", "domain": "side_a_3v3"},
      {"id": "side_b_power", "kind": "power", "direction": "sink", "domain": "side_b_5v"},
      {
        "id": "control_word", "kind": "digital_bus", "direction": "source", "domain": "side_a_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 8000000},
        "protocol": {"name": "parallel", "mode": "push_pull", "max_frequency_hz": 8000000}
      },
      {
        "id": "isolated_control_word", "kind": "digital_bus", "direction": "sink", "domain": "side_b_5v",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 5, "frequency_max_hz": 8000000, "default_state": "inactive"},
        "protocol": {"name": "parallel", "mode": "push_pull", "max_frequency_hz": 8000000}
      },
      {
        "id": "fault_return", "kind": "digital_logic", "direction": "source", "domain": "side_b_5v",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 5, "frequency_max_hz": 8000000},
        "protocol": {"name": "fault", "mode": "push_pull", "max_frequency_hz": 8000000}
      },
      {
        "id": "isolated_fault", "kind": "digital_logic", "direction": "sink", "domain": "side_a_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 8000000, "default_state": "inactive"},
        "protocol": {"name": "fault", "mode": "push_pull", "max_frequency_hz": 8000000}
      }
    ],
    "objectives": [{
      "id": "isolate_control_and_fault",
      "capability": "galvanic_isolation",
      "bindings": [
        {"role": "side_a_forward", "port": "control_word"},
        {"role": "side_b_forward", "port": "isolated_control_word"},
        {"role": "side_b_reverse", "port": "fault_return"},
        {"role": "side_a_reverse", "port": "isolated_fault"},
        {"role": "power_a", "port": "side_a_power"},
        {"role": "reference_a", "port": "side_a_ground"},
        {"role": "power_b", "port": "side_b_power"},
        {"role": "reference_b", "port": "side_b_ground"}
      ],
      "constraints": [
        {"name": "signaling_mode", "relation": "equal", "value": "push_pull"},
        {"name": "forward_channel_count", "relation": "minimum", "value": 16, "unit": "count"},
        {"name": "reverse_channel_count", "relation": "minimum", "value": 1, "unit": "count"},
        {"name": "isolation_working_voltage", "relation": "minimum", "value": 1000, "unit": "V"},
        {"name": "isolation_transient_voltage", "relation": "minimum", "value": 5000, "unit": "V"},
        {"name": "minimum_clearance", "relation": "minimum", "value": 6, "unit": "mm"},
        {"name": "minimum_creepage", "relation": "minimum", "value": 6, "unit": "mm"},
        {"name": "supply_loss_safe_state", "relation": "equal", "value": "low"},
        {"name": "independent_startup", "relation": "required", "value": true}
      ]
    }],
    "operating_cases": [
      {"id": "side_a_supply_loss", "conditions": [{"axis": "supply_voltage", "target": "side_a_3v3", "min": 0, "max": 3.45, "unit": "V"}, {"axis": "supply_voltage", "target": "side_b_5v", "min": 4.75, "max": 5.25, "unit": "V"}]},
      {"id": "side_b_supply_loss", "conditions": [{"axis": "supply_voltage", "target": "side_a_3v3", "min": 3.15, "max": 3.45, "unit": "V"}, {"axis": "supply_voltage", "target": "side_b_5v", "min": 0, "max": 5.25, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "forward_safe_low", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "isolated_control_word"}, "max": 0.8, "unit": "V", "operating_cases": ["side_a_supply_loss"], "critical": true},
      {"id": "reverse_safe_low", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "isolated_fault"}, "max": 0.8, "unit": "V", "operating_cases": ["side_b_supply_loss"], "critical": true}
    ],
    "constraints": {"max_components": 48, "max_width_mm": 110, "max_height_mm": 60}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true,
    "require_connectivity": true, "require_writer_correctness": true,
    "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true,
    "require_coverage_accounting": true, "require_alternatives": true,
    "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true
  }
}
