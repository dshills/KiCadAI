{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "heldout_mcu_translated_debug",
    "title": "Translated shared-pin controller debug",
    "description": "Provide a three-signal 3.3-volt host connection to a 1.8-volt controller while preserving SWD loading, reset entry, inactive startup, and shared-application-pin arbitration."
  },
  "requirements": {
    "domains": [
      {"id": "host_3v3", "kind": "supply", "min_voltage_v": 3.15, "nominal_voltage_v": 3.3, "max_voltage_v": 3.45, "max_current_a": 0.1, "source": "external"},
      {"id": "target_1v8", "kind": "supply", "min_voltage_v": 1.71, "nominal_voltage_v": 1.8, "max_voltage_v": 1.89, "max_current_a": 0.15, "source": "external"},
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"},
      {"id": "host_power", "kind": "power", "direction": "sink", "domain": "host_3v3"},
      {"id": "target_power", "kind": "power", "direction": "sink", "domain": "target_1v8"},
      {"id": "translator_enable", "kind": "digital_logic", "direction": "sink", "domain": "target_1v8", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "default_state": "inactive"}},
      {"id": "translator_direction", "kind": "digital_logic", "direction": "sink", "domain": "target_1v8", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "default_state": "inactive"}},
      {
        "id": "host_debug", "kind": "digital_bus", "direction": "source", "domain": "host_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 4000000},
        "protocol": {"name": "swd_host", "mode": "push_pull", "max_frequency_hz": 4000000}
      }
    ],
    "participants": [{
      "id": "controller",
      "capability": "programmable_controller",
      "domain": "target_1v8",
      "required_ports": [{
        "id": "shared_debug_application",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "protocol": {"name": "swd_target", "mode": "push_pull", "max_frequency_hz": 4000000}
      }],
      "constraints": [
        {"name": "programmable_interface", "relation": "required", "value": true},
        {"name": "programming_kind", "relation": "equal", "value": "swd"},
        {"name": "debug_load_capacitance", "relation": "maximum", "value": 8e-12, "unit": "F"},
        {"name": "debug_pins_shared", "relation": "required", "value": true},
        {"name": "debugger_voltage", "relation": "target", "value": 1.8, "unit": "V"}
      ]
    }],
    "objectives": [{
      "id": "translate_debug_host",
      "capability": "logic_level_translation",
      "bindings": [
        {"role": "side_a", "port": "host_debug"},
        {"role": "side_b", "participant": "controller", "participant_port": "shared_debug_application"},
        {"role": "power_a", "port": "host_power"},
        {"role": "power_b", "port": "target_power"},
        {"role": "reference", "port": "ground"},
        {"role": "enable", "port": "translator_enable"},
        {"role": "direction_control", "port": "translator_direction"}
      ],
      "constraints": [
        {"name": "signaling_mode", "relation": "equal", "value": "push_pull"},
        {"name": "direction", "relation": "equal", "value": "bidirectional"},
        {"name": "direction_change_state", "relation": "equal", "value": "disabled"},
        {"name": "channel_count", "relation": "minimum", "value": 3, "unit": "count"},
        {"name": "unpowered_backfeed_prevention", "relation": "required", "value": true}
      ]
    }],
    "operating_cases": [{
      "id": "debug_attached",
      "conditions": [
        {"axis": "supply_voltage", "target": "host_3v3", "min": 3.15, "max": 3.45, "unit": "V"},
        {"axis": "supply_voltage", "target": "target_1v8", "min": 1.71, "max": 1.89, "unit": "V"},
        {"axis": "load_capacitance", "target": "host_debug", "min": 2e-12, "max": 8e-12, "unit": "F"}
      ]
    }],
    "behavioral_requirements": [
      {"id": "startup", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "host_debug"}, "max": 3.45, "unit": "V", "operating_cases": ["debug_attached"], "critical": true},
      {"id": "debug_edge", "metric": "rise_time", "analysis": "transient", "observation": {"kind": "port", "id": "host_debug"}, "max": 250e-9, "unit": "s", "operating_cases": ["debug_attached"], "critical": true}
    ],
    "constraints": {"max_components": 28, "max_width_mm": 80, "max_height_mm": 55}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true,
    "require_connectivity": true, "require_writer_correctness": true,
    "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true,
    "require_coverage_accounting": true, "require_alternatives": true,
    "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true
  }
}
