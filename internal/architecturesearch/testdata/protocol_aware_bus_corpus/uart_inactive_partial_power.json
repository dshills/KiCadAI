{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "uart_inactive_partial_power",
    "title": "Inactive-safe asynchronous serial link",
    "description": "Translate a two-megahertz push-pull asynchronous serial link in both directions between 3.3-volt and 1.8-volt domains while preserving the inactive state and isolating either unpowered side."
  },
  "requirements": {
    "domains": [
      {"id": "terminal_3v3", "kind": "supply", "min_voltage_v": 3.13, "nominal_voltage_v": 3.3, "max_voltage_v": 3.47, "max_current_a": 0.1, "source": "external"},
      {"id": "controller_1v8", "kind": "supply", "min_voltage_v": 1.71, "nominal_voltage_v": 1.8, "max_voltage_v": 1.89, "max_current_a": 0.1, "source": "external"},
      {"id": "ground", "kind": "reference", "nominal_voltage_v": 0, "source": "external"}
    ],
    "ports": [
      {"id": "terminal_tx", "kind": "digital_logic", "direction": "source", "domain": "terminal_3v3", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 2000000, "default_state": "high"}, "protocol": {"name": "uart", "mode": "push_pull", "max_frequency_hz": 2000000}},
      {"id": "controller_rx", "kind": "digital_logic", "direction": "sink", "domain": "controller_1v8", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "frequency_max_hz": 2000000, "default_state": "high"}, "protocol": {"name": "uart", "mode": "push_pull", "max_frequency_hz": 2000000}},
      {"id": "controller_tx", "kind": "digital_logic", "direction": "source", "domain": "controller_1v8", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "frequency_max_hz": 2000000, "default_state": "high"}, "protocol": {"name": "uart", "mode": "push_pull", "max_frequency_hz": 2000000}},
      {"id": "terminal_rx", "kind": "digital_logic", "direction": "sink", "domain": "terminal_3v3", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 2000000, "default_state": "high"}, "protocol": {"name": "uart", "mode": "push_pull", "max_frequency_hz": 2000000}},
      {"id": "enable", "kind": "digital_logic", "direction": "sink", "domain": "controller_1v8", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1.8, "default_state": "inactive"}},
      {"id": "terminal_power", "kind": "power", "direction": "sink", "domain": "terminal_3v3"},
      {"id": "controller_power", "kind": "power", "direction": "sink", "domain": "controller_1v8"},
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}
    ],
    "objectives": [
      {
        "id": "translate_serial_link",
        "capability": "bus_buffering_level_translation",
        "bindings": [{"role": "side_a_forward", "port": "terminal_tx"}, {"role": "side_b_forward", "port": "controller_rx"}, {"role": "side_b_reverse", "port": "controller_tx"}, {"role": "side_a_reverse", "port": "terminal_rx"}, {"role": "power_a", "port": "terminal_power"}, {"role": "power_b", "port": "controller_power"}, {"role": "reference", "port": "ground"}, {"role": "enable", "port": "enable"}],
        "constraints": [{"name": "protocol", "relation": "equal", "value": "uart"}, {"name": "signaling_mode", "relation": "equal", "value": "push_pull"}, {"name": "direction", "relation": "equal", "value": "mixed_unidirectional"}, {"name": "forward_channel_count", "relation": "minimum", "value": 1, "unit": "count"}, {"name": "reverse_channel_count", "relation": "minimum", "value": 1, "unit": "count"}, {"name": "unpowered_backfeed_prevention", "relation": "required", "value": true}, {"name": "hot_plug_isolation", "relation": "required", "value": true}, {"name": "contention_policy", "relation": "equal", "value": "exclusive_drivers"}]
      }
    ],
    "operating_cases": [
      {"id": "normal", "conditions": [{"axis": "supply_voltage", "target": "terminal_3v3", "min": 3.13, "max": 3.47, "unit": "V"}, {"axis": "supply_voltage", "target": "controller_1v8", "min": 1.71, "max": 1.89, "unit": "V"}, {"axis": "load_capacitance", "target": "terminal_rx", "min": 5e-12, "max": 4e-11, "unit": "F"}]},
      {"id": "terminal_unpowered", "conditions": [{"axis": "supply_voltage", "target": "terminal_3v3", "min": 0, "max": 0, "unit": "V"}, {"axis": "supply_voltage", "target": "controller_1v8", "min": 1.71, "max": 1.89, "unit": "V"}]}
    ],
    "behavioral_requirements": [
      {"id": "terminal_off_safe", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "terminal_rx"}, "max": 0.2, "unit": "V", "operating_cases": ["terminal_unpowered"], "critical": true}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 55, "max_height_mm": 40}
  },
  "acceptance": {
    "require_erc": true, "require_strict_drc": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_deterministic_replay": true,
    "require_contract_composition": true, "require_global_reasoning": true, "require_coverage_accounting": true,
    "require_alternatives": true, "require_fail_closed": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true
  }
}
