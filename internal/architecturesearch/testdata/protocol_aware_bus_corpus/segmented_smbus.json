{
  "schema": "kicadai.open-set-requirement.v3",
  "version": 3,
  "project": {
    "name": "segmented_smbus",
    "title": "Isolated mixed-voltage monitor branches",
    "description": "Connect six independently isolatable 3.3-volt open-drain monitor branches to a 1.8-volt controller trunk at one megahertz while meeting whole-bus loading, rise-time, startup, and partial-power requirements."
  },
  "requirements": {
    "domains": [
      {
        "id": "controller_1v8",
        "kind": "supply",
        "min_voltage_v": 1.71,
        "nominal_voltage_v": 1.8,
        "max_voltage_v": 1.89,
        "max_current_a": 0.1,
        "source": "external"
      },
      {
        "id": "branch_3v3",
        "kind": "supply",
        "min_voltage_v": 3.13,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.47,
        "max_current_a": 0.2,
        "source": "external"
      },
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "trunk",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "controller_1v8",
        "electrical": {
          "min_voltage_v": 0,
          "max_voltage_v": 1.8,
          "frequency_max_hz": 1000000,
          "default_state": "inactive"
        },
        "protocol": {
          "name": "smbus",
          "mode": "open_drain",
          "max_frequency_hz": 1000000
        }
      },
      {
        "id": "branch_01",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "branch_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "smbus", "mode": "open_drain", "max_frequency_hz": 1000000}
      },
      {
        "id": "branch_02",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "branch_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "smbus", "mode": "open_drain", "max_frequency_hz": 1000000}
      },
      {
        "id": "branch_03",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "branch_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "smbus", "mode": "open_drain", "max_frequency_hz": 1000000}
      },
      {
        "id": "branch_04",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "branch_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "smbus", "mode": "open_drain", "max_frequency_hz": 1000000}
      },
      {
        "id": "branch_05",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "branch_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "smbus", "mode": "open_drain", "max_frequency_hz": 1000000}
      },
      {
        "id": "branch_06",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "branch_3v3",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.3, "frequency_max_hz": 1000000, "default_state": "inactive"},
        "protocol": {"name": "smbus", "mode": "open_drain", "max_frequency_hz": 1000000}
      },
      {"id": "controller_power", "kind": "power", "direction": "sink", "domain": "controller_1v8"},
      {"id": "branch_power", "kind": "power", "direction": "sink", "domain": "branch_3v3"},
      {"id": "ground", "kind": "reference", "direction": "bidirectional", "domain": "ground"}
    ],
    "objectives": [
      {
        "id": "condition_bus",
        "capability": "bus_buffering_level_translation",
        "bindings": [
          {"role": "trunk", "port": "trunk"},
          {"role": "segment_01", "port": "branch_01"},
          {"role": "segment_02", "port": "branch_02"},
          {"role": "segment_03", "port": "branch_03"},
          {"role": "segment_04", "port": "branch_04"},
          {"role": "segment_05", "port": "branch_05"},
          {"role": "segment_06", "port": "branch_06"},
          {"role": "power_a", "port": "controller_power"},
          {"role": "power_b", "port": "branch_power"},
          {"role": "reference", "port": "ground"}
        ],
        "constraints": [
          {"name": "protocol", "relation": "equal", "value": "smbus"},
          {"name": "signaling_mode", "relation": "equal", "value": "open_drain"},
          {"name": "direction", "relation": "equal", "value": "bidirectional"},
          {"name": "bus_frequency", "relation": "minimum", "value": 1000000, "unit": "Hz"},
          {"name": "segment_count", "relation": "equal", "value": 6, "unit": "count"},
          {"name": "receiver_count", "relation": "minimum", "value": 6, "unit": "count"},
          {"name": "aggregate_load_capacitance", "relation": "maximum", "value": 3.6e-10, "unit": "F"},
          {"name": "trunk_load_capacitance", "relation": "maximum", "value": 3e-11, "unit": "F"},
          {"name": "segment_load_capacitance", "relation": "maximum", "value": 5.5e-11, "unit": "F"},
          {"name": "rise_time", "relation": "maximum", "value": 1.2e-7, "unit": "s"},
          {"name": "branch_isolation", "relation": "required", "value": true},
          {"name": "unpowered_backfeed_prevention", "relation": "required", "value": true},
          {"name": "hot_plug_isolation", "relation": "required", "value": true},
          {"name": "contention_policy", "relation": "equal", "value": "wired_low"}
        ]
      }
    ],
    "operating_cases": [
      {
        "id": "all_branches_powered",
        "conditions": [
          {"axis": "supply_voltage", "target": "controller_1v8", "min": 1.71, "max": 1.89, "unit": "V"},
          {"axis": "supply_voltage", "target": "branch_3v3", "min": 3.13, "max": 3.47, "unit": "V"},
          {"axis": "load_capacitance", "target": "trunk", "min": 3e-11, "max": 3e-11, "unit": "F"}
        ]
      },
      {
        "id": "branch_power_absent",
        "conditions": [
          {"axis": "supply_voltage", "target": "controller_1v8", "min": 1.71, "max": 1.89, "unit": "V"},
          {"axis": "supply_voltage", "target": "branch_3v3", "min": 0, "max": 0, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "unpowered_branch_startup",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {"kind": "port", "id": "branch_01"},
        "max": 0.2,
        "unit": "V",
        "operating_cases": ["branch_power_absent"],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 48,
      "max_width_mm": 80,
      "max_height_mm": 55
    }
  },
  "acceptance": {
    "require_erc": true,
    "require_strict_drc": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_deterministic_replay": true,
    "require_contract_composition": true,
    "require_global_reasoning": true,
    "require_coverage_accounting": true,
    "require_alternatives": true,
    "require_fail_closed": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true
  }
}
