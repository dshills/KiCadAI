{
  "schema": "kicadai.open-set-requirement.v4",
  "version": 4,
  "project": {
    "name": "isolated_mixed_voltage_gateway_system",
    "title": "Isolated mixed-voltage communications gateway",
    "description": "Carry an externally exposed bidirectional bus across protected, translated, isolated, and separately powered voltage domains while preserving released startup behavior and reference separation."
  },
  "requirements": {
    "domains": [
      {
        "id": "host_5v",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.5,
        "source": "external"
      },
      {
        "id": "host_ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "isolated_3v3",
        "kind": "supply",
        "min_voltage_v": 3.15,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.45,
        "max_current_a": 0.15,
        "source": "isolated_rail"
      },
      {
        "id": "isolated_ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "remote_1v8",
        "kind": "supply",
        "min_voltage_v": 1.71,
        "nominal_voltage_v": 1.8,
        "max_voltage_v": 1.9,
        "max_current_a": 0.08,
        "source": "external"
      },
      {
        "id": "remote_ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "host_bus",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "host_5v",
        "protocol": {
          "name": "i2c",
          "mode": "open_drain",
          "max_frequency_hz": 400000
        }
      },
      {
        "id": "host_ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "host_ground"
      },
      {
        "id": "host_power",
        "kind": "power",
        "direction": "sink",
        "domain": "host_5v",
        "electrical": {
          "max_current_a": 0.5
        }
      },
      {
        "id": "isolated_ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "isolated_ground"
      },
      {
        "id": "remote_bus",
        "kind": "digital_bus",
        "direction": "bidirectional",
        "domain": "remote_1v8",
        "protocol": {
          "name": "i2c",
          "mode": "open_drain",
          "max_frequency_hz": 400000
        }
      },
      {
        "id": "remote_ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "remote_ground"
      },
      {
        "id": "remote_power",
        "kind": "power",
        "direction": "sink",
        "domain": "remote_1v8",
        "electrical": {
          "max_current_a": 0.08
        }
      }
    ],
    "signals": [
      {
        "id": "isolated_bus",
        "kind": "digital_bus",
        "domain": "isolated_3v3",
        "protocol": {
          "name": "i2c",
          "mode": "open_drain",
          "max_frequency_hz": 400000
        }
      },
      {
        "id": "isolated_rail",
        "kind": "power",
        "domain": "isolated_3v3",
        "electrical": {
          "min_voltage_v": 3.15,
          "max_voltage_v": 3.45,
          "max_current_a": 0.15
        }
      },
      {
        "id": "protected_host_bus",
        "kind": "digital_bus",
        "domain": "host_5v",
        "protocol": {
          "name": "i2c",
          "mode": "open_drain",
          "max_frequency_hz": 400000
        }
      }
    ],
    "objectives": [
      {
        "id": "isolate_bus",
        "capability": "galvanic_isolation",
        "bindings": [
          {
            "role": "side_a",
            "signal": "isolated_bus",
            "direction": "bidirectional"
          },
          {
            "role": "side_b",
            "port": "remote_bus"
          },
          {
            "role": "power_a",
            "signal": "isolated_rail",
            "direction": "sink"
          },
          {
            "role": "power_b",
            "port": "remote_power"
          },
          {
            "role": "reference_a",
            "port": "isolated_ground"
          },
          {
            "role": "reference_b",
            "port": "remote_ground"
          }
        ],
        "constraints": [
          {
            "name": "isolation_voltage",
            "relation": "minimum",
            "value": 1000,
            "unit": "V"
          }
        ]
      },
      {
        "id": "protect_host_bus",
        "capability": "transient_protection",
        "bindings": [
          {
            "role": "input",
            "port": "host_bus"
          },
          {
            "role": "output",
            "signal": "protected_host_bus",
            "direction": "bidirectional"
          },
          {
            "role": "reference",
            "port": "host_ground"
          }
        ],
        "constraints": [
          {
            "name": "esd_contact",
            "relation": "minimum",
            "value": 8000,
            "unit": "V"
          }
        ]
      },
      {
        "id": "regulate_isolated_power",
        "capability": "voltage_regulation",
        "bindings": [
          {
            "role": "input",
            "port": "host_power"
          },
          {
            "role": "output",
            "signal": "isolated_rail",
            "direction": "source"
          },
          {
            "role": "reference",
            "port": "isolated_ground"
          }
        ],
        "constraints": [
          {
            "name": "output_voltage",
            "relation": "target",
            "value": 3.3,
            "unit": "V",
            "tolerance_percent": 3
          },
          {
            "name": "isolation_required",
            "relation": "required",
            "value": true
          }
        ]
      },
      {
        "id": "translate_bus",
        "capability": "logic_level_translation",
        "bindings": [
          {
            "role": "side_a",
            "signal": "protected_host_bus",
            "direction": "bidirectional"
          },
          {
            "role": "side_b",
            "signal": "isolated_bus",
            "direction": "bidirectional"
          },
          {
            "role": "power_a",
            "port": "host_power"
          },
          {
            "role": "power_b",
            "signal": "isolated_rail",
            "direction": "sink"
          },
          {
            "role": "reference",
            "port": "host_ground"
          }
        ],
        "constraints": [
          {
            "name": "protocol",
            "relation": "equal",
            "value": "i2c"
          },
          {
            "name": "unpowered_backfeed_prevention",
            "relation": "required",
            "value": true
          }
        ]
      }
    ],
    "system_constraints": [
      {
        "name": "reference_separation",
        "relation": "required",
        "value": true
      },
      {
        "name": "startup_bus_state",
        "relation": "equal",
        "value": "released"
      }
    ],
    "constraints": {
      "max_components": 40,
      "max_width_mm": 85,
      "max_height_mm": 60
    },
    "operating_cases": [
      {
        "id": "interface_range",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "host_5v",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          },
          {
            "axis": "load_capacitance",
            "target": "remote_bus",
            "min": 1e-12,
            "max": 4e-10,
            "unit": "F"
          },
          {
            "axis": "ambient_temperature",
            "target": "circuit",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "tolerance",
            "target": "circuit",
            "selection": "all"
          },
          {
            "axis": "model_parameter",
            "target": "circuit",
            "selection": "all"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "isolated_rail",
        "metric": "dc_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "domain",
          "id": "isolated_3v3"
        },
        "min": 3.15,
        "max": 3.45,
        "unit": "V",
        "operating_cases": [
          "interface_range"
        ],
        "critical": true
      },
      {
        "id": "logic_high",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "remote_bus"
        },
        "min": 1.4,
        "unit": "V",
        "operating_cases": [
          "interface_range"
        ],
        "critical": true
      },
      {
        "id": "rise",
        "metric": "rise_time",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "remote_bus"
        },
        "max": 0.000001,
        "unit": "s",
        "operating_cases": [
          "interface_range"
        ]
      },
      {
        "id": "startup",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "remote_bus"
        },
        "max": 1.9,
        "unit": "V",
        "operating_cases": [
          "interface_range"
        ],
        "critical": true
      }
    ]
  },
  "acceptance": {
    "require_erc": true,
    "require_strict_drc": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_deterministic_replay": true,
    "require_contract_composition": true,
    "require_global_reasoning": true,
    "require_coverage_accounting": true,
    "require_alternatives": true,
    "require_fail_closed": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_hierarchical_decomposition": true,
    "require_interface_contracts": true,
    "require_shared_resource_planning": true,
    "require_deterministic_backtracking": true,
    "require_physical_partitioning": true,
    "require_end_to_end_traceability": true
  }
}
