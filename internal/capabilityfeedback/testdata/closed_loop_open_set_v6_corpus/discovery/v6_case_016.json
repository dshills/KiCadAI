{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name":"timed_current_pulse","title":"Commanded current-pulse interface","description":"Study an externally commanded interface that delivers bounded current pulses to a variable load with controlled edges and a defined inactive state."},
  "requirements": {
    "domains": [
      {"id":"shared_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"command_supply","kind":"supply","min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04,"source":"external"},
      {"id":"load_supply","kind":"supply","min_voltage_v":9,"nominal_voltage_v":12,"max_voltage_v":15,"max_current_a":0.5,"source":"external"}
    ],
    "ports": [
      {"id":"pulse_command","kind":"digital","direction":"sink","domain":"command_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"pulse_inhibit","kind":"digital","direction":"sink","domain":"command_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"input_impedance_min_ohm":100000,"default_state":"high"}},
      {"id":"current_delivery","kind":"controlled_current","direction":"source","domain":"load_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":6,"max_voltage_v":15,"max_current_a":0.35,"default_state":"low"}},
      {"id":"command_power","kind":"power","direction":"sink","domain":"command_supply","electrical":{"min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04}},
      {"id":"load_power","kind":"power","direction":"sink","domain":"load_supply","electrical":{"min_voltage_v":9,"nominal_voltage_v":12,"max_voltage_v":15,"max_current_a":0.5}},
      {"id":"pulse_return","kind":"reference","direction":"bidirectional","domain":"shared_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"active_pulse","conditions":[{"axis":"supply_voltage","target":"command_supply","min":3.0,"max":3.6,"unit":"V"},{"axis":"supply_voltage","target":"load_supply","min":9,"max":15,"unit":"V"},{"axis":"load_resistance","target":"current_delivery","min":10,"max":40,"unit":"ohm"},{"axis":"ambient_temperature","target":"pulse_return","min":-20,"max":80,"unit":"degC"}],"events":[{"id":"command_asserted","kind":"input_step","target":"pulse_command","trigger_time_s":0.00001,"initial":0,"applied":3.3,"unit":"V"}]},
      {"id":"inactive_output","conditions":[{"axis":"input_voltage","target":"pulse_command","min":0,"max":0,"unit":"V"},{"axis":"supply_voltage","target":"load_supply","min":9,"max":15,"unit":"V"},{"axis":"model_corner","target":"current_delivery","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"interrupted_pulse","conditions":[{"axis":"supply_voltage","target":"command_supply","min":3.0,"max":3.6,"unit":"V"},{"axis":"supply_voltage","target":"load_supply","min":9,"max":15,"unit":"V"},{"axis":"load_inductance","target":"current_delivery","min":0.0001,"max":0.002,"unit":"H"}],"events":[{"id":"inhibit_asserted","kind":"input_step","target":"pulse_inhibit","trigger_time_s":0.00002,"initial":0,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"pulse_amplitude","metric":"output_current","analysis":"transient","excitation":{"kind":"port","id":"pulse_command"},"observation":{"kind":"port","id":"current_delivery"},"min":0.18,"max":0.22,"unit":"A","operating_cases":["active_pulse"],"critical":true},
      {"id":"turn_on_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"pulse_command"},"observation":{"kind":"port","id":"current_delivery"},"max":0.000005,"unit":"s","operating_cases":["active_pulse"],"critical":true},
      {"id":"current_rise","metric":"rise_time","analysis":"transient","excitation":{"kind":"port","id":"pulse_command"},"observation":{"kind":"port","id":"current_delivery"},"max":0.00001,"unit":"s","operating_cases":["active_pulse"]},
      {"id":"idle_leakage","metric":"off_state_current","analysis":"dc_operating_point","observation":{"kind":"port","id":"current_delivery"},"max":0.00001,"unit":"A","operating_cases":["inactive_output"],"critical":true},
      {"id":"inhibit_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"pulse_inhibit"},"observation":{"kind":"port","id":"current_delivery"},"max":0.000004,"unit":"s","operating_cases":["interrupted_pulse"],"critical":true},
      {"id":"inductive_peak","metric":"peak_voltage","analysis":"transient","observation":{"kind":"port","id":"current_delivery"},"max":18,"unit":"V","operating_cases":["interrupted_pulse"],"critical":true}
    ],
    "constraints": {"max_components":20,"max_width_mm":36,"max_height_mm":26}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
