{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "precision_current_reader",
    "title": "Precision Unipolar Current Reader",
    "description": "Combine a bounded unipolar input current and a low-voltage offset command into an accurate, low-noise output across supply, tolerance, and temperature conditions."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external"},
      {"id": "measurement_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5.0, "max_voltage_v": 5.25, "max_current_a": 0.04, "source": "external"}
    ],
    "ports": [
      {"id": "sense_current", "kind": "analog_current", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0.0, "max_voltage_v": 0.25, "max_current_a": 0.004}},
      {"id": "offset_command", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 0.05, "max_voltage_v": 0.1, "input_impedance_min_ohm": 100000.0}},
      {"id": "measured_voltage", "kind": "analog_voltage", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 2.5, "max_voltage_v": 4.4, "max_current_a": 0.002}},
      {"id": "measurement_power", "kind": "power", "direction": "sink", "domain": "measurement_supply", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5.0, "max_voltage_v": 5.25, "max_current_a": 0.04}},
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "signal_return", "electrical": {"nominal_voltage_v": 0.0}}
    ],
    "operating_cases": [
      {
        "id": "room_transfer",
        "conditions": [
          {"axis": "input_current", "target": "sense_current", "min": 0.0002, "max": 0.004, "unit": "A"},
          {"axis": "input_voltage", "target": "offset_command", "min": 0.0, "max": 0.1, "unit": "V"},
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 5.0, "max": 5.0, "unit": "V"},
          {"axis": "ambient_temperature", "target": "measured_voltage", "min": 20.0, "max": 30.0, "unit": "degC"},
          {"axis": "load_resistance", "target": "measured_voltage", "min": 10000.0, "max": 1000000.0, "unit": "ohm"}
        ]
      },
      {
        "id": "environment_extremes",
        "conditions": [
          {"axis": "input_current", "target": "sense_current", "min": 0.0002, "max": 0.004, "unit": "A"},
          {"axis": "input_voltage", "target": "offset_command", "min": 0.0, "max": 0.1, "unit": "V"},
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "ambient_temperature", "target": "measured_voltage", "min": -20.0, "max": 70.0, "unit": "degC"},
          {"axis": "tolerance_corner", "target": "sense_current", "min": -1.0, "max": 1.0, "unit": "ratio"},
          {"axis": "load_capacitance", "target": "measured_voltage", "min": 0.0, "max": 0.00000001, "unit": "F"}
        ],
        "events": [
          {"id": "current_change", "kind": "input_step", "target": "sense_current", "trigger_time_s": 0.001, "initial": 0.0005, "applied": 0.0035, "unit": "A"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "transfer_accuracy", "metric": "transimpedance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "sense_current"}, "observation": {"kind": "port", "id": "measured_voltage"}, "min": 985.0, "max": 1015.0, "unit": "V/A", "operating_cases": ["room_transfer", "environment_extremes"], "critical": true},
      {"id": "offset_transfer", "metric": "voltage_gain", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "offset_command"}, "observation": {"kind": "port", "id": "measured_voltage"}, "min": 0.98, "max": 1.02, "unit": "ratio", "operating_cases": ["room_transfer", "environment_extremes"], "critical": true},
      {"id": "output_envelope", "metric": "output_voltage", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "sense_current"}, "observation": {"kind": "port", "id": "measured_voltage"}, "min": 0.18, "max": 4.2, "unit": "V", "operating_cases": ["room_transfer", "environment_extremes"]},
      {"id": "settling_behavior", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "sense_current"}, "observation": {"kind": "port", "id": "measured_voltage"}, "max": 0.0002, "unit": "s", "operating_cases": ["environment_extremes"]},
      {"id": "integrated_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "measured_voltage"}, "max": 0.003, "unit": "V_rms", "frequency_hz": 20000.0, "operating_cases": ["room_transfer"]}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 38.0, "max_height_mm": 24.0}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
