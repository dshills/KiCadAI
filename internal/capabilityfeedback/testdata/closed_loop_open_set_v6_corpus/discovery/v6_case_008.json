{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "field_bus_auxiliary",
    "title": "Wide-Range Auxiliary Power Converter",
    "description": "Study a controlled energy-conversion assembly that supplies a regulated auxiliary rail from a varying field input and reports when commanded delivery is available, including startup, load transients, ripple, and temperature operation."
  },
  "requirements": {
    "domains": [
      {"id": "power_return", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "field_supply", "kind": "supply", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 32, "max_current_a": 1.2, "source": "external"},
      {"id": "control_supply", "kind": "supply", "min_voltage_v": 2.7, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.01, "source": "external"}
    ],
    "ports": [
      {"id": "field_input", "kind": "power", "direction": "sink", "domain": "field_supply", "electrical": {"min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 32, "max_current_a": 1.2}},
      {"id": "auxiliary_output", "kind": "power", "direction": "source", "domain": "power_return", "electrical": {"min_voltage_v": 8.82, "nominal_voltage_v": 9, "max_voltage_v": 9.18, "max_current_a": 1.5}},
      {"id": "delivery_available", "kind": "digital", "direction": "source", "domain": "control_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.004, "default_state": "low"}},
      {"id": "run_command", "kind": "digital", "direction": "sink", "domain": "control_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "input_impedance_min_ohm": 10000, "default_state": "low"}},
      {"id": "common_return", "kind": "reference", "direction": "bidirectional", "domain": "power_return", "electrical": {"nominal_voltage_v": 0, "max_current_a": 2.7}}
    ],
    "operating_cases": [
      {"id": "steady_delivery", "conditions": [
        {"axis": "supply_voltage", "target": "field_supply", "min": 18, "max": 32, "unit": "V"},
        {"axis": "input_voltage", "target": "run_command", "min": 2.7, "max": 3.6, "unit": "V"},
        {"axis": "load_current", "target": "auxiliary_output", "min": 0.08, "max": 1.4, "unit": "A"},
        {"axis": "ambient_temperature", "target": "auxiliary_output", "min": -30, "max": 75, "unit": "degC"},
        {"axis": "tolerance_corner", "target": "field_input", "min": -1, "max": 1, "unit": "%"}
      ]},
      {"id": "energizing", "conditions": [
        {"axis": "supply_voltage", "target": "field_supply", "min": 18, "max": 32, "unit": "V"},
        {"axis": "input_voltage", "target": "run_command", "min": 2.7, "max": 3.6, "unit": "V"},
        {"axis": "load_resistance", "target": "auxiliary_output", "min": 9, "max": 112.5, "unit": "ohm"},
        {"axis": "model_corner", "target": "field_input", "min": -1, "max": 1, "unit": "ratio"}
      ], "events": [
        {"id": "apply_field_power", "kind": "startup", "target": "field_input", "trigger_time_s": 0.002, "initial": 0, "applied": 24, "unit": "V"}
      ]},
      {"id": "changing_load", "conditions": [
        {"axis": "supply_voltage", "target": "field_supply", "min": 20, "max": 28, "unit": "V"},
        {"axis": "input_voltage", "target": "run_command", "min": 2.7, "max": 3.6, "unit": "V"},
        {"axis": "load_current", "target": "auxiliary_output", "min": 0.1, "max": 1.3, "unit": "A"}
      ], "events": [
        {"id": "auxiliary_demand", "kind": "load_step", "target": "auxiliary_output", "trigger_time_s": 0.004, "initial": 0.15, "applied": 1.2, "unit": "A"}
      ]},
      {"id": "delivery_disabled", "conditions": [
        {"axis": "supply_voltage", "target": "field_supply", "min": 18, "max": 32, "unit": "V"},
        {"axis": "input_voltage", "target": "run_command", "min": 0, "max": 0.4, "unit": "V"},
        {"axis": "load_capacitance", "target": "delivery_available", "min": 0, "max": 5e-10, "unit": "F"}
      ]},
      {"id": "delivery_activation", "conditions": [
        {"axis": "supply_voltage", "target": "field_supply", "min": 18, "max": 32, "unit": "V"},
        {"axis": "load_resistance", "target": "auxiliary_output", "min": 12, "max": 90, "unit": "ohm"},
        {"axis": "model_corner", "target": "delivery_available", "min": -1, "max": 1, "unit": "ratio"}
      ], "events": [
        {"id": "request_delivery", "kind": "input_step", "target": "run_command", "trigger_time_s": 0.001, "initial": 0, "applied": 3.3, "unit": "V"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "regulated_rail", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "auxiliary_output"}, "min": 8.82, "max": 9.18, "unit": "V", "operating_cases": ["steady_delivery"], "critical": true},
      {"id": "conversion_quality", "metric": "conversion_efficiency", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "field_input"}, "observation": {"kind": "port", "id": "auxiliary_output"}, "min": 82, "unit": "%", "operating_cases": ["steady_delivery"]},
      {"id": "rail_ripple", "metric": "output_ripple", "analysis": "transient", "observation": {"kind": "port", "id": "auxiliary_output"}, "max": 0.12, "unit": "V_pp", "operating_cases": ["steady_delivery"]},
      {"id": "startup_peak", "metric": "startup_current", "analysis": "startup", "excitation": {"kind": "port", "id": "field_input"}, "observation": {"kind": "port", "id": "field_input"}, "max": 0.9, "unit": "A", "operating_cases": ["energizing"], "critical": true},
      {"id": "startup_rail_peak", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "auxiliary_output"}, "max": 0.45, "unit": "V", "operating_cases": ["energizing"]},
      {"id": "load_recovery", "metric": "settling_time", "analysis": "transient", "observation": {"kind": "port", "id": "auxiliary_output"}, "max": 0.0015, "unit": "s", "operating_cases": ["changing_load"], "critical": true},
      {"id": "thermal_limit", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "hottest_region"}, "max": 125, "unit": "degC", "operating_cases": ["steady_delivery"]},
      {"id": "availability_asserted", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "delivery_available"}, "min": 2.7, "unit": "V", "operating_cases": ["steady_delivery"], "critical": true},
      {"id": "availability_released", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "delivery_available"}, "max": 0.4, "unit": "V", "operating_cases": ["delivery_disabled"], "critical": true},
      {"id": "availability_latency", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "run_command"}, "observation": {"kind": "port", "id": "delivery_available"}, "min": 0.0002, "max": 0.02, "unit": "s", "operating_cases": ["delivery_activation"], "critical": true}
    ],
    "constraints": {"max_components": 28, "max_width_mm": 52, "max_height_mm": 36}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
