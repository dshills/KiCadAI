{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "compact_logic_bridge",
    "title": "Low-Voltage Command Level Bridge",
    "description": "Study a low-power interface that accepts a low-voltage command and reproduces its logic state in a separately powered peripheral domain with controlled edge timing."
  },
  "requirements": {
    "domains": [
      {"id": "shared_return", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "command_supply", "kind": "supply", "min_voltage_v": 1.62, "nominal_voltage_v": 1.8, "max_voltage_v": 1.98, "max_current_a": 0.01, "source": "external"},
      {"id": "peripheral_supply", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.025, "source": "external"}
    ],
    "ports": [
      {"id": "command_input", "kind": "digital", "direction": "sink", "domain": "command_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.8, "max_voltage_v": 1.98, "input_impedance_min_ohm": 50000, "default_state": "low"}},
      {"id": "peripheral_command", "kind": "digital", "direction": "source", "domain": "peripheral_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.008, "default_state": "low"}},
      {"id": "command_power", "kind": "power", "direction": "sink", "domain": "command_supply", "electrical": {"min_voltage_v": 1.62, "nominal_voltage_v": 1.8, "max_voltage_v": 1.98, "max_current_a": 0.01}},
      {"id": "peripheral_power", "kind": "power", "direction": "sink", "domain": "peripheral_supply", "electrical": {"min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.025}},
      {"id": "return_path", "kind": "reference", "direction": "bidirectional", "domain": "shared_return", "electrical": {"nominal_voltage_v": 0, "max_current_a": 0.04}}
    ],
    "operating_cases": [
      {"id": "logic_levels", "conditions": [
        {"axis": "supply_voltage", "target": "command_supply", "min": 1.62, "max": 1.98, "unit": "V"},
        {"axis": "supply_voltage", "target": "peripheral_supply", "min": 4.5, "max": 5.5, "unit": "V"},
        {"axis": "ambient_temperature", "target": "peripheral_command", "min": -10, "max": 70, "unit": "degC"},
        {"axis": "load_current", "target": "peripheral_command", "min": 0, "max": 0.006, "unit": "A"}
      ]},
      {"id": "command_edges", "conditions": [
        {"axis": "load_capacitance", "target": "peripheral_command", "min": 1e-11, "max": 2e-10, "unit": "F"},
        {"axis": "model_corner", "target": "peripheral_command", "min": -1, "max": 1, "unit": "ratio"}
      ], "events": [
        {"id": "command_assertion", "kind": "input_step", "target": "command_input", "trigger_time_s": 0.000001, "initial": 0, "applied": 1.8, "unit": "V"},
        {"id": "command_release", "kind": "input_step", "target": "command_input", "trigger_time_s": 0.000003, "initial": 1.8, "applied": 0, "unit": "V"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "peripheral_high", "metric": "output_high_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "command_input"}, "observation": {"kind": "port", "id": "peripheral_command"}, "min": 4, "unit": "V", "operating_cases": ["logic_levels"]},
      {"id": "peripheral_low", "metric": "output_low_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "command_input"}, "observation": {"kind": "port", "id": "peripheral_command"}, "max": 0.45, "unit": "V", "operating_cases": ["logic_levels"]},
      {"id": "rising_latency", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "command_input"}, "observation": {"kind": "port", "id": "peripheral_command"}, "max": 2e-7, "unit": "s", "operating_cases": ["command_edges"]},
      {"id": "output_rise", "metric": "rise_time", "analysis": "transient", "observation": {"kind": "port", "id": "peripheral_command"}, "max": 1.2e-7, "unit": "s", "operating_cases": ["command_edges"]},
      {"id": "output_fall", "metric": "fall_time", "analysis": "transient", "observation": {"kind": "port", "id": "peripheral_command"}, "max": 1.2e-7, "unit": "s", "operating_cases": ["command_edges"]},
      {"id": "idle_draw", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "peripheral_power"}, "max": 0.0015, "unit": "A", "operating_cases": ["logic_levels"]}
    ],
    "constraints": {"max_components": 12, "max_width_mm": 25, "max_height_mm": 18}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
