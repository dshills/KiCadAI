{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name":"compact_supply_stage","title":"Regulated low-voltage energy stage","description":"Study a bounded energy-conversion interface that maintains a low-voltage output through line, load, startup, and temperature variations."},
  "requirements": {
    "domains": [
      {"id":"power_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"source_rail","kind":"supply","min_voltage_v":8,"nominal_voltage_v":12,"max_voltage_v":16,"max_current_a":1.0,"source":"external"},
      {"id":"regulated_rail","kind":"supply","min_voltage_v":3.15,"nominal_voltage_v":3.3,"max_voltage_v":3.45,"max_current_a":1.5,"source":"external"}
    ],
    "ports": [
      {"id":"energy_input","kind":"power","direction":"sink","domain":"source_rail","electrical":{"min_voltage_v":8,"nominal_voltage_v":12,"max_voltage_v":16,"max_current_a":1.0}},
      {"id":"energy_output","kind":"power","direction":"source","domain":"regulated_rail","electrical":{"min_voltage_v":3.15,"nominal_voltage_v":3.3,"max_voltage_v":3.45,"max_current_a":1.5}},
      {"id":"run_control","kind":"digital","direction":"sink","domain":"regulated_rail","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.45,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"return_path","kind":"reference","direction":"bidirectional","domain":"power_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"line_and_load","conditions":[{"axis":"supply_voltage","target":"source_rail","min":8,"max":16,"unit":"V"},{"axis":"load_current","target":"energy_output","min":0.05,"max":1.5,"unit":"A"},{"axis":"ambient_temperature","target":"return_path","min":-10,"max":75,"unit":"degC"},{"axis":"tolerance_corner","target":"energy_output","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"output_load_step","conditions":[{"axis":"supply_voltage","target":"source_rail","min":10,"max":14,"unit":"V"},{"axis":"load_current","target":"energy_output","min":0.1,"max":1.2,"unit":"A"},{"axis":"load_capacitance","target":"energy_output","min":0.000022,"max":0.00047,"unit":"F"}],"events":[{"id":"demand_change","kind":"load_step","target":"energy_output","trigger_time_s":0.002,"initial":0.1,"applied":1.2,"unit":"A"}]},
      {"id":"energization","conditions":[{"axis":"supply_voltage","target":"source_rail","min":8,"max":16,"unit":"V"},{"axis":"load_current","target":"energy_output","min":0.05,"max":0.5,"unit":"A"},{"axis":"model_corner","target":"energy_output","min":-1,"max":1,"unit":"ratio"}],"events":[{"id":"source_applied","kind":"startup","target":"energy_input","trigger_time_s":0,"initial":0,"applied":12,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"regulated_level","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"domain","id":"source_rail"},"observation":{"kind":"port","id":"energy_output"},"min":3.2,"max":3.4,"unit":"V","operating_cases":["line_and_load"],"critical":true},
      {"id":"line_stability","metric":"line_regulation","analysis":"dc_sweep","excitation":{"kind":"domain","id":"source_rail"},"observation":{"kind":"port","id":"energy_output"},"max":0.02,"unit":"V","operating_cases":["line_and_load"]},
      {"id":"load_stability","metric":"load_regulation","analysis":"dc_sweep","excitation":{"kind":"port","id":"energy_output"},"observation":{"kind":"port","id":"energy_output"},"max":0.04,"unit":"V","operating_cases":["line_and_load"]},
      {"id":"energy_transfer","metric":"conversion_efficiency","analysis":"dc_operating_point","observation":{"kind":"circuit","id":"energy_transfer"},"min":82,"unit":"%","operating_cases":["line_and_load"]},
      {"id":"steady_ripple","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"energy_output"},"max":0.06,"unit":"V_pp","operating_cases":["line_and_load"]},
      {"id":"demand_recovery","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"energy_output"},"observation":{"kind":"port","id":"energy_output"},"max":0.001,"unit":"s","operating_cases":["output_load_step"],"critical":true},
      {"id":"startup_peak","metric":"startup_overshoot","analysis":"startup","excitation":{"kind":"port","id":"energy_input"},"observation":{"kind":"port","id":"energy_output"},"max":0.2,"unit":"V","operating_cases":["energization"],"critical":true},
      {"id":"thermal_ceiling","metric":"junction_temperature","analysis":"electrothermal","observation":{"kind":"circuit","id":"thermal_behavior"},"max":125,"unit":"degC","operating_cases":["line_and_load"],"critical":true}
    ],
    "constraints": {"max_components":28,"max_width_mm":45,"max_height_mm":38}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
