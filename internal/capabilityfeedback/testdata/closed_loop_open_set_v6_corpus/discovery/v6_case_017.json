{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name":"slow_signal_conditioner","title":"Low-level source signal conditioner","description":"Study an interface that presents high impedance to a low-level voltage source and supplies a quiet, bounded output over slow environmental and source changes."},
  "requirements": {
    "domains": [
      {"id":"measurement_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"measurement_supply","kind":"supply","min_voltage_v":2.7,"nominal_voltage_v":3.0,"max_voltage_v":3.3,"max_current_a":0.02,"source":"external"}
    ],
    "ports": [
      {"id":"sensor_voltage","kind":"analog_voltage","direction":"sink","domain":"measurement_return","electrical":{"min_voltage_v":0.01,"nominal_voltage_v":0.2,"max_voltage_v":0.45,"input_impedance_min_ohm":5000000}},
      {"id":"conditioned_voltage","kind":"analog_voltage","direction":"source","domain":"measurement_supply","electrical":{"min_voltage_v":0.05,"nominal_voltage_v":1.5,"max_voltage_v":2.95,"max_current_a":0.001}},
      {"id":"sensor_bias","kind":"controlled_current","direction":"source","domain":"measurement_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.5,"max_voltage_v":3.3,"max_current_a":0.0002}},
      {"id":"measurement_power","kind":"power","direction":"sink","domain":"measurement_supply","electrical":{"min_voltage_v":2.7,"nominal_voltage_v":3.0,"max_voltage_v":3.3,"max_current_a":0.02}},
      {"id":"measurement_common","kind":"reference","direction":"bidirectional","domain":"measurement_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"slow_input_span","conditions":[{"axis":"input_voltage","target":"sensor_voltage","min":0.02,"max":0.4,"unit":"V"},{"axis":"supply_voltage","target":"measurement_supply","min":2.7,"max":3.3,"unit":"V"},{"axis":"ambient_temperature","target":"measurement_common","min":-40,"max":100,"unit":"degC"},{"axis":"tolerance_corner","target":"conditioned_voltage","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"quiet_center","conditions":[{"axis":"input_voltage","target":"sensor_voltage","min":0.2,"max":0.2,"unit":"V"},{"axis":"supply_voltage","target":"measurement_supply","min":2.9,"max":3.1,"unit":"V"},{"axis":"load_resistance","target":"conditioned_voltage","min":50000,"max":1000000,"unit":"ohm"},{"axis":"model_corner","target":"conditioned_voltage","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"sensor_change","conditions":[{"axis":"input_voltage","target":"sensor_voltage","min":0.1,"max":0.3,"unit":"V"},{"axis":"load_capacitance","target":"conditioned_voltage","min":0.000000001,"max":0.0000001,"unit":"F"},{"axis":"supply_voltage","target":"measurement_supply","min":2.7,"max":3.3,"unit":"V"}],"events":[{"id":"sensed_step","kind":"input_step","target":"sensor_voltage","trigger_time_s":0.01,"initial":0.1,"applied":0.3,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"source_loading","metric":"input_impedance","analysis":"dc_operating_point","observation":{"kind":"port","id":"sensor_voltage"},"min":5000000,"unit":"ohm","operating_cases":["slow_input_span"],"critical":true},
      {"id":"signal_scaling","metric":"voltage_gain","analysis":"dc_sweep","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"conditioned_voltage"},"min":5.8,"max":6.2,"unit":"ratio","operating_cases":["slow_input_span"],"critical":true},
      {"id":"slow_band_edge","metric":"cutoff_frequency","analysis":"ac_sweep","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"conditioned_voltage"},"min":70,"max":130,"unit":"Hz","operating_cases":["quiet_center"]},
      {"id":"baseband_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"conditioned_voltage"},"max":0.0015,"unit":"V_rms","frequency_hz":100,"operating_cases":["quiet_center"]},
      {"id":"bias_current","metric":"output_current","analysis":"dc_operating_point","observation":{"kind":"port","id":"sensor_bias"},"min":0.00009,"max":0.00011,"unit":"A","operating_cases":["slow_input_span"]},
      {"id":"change_response","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"conditioned_voltage"},"max":0.02,"unit":"s","operating_cases":["sensor_change"]}
    ],
    "constraints": {"max_components":22,"max_width_mm":28,"max_height_mm":34}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
