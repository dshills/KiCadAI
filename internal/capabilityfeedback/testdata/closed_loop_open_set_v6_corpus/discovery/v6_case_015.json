{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name":"wide_level_decision","title":"Wide-range logic decision interface","description":"Study a logic interface that accepts a variable-amplitude input and produces a defined output with noise-resistant switching and bounded timing."},
  "requirements": {
    "domains": [
      {"id":"logic_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"logic_supply","kind":"supply","min_voltage_v":1.8,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"max_current_a":0.03,"source":"external"}
    ],
    "ports": [
      {"id":"logic_input","kind":"digital","direction":"sink","domain":"logic_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"logic_output","kind":"digital","direction":"source","domain":"logic_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"max_current_a":0.008,"default_state":"low"}},
      {"id":"logic_power","kind":"power","direction":"sink","domain":"logic_supply","electrical":{"min_voltage_v":1.8,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"max_current_a":0.03}},
      {"id":"logic_common","kind":"reference","direction":"bidirectional","domain":"logic_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"threshold_sweep","conditions":[{"axis":"input_voltage","target":"logic_input","min":0,"max":5.5,"unit":"V"},{"axis":"supply_voltage","target":"logic_supply","min":1.8,"max":5.5,"unit":"V"},{"axis":"ambient_temperature","target":"logic_common","min":-30,"max":85,"unit":"degC"},{"axis":"tolerance_corner","target":"logic_output","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"rising_transition","conditions":[{"axis":"input_voltage","target":"logic_input","min":0,"max":3.3,"unit":"V"},{"axis":"supply_voltage","target":"logic_supply","min":3.0,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"logic_output","min":0.00000000001,"max":0.0000000001,"unit":"F"}],"events":[{"id":"input_rises","kind":"input_step","target":"logic_input","trigger_time_s":0.000001,"initial":0,"applied":3.3,"unit":"V"}]},
      {"id":"falling_transition","conditions":[{"axis":"input_voltage","target":"logic_input","min":0,"max":3.3,"unit":"V"},{"axis":"supply_voltage","target":"logic_supply","min":3.0,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"logic_output","min":0.00000000001,"max":0.0000000001,"unit":"F"}],"events":[{"id":"input_falls","kind":"input_step","target":"logic_input","trigger_time_s":0.000001,"initial":3.3,"applied":0,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"upward_switch","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"min":0.56,"max":0.7,"unit":"ratio","operating_cases":["threshold_sweep"],"critical":true},
      {"id":"downward_switch","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"min":0.3,"max":0.44,"unit":"ratio","operating_cases":["threshold_sweep"],"critical":true},
      {"id":"noise_window","metric":"hysteresis","analysis":"dc_sweep","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"min":0.12,"unit":"ratio","operating_cases":["threshold_sweep"]},
      {"id":"asserted_level","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"logic_output"},"min":0.82,"unit":"ratio","operating_cases":["threshold_sweep"]},
      {"id":"deasserted_level","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"logic_output"},"max":0.12,"unit":"ratio","operating_cases":["threshold_sweep"]},
      {"id":"rising_response","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"max":0.0000005,"unit":"s","operating_cases":["rising_transition"],"critical":true},
      {"id":"falling_response","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"max":0.0000005,"unit":"s","operating_cases":["falling_transition"],"critical":true}
    ],
    "constraints": {"max_components":12,"max_width_mm":22,"max_height_mm":18}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
