{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_level_data_bridge",
    "title": "Dual-Level Data Bridge",
    "description": "Transfer a unidirectional logic signal between two externally powered voltage ranges with bounded thresholds, delay, and disabled-rail behavior."
  },
  "requirements": {
    "domains": [
      {"id": "logic_return", "kind": "reference", "source": "external"},
      {"id": "low_logic_supply", "kind": "supply", "min_voltage_v": 1.71, "nominal_voltage_v": 1.8, "max_voltage_v": 1.89, "max_current_a": 0.02, "source": "external"},
      {"id": "high_logic_supply", "kind": "supply", "min_voltage_v": 3.0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.03, "source": "external"}
    ],
    "ports": [
      {"id": "low_side_data", "kind": "digital", "direction": "sink", "domain": "low_logic_supply", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 0.9, "max_voltage_v": 1.89, "input_impedance_min_ohm": 100000.0, "default_state": "low"}},
      {"id": "high_side_data", "kind": "digital", "direction": "source", "domain": "high_logic_supply", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.008}},
      {"id": "bridge_enable", "kind": "digital", "direction": "sink", "domain": "low_logic_supply", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 1.8, "max_voltage_v": 1.89, "input_impedance_min_ohm": 100000.0, "default_state": "low"}},
      {"id": "logic_common", "kind": "reference", "direction": "bidirectional", "domain": "logic_return", "electrical": {"nominal_voltage_v": 0.0}}
    ],
    "operating_cases": [
      {
        "id": "enabled_corners",
        "conditions": [
          {"axis": "supply_voltage", "target": "low_logic_supply", "min": 1.71, "max": 1.89, "unit": "V"},
          {"axis": "supply_voltage", "target": "high_logic_supply", "min": 3.0, "max": 3.6, "unit": "V"},
          {"axis": "ambient_temperature", "target": "high_side_data", "min": -40.0, "max": 85.0, "unit": "degC"},
          {"axis": "load_capacitance", "target": "high_side_data", "min": 0.00000000001, "max": 0.00000000005, "unit": "F"},
          {"axis": "tolerance_corner", "target": "low_side_data", "min": -1.0, "max": 1.0, "unit": "ratio"}
        ],
        "events": [
          {"id": "logic_transition", "kind": "input_step", "target": "low_side_data", "trigger_time_s": 0.000001, "initial": 0.0, "applied": 1.8, "unit": "V"}
        ]
      },
      {
        "id": "upper_rail_absent",
        "conditions": [
          {"axis": "supply_voltage", "target": "low_logic_supply", "min": 1.71, "max": 1.89, "unit": "V"},
          {"axis": "ambient_temperature", "target": "high_side_data", "min": -20.0, "max": 70.0, "unit": "degC"}
        ],
        "events": [
          {"id": "upper_rail_removed", "kind": "rail_loss", "target": "high_side_data", "trigger_time_s": 0.000002, "initial": 3.3, "applied": 0.0, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "valid_high", "metric": "output_high_voltage", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "low_side_data"}, "observation": {"kind": "port", "id": "high_side_data"}, "min": 2.7, "max": 3.6, "unit": "V", "operating_cases": ["enabled_corners"], "critical": true},
      {"id": "valid_low", "metric": "output_low_voltage", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "low_side_data"}, "observation": {"kind": "port", "id": "high_side_data"}, "min": 0.0, "max": 0.3, "unit": "V", "operating_cases": ["enabled_corners"], "critical": true},
      {"id": "switching_threshold", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "low_side_data"}, "observation": {"kind": "port", "id": "high_side_data"}, "min": 0.95, "max": 1.25, "unit": "V", "operating_cases": ["enabled_corners"]},
      {"id": "forward_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "low_side_data"}, "observation": {"kind": "port", "id": "high_side_data"}, "max": 0.00000012, "unit": "s", "operating_cases": ["enabled_corners"]},
      {"id": "unpowered_leakage", "metric": "off_state_current", "analysis": "transient", "observation": {"kind": "port", "id": "high_side_data"}, "max": 0.00001, "unit": "A", "operating_cases": ["upper_rail_absent"], "critical": true}
    ],
    "constraints": {"max_components": 12, "max_width_mm": 28.0, "max_height_mm": 18.0}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
