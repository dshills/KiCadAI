{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_level_annunciator",
    "title": "Dual-Boundary Logic Annunciator",
    "description": "Study a logic-output assembly that identifies whether an externally observed voltage has crossed either boundary of an allowed interval, with defined hysteresis and transition timing."
  },
  "requirements": {
    "domains": [
      {"id": "logic_return", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "logic_energy", "kind": "supply", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.03, "source": "external"}
    ],
    "ports": [
      {"id": "observed_level", "kind": "analog_voltage", "direction": "sink", "domain": "logic_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.65, "max_voltage_v": 3.3, "input_impedance_min_ohm": 100000}},
      {"id": "below_interval", "kind": "digital", "direction": "source", "domain": "logic_energy", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.004, "default_state": "low"}},
      {"id": "above_interval", "kind": "digital", "direction": "source", "domain": "logic_energy", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.004, "default_state": "low"}},
      {"id": "logic_power", "kind": "power", "direction": "sink", "domain": "logic_energy", "electrical": {"min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.03}},
      {"id": "logic_common", "kind": "reference", "direction": "bidirectional", "domain": "logic_return", "electrical": {"nominal_voltage_v": 0, "max_current_a": 0.04}}
    ],
    "operating_cases": [
      {"id": "boundary_sweep", "conditions": [
        {"axis": "input_voltage", "target": "observed_level", "min": 0, "max": 3.3, "unit": "V"},
        {"axis": "supply_voltage", "target": "logic_energy", "min": 3, "max": 3.6, "unit": "V"},
        {"axis": "ambient_temperature", "target": "observed_level", "min": -40, "max": 85, "unit": "degC"},
        {"axis": "tolerance_corner", "target": "observed_level", "min": -1, "max": 1, "unit": "%"}
      ]},
      {"id": "fast_crossing", "conditions": [
        {"axis": "load_capacitance", "target": "above_interval", "min": 0, "max": 5e-10, "unit": "F"},
        {"axis": "model_corner", "target": "above_interval", "min": -1, "max": 1, "unit": "ratio"}
      ], "events": [
        {"id": "upper_crossing", "kind": "input_step", "target": "observed_level", "trigger_time_s": 0.000002, "initial": 2.1, "applied": 2.8, "unit": "V"},
        {"id": "lower_crossing", "kind": "input_step", "target": "observed_level", "trigger_time_s": 0.000006, "initial": 1.2, "applied": 0.5, "unit": "V"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "low_trip_point", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "observed_level"}, "observation": {"kind": "port", "id": "below_interval"}, "min": 0.72, "max": 0.88, "unit": "V", "operating_cases": ["boundary_sweep"], "critical": true},
      {"id": "high_trip_point", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "observed_level"}, "observation": {"kind": "port", "id": "above_interval"}, "min": 2.42, "max": 2.58, "unit": "V", "operating_cases": ["boundary_sweep"], "critical": true},
      {"id": "low_boundary_memory", "metric": "hysteresis", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "below_interval"}, "min": 0.025, "max": 0.09, "unit": "V", "operating_cases": ["boundary_sweep"]},
      {"id": "high_boundary_memory", "metric": "hysteresis", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "above_interval"}, "min": 0.025, "max": 0.09, "unit": "V", "operating_cases": ["boundary_sweep"]},
      {"id": "asserted_level", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "above_interval"}, "min": 2.7, "unit": "V", "operating_cases": ["boundary_sweep"]},
      {"id": "crossing_response", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "observed_level"}, "observation": {"kind": "port", "id": "above_interval"}, "max": 0.00001, "unit": "s", "operating_cases": ["fast_crossing"], "critical": true}
    ],
    "constraints": {"max_components": 16, "max_width_mm": 30, "max_height_mm": 22}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
