{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "current_pulse_encoder",
    "title": "Current-to-Pulse Measurement Encoder",
    "description": "Study a mixed-signal assembly that converts a unipolar measurement current into a periodic logic waveform whose duty cycle represents input magnitude over defined corners."
  },
  "requirements": {
    "domains": [
      {"id": "measurement_return", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "encoder_supply", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.06, "source": "external"}
    ],
    "ports": [
      {"id": "measurement_current", "kind": "analog_current", "direction": "sink", "domain": "measurement_return", "electrical": {"min_voltage_v": 0, "max_voltage_v": 1, "max_current_a": 0.022}},
      {"id": "encoded_pulses", "kind": "digital", "direction": "source", "domain": "encoder_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.006, "default_state": "low"}},
      {"id": "encoder_power", "kind": "power", "direction": "sink", "domain": "encoder_supply", "electrical": {"min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.06}},
      {"id": "measurement_common", "kind": "reference", "direction": "bidirectional", "domain": "measurement_return", "electrical": {"nominal_voltage_v": 0, "max_current_a": 0.09}}
    ],
    "operating_cases": [
      {"id": "encoding_span", "conditions": [
        {"axis": "input_current", "target": "measurement_current", "min": 0.004, "max": 0.02, "unit": "A"},
        {"axis": "supply_voltage", "target": "encoder_supply", "min": 4.5, "max": 5.5, "unit": "V"},
        {"axis": "ambient_temperature", "target": "encoded_pulses", "min": -20, "max": 75, "unit": "degC"},
        {"axis": "tolerance_corner", "target": "measurement_current", "min": -1, "max": 1, "unit": "%"}
      ]},
      {"id": "changing_measurement", "conditions": [
        {"axis": "input_current", "target": "measurement_current", "min": 0.004, "max": 0.02, "unit": "A"},
        {"axis": "load_capacitance", "target": "encoded_pulses", "min": 0, "max": 1e-9, "unit": "F"},
        {"axis": "model_corner", "target": "encoded_pulses", "min": -1, "max": 1, "unit": "ratio"}
      ], "events": [
        {"id": "measurement_jump", "kind": "input_step", "target": "measurement_current", "trigger_time_s": 0.002, "initial": 0.006, "applied": 0.018, "unit": "A"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "lower_current_boundary", "metric": "threshold_current", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "measurement_current"}, "observation": {"kind": "port", "id": "encoded_pulses"}, "min": 0.0038, "max": 0.0042, "unit": "A", "operating_cases": ["encoding_span"], "critical": true},
      {"id": "span_encoding", "metric": "duty_cycle", "analysis": "transient", "excitation": {"kind": "port", "id": "measurement_current"}, "observation": {"kind": "port", "id": "encoded_pulses"}, "min": 10, "max": 90, "unit": "%", "operating_cases": ["encoding_span"], "critical": true},
      {"id": "carrier_rate", "metric": "oscillation_frequency", "analysis": "transient", "observation": {"kind": "port", "id": "encoded_pulses"}, "min": 18000, "max": 22000, "unit": "Hz", "operating_cases": ["encoding_span"]},
      {"id": "logic_assertion", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "encoded_pulses"}, "min": 4, "unit": "V", "operating_cases": ["encoding_span"]},
      {"id": "logic_release", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "encoded_pulses"}, "max": 0.4, "unit": "V", "operating_cases": ["encoding_span"]},
      {"id": "encoding_response", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "measurement_current"}, "observation": {"kind": "port", "id": "encoded_pulses"}, "max": 0.001, "unit": "s", "operating_cases": ["changing_measurement"], "critical": true}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 40, "max_height_mm": 28}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
