{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "supply_readiness_guard",
    "title": "Supply Readiness Guard",
    "description": "Qualify a monitored low-voltage rail, issue a deterministic logic indication, and provide a proportional analog readback across environmental conditions."
  },
  "requirements": {
    "domains": [
      {"id": "control_return", "kind": "reference", "source": "external"},
      {"id": "control_supply", "kind": "supply", "min_voltage_v": 2.7, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.012, "source": "external"}
    ],
    "ports": [
      {"id": "monitored_rail", "kind": "analog_voltage", "direction": "sink", "domain": "control_return", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 3.0, "max_voltage_v": 3.6, "input_impedance_min_ohm": 200000.0}},
      {"id": "ready_signal", "kind": "digital", "direction": "source", "domain": "control_supply", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.004, "default_state": "low"}},
      {"id": "scaled_monitor", "kind": "analog_voltage", "direction": "source", "domain": "control_return", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 1.5, "max_voltage_v": 1.9, "max_current_a": 0.002}},
      {"id": "qualification_hold", "kind": "digital", "direction": "sink", "domain": "control_supply", "electrical": {"min_voltage_v": 0.0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "input_impedance_min_ohm": 100000.0, "default_state": "low"}},
      {"id": "control_power", "kind": "power", "direction": "sink", "domain": "control_supply", "electrical": {"min_voltage_v": 2.7, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.012}},
      {"id": "control_common", "kind": "reference", "direction": "bidirectional", "domain": "control_return", "electrical": {"nominal_voltage_v": 0.0}}
    ],
    "operating_cases": [
      {
        "id": "rail_ramp",
        "conditions": [
          {"axis": "supply_voltage", "target": "control_supply", "min": 2.7, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "monitored_rail", "min": 0.0, "max": 3.6, "unit": "V"},
          {"axis": "ambient_temperature", "target": "ready_signal", "min": -20.0, "max": 85.0, "unit": "degC"},
          {"axis": "tolerance_corner", "target": "monitored_rail", "min": -1.0, "max": 1.0, "unit": "ratio"},
          {"axis": "load_resistance", "target": "scaled_monitor", "min": 10000.0, "max": 1000000.0, "unit": "ohm"}
        ],
        "events": [
          {"id": "monitored_rise", "kind": "input_step", "target": "monitored_rail", "trigger_time_s": 0.002, "initial": 2.2, "applied": 3.2, "unit": "V"}
        ]
      },
      {
        "id": "rail_decline",
        "conditions": [
          {"axis": "supply_voltage", "target": "control_supply", "min": 2.7, "max": 3.6, "unit": "V"},
          {"axis": "load_capacitance", "target": "ready_signal", "min": 0.0, "max": 0.0000000001, "unit": "F"}
        ],
        "events": [
          {"id": "monitored_fall", "kind": "input_step", "target": "monitored_rail", "trigger_time_s": 0.003, "initial": 3.2, "applied": 2.2, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "assert_threshold", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_rail"}, "observation": {"kind": "port", "id": "ready_signal"}, "min": 2.85, "max": 3.0, "unit": "V", "operating_cases": ["rail_ramp"], "critical": true},
      {"id": "release_threshold", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_rail"}, "observation": {"kind": "port", "id": "ready_signal"}, "min": 2.55, "max": 2.72, "unit": "V", "operating_cases": ["rail_decline"], "critical": true},
      {"id": "threshold_separation", "metric": "hysteresis", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_rail"}, "observation": {"kind": "port", "id": "ready_signal"}, "min": 0.13, "max": 0.45, "unit": "V", "operating_cases": ["rail_ramp", "rail_decline"]},
      {"id": "indication_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "monitored_rail"}, "observation": {"kind": "port", "id": "ready_signal"}, "min": 0.00005, "max": 0.001, "unit": "s", "operating_cases": ["rail_ramp", "rail_decline"]},
      {"id": "readback_gain", "metric": "voltage_gain", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_rail"}, "observation": {"kind": "port", "id": "scaled_monitor"}, "min": 0.49, "max": 0.51, "unit": "ratio", "operating_cases": ["rail_ramp"], "critical": true},
      {"id": "control_draw", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "control_power"}, "max": 0.002, "unit": "A", "operating_cases": ["rail_ramp"]}
    ],
    "constraints": {"max_components": 14, "max_width_mm": 32.0, "max_height_mm": 20.0}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
