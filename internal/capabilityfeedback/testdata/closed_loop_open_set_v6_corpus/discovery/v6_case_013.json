{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bidirectional_current_reader",
    "title": "Low-noise bidirectional current reader",
    "description": "Study an interface that converts a small signed input current into a bounded voltage while retaining useful dynamic response across specified external conditions."
  },
  "requirements": {
    "domains": [
      {"id":"signal_reference","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"five_volt_supply","kind":"supply","min_voltage_v":4.75,"nominal_voltage_v":5.0,"max_voltage_v":5.25,"max_current_a":0.08,"source":"external"}
    ],
    "ports": [
      {"id":"sense_current","kind":"analog_current","direction":"sink","domain":"signal_reference","electrical":{"min_voltage_v":0.2,"nominal_voltage_v":2.5,"max_voltage_v":4.8,"max_current_a":0.00006}},
      {"id":"reader_output","kind":"analog_voltage","direction":"source","domain":"signal_reference","electrical":{"min_voltage_v":0.2,"nominal_voltage_v":2.5,"max_voltage_v":4.8,"max_current_a":0.002}},
      {"id":"upper_range_indicator","kind":"digital","direction":"source","domain":"five_volt_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":5.0,"max_voltage_v":5.25,"max_current_a":0.004,"default_state":"low"}},
      {"id":"supply_input","kind":"power","direction":"sink","domain":"five_volt_supply","electrical":{"min_voltage_v":4.75,"nominal_voltage_v":5.0,"max_voltage_v":5.25,"max_current_a":0.08}},
      {"id":"common_return","kind":"reference","direction":"bidirectional","domain":"signal_reference","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"centered_input","conditions":[{"axis":"input_current","target":"sense_current","min":0,"max":0,"unit":"A"},{"axis":"supply_voltage","target":"five_volt_supply","min":4.75,"max":5.25,"unit":"V"},{"axis":"ambient_temperature","target":"common_return","min":-20,"max":70,"unit":"degC"},{"axis":"tolerance_corner","target":"reader_output","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"signed_current_range","conditions":[{"axis":"input_current","target":"sense_current","min":-0.00004,"max":0.00004,"unit":"A"},{"axis":"supply_voltage","target":"five_volt_supply","min":4.75,"max":5.25,"unit":"V"},{"axis":"model_corner","target":"reader_output","min":-1,"max":1,"unit":"ratio"},{"axis":"load_resistance","target":"reader_output","min":10000,"max":100000,"unit":"ohm"}]},
      {"id":"positive_current_step","conditions":[{"axis":"input_current","target":"sense_current","min":0,"max":0.00002,"unit":"A"},{"axis":"load_capacitance","target":"reader_output","min":0.00000000005,"max":0.000000001,"unit":"F"},{"axis":"supply_voltage","target":"five_volt_supply","min":4.75,"max":5.25,"unit":"V"}],"events":[{"id":"current_transition","kind":"input_step","target":"sense_current","trigger_time_s":0.001,"initial":0,"applied":0.00002,"unit":"A"}]},
      {"id":"upper_range_sweep","conditions":[{"axis":"input_current","target":"sense_current","min":0.00003,"max":0.000055,"unit":"A"},{"axis":"supply_voltage","target":"five_volt_supply","min":4.75,"max":5.25,"unit":"V"},{"axis":"ambient_temperature","target":"common_return","min":-20,"max":70,"unit":"degC"},{"axis":"tolerance_corner","target":"upper_range_indicator","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"positive_overrange","conditions":[{"axis":"input_current","target":"sense_current","min":0.00005,"max":0.000055,"unit":"A"},{"axis":"supply_voltage","target":"five_volt_supply","min":4.75,"max":5.25,"unit":"V"},{"axis":"load_current","target":"upper_range_indicator","min":0.0001,"max":0.004,"unit":"A"},{"axis":"model_corner","target":"upper_range_indicator","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"upper_range_step","conditions":[{"axis":"input_current","target":"sense_current","min":0.00002,"max":0.00005,"unit":"A"},{"axis":"supply_voltage","target":"five_volt_supply","min":4.75,"max":5.25,"unit":"V"},{"axis":"load_capacitance","target":"upper_range_indicator","min":0.00000000001,"max":0.000000001,"unit":"F"}],"events":[{"id":"range_crossing","kind":"input_step","target":"sense_current","trigger_time_s":0.001,"initial":0.00002,"applied":0.00005,"unit":"A"}]}
    ],
    "behavioral_requirements": [
      {"id":"center_level","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"reader_output"},"min":2.4,"max":2.6,"unit":"V","operating_cases":["centered_input"],"critical":true},
      {"id":"current_conversion","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"reader_output"},"min":47000,"max":53000,"unit":"V/A","operating_cases":["signed_current_range"],"critical":true},
      {"id":"usable_span","metric":"output_swing","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"reader_output"},"min":3.7,"unit":"V_pp","operating_cases":["signed_current_range"]},
      {"id":"small_signal_width","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"reader_output"},"min":12000,"unit":"Hz","operating_cases":["signed_current_range"]},
      {"id":"integrated_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"reader_output"},"max":0.003,"unit":"V_rms","frequency_hz":10000,"operating_cases":["centered_input"]},
      {"id":"step_recovery","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"reader_output"},"max":0.00015,"unit":"s","operating_cases":["positive_current_step"],"critical":true},
      {"id":"range_trip_current","metric":"threshold_current","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"upper_range_indicator"},"min":0.000042,"max":0.000046,"unit":"A","operating_cases":["upper_range_sweep"],"critical":true},
      {"id":"normal_range_level","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"upper_range_indicator"},"max":0.5,"unit":"V","operating_cases":["centered_input","signed_current_range"],"critical":true},
      {"id":"overrange_level","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"upper_range_indicator"},"min":4.0,"unit":"V","operating_cases":["positive_overrange"],"critical":true},
      {"id":"range_report_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"upper_range_indicator"},"max":0.00005,"unit":"s","operating_cases":["upper_range_step"],"critical":true}
    ],
    "constraints": {"max_components":18,"max_width_mm":32,"max_height_mm":24}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
