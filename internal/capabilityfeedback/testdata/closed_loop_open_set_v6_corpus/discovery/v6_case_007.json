{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "quiet_current_reader",
    "title": "Bidirectional Low-Current Measurement Interface",
    "description": "Study an externally powered assembly that converts a bounded bidirectional input current into a low-noise voltage while preserving useful small-signal response across supply and temperature corners."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "positive_bias", "kind": "supply", "min_voltage_v": 11.4, "nominal_voltage_v": 12, "max_voltage_v": 12.6, "max_current_a": 0.08, "source": "external"},
      {"id": "negative_bias", "kind": "supply", "min_voltage_v": -12.6, "nominal_voltage_v": -12, "max_voltage_v": -11.4, "max_current_a": 0.08, "source": "external"}
    ],
    "ports": [
      {"id": "measured_current", "kind": "analog_current", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": -0.02, "max_voltage_v": 0.02, "max_current_a": 0.0001}},
      {"id": "measurement_voltage", "kind": "analog_voltage", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": -8.5, "nominal_voltage_v": 0, "max_voltage_v": 8.5, "max_current_a": 0.002}},
      {"id": "positive_power", "kind": "power", "direction": "sink", "domain": "positive_bias", "electrical": {"min_voltage_v": 11.4, "nominal_voltage_v": 12, "max_voltage_v": 12.6, "max_current_a": 0.08}},
      {"id": "negative_power", "kind": "power", "direction": "sink", "domain": "negative_bias", "electrical": {"min_voltage_v": -12.6, "nominal_voltage_v": -12, "max_voltage_v": -11.4, "max_current_a": 0.08}},
      {"id": "return_connection", "kind": "reference", "direction": "bidirectional", "domain": "signal_return", "electrical": {"nominal_voltage_v": 0, "max_current_a": 0.16}}
    ],
    "operating_cases": [
      {"id": "precision_range", "conditions": [
        {"axis": "input_current", "target": "measured_current", "min": -0.00008, "max": 0.00008, "unit": "A"},
        {"axis": "ambient_temperature", "target": "measurement_voltage", "min": -20, "max": 70, "unit": "degC"},
        {"axis": "supply_voltage", "target": "positive_bias", "min": 11.4, "max": 12.6, "unit": "V"},
        {"axis": "supply_voltage", "target": "negative_bias", "min": -12.6, "max": -11.4, "unit": "V"},
        {"axis": "tolerance_corner", "target": "measured_current", "min": -1, "max": 1, "unit": "%"}
      ]},
      {"id": "dynamic_range", "conditions": [
        {"axis": "input_current", "target": "measured_current", "min": -0.00006, "max": 0.00006, "unit": "A"},
        {"axis": "load_capacitance", "target": "measurement_voltage", "min": 0, "max": 2e-9, "unit": "F"},
        {"axis": "model_corner", "target": "measurement_voltage", "min": -1, "max": 1, "unit": "ratio"}
      ], "events": [
        {"id": "current_reversal", "kind": "input_step", "target": "measured_current", "trigger_time_s": 0.001, "initial": -0.00005, "applied": 0.00005, "unit": "A"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "conversion_ratio", "metric": "transimpedance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 98000, "max": 102000, "unit": "V/A", "operating_cases": ["precision_range"], "critical": true},
      {"id": "usable_swing", "metric": "output_swing", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 15.6, "unit": "V_pp", "operating_cases": ["precision_range"]},
      {"id": "small_signal_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 18000, "unit": "Hz", "operating_cases": ["dynamic_range"]},
      {"id": "integrated_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "measurement_voltage"}, "max": 0.0025, "unit": "V_rms", "frequency_hz": 10000, "operating_cases": ["precision_range"]},
      {"id": "reversal_settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "max": 0.00012, "unit": "s", "operating_cases": ["dynamic_range"], "critical": true}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 38, "max_height_mm": 24}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
