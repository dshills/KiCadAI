{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "ratio_signal_conditioner",
    "title": "Ratiometric Sensor Signal Conditioner",
    "description": "Study an analog conditioning assembly that scales a bounded sensor voltage relative to an external reference while limiting noise and loading across environmental and tolerance corners."
  },
  "requirements": {
    "domains": [
      {"id": "sensor_return", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "conditioning_supply", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.04, "source": "external"}
    ],
    "ports": [
      {"id": "sensor_voltage", "kind": "analog_voltage", "direction": "sink", "domain": "sensor_return", "electrical": {"min_voltage_v": 0.15, "nominal_voltage_v": 1.25, "max_voltage_v": 2.35, "input_impedance_min_ohm": 1000000}},
      {"id": "reference_voltage", "kind": "analog_voltage", "direction": "sink", "domain": "sensor_return", "electrical": {"min_voltage_v": 2.45, "nominal_voltage_v": 2.5, "max_voltage_v": 2.55, "input_impedance_min_ohm": 500000}},
      {"id": "conditioned_voltage", "kind": "analog_voltage", "direction": "source", "domain": "sensor_return", "electrical": {"min_voltage_v": 0.2, "nominal_voltage_v": 2.5, "max_voltage_v": 4.8, "max_current_a": 0.003}},
      {"id": "conditioning_power", "kind": "power", "direction": "sink", "domain": "conditioning_supply", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.04}},
      {"id": "sensor_common", "kind": "reference", "direction": "bidirectional", "domain": "sensor_return", "electrical": {"nominal_voltage_v": 0, "max_current_a": 0.05}}
    ],
    "operating_cases": [
      {"id": "measurement_span", "conditions": [
        {"axis": "input_voltage", "target": "sensor_voltage", "min": 0.15, "max": 2.35, "unit": "V"},
        {"axis": "input_voltage", "target": "reference_voltage", "min": 2.45, "max": 2.55, "unit": "V"},
        {"axis": "supply_voltage", "target": "conditioning_supply", "min": 4.75, "max": 5.25, "unit": "V"},
        {"axis": "ambient_temperature", "target": "sensor_voltage", "min": -25, "max": 80, "unit": "degC"},
        {"axis": "tolerance_corner", "target": "conditioned_voltage", "min": -1, "max": 1, "unit": "%"}
      ]},
      {"id": "sampled_output", "conditions": [
        {"axis": "input_voltage", "target": "sensor_voltage", "min": 0.25, "max": 2.25, "unit": "V"},
        {"axis": "load_capacitance", "target": "conditioned_voltage", "min": 1e-10, "max": 5e-9, "unit": "F"},
        {"axis": "model_corner", "target": "conditioned_voltage", "min": -1, "max": 1, "unit": "ratio"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "scale_factor", "metric": "voltage_gain", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "sensor_voltage"}, "observation": {"kind": "port", "id": "conditioned_voltage"}, "min": 1.96, "max": 2.04, "unit": "ratio", "operating_cases": ["measurement_span"], "critical": true},
      {"id": "sensor_loading", "metric": "input_impedance", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "sensor_voltage"}, "min": 1000000, "unit": "ohm", "operating_cases": ["measurement_span"]},
      {"id": "conditioned_span", "metric": "output_voltage", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "conditioned_voltage"}, "min": 0.2, "max": 4.8, "unit": "V", "operating_cases": ["measurement_span"]},
      {"id": "measurement_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "conditioned_voltage"}, "max": 0.0012, "unit": "V_rms", "frequency_hz": 5000, "operating_cases": ["measurement_span"], "critical": true},
      {"id": "alias_limit", "metric": "cutoff_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "sensor_voltage"}, "observation": {"kind": "port", "id": "conditioned_voltage"}, "min": 700, "max": 1300, "unit": "Hz", "operating_cases": ["sampled_output"]},
      {"id": "capacitive_stability", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "circuit", "id": "signal_path"}, "min": 50, "unit": "deg", "operating_cases": ["sampled_output"]}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 34, "max_height_mm": 26}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
