{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name":"voltage_timed_output","title":"Voltage-controlled timing interface","description":"Study an interface that represents a bounded input voltage as a periodic logic waveform with controlled frequency, duty range, and output levels."},
  "requirements": {
    "domains": [
      {"id":"timing_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"timing_supply","kind":"supply","min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.05,"source":"external"}
    ],
    "ports": [
      {"id":"control_voltage","kind":"analog_voltage","direction":"sink","domain":"timing_supply","electrical":{"min_voltage_v":0.5,"nominal_voltage_v":2.5,"max_voltage_v":4.5,"input_impedance_min_ohm":200000}},
      {"id":"timed_output","kind":"digital","direction":"source","domain":"timing_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.006,"default_state":"low"}},
      {"id":"timing_enable","kind":"digital","direction":"sink","domain":"timing_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"timing_power","kind":"power","direction":"sink","domain":"timing_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.05}},
      {"id":"timing_common","kind":"reference","direction":"bidirectional","domain":"timing_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"control_sweep","conditions":[{"axis":"input_voltage","target":"control_voltage","min":0.5,"max":4.5,"unit":"V"},{"axis":"supply_voltage","target":"timing_supply","min":4.5,"max":5.5,"unit":"V"},{"axis":"ambient_temperature","target":"timing_common","min":0,"max":70,"unit":"degC"},{"axis":"tolerance_corner","target":"timed_output","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"enabled_start","conditions":[{"axis":"input_voltage","target":"control_voltage","min":2.45,"max":2.55,"unit":"V"},{"axis":"supply_voltage","target":"timing_supply","min":4.5,"max":5.5,"unit":"V"},{"axis":"load_capacitance","target":"timed_output","min":0.00000000001,"max":0.0000000002,"unit":"F"}],"events":[{"id":"enable_transition","kind":"input_step","target":"timing_enable","trigger_time_s":0.0001,"initial":0,"applied":5,"unit":"V"}]},
      {"id":"output_loading","conditions":[{"axis":"input_voltage","target":"control_voltage","min":1,"max":4,"unit":"V"},{"axis":"supply_voltage","target":"timing_supply","min":4.5,"max":5.5,"unit":"V"},{"axis":"load_current","target":"timed_output","min":0.0001,"max":0.006,"unit":"A"},{"axis":"model_corner","target":"timed_output","min":-1,"max":1,"unit":"ratio"}]}
    ],
    "behavioral_requirements": [
      {"id":"carrier_rate","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"control_voltage"},"observation":{"kind":"port","id":"timed_output"},"min":18000,"max":22000,"unit":"Hz","operating_cases":["control_sweep"],"critical":true},
      {"id":"encoded_duty","metric":"duty_cycle","analysis":"transient","excitation":{"kind":"port","id":"control_voltage"},"observation":{"kind":"port","id":"timed_output"},"min":10,"max":90,"unit":"%","operating_cases":["control_sweep"],"critical":true},
      {"id":"upper_logic_level","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"timed_output"},"min":4.0,"unit":"V","operating_cases":["output_loading"]},
      {"id":"lower_logic_level","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"timed_output"},"max":0.5,"unit":"V","operating_cases":["output_loading"]},
      {"id":"start_latency","metric":"propagation_delay","analysis":"startup","excitation":{"kind":"port","id":"timing_enable"},"observation":{"kind":"port","id":"timed_output"},"max":0.001,"unit":"s","operating_cases":["enabled_start"],"critical":true},
      {"id":"edge_ascent","metric":"rise_time","analysis":"transient","observation":{"kind":"port","id":"timed_output"},"max":0.000001,"unit":"s","operating_cases":["output_loading"]},
      {"id":"supply_demand","metric":"quiescent_current","analysis":"dc_operating_point","observation":{"kind":"port","id":"timing_power"},"max":0.025,"unit":"A","operating_cases":["control_sweep"]}
    ],
    "constraints": {"max_components":24,"max_width_mm":40,"max_height_mm":22}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
