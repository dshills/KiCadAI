{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_012",
    "title": "Analog-permission power output",
    "description": "Enable a bounded load current only when an analog request is within the permitted range, with safe startup and fault behavior."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 9,
        "nominal_voltage_v": 12,
        "max_voltage_v": 15,
        "max_current_a": 1,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "load_output",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.5
        }
      },
      {
        "id": "permission",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5,
          "max_current_a": 0.001
        }
      }
    ],
    "operating_cases": [
      {
        "id": "output_fault",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "load_output",
            "min": 0,
            "max": 60,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "short",
            "kind": "short_circuit",
            "target": "load_output",
            "trigger_time_s": 0.003,
            "initial": 4,
            "applied": 0,
            "unit": "V"
          }
        ]
      },
      {
        "id": "permission_change",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "request",
            "min": 1,
            "max": 4,
            "unit": "V"
          },
          {
            "axis": "load_resistance",
            "target": "load_output",
            "min": 10,
            "max": 30,
            "unit": "ohm"
          }
        ],
        "events": [
          {
            "id": "permit",
            "kind": "input_step",
            "target": "permission",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "fault_peak",
        "metric": "peak_current",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "load_output"
        },
        "max": 0.6,
        "unit": "A",
        "operating_cases": [
          "output_fault"
        ],
        "critical": true
      },
      {
        "id": "permission_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "permission"
        },
        "observation": {
          "kind": "port",
          "id": "load_output"
        },
        "max": 0.002,
        "unit": "s",
        "operating_cases": [
          "permission_change"
        ]
      },
      {
        "id": "requested_current",
        "metric": "output_current",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "request"
        },
        "observation": {
          "kind": "port",
          "id": "load_output"
        },
        "min": 0.35,
        "max": 0.45,
        "unit": "A",
        "operating_cases": [
          "permission_change"
        ],
        "critical": true
      },
      {
        "id": "startup_limit",
        "metric": "startup_current",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "load_output"
        },
        "max": 0.05,
        "unit": "A",
        "operating_cases": [
          "permission_change"
        ],
        "critical": true
      },
      {
        "id": "thermal_limit",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 120,
        "unit": "degC",
        "operating_cases": [
          "output_fault",
          "permission_change"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
