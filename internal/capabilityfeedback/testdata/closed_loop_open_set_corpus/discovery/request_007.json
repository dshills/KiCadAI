{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_007",
    "title": "Command and response logic interface",
    "description": "Convey an externally timed command to a response output with bounded thresholds, delay, and edge rates across supply variation."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 2.7,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.03,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "command_input",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "response_output",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.008
        }
      }
    ],
    "operating_cases": [
      {
        "id": "falling_command",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 2.7,
            "max": 3.6,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "command_fall",
            "kind": "input_step",
            "target": "command_input",
            "trigger_time_s": 0.001,
            "initial": 3.3,
            "applied": 0,
            "unit": "V"
          }
        ]
      },
      {
        "id": "rising_command",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "response_output",
            "min": 0,
            "max": 1e-9,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "command_rise",
            "kind": "input_step",
            "target": "command_input",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "command_input"
        },
        "observation": {
          "kind": "port",
          "id": "response_output"
        },
        "max": 0.000001,
        "unit": "s",
        "operating_cases": [
          "falling_command",
          "rising_command"
        ],
        "critical": true
      },
      {
        "id": "fall",
        "metric": "fall_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "command_input"
        },
        "observation": {
          "kind": "port",
          "id": "response_output"
        },
        "max": 5e-7,
        "unit": "s",
        "operating_cases": [
          "falling_command"
        ]
      },
      {
        "id": "high_level",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "response_output"
        },
        "min": 2.7,
        "unit": "V",
        "operating_cases": [
          "rising_command"
        ]
      },
      {
        "id": "low_level",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "response_output"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "falling_command"
        ]
      },
      {
        "id": "rise",
        "metric": "rise_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "command_input"
        },
        "observation": {
          "kind": "port",
          "id": "response_output"
        },
        "max": 5e-7,
        "unit": "s",
        "operating_cases": [
          "rising_command"
        ]
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
