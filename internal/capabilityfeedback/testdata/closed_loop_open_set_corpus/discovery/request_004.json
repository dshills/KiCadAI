{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_004",
    "title": "Bidirectional midpoint supply",
    "description": "Hold a midpoint voltage while alternately sourcing and sinking bounded load current, including startup and short-duration faults."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 10,
        "nominal_voltage_v": 12,
        "max_voltage_v": 14,
        "max_current_a": 0.5,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "load_demand",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.1
        }
      },
      {
        "id": "midpoint",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 6,
          "max_voltage_v": 12,
          "max_current_a": 0.2
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "bidirectional_load",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "midpoint",
            "min": 0,
            "max": 60,
            "unit": "degC"
          },
          {
            "axis": "load_current",
            "target": "midpoint",
            "min": -0.1,
            "max": 0.1,
            "unit": "A"
          }
        ]
      },
      {
        "id": "fault",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 10,
            "max": 14,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "short",
            "kind": "short_circuit",
            "target": "midpoint",
            "trigger_time_s": 0.002,
            "initial": 6,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "accuracy",
        "metric": "output_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "midpoint"
        },
        "min": 5.9,
        "max": 6.1,
        "unit": "V",
        "operating_cases": [
          "bidirectional_load"
        ],
        "critical": true
      },
      {
        "id": "area_margin",
        "metric": "soa_margin",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "minimum_soa_margin"
        },
        "min": 1.3,
        "unit": "ratio",
        "operating_cases": [
          "bidirectional_load",
          "fault"
        ],
        "critical": true
      },
      {
        "id": "fault_current",
        "metric": "peak_current",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "midpoint"
        },
        "max": 0.2,
        "unit": "A",
        "operating_cases": [
          "fault"
        ],
        "critical": true
      },
      {
        "id": "load_change",
        "metric": "load_regulation",
        "analysis": "dc_sweep",
        "observation": {
          "kind": "port",
          "id": "midpoint"
        },
        "max": 0.1,
        "unit": "V",
        "operating_cases": [
          "bidirectional_load"
        ]
      },
      {
        "id": "thermal_limit",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 125,
        "unit": "degC",
        "operating_cases": [
          "bidirectional_load",
          "fault"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
