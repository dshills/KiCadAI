{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_002",
    "title": "Low-current measurement transfer",
    "description": "Convert a small bidirectional input current into a bounded low-noise voltage over the stated signal band."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 8,
        "nominal_voltage_v": 9,
        "max_voltage_v": 10,
        "max_current_a": 0.04,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "measured_current",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.001
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "reported_voltage",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -2.5,
          "nominal_voltage_v": 0,
          "max_voltage_v": 2.5,
          "max_current_a": 0.005
        }
      }
    ],
    "operating_cases": [
      {
        "id": "change",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "reported_voltage",
            "min": 0,
            "max": 1e-9,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "current_step",
            "kind": "input_step",
            "target": "measured_current",
            "trigger_time_s": 0.001,
            "initial": -0.00005,
            "applied": 0.00005,
            "unit": "A"
          }
        ]
      },
      {
        "id": "measurement",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "reported_voltage",
            "min": 0,
            "max": 50,
            "unit": "degC"
          },
          {
            "axis": "input_current",
            "target": "measured_current",
            "min": -0.0001,
            "max": 0.0001,
            "unit": "A"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "reported_voltage"
        },
        "max": 0.002,
        "unit": "V_rms",
        "operating_cases": [
          "measurement"
        ]
      },
      {
        "id": "scale",
        "metric": "transimpedance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "reported_voltage"
        },
        "min": 9800,
        "max": 10200,
        "unit": "V/A",
        "operating_cases": [
          "measurement"
        ],
        "critical": true
      },
      {
        "id": "speed",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "reported_voltage"
        },
        "max": 0.0005,
        "unit": "s",
        "operating_cases": [
          "change"
        ]
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
