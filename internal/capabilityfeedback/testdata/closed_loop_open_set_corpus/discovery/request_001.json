{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_001",
    "title": "Bipolar precision level transfer",
    "description": "Translate a bounded bipolar input into a quiet positive output with controlled gain and dynamic response."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.05,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "input",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -1.2,
          "nominal_voltage_v": 0,
          "max_voltage_v": 1.2,
          "max_current_a": 0.001
        }
      },
      {
        "id": "output",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5,
          "max_current_a": 0.01
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "range",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "output",
            "min": -10,
            "max": 60,
            "unit": "degC"
          },
          {
            "axis": "input_voltage",
            "target": "input",
            "min": -1,
            "max": 1,
            "unit": "V"
          }
        ]
      },
      {
        "id": "step",
        "conditions": [
          {
            "axis": "load_resistance",
            "target": "output",
            "min": 10000,
            "max": 100000,
            "unit": "ohm"
          }
        ],
        "events": [
          {
            "id": "input_step",
            "kind": "input_step",
            "target": "input",
            "trigger_time_s": 0.001,
            "initial": -0.5,
            "applied": 0.5,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "band",
        "metric": "bandwidth",
        "analysis": "ac_sweep",
        "excitation": {
          "kind": "port",
          "id": "input"
        },
        "observation": {
          "kind": "port",
          "id": "output"
        },
        "min": 20000,
        "unit": "Hz",
        "operating_cases": [
          "range"
        ]
      },
      {
        "id": "gain",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "input"
        },
        "observation": {
          "kind": "port",
          "id": "output"
        },
        "min": 1.9,
        "max": 2.1,
        "unit": "ratio",
        "operating_cases": [
          "range"
        ],
        "critical": true
      },
      {
        "id": "quiet",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "output"
        },
        "max": 0.001,
        "unit": "V_rms",
        "operating_cases": [
          "range"
        ]
      },
      {
        "id": "response",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "input"
        },
        "observation": {
          "kind": "port",
          "id": "output"
        },
        "max": 0.0002,
        "unit": "s",
        "operating_cases": [
          "step"
        ]
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
