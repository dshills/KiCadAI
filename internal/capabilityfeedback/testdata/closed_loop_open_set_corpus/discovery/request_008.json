{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_008",
    "title": "Bidirectional two-line logic interface",
    "description": "Preserve externally driven low states and release both communication lines with bounded leakage and transition time."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 2.9,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.03,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "activity_status",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 3.6,
          "max_current_a": 0.005
        }
      },
      {
        "id": "clock_line",
        "kind": "digital",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.01,
          "default_state": "high"
        }
      },
      {
        "id": "data_line",
        "kind": "digital",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.01,
          "default_state": "high"
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "interface_enable",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.001,
          "default_state": "high"
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "clock_release",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "clock_line",
            "min": 1e-11,
            "max": 4e-10,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "release_clock",
            "kind": "input_step",
            "target": "clock_line",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      },
      {
        "id": "data_release",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "data_line",
            "min": 1e-11,
            "max": 4e-10,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "release_data",
            "kind": "input_step",
            "target": "data_line",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "clock_low",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "clock_line"
        },
        "max": 0.4,
        "unit": "V",
        "operating_cases": [
          "clock_release"
        ],
        "critical": true
      },
      {
        "id": "data_low",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "data_line"
        },
        "max": 0.4,
        "unit": "V",
        "operating_cases": [
          "data_release"
        ],
        "critical": true
      },
      {
        "id": "data_release_time",
        "metric": "rise_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "data_line"
        },
        "observation": {
          "kind": "port",
          "id": "data_line"
        },
        "max": 0.000002,
        "unit": "s",
        "operating_cases": [
          "data_release"
        ]
      },
      {
        "id": "released_leakage",
        "metric": "off_state_current",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "data_line"
        },
        "max": 0.00001,
        "unit": "A",
        "operating_cases": [
          "data_release"
        ]
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
