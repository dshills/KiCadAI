{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_011",
    "title": "Pulse-commanded average current",
    "description": "Deliver average load current according to an external pulse command while bounding ripple, enable recovery, temperature, and safe operating margin."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 10,
        "nominal_voltage_v": 12,
        "max_voltage_v": 14,
        "max_current_a": 1.2,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "average_current",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.8
        }
      },
      {
        "id": "enable",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "pulse_command",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      }
    ],
    "operating_cases": [
      {
        "id": "commanded",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "average_current",
            "min": 0,
            "max": 60,
            "unit": "degC"
          },
          {
            "axis": "load_resistance",
            "target": "average_current",
            "min": 8,
            "max": 25,
            "unit": "ohm"
          }
        ],
        "events": [
          {
            "id": "command_rise",
            "kind": "input_step",
            "target": "pulse_command",
            "trigger_time_s": 0.002,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          },
          {
            "id": "enable_rise",
            "kind": "input_step",
            "target": "enable",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "load_change",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 10,
            "max": 14,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "load_step",
            "kind": "load_step",
            "target": "average_current",
            "trigger_time_s": 0.003,
            "initial": 20,
            "applied": 10,
            "unit": "ohm"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "area_margin",
        "metric": "soa_margin",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "minimum_soa_margin"
        },
        "min": 1.3,
        "unit": "ratio",
        "operating_cases": [
          "commanded",
          "load_change"
        ],
        "critical": true
      },
      {
        "id": "average",
        "metric": "output_current",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "pulse_command"
        },
        "observation": {
          "kind": "port",
          "id": "average_current"
        },
        "min": 0.35,
        "max": 0.45,
        "unit": "A",
        "operating_cases": [
          "commanded"
        ],
        "critical": true
      },
      {
        "id": "recovery",
        "metric": "settling_time",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "average_current"
        },
        "max": 0.003,
        "unit": "s",
        "operating_cases": [
          "load_change"
        ]
      },
      {
        "id": "ripple",
        "metric": "output_ripple",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "average_current"
        },
        "max": 0.03,
        "unit": "A",
        "operating_cases": [
          "commanded"
        ]
      },
      {
        "id": "thermal",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 115,
        "unit": "degC",
        "operating_cases": [
          "commanded",
          "load_change"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
