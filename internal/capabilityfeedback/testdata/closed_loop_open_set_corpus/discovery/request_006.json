{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_006",
    "title": "Enabled periodic logic output",
    "description": "Produce a repeatable logic waveform only while enabled, with bounded rate, duty balance, transitions, and startup behavior."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 3.1,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.5,
        "max_current_a": 0.04,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "clock_output",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.5,
          "max_current_a": 0.005
        }
      },
      {
        "id": "enable",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 3.5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "corners",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "clock_output",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 3.1,
            "max": 3.5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "enabled",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "clock_output",
            "min": 0,
            "max": 2e-9,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "enable_rise",
            "kind": "input_step",
            "target": "enable",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "duty",
        "metric": "duty_cycle",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "clock_output"
        },
        "min": 45,
        "max": 55,
        "unit": "%",
        "operating_cases": [
          "corners",
          "enabled"
        ]
      },
      {
        "id": "rate",
        "metric": "oscillation_frequency",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "clock_output"
        },
        "min": 9500,
        "max": 10500,
        "unit": "Hz",
        "operating_cases": [
          "corners",
          "enabled"
        ],
        "critical": true
      },
      {
        "id": "rise",
        "metric": "rise_time",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "clock_output"
        },
        "max": 0.000002,
        "unit": "s",
        "operating_cases": [
          "enabled"
        ]
      },
      {
        "id": "start",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "clock_output"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "enabled"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
