{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_009",
    "title": "Low-current sensor reporting",
    "description": "Translate a unipolar measured current into a stable voltage with bounded scale error, noise, bandwidth, and startup output."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.03,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "sensor_current",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.001
        }
      },
      {
        "id": "sensor_report",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.5,
          "max_voltage_v": 3.3,
          "max_current_a": 0.005
        }
      }
    ],
    "operating_cases": [
      {
        "id": "measurement",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "sensor_report",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "input_current",
            "target": "sensor_current",
            "min": 0.00001,
            "max": 0.00009,
            "unit": "A"
          }
        ]
      },
      {
        "id": "startup",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 0,
            "max": 3.3,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "apply_power",
            "kind": "startup",
            "target": "power",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "band",
        "metric": "bandwidth",
        "analysis": "ac_sweep",
        "excitation": {
          "kind": "port",
          "id": "sensor_current"
        },
        "observation": {
          "kind": "port",
          "id": "sensor_report"
        },
        "min": 5000,
        "unit": "Hz",
        "operating_cases": [
          "measurement"
        ]
      },
      {
        "id": "noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "sensor_report"
        },
        "max": 0.001,
        "unit": "V_rms",
        "operating_cases": [
          "measurement"
        ]
      },
      {
        "id": "safe_start",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "sensor_report"
        },
        "max": 0.2,
        "unit": "V",
        "operating_cases": [
          "startup"
        ],
        "critical": true
      },
      {
        "id": "scale",
        "metric": "transimpedance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "sensor_current"
        },
        "observation": {
          "kind": "port",
          "id": "sensor_report"
        },
        "min": 29000,
        "max": 31000,
        "unit": "V/A",
        "operating_cases": [
          "measurement"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
