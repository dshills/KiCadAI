{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_010",
    "title": "Differential low-level measurement",
    "description": "Report the difference between two low-level inputs while preserving bipolar response, low noise, and a bounded settling time."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.04,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "measurement_output",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5,
          "max_current_a": 0.005
        }
      },
      {
        "id": "negative_input",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -0.05,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0.05,
          "max_current_a": 0.001
        }
      },
      {
        "id": "positive_input",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -0.05,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0.05,
          "max_current_a": 0.001
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "positive_difference",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "negative_input",
            "min": -0.04,
            "max": -0.005,
            "unit": "V"
          },
          {
            "axis": "input_voltage",
            "target": "positive_input",
            "min": 0.005,
            "max": 0.04,
            "unit": "V"
          }
        ]
      },
      {
        "id": "reversal",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "measurement_output",
            "min": -20,
            "max": 70,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "polarity_change",
            "kind": "input_step",
            "target": "positive_input",
            "trigger_time_s": 0.001,
            "initial": -0.02,
            "applied": 0.02,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "difference_gain",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "positive_input"
        },
        "observation": {
          "kind": "port",
          "id": "measurement_output"
        },
        "min": 45,
        "max": 55,
        "unit": "ratio",
        "operating_cases": [
          "positive_difference"
        ],
        "critical": true
      },
      {
        "id": "noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "measurement_output"
        },
        "max": 0.001,
        "unit": "V_rms",
        "operating_cases": [
          "positive_difference"
        ]
      },
      {
        "id": "recovery",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "positive_input"
        },
        "observation": {
          "kind": "port",
          "id": "measurement_output"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "reversal"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
