{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_019",
    "title": "Cross-domain logic conveyance",
    "description": "Convey two external logic inputs into a lower-voltage domain with bounded thresholds, delay, output levels, and safe startup."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.04,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "input_a",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5.5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "input_b",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5.5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "output_a",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.006
        }
      },
      {
        "id": "output_b",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.006
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "channel_a",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "output_a",
            "min": 0,
            "max": 8e-10,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "input_a_rise",
            "kind": "input_step",
            "target": "input_a",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "channel_b",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 3,
            "max": 3.6,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "input_b_fall",
            "kind": "input_step",
            "target": "input_b",
            "trigger_time_s": 0.001,
            "initial": 5,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "a_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "input_a"
        },
        "observation": {
          "kind": "port",
          "id": "output_a"
        },
        "max": 8e-7,
        "unit": "s",
        "operating_cases": [
          "channel_a"
        ],
        "critical": true
      },
      {
        "id": "a_high",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "output_a"
        },
        "min": 2.7,
        "unit": "V",
        "operating_cases": [
          "channel_a"
        ]
      },
      {
        "id": "b_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "input_b"
        },
        "observation": {
          "kind": "port",
          "id": "output_b"
        },
        "max": 8e-7,
        "unit": "s",
        "operating_cases": [
          "channel_b"
        ],
        "critical": true
      },
      {
        "id": "b_low",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "output_b"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "channel_b"
        ]
      },
      {
        "id": "safe_start",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "output_a"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "channel_a"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
