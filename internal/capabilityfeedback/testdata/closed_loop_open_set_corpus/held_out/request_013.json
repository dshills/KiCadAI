{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_013",
    "title": "Bipolar band-limited signal transfer",
    "description": "Apply bounded gain to a bipolar signal in the desired band while limiting low-frequency response, distortion, and output noise."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 8,
        "nominal_voltage_v": 9,
        "max_voltage_v": 10,
        "max_current_a": 0.05,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "signal_input",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -2,
          "nominal_voltage_v": 0,
          "max_voltage_v": 2,
          "max_current_a": 0.001
        }
      },
      {
        "id": "signal_output",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -4,
          "nominal_voltage_v": 0,
          "max_voltage_v": 4,
          "max_current_a": 0.01
        }
      }
    ],
    "operating_cases": [
      {
        "id": "band",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "signal_input",
            "min": -0.5,
            "max": 0.5,
            "unit": "V"
          },
          {
            "axis": "load_resistance",
            "target": "signal_output",
            "min": 10000,
            "max": 100000,
            "unit": "ohm"
          }
        ]
      },
      {
        "id": "step",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "signal_output",
            "min": 0,
            "max": 50,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "input_change",
            "kind": "input_step",
            "target": "signal_input",
            "trigger_time_s": 0.001,
            "initial": -0.2,
            "applied": 0.2,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "cutoff",
        "metric": "cutoff_frequency",
        "analysis": "ac_sweep",
        "excitation": {
          "kind": "port",
          "id": "signal_input"
        },
        "observation": {
          "kind": "port",
          "id": "signal_output"
        },
        "min": 80,
        "max": 120,
        "unit": "Hz",
        "operating_cases": [
          "band"
        ]
      },
      {
        "id": "distortion",
        "metric": "total_harmonic_distortion",
        "analysis": "distortion",
        "excitation": {
          "kind": "port",
          "id": "signal_input"
        },
        "observation": {
          "kind": "port",
          "id": "signal_output"
        },
        "max": 0.2,
        "unit": "%",
        "operating_cases": [
          "band"
        ]
      },
      {
        "id": "midband_gain",
        "metric": "voltage_gain_at_frequency",
        "analysis": "ac_sweep",
        "excitation": {
          "kind": "port",
          "id": "signal_input"
        },
        "observation": {
          "kind": "port",
          "id": "signal_output"
        },
        "min": 3.8,
        "max": 4.2,
        "unit": "ratio",
        "frequency_hz": 1000,
        "operating_cases": [
          "band"
        ]
      },
      {
        "id": "settling",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "signal_input"
        },
        "observation": {
          "kind": "port",
          "id": "signal_output"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "step"
        ]
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
