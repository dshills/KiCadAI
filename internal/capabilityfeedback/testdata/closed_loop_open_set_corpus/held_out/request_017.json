{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_017",
    "title": "Bounded-range status indication",
    "description": "Assert an external status only while a monitored level lies within a bounded range, with stable boundaries and prompt transitions."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.03,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "monitored_level",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -1,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 6,
          "max_current_a": 0.001
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "range_status",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5.25,
          "max_current_a": 0.01
        }
      }
    ],
    "operating_cases": [
      {
        "id": "edge_change",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "range_status",
            "min": 0,
            "max": 1e-9,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "cross_boundary",
            "kind": "input_step",
            "target": "monitored_level",
            "trigger_time_s": 0.001,
            "initial": 1,
            "applied": 2.5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "level_sweep",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "range_status",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "input_voltage",
            "target": "monitored_level",
            "min": 0,
            "max": 5,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "monitored_level"
        },
        "observation": {
          "kind": "port",
          "id": "range_status"
        },
        "max": 0.00005,
        "unit": "s",
        "operating_cases": [
          "edge_change"
        ],
        "critical": true
      },
      {
        "id": "lower",
        "metric": "lower_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "monitored_level"
        },
        "observation": {
          "kind": "port",
          "id": "range_status"
        },
        "min": 1.4,
        "max": 1.6,
        "unit": "V",
        "operating_cases": [
          "level_sweep"
        ],
        "critical": true
      },
      {
        "id": "memory",
        "metric": "hysteresis",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "monitored_level"
        },
        "observation": {
          "kind": "port",
          "id": "range_status"
        },
        "min": 0.05,
        "max": 0.15,
        "unit": "V",
        "operating_cases": [
          "level_sweep"
        ]
      },
      {
        "id": "upper",
        "metric": "upper_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "monitored_level"
        },
        "observation": {
          "kind": "port",
          "id": "range_status"
        },
        "min": 3.4,
        "max": 3.6,
        "unit": "V",
        "operating_cases": [
          "level_sweep"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
