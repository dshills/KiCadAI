{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_020",
    "title": "Analog request status interface",
    "description": "Convert a bounded analog request into two mutually exclusive status outputs with stable decision levels and safe startup."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.03,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "accepted",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 3.6,
          "max_current_a": 0.005
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "rejected",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 3.6,
          "max_current_a": 0.005
        }
      },
      {
        "id": "request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -0.5,
          "nominal_voltage_v": 1.5,
          "max_voltage_v": 3.8,
          "max_current_a": 0.001
        }
      }
    ],
    "operating_cases": [
      {
        "id": "request_sweep",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "accepted",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "input_voltage",
            "target": "request",
            "min": -0.2,
            "max": 3.5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "startup",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 0,
            "max": 3.3,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "apply_power",
            "kind": "startup",
            "target": "power",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "accept_level",
        "metric": "rising_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "request"
        },
        "observation": {
          "kind": "port",
          "id": "accepted"
        },
        "min": 1.9,
        "max": 2.1,
        "unit": "V",
        "operating_cases": [
          "request_sweep"
        ],
        "critical": true
      },
      {
        "id": "decision_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "request"
        },
        "observation": {
          "kind": "port",
          "id": "accepted"
        },
        "max": 0.00005,
        "unit": "s",
        "operating_cases": [
          "request_sweep"
        ]
      },
      {
        "id": "reject_level",
        "metric": "falling_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "request"
        },
        "observation": {
          "kind": "port",
          "id": "rejected"
        },
        "min": 0.9,
        "max": 1.1,
        "unit": "V",
        "operating_cases": [
          "request_sweep"
        ],
        "critical": true
      },
      {
        "id": "safe_start",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "accepted"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "startup"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
