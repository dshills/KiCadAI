{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_016",
    "title": "Enabled constant load current",
    "description": "Deliver a stable load current after enable across line and load variation while bounding startup, temperature, and fault current."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 7,
        "nominal_voltage_v": 9,
        "max_voltage_v": 12,
        "max_current_a": 0.7,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "enable",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "load_current",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.5
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "enabled_load",
        "conditions": [
          {
            "axis": "load_resistance",
            "target": "load_current",
            "min": 5,
            "max": 20,
            "unit": "ohm"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 7,
            "max": 12,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "enable_rise",
            "kind": "input_step",
            "target": "enable",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "shorted_load",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "load_current",
            "min": 0,
            "max": 55,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "short",
            "kind": "short_circuit",
            "target": "load_current",
            "trigger_time_s": 0.004,
            "initial": 3.5,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "current",
        "metric": "output_current",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "load_current"
        },
        "min": 0.34,
        "max": 0.36,
        "unit": "A",
        "operating_cases": [
          "enabled_load"
        ],
        "critical": true
      },
      {
        "id": "fault_peak",
        "metric": "peak_current",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "load_current"
        },
        "max": 0.55,
        "unit": "A",
        "operating_cases": [
          "shorted_load"
        ],
        "critical": true
      },
      {
        "id": "load_stability",
        "metric": "load_regulation",
        "analysis": "dc_sweep",
        "observation": {
          "kind": "port",
          "id": "load_current"
        },
        "max": 0.01,
        "unit": "A",
        "operating_cases": [
          "enabled_load"
        ]
      },
      {
        "id": "startup",
        "metric": "startup_current",
        "analysis": "startup",
        "excitation": {
          "kind": "port",
          "id": "enable"
        },
        "observation": {
          "kind": "port",
          "id": "load_current"
        },
        "max": 0.4,
        "unit": "A",
        "operating_cases": [
          "enabled_load"
        ],
        "critical": true
      },
      {
        "id": "thermal",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 115,
        "unit": "degC",
        "operating_cases": [
          "enabled_load",
          "shorted_load"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
