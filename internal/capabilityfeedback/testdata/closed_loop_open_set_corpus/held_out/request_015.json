{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_015",
    "title": "Enabled medium-voltage power delivery",
    "description": "Provide a stable enabled output across line and load variation with bounded ripple, startup overshoot, efficiency, and short-circuit stress."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 18,
        "nominal_voltage_v": 22,
        "max_voltage_v": 26,
        "max_current_a": 2,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "enable",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "power_output",
        "kind": "power",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 12,
          "max_voltage_v": 13,
          "max_current_a": 1.2
        }
      }
    ],
    "operating_cases": [
      {
        "id": "enabled_load",
        "conditions": [
          {
            "axis": "load_current",
            "target": "power_output",
            "min": 0.2,
            "max": 1,
            "unit": "A"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 18,
            "max": 26,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "enable_rise",
            "kind": "input_step",
            "target": "enable",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "shorted",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "power_output",
            "min": 0,
            "max": 55,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "short",
            "kind": "short_circuit",
            "target": "power_output",
            "trigger_time_s": 0.005,
            "initial": 12,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "efficiency",
        "metric": "conversion_efficiency",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "power_output"
        },
        "min": 85,
        "unit": "%",
        "operating_cases": [
          "enabled_load"
        ]
      },
      {
        "id": "fault_peak",
        "metric": "peak_current",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "power_output"
        },
        "max": 1.6,
        "unit": "A",
        "operating_cases": [
          "shorted"
        ],
        "critical": true
      },
      {
        "id": "overshoot",
        "metric": "startup_overshoot",
        "analysis": "startup",
        "excitation": {
          "kind": "port",
          "id": "enable"
        },
        "observation": {
          "kind": "port",
          "id": "power_output"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "enabled_load"
        ],
        "critical": true
      },
      {
        "id": "ripple",
        "metric": "output_ripple",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "power_output"
        },
        "max": 0.08,
        "unit": "V",
        "operating_cases": [
          "enabled_load"
        ]
      },
      {
        "id": "thermal",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 120,
        "unit": "degC",
        "operating_cases": [
          "enabled_load",
          "shorted"
        ],
        "critical": true
      },
      {
        "id": "voltage",
        "metric": "output_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "power_output"
        },
        "min": 11.8,
        "max": 12.2,
        "unit": "V",
        "operating_cases": [
          "enabled_load"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
