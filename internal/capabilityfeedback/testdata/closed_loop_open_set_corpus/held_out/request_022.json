{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_022",
    "title": "Low-level event detector",
    "description": "Assert a logic indication when a small measured current crosses a stable boundary, with bounded hysteresis, delay, and noise susceptibility."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 2.8,
        "nominal_voltage_v": 3,
        "max_voltage_v": 3.2,
        "max_current_a": 0.025,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "event_output",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 3.2,
          "max_current_a": 0.005
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "measured_current",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.001
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "event_step",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "event_output",
            "min": 0,
            "max": 1e-9,
            "unit": "F"
          }
        ],
        "events": [
          {
            "id": "current_rise",
            "kind": "input_step",
            "target": "measured_current",
            "trigger_time_s": 0.001,
            "initial": 0.00002,
            "applied": 0.00008,
            "unit": "A"
          }
        ]
      },
      {
        "id": "threshold_sweep",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "event_output",
            "min": -10,
            "max": 60,
            "unit": "degC"
          },
          {
            "axis": "input_current",
            "target": "measured_current",
            "min": 0,
            "max": 0.0001,
            "unit": "A"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "event_output"
        },
        "max": 0.0002,
        "unit": "s",
        "operating_cases": [
          "event_step"
        ],
        "critical": true
      },
      {
        "id": "memory",
        "metric": "hysteresis",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "event_output"
        },
        "min": 0.000005,
        "max": 0.000015,
        "unit": "A",
        "operating_cases": [
          "threshold_sweep"
        ]
      },
      {
        "id": "noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "event_output"
        },
        "max": 0.01,
        "unit": "V_rms",
        "operating_cases": [
          "threshold_sweep"
        ]
      },
      {
        "id": "trip",
        "metric": "threshold_current",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "event_output"
        },
        "min": 0.000045,
        "max": 0.000055,
        "unit": "A",
        "operating_cases": [
          "threshold_sweep"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
