{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_021",
    "title": "Bidirectional current measurement",
    "description": "Report a small bidirectional measured current as a centered voltage with bounded scale error, noise, bandwidth, and overload recovery."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 4.5,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.5,
        "max_current_a": 0.04,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "measured_current",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.03
        }
      },
      {
        "id": "measurement_voltage",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5,
          "max_current_a": 0.005
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "measurement",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "measurement_voltage",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "input_current",
            "target": "measured_current",
            "min": -0.01,
            "max": 0.01,
            "unit": "A"
          }
        ]
      },
      {
        "id": "overload_recovery",
        "conditions": [
          {
            "axis": "load_resistance",
            "target": "measurement_voltage",
            "min": 10000,
            "max": 100000,
            "unit": "ohm"
          }
        ],
        "events": [
          {
            "id": "overload_clear",
            "kind": "input_step",
            "target": "measured_current",
            "trigger_time_s": 0.001,
            "initial": 0.018,
            "applied": 0.002,
            "unit": "A"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "bandwidth",
        "metric": "bandwidth",
        "analysis": "ac_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "measurement_voltage"
        },
        "min": 10000,
        "unit": "Hz",
        "operating_cases": [
          "measurement"
        ]
      },
      {
        "id": "noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "measurement_voltage"
        },
        "max": 0.0008,
        "unit": "V_rms",
        "operating_cases": [
          "measurement"
        ]
      },
      {
        "id": "recovery",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "measurement_voltage"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "overload_recovery"
        ],
        "critical": true
      },
      {
        "id": "scale",
        "metric": "transimpedance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_current"
        },
        "observation": {
          "kind": "port",
          "id": "measurement_voltage"
        },
        "min": 190,
        "max": 210,
        "unit": "V/A",
        "operating_cases": [
          "measurement"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
