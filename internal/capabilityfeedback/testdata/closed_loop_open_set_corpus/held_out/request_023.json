{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_023",
    "title": "Pulse-controlled voltage delivery",
    "description": "Provide a stable load voltage while an external pulse command is active, with bounded ripple, shutdown delay, startup, and thermal stress."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 9,
        "nominal_voltage_v": 12,
        "max_voltage_v": 15,
        "max_current_a": 1.2,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "load_voltage",
        "kind": "power",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 6,
          "max_voltage_v": 7,
          "max_current_a": 0.8
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "pulse_enable",
        "kind": "digital",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.001,
          "default_state": "low"
        }
      }
    ],
    "operating_cases": [
      {
        "id": "active",
        "conditions": [
          {
            "axis": "load_current",
            "target": "load_voltage",
            "min": 0.1,
            "max": 0.6,
            "unit": "A"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 9,
            "max": 15,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "pulse_rise",
            "kind": "input_step",
            "target": "pulse_enable",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 5,
            "unit": "V"
          }
        ]
      },
      {
        "id": "shutdown",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "load_voltage",
            "min": 0,
            "max": 60,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "pulse_fall",
            "kind": "input_step",
            "target": "pulse_enable",
            "trigger_time_s": 0.004,
            "initial": 5,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "active_voltage",
        "metric": "output_voltage",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "pulse_enable"
        },
        "observation": {
          "kind": "port",
          "id": "load_voltage"
        },
        "min": 5.8,
        "max": 6.2,
        "unit": "V",
        "operating_cases": [
          "active"
        ],
        "critical": true
      },
      {
        "id": "ripple",
        "metric": "output_ripple",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "load_voltage"
        },
        "max": 0.08,
        "unit": "V",
        "operating_cases": [
          "active"
        ]
      },
      {
        "id": "shutdown_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "pulse_enable"
        },
        "observation": {
          "kind": "port",
          "id": "load_voltage"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "shutdown"
        ],
        "critical": true
      },
      {
        "id": "startup_peak",
        "metric": "startup_overshoot",
        "analysis": "startup",
        "excitation": {
          "kind": "port",
          "id": "pulse_enable"
        },
        "observation": {
          "kind": "port",
          "id": "load_voltage"
        },
        "max": 0.3,
        "unit": "V",
        "operating_cases": [
          "active"
        ],
        "critical": true
      },
      {
        "id": "thermal",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 115,
        "unit": "degC",
        "operating_cases": [
          "active",
          "shutdown"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
