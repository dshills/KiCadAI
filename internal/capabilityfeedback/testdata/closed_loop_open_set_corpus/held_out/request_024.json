{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_024",
    "title": "Measured-demand power control",
    "description": "Deliver load current proportional to a measured analog demand and assert a fault status when safe delivery cannot be maintained."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 14,
        "nominal_voltage_v": 18,
        "max_voltage_v": 22,
        "max_current_a": 1.5,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "fault_status",
        "kind": "digital",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.005
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "load_current",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "max_current_a": 1
        }
      },
      {
        "id": "measured_demand",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "min_voltage_v": -1,
          "nominal_voltage_v": 1,
          "max_voltage_v": 3,
          "max_current_a": 0.001
        }
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      }
    ],
    "operating_cases": [
      {
        "id": "demand_range",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "measured_demand",
            "min": -0.5,
            "max": 2.5,
            "unit": "V"
          },
          {
            "axis": "load_resistance",
            "target": "load_current",
            "min": 8,
            "max": 30,
            "unit": "ohm"
          }
        ]
      },
      {
        "id": "load_fault",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "load_current",
            "min": 0,
            "max": 65,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "short",
            "kind": "short_circuit",
            "target": "load_current",
            "trigger_time_s": 0.003,
            "initial": 5,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "area_margin",
        "metric": "soa_margin",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "minimum_soa_margin"
        },
        "min": 1.4,
        "unit": "ratio",
        "operating_cases": [
          "demand_range",
          "load_fault"
        ],
        "critical": true
      },
      {
        "id": "demand_scale",
        "metric": "transconductance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_demand"
        },
        "observation": {
          "kind": "port",
          "id": "load_current"
        },
        "min": 0.24,
        "max": 0.26,
        "unit": "A/V",
        "operating_cases": [
          "demand_range"
        ],
        "critical": true
      },
      {
        "id": "fault_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "load_current"
        },
        "observation": {
          "kind": "port",
          "id": "fault_status"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "load_fault"
        ],
        "critical": true
      },
      {
        "id": "fault_threshold",
        "metric": "threshold_current",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "fault_status"
        },
        "min": 0.8,
        "max": 1,
        "unit": "A",
        "operating_cases": [
          "load_fault"
        ],
        "critical": true
      },
      {
        "id": "thermal",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "maximum_junction_temperature"
        },
        "max": 120,
        "unit": "degC",
        "operating_cases": [
          "demand_range",
          "load_fault"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
