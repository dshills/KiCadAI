{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "request_014",
    "title": "Bipolar current replication",
    "description": "Produce a bounded output current proportional to a bidirectional command current with controlled error, noise, and recovery time."
  },
  "requirements": {
    "domains": [
      {
        "id": "ground",
        "kind": "reference",
        "nominal_voltage_v": 0,
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 10,
        "nominal_voltage_v": 12,
        "max_voltage_v": 14,
        "max_current_a": 0.2,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "command_current",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.02
        }
      },
      {
        "id": "ground",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "ground",
        "electrical": {}
      },
      {
        "id": "power",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {}
      },
      {
        "id": "replicated_current",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "ground",
        "electrical": {
          "max_current_a": 0.06
        }
      }
    ],
    "operating_cases": [
      {
        "id": "bipolar_range",
        "conditions": [
          {
            "axis": "input_current",
            "target": "command_current",
            "min": -0.008,
            "max": 0.008,
            "unit": "A"
          },
          {
            "axis": "load_resistance",
            "target": "replicated_current",
            "min": 20,
            "max": 200,
            "unit": "ohm"
          }
        ]
      },
      {
        "id": "recovery",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "replicated_current",
            "min": -10,
            "max": 60,
            "unit": "degC"
          }
        ],
        "events": [
          {
            "id": "command_reversal",
            "kind": "input_step",
            "target": "command_current",
            "trigger_time_s": 0.001,
            "initial": -0.005,
            "applied": 0.005,
            "unit": "A"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "replicated_current"
        },
        "max": 0.0002,
        "unit": "A",
        "operating_cases": [
          "bipolar_range"
        ]
      },
      {
        "id": "recovery_time",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "command_current"
        },
        "observation": {
          "kind": "port",
          "id": "replicated_current"
        },
        "max": 0.0005,
        "unit": "s",
        "operating_cases": [
          "recovery"
        ]
      },
      {
        "id": "scale",
        "metric": "output_current",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "command_current"
        },
        "observation": {
          "kind": "port",
          "id": "replicated_current"
        },
        "min": 0.024,
        "max": 0.026,
        "unit": "A",
        "operating_cases": [
          "bipolar_range"
        ],
        "critical": true
      }
    ],
    "constraints": {
      "max_components": 32,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
