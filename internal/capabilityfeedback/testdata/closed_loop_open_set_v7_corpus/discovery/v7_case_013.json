{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "current_window_output",
    "title": "Current-window voltage and alert interface",
    "description": "Study an externally powered interface that maps a bounded input current to a voltage and indicates when the current leaves its normal window."
  },
  "requirements": {
    "domains": [
      {"id":"signal_return","kind":"reference","source":"external"},
      {"id":"interface_supply","kind":"supply","source":"external","min_voltage_v":10.8,"nominal_voltage_v":12.0,"max_voltage_v":13.2,"max_current_a":0.08}
    ],
    "ports": [
      {"id":"current_input","kind":"analog_current","direction":"sink","domain":"signal_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":5.0,"max_current_a":0.024}},
      {"id":"supply_input","kind":"power","direction":"sink","domain":"interface_supply","electrical":{"min_voltage_v":10.8,"nominal_voltage_v":12.0,"max_voltage_v":13.2,"max_current_a":0.08}},
      {"id":"scaled_output","kind":"analog_voltage","direction":"source","domain":"signal_return","electrical":{"min_voltage_v":0.2,"max_voltage_v":4.8,"max_current_a":0.002}},
      {"id":"window_alert","kind":"digital","direction":"source","domain":"signal_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":5.0,"max_current_a":0.002,"default_state":"high"}}
    ],
    "operating_cases": [
      {
        "id":"normal_sweep",
        "conditions":[
          {"axis":"input_current","target":"current_input","min":0.004,"max":0.020,"unit":"A"},
          {"axis":"supply_voltage","target":"interface_supply","min":10.8,"max":13.2,"unit":"V"},
          {"axis":"ambient_temperature","target":"signal_return","min":-20,"max":70,"unit":"degC"},
          {"axis":"tolerance_corner","target":"scaled_output","min":-1,"max":1,"unit":"ratio"}
        ]
      },
      {
        "id":"overrange_step",
        "conditions":[
          {"axis":"input_current","target":"current_input","min":0.020,"max":0.024,"unit":"A"},
          {"axis":"supply_voltage","target":"interface_supply","min":10.8,"max":13.2,"unit":"V"}
        ],
        "events":[
          {"id":"current_rise","kind":"input_step","target":"current_input","trigger_time_s":0.002,"initial":0.018,"applied":0.023,"unit":"A"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"current_to_voltage_ratio","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"scaled_output"},"min":240,"max":260,"unit":"V/A","operating_cases":["normal_sweep"],"critical":true},
      {"id":"normal_output_ceiling","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"scaled_output"},"min":0.7,"max":4.7,"unit":"V","operating_cases":["normal_sweep"],"critical":true},
      {"id":"alert_dc_overrange","metric":"output_low_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"window_alert"},"max":0.5,"unit":"V","operating_cases":["overrange_step"],"critical":true},
      {"id":"alert_low_overrange","metric":"output_low_voltage","analysis":"transient","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"window_alert"},"max":0.5,"unit":"V","operating_cases":["overrange_step"],"critical":true},
      {"id":"alert_response_time","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"window_alert"},"max":0.0002,"unit":"s","operating_cases":["overrange_step"],"critical":true},
      {"id":"output_noise","metric":"output_noise_rms","analysis":"noise","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"scaled_output"},"max":0.008,"unit":"V_rms","operating_cases":["normal_sweep"],"frequency_hz":10000}
    ],
    "constraints": {"max_components":28,"max_width_mm":42,"max_height_mm":28}
  },
  "acceptance": {
    "require_primitive_only":true,
    "require_topology_search":true,
    "require_simulation":true,
    "require_all_corners":true,
    "require_model_provenance":true,
    "require_closed_loop_evidence":true,
    "require_complete_routing":true,
    "require_connectivity":true,
    "require_writer_correctness":true,
    "require_round_trip_zero_diff":true,
    "require_erc":true,
    "require_strict_drc":true,
    "require_deterministic_replay":true,
    "require_fail_closed":true
  }
}
