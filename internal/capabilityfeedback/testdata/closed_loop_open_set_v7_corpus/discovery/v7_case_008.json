{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "pulsed_load_supply",
    "title": "Pulsed Load Supply",
    "description": "Provide a regulated output from a bounded input source during steady and stepped loads, including controlled startup and a declared output fault."
  },
  "requirements": {
    "domains": [
      {"id":"power_return","kind":"reference","source":"external","nominal_voltage_v":0},
      {"id":"input_energy","kind":"supply","source":"external","min_voltage_v":8,"nominal_voltage_v":12,"max_voltage_v":16,"max_current_a":2.5},
      {"id":"regulated_domain","kind":"supply","source":"external","min_voltage_v":4.85,"nominal_voltage_v":5,"max_voltage_v":5.15,"max_current_a":3}
    ],
    "ports": [
      {"id":"energy_input","kind":"power","direction":"sink","domain":"input_energy","electrical":{"min_voltage_v":8,"nominal_voltage_v":12,"max_voltage_v":16,"max_current_a":2.5}},
      {"id":"regulated_output","kind":"power","direction":"source","domain":"regulated_domain","electrical":{"min_voltage_v":4.85,"nominal_voltage_v":5,"max_voltage_v":5.15,"max_current_a":3}},
      {"id":"output_enable","kind":"digital","direction":"sink","domain":"power_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"common_return","kind":"reference","direction":"bidirectional","domain":"power_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"steady_delivery","conditions":[{"axis":"supply_voltage","target":"input_energy","min":8,"max":16,"unit":"V"},{"axis":"load_current","target":"regulated_output","min":0.05,"max":2.4,"unit":"A"},{"axis":"ambient_temperature","target":"common_return","min":-20,"max":70,"unit":"degC"},{"axis":"tolerance_corner","target":"regulated_output","min":-1,"max":1,"unit":"ratio"}]},
      {"id":"load_transition","conditions":[{"axis":"supply_voltage","target":"input_energy","min":9,"max":15,"unit":"V"},{"axis":"load_current","target":"regulated_output","min":0.1,"max":2.4,"unit":"A"},{"axis":"load_capacitance","target":"regulated_output","min":0.000047,"max":0.00047,"unit":"F"}],"events":[{"id":"load_rise","kind":"load_step","target":"regulated_output","trigger_time_s":0.002,"initial":0.1,"applied":2.2,"unit":"A"}]},
      {"id":"enabled_start","conditions":[{"axis":"supply_voltage","target":"input_energy","min":8,"max":16,"unit":"V"},{"axis":"load_current","target":"regulated_output","min":0.1,"max":1,"unit":"A"}],"events":[{"id":"apply_input","kind":"startup","target":"energy_input","trigger_time_s":0,"initial":0,"applied":12,"unit":"V"}]},
      {"id":"bounded_short","conditions":[{"axis":"supply_voltage","target":"input_energy","min":10,"max":14,"unit":"V"},{"axis":"ambient_temperature","target":"common_return","min":0,"max":40,"unit":"degC"}],"events":[{"id":"output_fault","kind":"short_circuit","target":"regulated_output","trigger_time_s":0.003,"initial":5,"applied":0,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"regulated_level","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"energy_input"},"observation":{"kind":"port","id":"regulated_output"},"min":4.85,"max":5.15,"unit":"V","operating_cases":["steady_delivery"],"critical":true},
      {"id":"conversion_floor","metric":"conversion_efficiency","analysis":"dc_operating_point","excitation":{"kind":"port","id":"energy_input"},"observation":{"kind":"circuit","id":"energy_transfer"},"min":82,"unit":"%","operating_cases":["steady_delivery"]},
      {"id":"loaded_temperature","metric":"junction_temperature","analysis":"electrothermal","excitation":{"kind":"port","id":"regulated_output"},"observation":{"kind":"circuit","id":"loaded_assembly"},"max":125,"unit":"degC","operating_cases":["steady_delivery"],"critical":true},
      {"id":"step_recovery","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"regulated_output"},"observation":{"kind":"port","id":"regulated_output"},"max":0.0012,"unit":"s","operating_cases":["load_transition"],"critical":true},
      {"id":"start_overshoot","metric":"startup_overshoot","analysis":"startup","excitation":{"kind":"port","id":"energy_input"},"observation":{"kind":"port","id":"regulated_output"},"max":0.25,"unit":"V","operating_cases":["enabled_start"],"critical":true},
      {"id":"fault_peak","metric":"peak_current","analysis":"transient","excitation":{"kind":"port","id":"regulated_output"},"observation":{"kind":"port","id":"regulated_output"},"max":3.8,"unit":"A","operating_cases":["bounded_short"],"critical":true}
    ],
    "constraints": {"max_components":28,"max_width_mm":48,"max_height_mm":38}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
