{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "low_level_sensor_reader",
    "title": "Low-Level Sensor Reader",
    "description": "Map a bounded low-level input voltage into a measurable output span with controlled noise and frequency response across the declared environment."
  },
  "requirements": {
    "domains": [
      {"id":"measurement_return","kind":"reference","source":"external","nominal_voltage_v":0},
      {"id":"measurement_supply","kind":"supply","source":"external","min_voltage_v":3.1,"nominal_voltage_v":3.3,"max_voltage_v":3.5,"max_current_a":0.018}
    ],
    "ports": [
      {"id":"sensor_voltage","kind":"analog_voltage","direction":"sink","domain":"measurement_return","electrical":{"min_voltage_v":0.01,"nominal_voltage_v":0.03,"max_voltage_v":0.06,"input_impedance_min_ohm":1000000}},
      {"id":"measured_voltage","kind":"analog_voltage","direction":"source","domain":"measurement_return","electrical":{"min_voltage_v":0.35,"nominal_voltage_v":1.2,"max_voltage_v":2.7,"max_current_a":0.001}},
      {"id":"measurement_power","kind":"power","direction":"sink","domain":"measurement_supply","electrical":{"min_voltage_v":3.1,"nominal_voltage_v":3.3,"max_voltage_v":3.5,"max_current_a":0.018}},
      {"id":"measurement_common","kind":"reference","direction":"bidirectional","domain":"measurement_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"precision_range","conditions":[{"axis":"input_voltage","target":"sensor_voltage","min":0.01,"max":0.04,"unit":"V"},{"axis":"load_resistance","target":"measured_voltage","min":100000,"max":1000000,"unit":"ohm"},{"axis":"ambient_temperature","target":"measurement_common","min":-30,"max":70,"unit":"degC"},{"axis":"supply_voltage","target":"measurement_supply","min":3.1,"max":3.5,"unit":"V"}]},
      {"id":"upper_range","conditions":[{"axis":"input_voltage","target":"sensor_voltage","min":0.04,"max":0.06,"unit":"V"},{"axis":"load_resistance","target":"measured_voltage","min":100000,"max":1000000,"unit":"ohm"},{"axis":"model_corner","target":"measured_voltage","min":-1,"max":1,"unit":"ratio"},{"axis":"supply_voltage","target":"measurement_supply","min":3.1,"max":3.5,"unit":"V"}]},
      {"id":"sensor_transition","conditions":[{"axis":"input_voltage","target":"sensor_voltage","min":0.01,"max":0.05,"unit":"V"},{"axis":"load_capacitance","target":"measured_voltage","min":0,"max":0.000000001,"unit":"F"}],"events":[{"id":"sensor_step","kind":"input_step","target":"sensor_voltage","trigger_time_s":0.001,"initial":0.015,"applied":0.045,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"measurement_gain","metric":"voltage_gain","analysis":"dc_sweep","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"measured_voltage"},"min":39,"max":41,"unit":"ratio","operating_cases":["precision_range","upper_range"],"critical":true},
      {"id":"response_band","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"measured_voltage"},"min":3200,"unit":"Hz","operating_cases":["precision_range"]},
      {"id":"measurement_noise","metric":"output_noise_rms","analysis":"noise","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"measured_voltage"},"max":0.0008,"unit":"V_rms","operating_cases":["precision_range"],"critical":true},
      {"id":"transition_settle","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"sensor_voltage"},"observation":{"kind":"port","id":"measured_voltage"},"max":0.0003,"unit":"s","operating_cases":["sensor_transition"]}
    ],
    "constraints": {"max_components":22,"max_width_mm":26,"max_height_mm":21}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
