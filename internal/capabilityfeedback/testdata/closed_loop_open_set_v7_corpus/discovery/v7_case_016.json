{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"activity_interval_guard","title":"Activity-interval guard output","description":"Study a powered interface that holds a control output inactive during startup, responds to periodic external activity, and changes state after activity ceases."},
  "requirements":{
    "domains":[
      {"id":"control_return","kind":"reference","source":"external"},
      {"id":"control_supply","kind":"supply","source":"external","min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.05}
    ],
    "ports":[
      {"id":"power_input","kind":"power","direction":"sink","domain":"control_supply","electrical":{"min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.05}},
      {"id":"activity_input","kind":"digital","direction":"sink","domain":"control_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":3.6,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"guard_output","kind":"digital","direction":"source","domain":"control_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":3.6,"max_current_a":0.006,"default_state":"low"}}
    ],
    "operating_cases":[
      {"id":"startup_hold","conditions":[
        {"axis":"supply_voltage","target":"control_supply","min":3.0,"max":3.6,"unit":"V"},
        {"axis":"load_resistance","target":"guard_output","min":1000,"max":10000,"unit":"ohm"},
        {"axis":"ambient_temperature","target":"control_return","min":-20,"max":75,"unit":"degC"},
        {"axis":"model_corner","target":"power_input","min":-1,"max":1,"unit":"ratio"}
      ],"events":[
        {"id":"power_applied","kind":"startup","target":"power_input","trigger_time_s":0.0,"initial":0.0,"applied":3.3,"unit":"V"}
      ]},
      {"id":"activity_ceases","conditions":[
        {"axis":"supply_voltage","target":"control_supply","min":3.0,"max":3.6,"unit":"V"},
        {"axis":"input_voltage","target":"activity_input","min":0.0,"max":3.6,"unit":"V"},
        {"axis":"tolerance_corner","target":"guard_output","min":-1,"max":1,"unit":"ratio"}
      ],"events":[
        {"id":"last_activity","kind":"input_step","target":"activity_input","trigger_time_s":0.005,"initial":3.3,"applied":0.0,"unit":"V"}
      ]}
    ],
    "behavioral_requirements":[
      {"id":"startup_low_state","metric":"startup_output_voltage","analysis":"startup","excitation":{"kind":"port","id":"power_input"},"observation":{"kind":"port","id":"guard_output"},"max":0.4,"unit":"V","operating_cases":["startup_hold"],"critical":true},
      {"id":"startup_current_limit","metric":"startup_current","analysis":"startup","excitation":{"kind":"port","id":"power_input"},"observation":{"kind":"port","id":"power_input"},"max":0.05,"unit":"A","operating_cases":["startup_hold"]},
      {"id":"cessation_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"activity_input"},"observation":{"kind":"port","id":"guard_output"},"min":0.08,"max":0.14,"unit":"s","operating_cases":["activity_ceases"],"critical":true},
      {"id":"guard_asserted_level","metric":"output_high_voltage","analysis":"transient","excitation":{"kind":"port","id":"activity_input"},"observation":{"kind":"port","id":"guard_output"},"min":2.6,"unit":"V","operating_cases":["activity_ceases"],"critical":true},
      {"id":"activity_input_impedance","metric":"input_impedance","analysis":"dc_operating_point","excitation":{"kind":"port","id":"activity_input"},"observation":{"kind":"port","id":"activity_input"},"min":100000,"unit":"ohm","operating_cases":["activity_ceases"]}
    ],
    "constraints":{"max_components":24,"max_width_mm":38,"max_height_mm":30}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
