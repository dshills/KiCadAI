{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"level_to_pulse_rate","title":"Level-to-pulse-rate interface","description":"Study an externally powered interface whose output pulse rate follows a bounded control voltage while maintaining defined logic levels and duty cycle."},
  "requirements":{
    "domains":[
      {"id":"common_return","kind":"reference","source":"external"},
      {"id":"signal_supply","kind":"supply","source":"external","min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.06}
    ],
    "ports":[
      {"id":"supply_input","kind":"power","direction":"sink","domain":"signal_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.06}},
      {"id":"level_input","kind":"analog_voltage","direction":"sink","domain":"common_return","electrical":{"min_voltage_v":0.4,"nominal_voltage_v":2.0,"max_voltage_v":3.6,"input_impedance_min_ohm":50000}},
      {"id":"pulse_output","kind":"digital","direction":"source","domain":"common_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":5.5,"max_current_a":0.006,"default_state":"low"}}
    ],
    "operating_cases":[
      {"id":"rate_sweep","conditions":[
        {"axis":"input_voltage","target":"level_input","min":0.4,"max":0.6,"unit":"V"},
        {"axis":"supply_voltage","target":"signal_supply","min":4.5,"max":5.5,"unit":"V"},
        {"axis":"load_capacitance","target":"pulse_output","min":0.00000000001,"max":0.0000000001,"unit":"F"},
        {"axis":"ambient_temperature","target":"common_return","min":-20,"max":70,"unit":"degC"},
        {"axis":"model_corner","target":"pulse_output","min":-1,"max":1,"unit":"ratio"}
      ]},
      {"id":"level_transition","conditions":[
        {"axis":"supply_voltage","target":"signal_supply","min":4.5,"max":5.5,"unit":"V"},
        {"axis":"load_resistance","target":"pulse_output","min":1000,"max":10000,"unit":"ohm"}
      ],"events":[
        {"id":"level_rise","kind":"input_step","target":"level_input","trigger_time_s":0.002,"initial":0.8,"applied":3.2,"unit":"V"}
      ]},
      {"id":"control_loading","conditions":[
        {"axis":"input_voltage","target":"level_input","min":0.4,"max":3.6,"unit":"V"},
        {"axis":"supply_voltage","target":"signal_supply","min":4.5,"max":5.5,"unit":"V"},
        {"axis":"ambient_temperature","target":"common_return","min":-20,"max":70,"unit":"degC"},
        {"axis":"tolerance_corner","target":"level_input","min":-1,"max":1,"unit":"ratio"}
      ]}
    ],
    "behavioral_requirements":[
      {"id":"control_input_loading","metric":"input_impedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"level_input"},"observation":{"kind":"port","id":"level_input"},"min":50000,"unit":"ohm","operating_cases":["control_loading"]},
      {"id":"low_level_rate","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"level_input"},"observation":{"kind":"port","id":"pulse_output"},"min":800,"max":1400,"unit":"Hz","operating_cases":["rate_sweep"]},
      {"id":"high_level_rate","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"level_input"},"observation":{"kind":"port","id":"pulse_output"},"min":7000,"max":9000,"unit":"Hz","operating_cases":["level_transition"]},
      {"id":"supply_demand","metric":"quiescent_current","analysis":"dc_operating_point","excitation":{"kind":"port","id":"level_input"},"observation":{"kind":"port","id":"supply_input"},"max":0.04,"unit":"A","operating_cases":["rate_sweep"]},
      {"id":"pulse_duty","metric":"duty_cycle","analysis":"transient","excitation":{"kind":"port","id":"level_input"},"observation":{"kind":"port","id":"pulse_output"},"min":35,"max":65,"unit":"%","operating_cases":["rate_sweep","level_transition"]},
      {"id":"pulse_high_level","metric":"output_high_voltage","analysis":"transient","observation":{"kind":"port","id":"pulse_output"},"min":4.0,"unit":"V","operating_cases":["rate_sweep"]},
      {"id":"pulse_low_level","metric":"output_low_voltage","analysis":"transient","observation":{"kind":"port","id":"pulse_output"},"max":0.5,"unit":"V","operating_cases":["rate_sweep"]}
    ],
    "constraints":{"max_components":22,"max_width_mm":36,"max_height_mm":26}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
