{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_rail_energy_service",
    "title": "Dual-rail energy service",
    "description": "Provide two bounded voltage outputs from a variable external source while maintaining defined steady-state, startup, load-change, and fault responses."
  },
  "requirements": {
    "domains": [
      {"id":"power_reference","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0},
      {"id":"source_domain","kind":"supply","source":"external","min_voltage_v":10,"nominal_voltage_v":12,"max_voltage_v":14,"max_current_a":2.4},
      {"id":"five_domain","kind":"supply","source":"external","min_voltage_v":4.85,"nominal_voltage_v":5,"max_voltage_v":5.15,"max_current_a":1.2},
      {"id":"three_domain","kind":"supply","source":"external","min_voltage_v":3.2,"nominal_voltage_v":3.3,"max_voltage_v":3.4,"max_current_a":0.45}
    ],
    "ports": [
      {"id":"source_input","kind":"power","direction":"sink","domain":"source_domain","electrical":{"min_voltage_v":10,"nominal_voltage_v":12,"max_voltage_v":14,"max_current_a":2.4}},
      {"id":"primary_output","kind":"power","direction":"source","domain":"five_domain","electrical":{"min_voltage_v":4.85,"nominal_voltage_v":5,"max_voltage_v":5.15,"max_current_a":1.2}},
      {"id":"auxiliary_output","kind":"power","direction":"source","domain":"three_domain","electrical":{"min_voltage_v":3.2,"nominal_voltage_v":3.3,"max_voltage_v":3.4,"max_current_a":0.45}},
      {"id":"service_enable","kind":"digital","direction":"sink","domain":"source_domain","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":5,"max_current_a":0.001,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"return_connection","kind":"reference","direction":"bidirectional","domain":"power_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":2.4}}
    ],
    "operating_cases": [
      {
        "id":"balanced_load",
        "conditions":[
          {"axis":"ambient_temperature","target":"power_reference","min":-10,"max":55,"unit":"degC"},
          {"axis":"supply_voltage","target":"source_domain","min":10,"max":14,"unit":"V"},
          {"axis":"load_current","target":"primary_output","min":0.08,"max":0.9,"unit":"A"},
          {"axis":"load_current","target":"auxiliary_output","min":0.03,"max":0.35,"unit":"A"}
        ],
        "events":[
          {"id":"primary_load_change","kind":"load_step","target":"primary_output","trigger_time_s":0.004,"initial":0.08,"applied":0.9,"unit":"A"}
        ]
      },
      {
        "id":"source_change",
        "conditions":[
          {"axis":"ambient_temperature","target":"power_reference","min":-10,"max":55,"unit":"degC"},
          {"axis":"supply_voltage","target":"source_domain","min":10,"max":14,"unit":"V"},
          {"axis":"load_current","target":"primary_output","min":0.2,"max":0.8,"unit":"A"},
          {"axis":"load_current","target":"auxiliary_output","min":0.05,"max":0.3,"unit":"A"}
        ],
        "events":[
          {"id":"source_voltage_change","kind":"power_step","target":"source_input","trigger_time_s":0.005,"initial":10,"applied":14,"unit":"V"}
        ]
      },
      {
        "id":"cold_start",
        "conditions":[
          {"axis":"ambient_temperature","target":"power_reference","min":-30,"max":0,"unit":"degC"},
          {"axis":"supply_voltage","target":"source_domain","min":10,"max":14,"unit":"V"},
          {"axis":"load_current","target":"primary_output","min":0.05,"max":0.6,"unit":"A"},
          {"axis":"load_current","target":"auxiliary_output","min":0.02,"max":0.25,"unit":"A"}
        ],
        "events":[
          {"id":"source_application","kind":"startup","target":"source_input","trigger_time_s":0,"initial":0,"applied":12,"unit":"V"}
        ]
      },
      {
        "id":"primary_fault",
        "conditions":[
          {"axis":"ambient_temperature","target":"power_reference","min":20,"max":40,"unit":"degC"},
          {"axis":"supply_voltage","target":"source_domain","min":10,"max":14,"unit":"V"},
          {"axis":"load_current","target":"auxiliary_output","min":0.05,"max":0.35,"unit":"A"}
        ],
        "events":[
          {"id":"primary_short","kind":"short_circuit","target":"primary_output","trigger_time_s":0.006,"initial":20,"applied":0,"unit":"ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"energy_efficiency","metric":"conversion_efficiency","analysis":"dc_operating_point","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"circuit","id":"energy_service"},"min":78,"unit":"%","operating_cases":["balanced_load"]},
      {"id":"primary_regulation","metric":"output_voltage","analysis":"transient","observation":{"kind":"port","id":"primary_output"},"min":4.75,"max":5.25,"unit":"V","operating_cases":["balanced_load","cold_start"],"critical":true},
      {"id":"auxiliary_regulation","metric":"output_voltage","analysis":"dc_sweep","observation":{"kind":"port","id":"auxiliary_output"},"min":3.15,"max":3.45,"unit":"V","operating_cases":["balanced_load","cold_start"],"critical":true},
      {"id":"primary_ripple","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"primary_output"},"max":0.12,"unit":"V_pp","operating_cases":["balanced_load"]},
      {"id":"source_change_peak","metric":"peak_voltage","analysis":"transient","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"port","id":"primary_output"},"max":5.35,"unit":"V","operating_cases":["source_change"],"critical":true},
      {"id":"startup_excursion","metric":"startup_overshoot","analysis":"startup","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"port","id":"primary_output"},"max":0.35,"unit":"V","operating_cases":["cold_start"],"critical":true},
      {"id":"fault_peak","metric":"peak_current","analysis":"transient","observation":{"kind":"port","id":"primary_output"},"max":2.2,"unit":"A","operating_cases":["primary_fault"],"critical":true}
    ],
    "constraints":{"max_components":44,"max_width_mm":58,"max_height_mm":42}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
