{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"pulse_window_supervision","title":"Pulse-window supervision interface","description":"Observe an external logic pulse and issue a bounded status state according to declared voltage and time response limits over temperature and loading."},
  "requirements":{
    "domains":[
      {"id":"control_reference","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0},
      {"id":"control_supply","kind":"supply","source":"external","min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.025}
    ],
    "ports":[
      {"id":"pulse_input","kind":"digital","direction":"sink","domain":"control_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.6,"max_current_a":0.0001,"input_impedance_min_ohm":300000,"default_state":"low"}},
      {"id":"hold_input","kind":"digital","direction":"sink","domain":"control_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.6,"max_current_a":0.0001,"input_impedance_min_ohm":300000,"default_state":"low"}},
      {"id":"status_output","kind":"digital","direction":"source","domain":"control_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.6,"max_current_a":0.004,"default_state":"low"}},
      {"id":"control_power","kind":"power","direction":"sink","domain":"control_supply","electrical":{"min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.025}},
      {"id":"control_return","kind":"reference","direction":"bidirectional","domain":"control_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.025}}
    ],
    "operating_cases":[
      {"id":"pulse_assertion","conditions":[
        {"axis":"ambient_temperature","target":"control_reference","min":-30,"max":75,"unit":"degC"},
        {"axis":"supply_voltage","target":"control_supply","min":2.7,"max":3.6,"unit":"V"},
        {"axis":"load_capacitance","target":"status_output","min":0,"max":0.00000000008,"unit":"F"}
      ],"events":[{"id":"pulse_edge","kind":"input_step","target":"pulse_input","trigger_time_s":0.002,"initial":0,"applied":3.3,"unit":"V"}]},
      {"id":"hold_assertion","conditions":[
        {"axis":"ambient_temperature","target":"control_reference","min":-30,"max":75,"unit":"degC"},
        {"axis":"supply_voltage","target":"control_supply","min":2.7,"max":3.6,"unit":"V"},
        {"axis":"load_resistance","target":"status_output","min":20000,"max":200000,"unit":"ohm"}
      ],"events":[{"id":"hold_edge","kind":"input_step","target":"hold_input","trigger_time_s":0.001,"initial":0,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"pulse_high_threshold","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"pulse_input"},"observation":{"kind":"port","id":"status_output"},"min":1.65,"max":2.25,"unit":"V","operating_cases":["pulse_assertion"],"critical":true},
      {"id":"pulse_low_threshold","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"pulse_input"},"observation":{"kind":"port","id":"status_output"},"min":0.65,"max":1.25,"unit":"V","operating_cases":["pulse_assertion"]},
      {"id":"threshold_separation","metric":"hysteresis","analysis":"dc_sweep","excitation":{"kind":"port","id":"pulse_input"},"observation":{"kind":"port","id":"status_output"},"min":0.3,"unit":"V","operating_cases":["pulse_assertion"]},
      {"id":"status_response","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"pulse_input"},"observation":{"kind":"port","id":"status_output"},"max":0.00002,"unit":"s","operating_cases":["pulse_assertion"],"critical":true},
      {"id":"held_status_low","metric":"output_low_voltage","analysis":"transient","excitation":{"kind":"port","id":"hold_input"},"observation":{"kind":"port","id":"status_output"},"max":0.25,"unit":"V","operating_cases":["hold_assertion"],"critical":true},
      {"id":"active_status_high","metric":"output_high_voltage","analysis":"transient","observation":{"kind":"port","id":"status_output"},"min":2.4,"unit":"V","operating_cases":["pulse_assertion"]}
    ],
    "constraints":{"max_components":20,"max_width_mm":30,"max_height_mm":22}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
