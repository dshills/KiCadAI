{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "quiet_current_readout",
    "title": "Quiet Current Readout",
    "description": "Study a bounded current input and produce a proportional voltage while preserving small-signal response across the stated environment."
  },
  "requirements": {
    "domains": [
      {"id":"signal_return","kind":"reference","source":"external","nominal_voltage_v":0},
      {"id":"readout_supply","kind":"supply","source":"external","min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.03}
    ],
    "ports": [
      {"id":"sense_current","kind":"analog_current","direction":"sink","domain":"signal_return","electrical":{"min_voltage_v":-0.02,"nominal_voltage_v":0,"max_voltage_v":0.02,"max_current_a":0.000018}},
      {"id":"readout_voltage","kind":"analog_voltage","direction":"source","domain":"signal_return","electrical":{"min_voltage_v":0.1,"nominal_voltage_v":2.5,"max_voltage_v":4.65,"max_current_a":0.002}},
      {"id":"supply_input","kind":"power","direction":"sink","domain":"readout_supply","electrical":{"min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.03}},
      {"id":"return_node","kind":"reference","direction":"bidirectional","domain":"signal_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"fine_signal","conditions":[{"axis":"input_current","target":"sense_current","min":0.0000002,"max":0.000002,"unit":"A"},{"axis":"load_capacitance","target":"readout_voltage","min":0,"max":0.0000000001,"unit":"F"},{"axis":"ambient_temperature","target":"return_node","min":-10,"max":55,"unit":"degC"},{"axis":"supply_voltage","target":"readout_supply","min":4.75,"max":5.25,"unit":"V"}]},
      {"id":"wide_signal","conditions":[{"axis":"input_current","target":"sense_current","min":0.000002,"max":0.000018,"unit":"A"},{"axis":"load_capacitance","target":"readout_voltage","min":0.0000000001,"max":0.000000001,"unit":"F"},{"axis":"ambient_temperature","target":"return_node","min":-10,"max":55,"unit":"degC"},{"axis":"supply_voltage","target":"readout_supply","min":4.75,"max":5.25,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"current_conversion","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"readout_voltage"},"min":245000,"max":255000,"unit":"V/A","operating_cases":["fine_signal","wide_signal"],"critical":true},
      {"id":"small_signal_band","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"readout_voltage"},"min":18000,"unit":"Hz","operating_cases":["fine_signal"],"critical":true},
      {"id":"quiet_output","metric":"output_noise_rms","analysis":"noise","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"readout_voltage"},"max":0.0015,"unit":"V_rms","operating_cases":["fine_signal"]},
      {"id":"usable_span","metric":"output_swing","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"readout_voltage"},"min":4,"unit":"V_pp","operating_cases":["wide_signal"]}
    ],
    "constraints": {"max_components":18,"max_width_mm":28,"max_height_mm":24}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
