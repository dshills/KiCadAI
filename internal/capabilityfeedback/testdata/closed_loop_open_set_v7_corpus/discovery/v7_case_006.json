{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"voltage_timed_pulse_source","title":"Voltage-timed pulse source","description":"Generate a repetitive binary output whose frequency follows an external control voltage while also providing a bounded analog indication of operating level."},
  "requirements":{
    "domains":[
      {"id":"timing_reference","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0},
      {"id":"timing_supply","kind":"supply","source":"external","min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.04}
    ],
    "ports":[
      {"id":"control_voltage","kind":"analog_voltage","direction":"sink","domain":"timing_supply","electrical":{"min_voltage_v":0.5,"nominal_voltage_v":2.5,"max_voltage_v":4.5,"max_current_a":0.00005,"input_impedance_min_ohm":500000}},
      {"id":"run_input","kind":"digital","direction":"sink","domain":"timing_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5.25,"max_current_a":0.0001,"input_impedance_min_ohm":200000,"default_state":"low"}},
      {"id":"pulse_output","kind":"digital","direction":"source","domain":"timing_supply","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5.25,"max_current_a":0.006,"default_state":"low"}},
      {"id":"level_output","kind":"analog_voltage","direction":"source","domain":"timing_supply","electrical":{"min_voltage_v":0.4,"nominal_voltage_v":2.5,"max_voltage_v":4.6,"max_current_a":0.002}},
      {"id":"timing_power","kind":"power","direction":"sink","domain":"timing_supply","electrical":{"min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.04}},
      {"id":"timing_return","kind":"reference","direction":"bidirectional","domain":"timing_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.04}}
    ],
    "operating_cases":[
      {"id":"low_control","conditions":[
        {"axis":"ambient_temperature","target":"timing_reference","min":-10,"max":60,"unit":"degC"},
        {"axis":"supply_voltage","target":"timing_supply","min":4.75,"max":5.25,"unit":"V"},
        {"axis":"input_voltage","target":"control_voltage","min":0.5,"max":1.5,"unit":"V"},
        {"axis":"load_capacitance","target":"pulse_output","min":0,"max":0.00000000005,"unit":"F"}
      ]},
      {"id":"high_control","conditions":[
        {"axis":"ambient_temperature","target":"timing_reference","min":-10,"max":60,"unit":"degC"},
        {"axis":"supply_voltage","target":"timing_supply","min":4.75,"max":5.25,"unit":"V"},
        {"axis":"input_voltage","target":"control_voltage","min":3.5,"max":4.5,"unit":"V"},
        {"axis":"load_resistance","target":"level_output","min":20000,"max":200000,"unit":"ohm"}
      ]},
      {"id":"run_transition","conditions":[
        {"axis":"ambient_temperature","target":"timing_reference","min":20,"max":30,"unit":"degC"},
        {"axis":"supply_voltage","target":"timing_supply","min":4.75,"max":5.25,"unit":"V"},
        {"axis":"input_voltage","target":"control_voltage","min":2.45,"max":2.55,"unit":"V"}
      ],"events":[{"id":"run_edge","kind":"input_step","target":"run_input","trigger_time_s":0.001,"initial":0,"applied":5,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"run_latency","metric":"startup_output_voltage","analysis":"startup","excitation":{"kind":"port","id":"run_input"},"observation":{"kind":"port","id":"pulse_output"},"min":4,"unit":"V","operating_cases":["run_transition"],"critical":true},
      {"id":"low_range_frequency","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"control_voltage"},"observation":{"kind":"port","id":"pulse_output"},"min":800,"max":4200,"unit":"Hz","operating_cases":["low_control"]},
      {"id":"high_range_frequency","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"control_voltage"},"observation":{"kind":"port","id":"pulse_output"},"min":8500,"max":12500,"unit":"Hz","operating_cases":["high_control"]},
      {"id":"pulse_balance","metric":"duty_cycle","analysis":"transient","observation":{"kind":"port","id":"pulse_output"},"min":42,"max":58,"unit":"%","operating_cases":["low_control","high_control"]},
      {"id":"control_loading","metric":"input_impedance","analysis":"dc_operating_point","observation":{"kind":"port","id":"control_voltage"},"min":500000,"unit":"ohm","operating_cases":["low_control","high_control"]},
      {"id":"level_tracking","metric":"voltage_gain","analysis":"dc_sweep","excitation":{"kind":"port","id":"control_voltage"},"observation":{"kind":"port","id":"level_output"},"min":0.95,"max":1.05,"unit":"ratio","operating_cases":["low_control","high_control"]}
    ],
    "constraints":{"max_components":26,"max_width_mm":36,"max_height_mm":25}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
