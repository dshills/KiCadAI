{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "three_level_interlock",
    "title": "Three-Input Interlock",
    "description": "Assert an output only when all declared input levels are valid, with bounded static levels and transition timing over the specified loading range."
  },
  "requirements": {
    "domains": [
      {"id":"logic_return","kind":"reference","source":"external","nominal_voltage_v":0},
      {"id":"logic_supply","kind":"supply","source":"external","min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.02}
    ],
    "ports": [
      {"id":"permit_a","kind":"digital","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"permit_b","kind":"digital","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"permit_c","kind":"digital","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"combined_permit","kind":"digital","direction":"source","domain":"logic_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.006,"default_state":"low"}},
      {"id":"logic_power","kind":"power","direction":"sink","domain":"logic_supply","electrical":{"min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.02}},
      {"id":"logic_common","kind":"reference","direction":"bidirectional","domain":"logic_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"all_permitted","conditions":[{"axis":"input_voltage","target":"permit_a","min":2.2,"max":3.6,"unit":"V"},{"axis":"input_voltage","target":"permit_b","min":2.2,"max":3.6,"unit":"V"},{"axis":"input_voltage","target":"permit_c","min":2.2,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"combined_permit","min":0,"max":0.0000000002,"unit":"F"},{"axis":"supply_voltage","target":"logic_supply","min":2.7,"max":3.6,"unit":"V"}]},
      {"id":"one_blocked","conditions":[{"axis":"input_voltage","target":"permit_a","min":0,"max":0.6,"unit":"V"},{"axis":"input_voltage","target":"permit_b","min":2.2,"max":3.6,"unit":"V"},{"axis":"input_voltage","target":"permit_c","min":2.2,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"combined_permit","min":0,"max":0.0000000002,"unit":"F"},{"axis":"supply_voltage","target":"logic_supply","min":2.7,"max":3.6,"unit":"V"}]},
      {"id":"permit_transition","conditions":[{"axis":"input_voltage","target":"permit_a","min":0,"max":3.6,"unit":"V"},{"axis":"input_voltage","target":"permit_b","min":2.2,"max":3.6,"unit":"V"},{"axis":"input_voltage","target":"permit_c","min":2.2,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"combined_permit","min":0.00000000005,"max":0.0000000002,"unit":"F"}],"events":[{"id":"permit_a_rise","kind":"input_step","target":"permit_a","trigger_time_s":0.000001,"initial":0,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"valid_high","metric":"output_high_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"permit_a"},"observation":{"kind":"port","id":"combined_permit"},"min":2.4,"unit":"V","operating_cases":["all_permitted"],"critical":true},
      {"id":"blocked_low","metric":"output_low_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"permit_a"},"observation":{"kind":"port","id":"combined_permit"},"max":0.4,"unit":"V","operating_cases":["one_blocked"],"critical":true},
      {"id":"decision_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"permit_a"},"observation":{"kind":"port","id":"combined_permit"},"max":0.00000035,"unit":"s","operating_cases":["permit_transition"],"critical":true},
      {"id":"output_rise","metric":"rise_time","analysis":"transient","excitation":{"kind":"port","id":"permit_a"},"observation":{"kind":"port","id":"combined_permit"},"max":0.00000012,"unit":"s","operating_cases":["permit_transition"]}
    ],
    "constraints": {"max_components":14,"max_width_mm":22,"max_height_mm":18}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
