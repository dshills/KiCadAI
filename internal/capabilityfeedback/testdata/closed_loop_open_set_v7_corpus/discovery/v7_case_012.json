{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "gated_current_command",
    "title": "Gated Current Command",
    "description": "Convert an input command voltage to a bounded output current when enabled and suppress the output when disabled, including transition behavior."
  },
  "requirements": {
    "domains": [
      {"id":"command_return","kind":"reference","source":"external","nominal_voltage_v":0},
      {"id":"command_supply","kind":"supply","source":"external","min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.15}
    ],
    "ports": [
      {"id":"level_command","kind":"analog_voltage","direction":"sink","domain":"command_return","electrical":{"min_voltage_v":0.2,"nominal_voltage_v":1.2,"max_voltage_v":2.5,"input_impedance_min_ohm":100000}},
      {"id":"gate_enable","kind":"digital","direction":"sink","domain":"command_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"commanded_current","kind":"controlled_current","direction":"source","domain":"command_return","electrical":{"min_voltage_v":0,"nominal_voltage_v":2,"max_voltage_v":4,"max_current_a":0.1,"default_state":"low"}},
      {"id":"command_power","kind":"power","direction":"sink","domain":"command_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.15}},
      {"id":"command_common","kind":"reference","direction":"bidirectional","domain":"command_return","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"enabled_command","conditions":[{"axis":"input_voltage","target":"level_command","min":0.2,"max":2.5,"unit":"V"},{"axis":"input_voltage","target":"gate_enable","min":2.2,"max":5.5,"unit":"V"},{"axis":"load_resistance","target":"commanded_current","min":10,"max":40,"unit":"ohm"},{"axis":"supply_voltage","target":"command_supply","min":4.5,"max":5.5,"unit":"V"}]},
      {"id":"disabled_command","conditions":[{"axis":"input_voltage","target":"level_command","min":0.2,"max":2.5,"unit":"V"},{"axis":"input_voltage","target":"gate_enable","min":0,"max":0.6,"unit":"V"},{"axis":"load_resistance","target":"commanded_current","min":10,"max":40,"unit":"ohm"},{"axis":"ambient_temperature","target":"command_common","min":-20,"max":60,"unit":"degC"}]},
      {"id":"gate_transition","conditions":[{"axis":"input_voltage","target":"level_command","min":1,"max":1.2,"unit":"V"},{"axis":"input_voltage","target":"gate_enable","min":0,"max":5,"unit":"V"},{"axis":"load_inductance","target":"commanded_current","min":0,"max":0.0002,"unit":"H"}],"events":[{"id":"enable_rise","kind":"input_step","target":"gate_enable","trigger_time_s":0.0001,"initial":0,"applied":5,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"command_ratio","metric":"transconductance","analysis":"dc_sweep","excitation":{"kind":"port","id":"level_command"},"observation":{"kind":"port","id":"commanded_current"},"min":0.039,"max":0.041,"unit":"A/V","operating_cases":["enabled_command"],"critical":true},
      {"id":"command_ceiling","metric":"output_current","analysis":"dc_sweep","excitation":{"kind":"port","id":"level_command"},"observation":{"kind":"port","id":"commanded_current"},"max":0.103,"unit":"A","operating_cases":["enabled_command"],"critical":true},
      {"id":"disabled_leakage","metric":"off_state_current","analysis":"dc_operating_point","excitation":{"kind":"port","id":"gate_enable"},"observation":{"kind":"port","id":"commanded_current"},"max":0.00001,"unit":"A","operating_cases":["disabled_command"],"critical":true},
      {"id":"enable_settle","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"gate_enable"},"observation":{"kind":"port","id":"commanded_current"},"max":0.00008,"unit":"s","operating_cases":["gate_transition"]}
    ],
    "constraints": {"max_components":24,"max_width_mm":32,"max_height_mm":25}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
