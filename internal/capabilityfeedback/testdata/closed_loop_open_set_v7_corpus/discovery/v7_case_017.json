{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"millivolt_level_mapper","title":"Millivolt-level measurement mapper","description":"Study an externally powered interface that presents a bounded high-impedance load to a small differential-range signal and produces a scaled voltage for downstream measurement."},
  "requirements":{
    "domains":[
      {"id":"measurement_return","kind":"reference","source":"external"},
      {"id":"positive_supply","kind":"supply","source":"external","min_voltage_v":5.5,"nominal_voltage_v":6.0,"max_voltage_v":6.5,"max_current_a":0.025},
      {"id":"negative_supply","kind":"supply","source":"external","min_voltage_v":-6.5,"nominal_voltage_v":-6.0,"max_voltage_v":-5.5,"max_current_a":0.015}
    ],
    "ports":[
      {"id":"positive_power_input","kind":"power","direction":"sink","domain":"positive_supply","electrical":{"min_voltage_v":5.5,"nominal_voltage_v":6.0,"max_voltage_v":6.5,"max_current_a":0.025}},
      {"id":"negative_power_input","kind":"power","direction":"sink","domain":"negative_supply","electrical":{"min_voltage_v":-6.5,"nominal_voltage_v":-6.0,"max_voltage_v":-5.5,"max_current_a":0.015}},
      {"id":"signal_input","kind":"analog_voltage","direction":"sink","domain":"measurement_return","electrical":{"min_voltage_v":0.005,"nominal_voltage_v":0.025,"max_voltage_v":0.045,"input_impedance_min_ohm":1000000}},
      {"id":"mapped_output","kind":"analog_voltage","direction":"source","domain":"measurement_return","electrical":{"min_voltage_v":0.2,"max_voltage_v":4.8,"max_current_a":0.004}}
    ],
    "operating_cases":[
      {"id":"measurement_range","conditions":[
        {"axis":"input_voltage","target":"signal_input","min":0.005,"max":0.045,"unit":"V"},
        {"axis":"supply_voltage","target":"positive_supply","min":5.5,"max":6.5,"unit":"V"},
        {"axis":"supply_voltage","target":"negative_supply","min":-6.5,"max":-5.5,"unit":"V"},
        {"axis":"load_resistance","target":"mapped_output","min":10000,"max":100000,"unit":"ohm"},
        {"axis":"ambient_temperature","target":"measurement_return","min":-5,"max":55,"unit":"degC"},
        {"axis":"tolerance_corner","target":"signal_input","min":-1,"max":1,"unit":"ratio"}
      ]},
      {"id":"small_signal_band","conditions":[
        {"axis":"input_voltage","target":"signal_input","min":0.020,"max":0.030,"unit":"V"},
        {"axis":"supply_voltage","target":"positive_supply","min":5.5,"max":6.5,"unit":"V"},
        {"axis":"supply_voltage","target":"negative_supply","min":-6.5,"max":-5.5,"unit":"V"},
        {"axis":"load_capacitance","target":"mapped_output","min":0.00000000005,"max":0.000000001,"unit":"F"},
        {"axis":"model_corner","target":"mapped_output","min":-1,"max":1,"unit":"ratio"}
      ],"events":[
        {"id":"small_signal_rise","kind":"input_step","target":"signal_input","trigger_time_s":0.002,"initial":0.020,"applied":0.030,"unit":"V"}
      ]}
    ],
    "behavioral_requirements":[
      {"id":"mapping_gain","metric":"voltage_gain","analysis":"dc_sweep","excitation":{"kind":"port","id":"signal_input"},"observation":{"kind":"port","id":"mapped_output"},"min":88,"max":96,"unit":"ratio","operating_cases":["measurement_range"]},
      {"id":"mapped_voltage_range","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"signal_input"},"observation":{"kind":"port","id":"mapped_output"},"min":0.35,"max":4.5,"unit":"V","operating_cases":["measurement_range"]},
      {"id":"input_loading","metric":"input_impedance","analysis":"dc_operating_point","excitation":{"kind":"port","id":"signal_input"},"observation":{"kind":"port","id":"signal_input"},"min":1000000,"unit":"ohm","operating_cases":["measurement_range"]},
      {"id":"measurement_noise","metric":"output_noise_rms","analysis":"noise","excitation":{"kind":"port","id":"signal_input"},"observation":{"kind":"port","id":"mapped_output"},"max":0.004,"unit":"V_rms","operating_cases":["small_signal_band"],"frequency_hz":2000},
      {"id":"measurement_bandwidth","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"signal_input"},"observation":{"kind":"port","id":"mapped_output"},"min":800,"unit":"Hz","operating_cases":["small_signal_band"]},
      {"id":"output_settling","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"signal_input"},"observation":{"kind":"port","id":"mapped_output"},"max":0.004,"unit":"s","operating_cases":["small_signal_band"]}
    ],
    "constraints":{"max_components":18,"max_width_mm":30,"max_height_mm":22}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
