{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"qualified_logic_bridge","title":"Qualified logic-state bridge","description":"Study a dual-supply interface that accepts a control state, applies an independent qualification state, and presents a bounded logic output."},
  "requirements":{
    "domains":[
      {"id":"logic_return","kind":"reference","source":"external"},
      {"id":"input_supply","kind":"supply","source":"external","min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.025},
      {"id":"output_supply","kind":"supply","source":"external","min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.04}
    ],
    "ports":[
      {"id":"input_power","kind":"power","direction":"sink","domain":"input_supply","electrical":{"min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.025}},
      {"id":"output_power","kind":"power","direction":"sink","domain":"output_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.04}},
      {"id":"logic_input","kind":"digital","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":3.6,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"qualify_input","kind":"digital","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":3.6,"input_impedance_min_ohm":50000,"default_state":"low"}},
      {"id":"logic_output","kind":"digital","direction":"source","domain":"logic_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":5.5,"max_current_a":0.008,"default_state":"low"}}
    ],
    "operating_cases":[
      {"id":"qualified_transition","conditions":[
        {"axis":"supply_voltage","target":"input_supply","min":2.7,"max":3.6,"unit":"V"},
        {"axis":"supply_voltage","target":"output_supply","min":4.5,"max":5.5,"unit":"V"},
        {"axis":"input_voltage","target":"logic_input","min":0.0,"max":3.6,"unit":"V"},
        {"axis":"input_voltage","target":"qualify_input","min":2.0,"max":3.6,"unit":"V"},
        {"axis":"load_capacitance","target":"logic_output","min":0.00000000002,"max":0.0000000002,"unit":"F"},
        {"axis":"ambient_temperature","target":"logic_return","min":-40,"max":85,"unit":"degC"},
        {"axis":"tolerance_corner","target":"logic_input","min":-1,"max":1,"unit":"ratio"}
      ],"events":[
        {"id":"data_rise","kind":"input_step","target":"logic_input","trigger_time_s":0.000001,"initial":0.0,"applied":3.3,"unit":"V"},
        {"id":"qualification_rise","kind":"input_step","target":"qualify_input","trigger_time_s":0.000003,"initial":0.0,"applied":3.3,"unit":"V"}
      ]},
      {"id":"unqualified_high_input","conditions":[
        {"axis":"input_voltage","target":"logic_input","min":2.0,"max":3.6,"unit":"V"},
        {"axis":"input_voltage","target":"qualify_input","min":0.0,"max":0.6,"unit":"V"},
        {"axis":"supply_voltage","target":"output_supply","min":4.5,"max":5.5,"unit":"V"}
      ]}
    ],
    "behavioral_requirements":[
      {"id":"input_rising_level","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"min":1.6,"max":2.3,"unit":"V","operating_cases":["qualified_transition"]},
      {"id":"input_falling_level","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"min":0.7,"max":1.4,"unit":"V","operating_cases":["qualified_transition"]},
      {"id":"qualified_high_level","metric":"output_high_voltage","analysis":"transient","excitation":{"kind":"port","id":"qualify_input"},"observation":{"kind":"port","id":"logic_output"},"min":4.0,"unit":"V","operating_cases":["qualified_transition"],"critical":true},
      {"id":"qualified_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"qualify_input"},"observation":{"kind":"port","id":"logic_output"},"max":0.0000008,"unit":"s","operating_cases":["qualified_transition"]},
      {"id":"unqualified_low_level","metric":"output_low_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"logic_input"},"observation":{"kind":"port","id":"logic_output"},"max":0.4,"unit":"V","operating_cases":["unqualified_high_input"],"critical":true},
      {"id":"output_rise_slew","metric":"rise_time","analysis":"transient","excitation":{"kind":"port","id":"qualify_input"},"observation":{"kind":"port","id":"logic_output"},"max":0.0000015,"unit":"s","operating_cases":["qualified_transition"]}
    ],
    "constraints":{"max_components":20,"max_width_mm":34,"max_height_mm":24}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
