{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"dual_rail_load_service","title":"Sequenced dual-rail load service","description":"Study an input-powered assembly that supplies two regulated load rails with bounded startup sequencing, ripple, and shared-input demand."},
  "requirements":{
    "domains":[
      {"id":"power_return","kind":"reference","source":"external"},
      {"id":"source_rail","kind":"supply","source":"external","min_voltage_v":18.0,"nominal_voltage_v":24.0,"max_voltage_v":30.0,"max_current_a":1.8}
    ],
    "ports":[
      {"id":"source_input","kind":"power","direction":"sink","domain":"source_rail","electrical":{"min_voltage_v":18.0,"nominal_voltage_v":24.0,"max_voltage_v":30.0,"max_current_a":1.8}},
      {"id":"service_enable","kind":"digital","direction":"sink","domain":"power_return","electrical":{"min_voltage_v":0.0,"max_voltage_v":5.5,"input_impedance_min_ohm":20000,"default_state":"low"}},
      {"id":"rail_a_output","kind":"power","direction":"source","domain":"power_return","electrical":{"min_voltage_v":4.8,"nominal_voltage_v":5.0,"max_voltage_v":5.2,"max_current_a":2.0}},
      {"id":"rail_b_output","kind":"power","direction":"source","domain":"power_return","electrical":{"min_voltage_v":11.6,"nominal_voltage_v":12.0,"max_voltage_v":12.4,"max_current_a":0.55}}
    ],
    "operating_cases":[
      {"id":"combined_load","conditions":[
        {"axis":"supply_voltage","target":"source_rail","min":18.0,"max":30.0,"unit":"V"},
        {"axis":"load_current","target":"rail_a_output","min":0.15,"max":2.0,"unit":"A"},
        {"axis":"load_current","target":"rail_b_output","min":0.04,"max":0.55,"unit":"A"},
        {"axis":"ambient_temperature","target":"power_return","min":-10,"max":60,"unit":"degC"},
        {"axis":"model_corner","target":"source_input","min":-1,"max":1,"unit":"ratio"}
      ]},
      {"id":"enabled_start","conditions":[
        {"axis":"supply_voltage","target":"source_rail","min":18.0,"max":30.0,"unit":"V"},
        {"axis":"load_current","target":"rail_a_output","min":0.15,"max":1.0,"unit":"A"},
        {"axis":"load_current","target":"rail_b_output","min":0.04,"max":0.3,"unit":"A"}
      ],"events":[
        {"id":"enable_rise","kind":"input_step","target":"service_enable","trigger_time_s":0.005,"initial":0.0,"applied":5.0,"unit":"V"}
      ]},
      {"id":"rail_a_load_change","conditions":[
        {"axis":"supply_voltage","target":"source_rail","min":22.0,"max":26.0,"unit":"V"},
        {"axis":"load_current","target":"rail_b_output","min":0.2,"max":0.2,"unit":"A"}
      ],"events":[
        {"id":"load_a_rise","kind":"load_step","target":"rail_a_output","trigger_time_s":0.003,"initial":0.2,"applied":1.8,"unit":"A"}
      ]}
    ],
    "behavioral_requirements":[
      {"id":"rail_a_regulation","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"port","id":"rail_a_output"},"min":4.8,"max":5.2,"unit":"V","operating_cases":["combined_load"],"critical":true},
      {"id":"rail_b_regulation","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"port","id":"rail_b_output"},"min":11.6,"max":12.4,"unit":"V","operating_cases":["combined_load"],"critical":true},
      {"id":"rail_a_ripple","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"rail_a_output"},"max":0.08,"unit":"V_pp","operating_cases":["combined_load"],"critical":false},
      {"id":"rail_b_ripple","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"rail_b_output"},"max":0.12,"unit":"V_pp","operating_cases":["combined_load"],"critical":false},
      {"id":"rail_a_start_limit","metric":"startup_overshoot","analysis":"startup","excitation":{"kind":"port","id":"service_enable"},"observation":{"kind":"port","id":"rail_a_output"},"max":0.3,"unit":"V","operating_cases":["enabled_start"]},
      {"id":"rail_b_start_limit","metric":"startup_overshoot","analysis":"startup","excitation":{"kind":"port","id":"service_enable"},"observation":{"kind":"port","id":"rail_b_output"},"max":0.5,"unit":"V","operating_cases":["enabled_start"]},
      {"id":"rail_a_load_recovery","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"rail_a_output"},"observation":{"kind":"port","id":"rail_a_output"},"max":0.002,"unit":"s","operating_cases":["rail_a_load_change"]},
      {"id":"input_efficiency","metric":"conversion_efficiency","analysis":"dc_operating_point","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"circuit","id":"combined_power_service"},"min":82,"unit":"%","operating_cases":["combined_load"]},
      {"id":"rail_a_delivered_power","metric":"output_power","analysis":"dc_sweep","excitation":{"kind":"port","id":"source_input"},"observation":{"kind":"port","id":"rail_a_output"},"min":0.7,"max":10.5,"unit":"W","operating_cases":["combined_load"]}
    ],
    "constraints":{"max_components":40,"max_width_mm":68,"max_height_mm":46}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
