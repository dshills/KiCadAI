{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "precision_current_readout",
    "title": "Precision current-to-voltage readout",
    "description": "Study a bounded current input and produce a low-noise voltage whose steady and frequency-dependent behavior remains defined across the declared operating envelope."
  },
  "requirements": {
    "domains": [
      {"id":"signal_reference","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0},
      {"id":"positive_supply","kind":"supply","source":"external","min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.08}
    ],
    "ports": [
      {"id":"current_input","kind":"analog_current","direction":"sink","domain":"signal_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0.9,"max_voltage_v":1.8,"max_current_a":0.00012,"input_impedance_min_ohm":50}},
      {"id":"voltage_output","kind":"analog_voltage","direction":"source","domain":"positive_supply","electrical":{"min_voltage_v":0.15,"nominal_voltage_v":1.65,"max_voltage_v":3.2,"max_current_a":0.002}},
      {"id":"supply_input","kind":"power","direction":"sink","domain":"positive_supply","electrical":{"min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.08}},
      {"id":"reference_connection","kind":"reference","direction":"bidirectional","domain":"signal_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.08}}
    ],
    "operating_cases": [
      {
        "id": "room_range",
        "conditions": [
          {"axis":"ambient_temperature","target":"signal_reference","min":20,"max":30,"unit":"degC"},
          {"axis":"supply_voltage","target":"positive_supply","min":4.95,"max":5.05,"unit":"V"},
          {"axis":"input_current","target":"current_input","min":0.00001,"max":0.0001,"unit":"A"},
          {"axis":"load_resistance","target":"voltage_output","min":10000,"max":100000,"unit":"ohm"}
        ]
      },
      {
        "id": "full_envelope",
        "conditions": [
          {"axis":"ambient_temperature","target":"signal_reference","min":-20,"max":70,"unit":"degC"},
          {"axis":"supply_voltage","target":"positive_supply","min":4.75,"max":5.25,"unit":"V"},
          {"axis":"input_current","target":"current_input","min":0.000002,"max":0.00012,"unit":"A"},
          {"axis":"load_capacitance","target":"voltage_output","min":0,"max":0.000000001,"unit":"F"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"conversion_ratio","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"voltage_output"},"min":24500,"max":25500,"unit":"V/A","operating_cases":["room_range","full_envelope"],"critical":true},
      {"id":"usable_bandwidth","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"current_input"},"observation":{"kind":"port","id":"voltage_output"},"min":18000,"unit":"Hz","operating_cases":["room_range","full_envelope"]},
      {"id":"integrated_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"voltage_output"},"max":0.002,"unit":"V_rms","operating_cases":["room_range","full_envelope"],"frequency_hz":18000},
      {"id":"bounded_output","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"voltage_output"},"min":0.18,"max":3.1,"unit":"V","operating_cases":["room_range","full_envelope"],"critical":true}
    ],
    "constraints": {"max_components":18,"max_width_mm":32,"max_height_mm":24}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
