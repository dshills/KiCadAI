{
  "schema":"kicadai.open-topology-requirement.v1",
  "version":1,
  "project":{"name":"isolated_logic_exchange","title":"Bounded logic-level exchange","description":"Transfer externally applied binary states between two voltage domains with defined thresholds, timing, loading, and inactive-source behavior."},
  "requirements":{
    "domains":[
      {"id":"logic_reference","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0},
      {"id":"input_domain","kind":"supply","source":"external","min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.02},
      {"id":"output_domain","kind":"supply","source":"external","min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.03}
    ],
    "ports":[
      {"id":"data_input","kind":"digital","direction":"sink","domain":"input_domain","electrical":{"min_voltage_v":0,"nominal_voltage_v":0.9,"max_voltage_v":1.9,"max_current_a":0.0002,"input_impedance_min_ohm":200000,"default_state":"low"}},
      {"id":"enable_input","kind":"digital","direction":"sink","domain":"output_domain","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.6,"max_current_a":0.0002,"input_impedance_min_ohm":200000,"default_state":"low"}},
      {"id":"data_output","kind":"digital","direction":"source","domain":"output_domain","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.6,"max_current_a":0.008,"default_state":"low"}},
      {"id":"input_supply","kind":"power","direction":"sink","domain":"input_domain","electrical":{"min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.02}},
      {"id":"output_supply","kind":"power","direction":"sink","domain":"output_domain","electrical":{"min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.03}},
      {"id":"logic_return","kind":"reference","direction":"bidirectional","domain":"logic_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.05}}
    ],
    "operating_cases":[
      {"id":"enabled_transfer","conditions":[
        {"axis":"ambient_temperature","target":"logic_reference","min":-20,"max":70,"unit":"degC"},
        {"axis":"supply_voltage","target":"input_domain","min":1.7,"max":1.9,"unit":"V"},
        {"axis":"supply_voltage","target":"output_domain","min":3,"max":3.6,"unit":"V"},
        {"axis":"load_capacitance","target":"data_output","min":0.000000000005,"max":0.00000000005,"unit":"F"}
      ],"events":[{"id":"data_rise","kind":"input_step","target":"data_input","trigger_time_s":0.000001,"initial":0,"applied":1.8,"unit":"V"}]},
      {"id":"input_power_absent","conditions":[
        {"axis":"ambient_temperature","target":"logic_reference","min":-20,"max":70,"unit":"degC"},
        {"axis":"supply_voltage","target":"output_domain","min":3,"max":3.6,"unit":"V"},
        {"axis":"load_resistance","target":"data_output","min":10000,"max":100000,"unit":"ohm"}
      ],"events":[{"id":"input_rail_removed","kind":"rail_loss","target":"input_supply","trigger_time_s":0.000002,"initial":1.8,"applied":0,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"high_level","metric":"output_high_voltage","analysis":"transient","observation":{"kind":"port","id":"data_output"},"min":2.75,"unit":"V","operating_cases":["enabled_transfer"]},
      {"id":"recognized_high","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"data_input"},"observation":{"kind":"port","id":"data_output"},"min":0.95,"max":1.3,"unit":"V","operating_cases":["enabled_transfer"],"critical":true},
      {"id":"recognized_low","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"data_input"},"observation":{"kind":"port","id":"data_output"},"min":0.35,"max":0.75,"unit":"V","operating_cases":["enabled_transfer"],"critical":true},
      {"id":"low_level","metric":"output_low_voltage","analysis":"transient","observation":{"kind":"port","id":"data_output"},"max":0.3,"unit":"V","operating_cases":["enabled_transfer"]},
      {"id":"transfer_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"data_input"},"observation":{"kind":"port","id":"data_output"},"max":0.00000025,"unit":"s","operating_cases":["enabled_transfer"],"critical":true},
      {"id":"inactive_leakage","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"data_input"},"max":0.00001,"unit":"A","operating_cases":["input_power_absent"],"critical":true}
    ],
    "constraints":{"max_components":16,"max_width_mm":28,"max_height_mm":20}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
