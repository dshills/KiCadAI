{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"meadow_pulse","title":"Meadow Pulse","description":"Externally observable electrical behavior study over declared operating conditions."},
  "requirements":{
    "domains":[
      {"id":"measure_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"measure_rail","kind":"supply","min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.04,"source":"external"}
    ],
    "ports":[
      {"id":"measured_current","kind":"analog_current","direction":"sink","domain":"measure_return","electrical":{"min_voltage_v":0,"max_voltage_v":1,"max_current_a":0.0025}},
      {"id":"level_out","kind":"analog_voltage","direction":"source","domain":"measure_return","electrical":{"min_voltage_v":0,"max_voltage_v":4.8,"max_current_a":0.003}},
      {"id":"alert_out","kind":"digital","direction":"source","domain":"measure_rail","electrical":{"min_voltage_v":0,"max_voltage_v":5.5,"max_current_a":0.005,"default_state":"low"}},
      {"id":"measure_power","kind":"power","direction":"sink","domain":"measure_rail","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.04}}
    ],
    "operating_cases":[
      {"id":"current_scan","conditions":[
        {"axis":"input_current","target":"measured_current","min":0,"max":0.002,"unit":"A"},
        {"axis":"load_resistance","target":"level_out","min":10000,"max":1000000,"unit":"ohm"},
        {"axis":"supply_voltage","target":"measure_rail","min":4.5,"max":5.5,"unit":"V"}
      ],"events":[{"id":"current_edge","kind":"input_step","target":"measured_current","trigger_time_s":0.001,"initial":0.0004,"applied":0.0016,"unit":"A"}]},
      {"id":"weathered_scan","conditions":[
        {"axis":"input_current","target":"measured_current","min":0,"max":0.002,"unit":"A"},
        {"axis":"ambient_temperature","target":"measure_return","min":-30,"max":90,"unit":"degC"},
        {"axis":"tolerance_corner","target":"alert_out","min":-1,"max":1,"unit":"ratio"}
      ]}
    ],
    "behavioral_requirements":[
      {"id":"level_ratio","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"measured_current"},"observation":{"kind":"port","id":"level_out"},"min":1800,"max":2200,"unit":"V/A","operating_cases":["current_scan","weathered_scan"]},
      {"id":"alert_point","metric":"threshold_current","analysis":"dc_sweep","excitation":{"kind":"port","id":"measured_current"},"observation":{"kind":"port","id":"alert_out"},"min":0.0009,"max":0.0011,"unit":"A","operating_cases":["current_scan","weathered_scan"]},
      {"id":"alert_memory","metric":"hysteresis","analysis":"dc_sweep","excitation":{"kind":"port","id":"measured_current"},"observation":{"kind":"port","id":"alert_out"},"min":0.00004,"max":0.00015,"unit":"A","operating_cases":["current_scan"]},
      {"id":"alert_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"measured_current"},"observation":{"kind":"port","id":"alert_out"},"max":0.00005,"unit":"s","operating_cases":["current_scan"]},
      {"id":"alert_high","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"alert_out"},"min":4,"unit":"V","operating_cases":["current_scan","weathered_scan"]},
      {"id":"level_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"level_out"},"max":0.004,"unit":"V_rms","frequency_hz":20000,"operating_cases":["current_scan"]}
    ],
    "constraints":{"max_components":26,"max_width_mm":52,"max_height_mm":44}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
