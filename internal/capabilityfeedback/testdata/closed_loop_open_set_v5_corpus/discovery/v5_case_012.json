{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"opal_cadence","title":"Opal Cadence","description":"Externally observable electrical behavior study over declared operating conditions."},
  "requirements":{
    "domains":[
      {"id":"timing_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"timing_rail","kind":"supply","min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.06,"source":"external"}
    ],
    "ports":[
      {"id":"rate_control","kind":"analog_voltage","direction":"sink","domain":"timing_return","electrical":{"min_voltage_v":0.5,"nominal_voltage_v":2.5,"max_voltage_v":4.5,"input_impedance_min_ohm":100000}},
      {"id":"gate_in","kind":"digital","direction":"sink","domain":"timing_rail","electrical":{"min_voltage_v":0,"max_voltage_v":5.25,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"timing_out","kind":"digital","direction":"source","domain":"timing_rail","electrical":{"min_voltage_v":0,"max_voltage_v":5.25,"max_current_a":0.008,"default_state":"low"}},
      {"id":"level_out","kind":"analog_voltage","direction":"source","domain":"timing_return","electrical":{"min_voltage_v":0.2,"max_voltage_v":4.8,"max_current_a":0.004}},
      {"id":"timing_power","kind":"power","direction":"sink","domain":"timing_rail","electrical":{"min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.06}}
    ],
    "operating_cases":[
      {"id":"rate_span","conditions":[
        {"axis":"input_voltage","target":"rate_control","min":0.5,"max":4.5,"unit":"V"},
        {"axis":"load_capacitance","target":"timing_out","min":0.000000000005,"max":0.0000000001,"unit":"F"},
        {"axis":"supply_voltage","target":"timing_rail","min":4.75,"max":5.25,"unit":"V"}
      ],"events":[{"id":"gate_release","kind":"input_step","target":"gate_in","trigger_time_s":0.0001,"initial":0,"applied":5,"unit":"V"}]},
      {"id":"energizing","conditions":[
        {"axis":"input_voltage","target":"rate_control","min":2.4,"max":2.6,"unit":"V"},
        {"axis":"ambient_temperature","target":"timing_return","min":-20,"max":80,"unit":"degC"},
        {"axis":"model_corner","target":"timing_out","min":-1,"max":1,"unit":"ratio"}
      ],"events":[{"id":"power_arrival","kind":"power_step","target":"timing_power","trigger_time_s":0,"initial":0,"applied":5,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"rate_range","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"rate_control"},"observation":{"kind":"port","id":"timing_out"},"min":1000,"max":100000,"unit":"Hz","operating_cases":["rate_span"],"critical":true},
      {"id":"cycle_balance","metric":"duty_cycle","analysis":"transient","observation":{"kind":"port","id":"timing_out"},"min":40,"max":60,"unit":"%","operating_cases":["rate_span"],"critical":true},
      {"id":"timing_rise","metric":"rise_time","analysis":"transient","observation":{"kind":"port","id":"timing_out"},"max":0.000002,"unit":"s","operating_cases":["rate_span"]},
      {"id":"control_level","metric":"output_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"rate_control"},"observation":{"kind":"port","id":"level_out"},"min":0.5,"max":4.5,"unit":"V","operating_cases":["rate_span"]},
      {"id":"start_delay","metric":"settling_time","analysis":"startup","observation":{"kind":"port","id":"timing_out"},"max":0.01,"unit":"s","operating_cases":["energizing"],"critical":true},
      {"id":"start_peak","metric":"startup_current","analysis":"startup","observation":{"kind":"circuit","id":"assembly_supply_draw"},"max":0.08,"unit":"A","operating_cases":["energizing"],"critical":true}
    ],
    "constraints":{"max_components":30,"max_width_mm":58,"max_height_mm":48}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
