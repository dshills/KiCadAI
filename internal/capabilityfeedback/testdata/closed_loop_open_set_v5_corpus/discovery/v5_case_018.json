    "operating_cases":[{"id":"low_rate_service","conditions":[{"axis":"input_voltage","target":"rate_command","min":0.25,"max":0.25,"unit":"V"},{"axis":"input_voltage","target":"activity_command","min":3,"max":3,"unit":"V"},{"axis":"supply_voltage","target":"pulse_energy","min":2.7,"max":3.3,"unit":"V"},{"axis":"ambient_temperature","target":"pulse_reference","min":-10,"max":70,"unit":"degC"},{"axis":"load_capacitance","target":"pulse_output","min":0,"max":1e-9,"unit":"F"}]},{"id":"high_rate_service","conditions":[{"axis":"input_voltage","target":"rate_command","min":2.75,"max":2.75,"unit":"V"},{"axis":"input_voltage","target":"activity_command","min":3,"max":3,"unit":"V"},{"axis":"supply_voltage","target":"pulse_energy","min":2.7,"max":3.3,"unit":"V"},{"axis":"ambient_temperature","target":"pulse_reference","min":-10,"max":70,"unit":"degC"},{"axis":"load_capacitance","target":"pulse_output","min":0,"max":1e-9,"unit":"F"}]},{"id":"activation_sequence","conditions":[{"axis":"input_voltage","target":"rate_command","min":1,"max":2,"unit":"V"},{"axis":"model_corner","target":"pulse_energy","min":-1,"max":1,"unit":"ratio"}],"events":[{"id":"power_arrival","kind":"startup","target":"pulse_feed","trigger_time_s":0,"initial":0,"applied":3,"unit":"V"},{"id":"activity_enable","kind":"input_step","target":"activity_command","trigger_time_s":0.004,"initial":0,"applied":3,"unit":"V"}]}],
    "behavioral_requirements":[{"id":"low_command_rate","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"rate_command"},"observation":{"kind":"port","id":"pulse_output"},"min":800,"max":1200,"unit":"Hz","operating_cases":["low_rate_service"]},{"id":"high_command_rate","metric":"oscillation_frequency","analysis":"transient","excitation":{"kind":"port","id":"rate_command"},"observation":{"kind":"port","id":"pulse_output"},"min":8800,"max":11200,"unit":"Hz","operating_cases":["high_rate_service"]},{"id":"pulse_symmetry","metric":"duty_cycle","analysis":"transient","observation":{"kind":"port","id":"pulse_output"},"min":45,"max":55,"unit":"%","operating_cases":["low_rate_service","high_rate_service"]},{"id":"pulse_high_level","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"pulse_output"},"min":2.4,"unit":"V","operating_cases":["low_rate_service","high_rate_service"]},{"id":"disabled_output_level","metric":"output_low_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"activity_command"},"observation":{"kind":"port","id":"pulse_output"},"max":0.3,"unit":"V","operating_cases":["activation_sequence"],"critical":true},{"id":"readiness_delay","metric":"propagation_delay","analysis":"startup","observation":{"kind":"port","id":"ready_output"},"max":0.003,"unit":"s","operating_cases":["activation_sequence"],"critical":true}],
