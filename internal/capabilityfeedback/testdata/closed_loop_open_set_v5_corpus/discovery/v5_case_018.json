{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"commanded_pulse_service","title":"Commanded Pulse Service Study","description":"Evaluate a pulse output whose activity and timing respond to separate analog and digital commands across static, startup, and dynamic conditions."},
  "requirements":{
    "domains":[{"id":"pulse_reference","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"pulse_energy","kind":"supply","min_voltage_v":2.7,"nominal_voltage_v":3,"max_voltage_v":3.3,"max_current_a":0.08,"source":"external"}],
