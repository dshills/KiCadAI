{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name":"differential_current_observer","title":"Differential Current Observation Stage","description":"Study externally observable voltage response to two bounded current excitations across static, dynamic, frequency, and environmental cases."},
  "requirements": {
    "domains": [
      {"id":"signal_reference","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},
      {"id":"positive_energy","kind":"supply","min_voltage_v":7.5,"nominal_voltage_v":9,"max_voltage_v":10.5,"max_current_a":0.12,"source":"external"},
      {"id":"negative_energy","kind":"supply","min_voltage_v":-10.5,"nominal_voltage_v":-9,"max_voltage_v":-7.5,"max_current_a":0.12,"source":"external"}
    ],
    "ports": [
      {"id":"primary_current","kind":"analog_current","direction":"sink","domain":"signal_reference","electrical":{"min_voltage_v":-0.2,"nominal_voltage_v":0,"max_voltage_v":0.2,"max_current_a":0.001}},
      {"id":"balancing_current","kind":"analog_current","direction":"sink","domain":"signal_reference","electrical":{"min_voltage_v":-0.2,"nominal_voltage_v":0,"max_voltage_v":0.2,"max_current_a":0.001}},
      {"id":"difference_voltage","kind":"analog_voltage","direction":"source","domain":"signal_reference","electrical":{"min_voltage_v":-6.5,"nominal_voltage_v":0,"max_voltage_v":6.5,"max_current_a":0.015}},
      {"id":"positive_feed","kind":"power","direction":"sink","domain":"positive_energy","electrical":{"min_voltage_v":7.5,"nominal_voltage_v":9,"max_voltage_v":10.5,"max_current_a":0.12}},
      {"id":"negative_feed","kind":"power","direction":"sink","domain":"negative_energy","electrical":{"min_voltage_v":-10.5,"nominal_voltage_v":-9,"max_voltage_v":-7.5,"max_current_a":0.12}},
      {"id":"common_reference","kind":"reference","direction":"bidirectional","domain":"signal_reference","electrical":{"nominal_voltage_v":0}}
    ],
    "operating_cases": [
      {"id":"balanced_static","conditions":[{"axis":"input_current","target":"primary_current","min":-0.0002,"max":0.0002,"unit":"A"},{"axis":"input_current","target":"balancing_current","min":-0.0002,"max":0.0002,"unit":"A"},{"axis":"load_resistance","target":"difference_voltage","min":10000,"max":100000,"unit":"ohm"},{"axis":"ambient_temperature","target":"signal_reference","min":-20,"max":70,"unit":"degC"}]},
      {"id":"differential_transition","conditions":[{"axis":"input_current","target":"primary_current","min":-0.0002,"max":0.0002,"unit":"A"},{"axis":"input_current","target":"balancing_current","min":-0.0002,"max":0.0002,"unit":"A"},{"axis":"load_capacitance","target":"difference_voltage","min":0,"max":2e-9,"unit":"F"},{"axis":"supply_voltage","target":"positive_energy","min":7.5,"max":10.5,"unit":"V"}],"events":[{"id":"primary_reversal","kind":"input_step","target":"primary_current","trigger_time_s":0.001,"initial":-0.0002,"applied":0.0002,"unit":"A"},{"id":"balance_reversal","kind":"input_step","target":"balancing_current","trigger_time_s":0.002,"initial":0.00015,"applied":-0.00015,"unit":"A"}]},
      {"id":"frequency_edges","conditions":[{"axis":"input_current","target":"primary_current","min":-0.00005,"max":0.00005,"unit":"A"},{"axis":"input_current","target":"balancing_current","min":0,"max":0,"unit":"A"},{"axis":"model_corner","target":"positive_energy","min":-1,"max":1,"unit":"ratio"},{"axis":"tolerance_corner","target":"negative_energy","min":-1,"max":1,"unit":"ratio"}]}
    ],
    "behavioral_requirements": [
      {"id":"differential_scale","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"primary_current"},"observation":{"kind":"port","id":"difference_voltage"},"min":14500,"max":15500,"unit":"V/A","operating_cases":["balanced_static"],"critical":true},
      {"id":"balance_scale","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"balancing_current"},"observation":{"kind":"port","id":"difference_voltage"},"min":-15500,"max":-14500,"unit":"V/A","operating_cases":["balanced_static"],"critical":true},
      {"id":"quiet_difference","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"difference_voltage"},"max":0.00035,"unit":"V_rms","frequency_hz":20000,"operating_cases":["balanced_static","frequency_edges"],"critical":true},
      {"id":"response_bandwidth","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"primary_current"},"observation":{"kind":"port","id":"difference_voltage"},"min":180000,"unit":"Hz","operating_cases":["frequency_edges"],"critical":true},
      {"id":"transition_settling","metric":"settling_time","analysis":"transient","observation":{"kind":"port","id":"difference_voltage"},"max":0.00003,"unit":"s","operating_cases":["differential_transition"],"critical":true},
      {"id":"thermal_output_limit","metric":"peak_voltage","analysis":"electrothermal","observation":{"kind":"port","id":"difference_voltage"},"min":-6.2,"max":6.2,"unit":"V","operating_cases":["balanced_static","differential_transition"],"critical":true}
    ],
    "constraints": {"max_components":24,"max_width_mm":48,"max_height_mm":38}
  },
  "acceptance": {"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
