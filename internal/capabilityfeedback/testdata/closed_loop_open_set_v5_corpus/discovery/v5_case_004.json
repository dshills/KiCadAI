{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "granite_echo",
    "title": "Granite Echo Behavioral Study",
    "description": "Study of coordinated externally observable responses to timed control excitations."
  },
  "requirements": {
    "domains": [
      {"id": "common_reference", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "interface_energy", "kind": "supply", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.06, "source": "external"}
    ],
    "ports": [
      {"id": "timing_input", "kind": "digital", "direction": "sink", "domain": "common_reference", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.6, "input_impedance_min_ohm": 100000, "default_state": "low"}},
      {"id": "payload_input", "kind": "digital", "direction": "sink", "domain": "common_reference", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.6, "input_impedance_min_ohm": 100000, "default_state": "low"}},
      {"id": "payload_response", "kind": "digital", "direction": "source", "domain": "common_reference", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.6, "max_current_a": 0.008}},
      {"id": "attention_response", "kind": "digital", "direction": "source", "domain": "common_reference", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.6, "max_current_a": 0.004}}
    ],
    "operating_cases": [
      {
        "id": "light_loading",
        "conditions": [
          {"axis": "load_capacitance", "target": "payload_response", "min": 0.000000000005, "max": 0.00000000003, "unit": "F"},
          {"axis": "load_capacitance", "target": "attention_response", "min": 0.000000000005, "max": 0.00000000002, "unit": "F"},
          {"axis": "supply_voltage", "target": "interface_energy", "min": 3, "max": 3.6, "unit": "V"}
        ],
        "events": [
          {"id": "payload_edge", "kind": "input_step", "target": "payload_input", "trigger_time_s": 0.000002, "initial": 0, "applied": 3.3, "unit": "V"}
        ]
      },
      {
        "id": "corner_loading",
        "conditions": [
          {"axis": "load_capacitance", "target": "payload_response", "min": 0.00000000003, "max": 0.0000000001, "unit": "F"},
          {"axis": "ambient_temperature", "target": "interface_energy", "min": -20, "max": 85, "unit": "degC"},
          {"axis": "model_corner", "target": "payload_response", "min": -1, "max": 1, "unit": "ratio"}
        ],
        "events": [
          {"id": "timing_edge", "kind": "input_step", "target": "timing_input", "trigger_time_s": 0.000003, "initial": 0, "applied": 3.3, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "payload_latency", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "payload_input"}, "observation": {"kind": "port", "id": "payload_response"}, "max": 0.0000005, "unit": "s", "operating_cases": ["light_loading", "corner_loading"]},
      {"id": "attention_latency", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "timing_input"}, "observation": {"kind": "port", "id": "attention_response"}, "max": 0.0000012, "unit": "s", "operating_cases": ["corner_loading"]},
      {"id": "payload_assertion", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "payload_response"}, "min": 2.6, "unit": "V", "operating_cases": ["light_loading", "corner_loading"]},
      {"id": "attention_deassertion", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "attention_response"}, "max": 0.35, "unit": "V", "operating_cases": ["light_loading", "corner_loading"]},
      {"id": "idle_draw", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "domain", "id": "interface_energy"}, "max": 0.004, "unit": "A", "operating_cases": ["light_loading"]}
    ],
    "constraints": {"max_components": 26, "max_width_mm": 42, "max_height_mm": 30}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
