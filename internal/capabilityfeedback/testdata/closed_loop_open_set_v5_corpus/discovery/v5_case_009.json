{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"cedar_window","title":"Cedar Window","description":"Externally observable electrical behavior study over declared operating conditions."},
  "requirements":{
    "domains":[
      {"id":"logic_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"logic_rail","kind":"supply","min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04,"source":"external"}
    ],
    "ports":[
      {"id":"level_a","kind":"analog_voltage","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0,"max_voltage_v":3.6,"input_impedance_min_ohm":100000}},
      {"id":"level_b","kind":"analog_voltage","direction":"sink","domain":"logic_return","electrical":{"min_voltage_v":0,"max_voltage_v":3.6,"input_impedance_min_ohm":100000}},
      {"id":"below_out","kind":"digital","direction":"source","domain":"logic_rail","electrical":{"min_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.006,"default_state":"low"}},
      {"id":"above_out","kind":"digital","direction":"source","domain":"logic_rail","electrical":{"min_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.006,"default_state":"low"}},
      {"id":"logic_power","kind":"power","direction":"sink","domain":"logic_rail","electrical":{"min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04}}
    ],
    "operating_cases":[
      {"id":"level_sweep","conditions":[
        {"axis":"input_voltage","target":"level_a","min":0,"max":3.3,"unit":"V"},
        {"axis":"input_voltage","target":"level_b","min":0,"max":3.3,"unit":"V"},
        {"axis":"supply_voltage","target":"logic_rail","min":3,"max":3.6,"unit":"V"},
        {"axis":"ambient_temperature","target":"logic_return","min":-40,"max":85,"unit":"degC"}
      ],"events":[{"id":"crossing_edge","kind":"input_step","target":"level_a","trigger_time_s":0.00001,"initial":0.8,"applied":2.4,"unit":"V"}]},
      {"id":"rail_interruption","conditions":[
        {"axis":"input_voltage","target":"level_a","min":0,"max":3.3,"unit":"V"},
        {"axis":"load_capacitance","target":"above_out","min":0,"max":0.0000000001,"unit":"F"}
      ],"events":[{"id":"power_removed","kind":"rail_loss","target":"logic_power","trigger_time_s":0.001,"initial":3.3,"applied":0,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"lower_crossing","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"level_a"},"observation":{"kind":"port","id":"below_out"},"min":0.9,"max":1.2,"unit":"V","operating_cases":["level_sweep"],"critical":true},
      {"id":"upper_crossing","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"level_b"},"observation":{"kind":"port","id":"above_out"},"min":2.1,"max":2.4,"unit":"V","operating_cases":["level_sweep"],"critical":true},
      {"id":"crossing_memory","metric":"hysteresis","analysis":"dc_sweep","excitation":{"kind":"port","id":"level_a"},"observation":{"kind":"port","id":"below_out"},"min":0.05,"max":0.25,"unit":"V","operating_cases":["level_sweep"]},
      {"id":"edge_latency","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"level_a"},"observation":{"kind":"port","id":"above_out"},"max":0.000002,"unit":"s","operating_cases":["level_sweep"],"critical":true},
      {"id":"valid_high","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"above_out"},"min":2.7,"unit":"V","operating_cases":["level_sweep"]},
      {"id":"valid_low","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"below_out"},"max":0.35,"unit":"V","operating_cases":["level_sweep"]},
      {"id":"loss_current","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"above_out"},"max":0.00001,"unit":"A","operating_cases":["rail_interruption"],"critical":true}
    ],
    "constraints":{"max_components":22,"max_width_mm":48,"max_height_mm":40}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
