{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "cobalt_harbor",
    "title": "Cobalt Harbor Behavioral Study",
    "description": "Study of bounded energy delivery during steady, changing, and faulted external conditions."
  },
  "requirements": {
    "domains": [
      {"id": "return_reference", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "incoming_energy", "kind": "supply", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 16, "max_current_a": 1.8, "source": "external"}
    ],
    "ports": [
      {"id": "enable_request", "kind": "digital", "direction": "sink", "domain": "return_reference", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5.5, "input_impedance_min_ohm": 100000, "default_state": "low"}},
      {"id": "delivered_energy", "kind": "power", "direction": "source", "domain": "return_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5.3, "max_current_a": 2.5}}
    ],
    "operating_cases": [
      {
        "id": "rated_delivery",
        "conditions": [
          {"axis": "supply_voltage", "target": "incoming_energy", "min": 9, "max": 16, "unit": "V"},
          {"axis": "load_current", "target": "delivered_energy", "min": 0.05, "max": 1.5, "unit": "A"},
          {"axis": "ambient_temperature", "target": "incoming_energy", "min": -30, "max": 75, "unit": "degC"}
        ],
        "events": [
          {"id": "energize", "kind": "startup", "target": "enable_request", "trigger_time_s": 0.002, "initial": 0, "applied": 5, "unit": "V"},
          {"id": "demand_change", "kind": "load_step", "target": "delivered_energy", "trigger_time_s": 0.01, "initial": 0.15, "applied": 1.35, "unit": "A"}
        ]
      },
      {
        "id": "bounded_fault",
        "conditions": [
          {"axis": "supply_voltage", "target": "incoming_energy", "min": 12, "max": 16, "unit": "V"},
          {"axis": "tolerance_corner", "target": "delivered_energy", "min": -1, "max": 1, "unit": "ratio"}
        ],
        "events": [
          {"id": "output_short", "kind": "short_circuit", "target": "delivered_energy", "trigger_time_s": 0.006, "initial": 5, "applied": 0, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "regulated_level", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "delivered_energy"}, "min": 4.85, "max": 5.15, "unit": "V", "operating_cases": ["rated_delivery"], "critical": true},
      {"id": "energy_conversion", "metric": "conversion_efficiency", "analysis": "dc_sweep", "excitation": {"kind": "domain", "id": "incoming_energy"}, "observation": {"kind": "port", "id": "delivered_energy"}, "min": 0.78, "max": 1, "unit": "ratio", "operating_cases": ["rated_delivery"]},
      {"id": "fault_current_bound", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "delivered_energy"}, "max": 2.2, "unit": "A", "operating_cases": ["bounded_fault"], "critical": true},
      {"id": "temperature_bound", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "assembly_thermal_state"}, "max": 145, "unit": "degC", "operating_cases": ["rated_delivery", "bounded_fault"], "critical": true},
      {"id": "startup_peak", "metric": "startup_overshoot", "analysis": "startup", "excitation": {"kind": "port", "id": "enable_request"}, "observation": {"kind": "port", "id": "delivered_energy"}, "max": 0.25, "unit": "V", "operating_cases": ["rated_delivery"], "critical": true}
    ],
    "constraints": {"max_components": 32, "max_width_mm": 60, "max_height_mm": 45}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
