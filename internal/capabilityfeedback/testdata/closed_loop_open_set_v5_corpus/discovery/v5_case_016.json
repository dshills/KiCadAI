{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"dual_domain_command_link","title":"Dual-Domain Command Link Study","description":"Measure externally visible command transfer between independently supplied signaling domains during valid operation and bounded loss of one energy source."},
  "requirements":{
    "domains":[{"id":"shared_reference","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"command_energy","kind":"supply","min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.03,"source":"external"},{"id":"receive_energy","kind":"supply","min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04,"source":"external"}],
    "ports":[{"id":"command_data","kind":"digital","direction":"sink","domain":"shared_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":1.9,"input_impedance_min_ohm":100000,"default_state":"low"}},{"id":"command_strobe","kind":"digital","direction":"sink","domain":"shared_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":1.9,"input_impedance_min_ohm":100000,"default_state":"low"}},{"id":"received_data","kind":"digital","direction":"source","domain":"shared_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.006,"default_state":"low"}},{"id":"received_marker","kind":"digital","direction":"source","domain":"shared_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.006,"default_state":"low"}},{"id":"command_feed","kind":"power","direction":"sink","domain":"command_energy","electrical":{"min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.03}},{"id":"receive_feed","kind":"power","direction":"sink","domain":"receive_energy","electrical":{"min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04}},{"id":"common_return","kind":"reference","direction":"bidirectional","domain":"shared_reference","electrical":{"nominal_voltage_v":0}}],
    "operating_cases":[{"id":"valid_transfer","conditions":[{"axis":"supply_voltage","target":"command_energy","min":1.7,"max":1.9,"unit":"V"},{"axis":"supply_voltage","target":"receive_energy","min":3,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"received_data","min":0,"max":2e-10,"unit":"F"},{"axis":"ambient_temperature","target":"shared_reference","min":-20,"max":75,"unit":"degC"}]},{"id":"timed_commands","conditions":[{"axis":"input_voltage","target":"command_data","min":0,"max":1.8,"unit":"V"},{"axis":"input_voltage","target":"command_strobe","min":0,"max":1.8,"unit":"V"},{"axis":"model_corner","target":"receive_energy","min":-1,"max":1,"unit":"ratio"}],"events":[{"id":"data_assertion","kind":"input_step","target":"command_data","trigger_time_s":0.001,"initial":0,"applied":1.8,"unit":"V"},{"id":"strobe_assertion","kind":"input_step","target":"command_strobe","trigger_time_s":0.0015,"initial":0,"applied":1.8,"unit":"V"}]},{"id":"receive_rail_loss","conditions":[{"axis":"supply_voltage","target":"command_energy","min":1.7,"max":1.9,"unit":"V"},{"axis":"load_resistance","target":"received_data","min":10000,"max":100000,"unit":"ohm"}],"events":[{"id":"receive_energy_loss","kind":"rail_loss","target":"receive_feed","trigger_time_s":0.002,"initial":3.3,"applied":0,"unit":"V"}]}],
    "behavioral_requirements":[{"id":"received_high","metric":"output_high_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"command_data"},"observation":{"kind":"port","id":"received_data"},"min":2.7,"unit":"V","operating_cases":["valid_transfer"],"critical":true},{"id":"received_low","metric":"output_low_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"command_data"},"observation":{"kind":"port","id":"received_data"},"max":0.35,"unit":"V","operating_cases":["valid_transfer"],"critical":true},{"id":"data_latency","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"command_data"},"observation":{"kind":"port","id":"received_data"},"max":8e-7,"unit":"s","operating_cases":["timed_commands"],"critical":true},{"id":"marker_latency","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"command_strobe"},"observation":{"kind":"port","id":"received_marker"},"max":8e-7,"unit":"s","operating_cases":["timed_commands"],"critical":true},{"id":"loss_data_limit","metric":"peak_voltage","analysis":"transient","observation":{"kind":"port","id":"received_data"},"max":0.4,"unit":"V","operating_cases":["receive_rail_loss"],"critical":true},{"id":"loss_marker_limit","metric":"peak_voltage","analysis":"transient","observation":{"kind":"port","id":"received_marker"},"max":0.4,"unit":"V","operating_cases":["receive_rail_loss"],"critical":true}],
    "constraints":{"max_components":22,"max_width_mm":40,"max_height_mm":30}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
