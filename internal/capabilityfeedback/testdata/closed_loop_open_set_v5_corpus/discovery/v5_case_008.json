{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"amber_field","title":"Amber Field","description":"Externally observable electrical behavior study over declared operating conditions."},
  "requirements":{
    "domains":[
      {"id":"energy_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"energy_bus","kind":"supply","min_voltage_v":18,"nominal_voltage_v":24,"max_voltage_v":30,"max_current_a":2,"source":"external"},
      {"id":"control_rail","kind":"supply","min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.03,"source":"external"}
    ],
    "ports":[
      {"id":"power_feed","kind":"power","direction":"sink","domain":"energy_bus","electrical":{"min_voltage_v":18,"nominal_voltage_v":24,"max_voltage_v":30,"max_current_a":2}},
      {"id":"current_request","kind":"analog_voltage","direction":"sink","domain":"control_rail","electrical":{"min_voltage_v":0.2,"nominal_voltage_v":1.5,"max_voltage_v":2.8,"input_impedance_min_ohm":100000}},
      {"id":"load_drive","kind":"controlled_current","direction":"source","domain":"energy_return","electrical":{"min_voltage_v":0,"max_voltage_v":28,"max_current_a":1.2}},
      {"id":"state_out","kind":"digital","direction":"source","domain":"control_rail","electrical":{"min_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.004,"default_state":"low"}},
      {"id":"control_power","kind":"power","direction":"sink","domain":"control_rail","electrical":{"min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.03}}
    ],
    "operating_cases":[
      {"id":"commanded_load","conditions":[
        {"axis":"input_voltage","target":"current_request","min":0.5,"max":2.5,"unit":"V"},
        {"axis":"supply_voltage","target":"energy_bus","min":18,"max":30,"unit":"V"},
        {"axis":"load_resistance","target":"load_drive","min":5,"max":15,"unit":"ohm"}
      ],"events":[{"id":"demand_change","kind":"load_step","target":"load_drive","trigger_time_s":0.002,"initial":0.2,"applied":0.8,"unit":"A"}]},
      {"id":"bounded_fault","conditions":[
        {"axis":"supply_voltage","target":"energy_bus","min":18,"max":30,"unit":"V"},
        {"axis":"ambient_temperature","target":"energy_return","min":-20,"max":85,"unit":"degC"},
        {"axis":"model_corner","target":"load_drive","min":-1,"max":1,"unit":"ratio"}
      ],"events":[{"id":"load_fault","kind":"short_circuit","target":"load_drive","trigger_time_s":0.004,"initial":24,"applied":0.1,"unit":"ohm"}]}
    ],
    "behavioral_requirements":[
      {"id":"demand_tracking","metric":"output_current","analysis":"dc_sweep","excitation":{"kind":"port","id":"current_request"},"observation":{"kind":"port","id":"load_drive"},"min":0.1,"max":1,"unit":"A","operating_cases":["commanded_load"]},
      {"id":"line_stability","metric":"line_regulation","analysis":"dc_sweep","observation":{"kind":"port","id":"load_drive"},"max":2,"unit":"%","operating_cases":["commanded_load"]},
      {"id":"transfer_efficiency","metric":"conversion_efficiency","analysis":"dc_operating_point","excitation":{"kind":"port","id":"power_feed"},"observation":{"kind":"port","id":"load_drive"},"min":80,"unit":"%","operating_cases":["commanded_load"]},
      {"id":"demand_settle","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"current_request"},"observation":{"kind":"port","id":"load_drive"},"max":0.001,"unit":"s","operating_cases":["commanded_load"]},
      {"id":"fault_peak","metric":"peak_current","analysis":"transient","observation":{"kind":"port","id":"load_drive"},"max":1.4,"unit":"A","operating_cases":["bounded_fault"],"critical":true},
      {"id":"thermal_limit","metric":"junction_temperature","analysis":"electrothermal","observation":{"kind":"circuit","id":"assembly_temperature"},"max":140,"unit":"degC","operating_cases":["commanded_load","bounded_fault"],"critical":true},
      {"id":"state_high","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"state_out"},"min":2.7,"unit":"V","operating_cases":["commanded_load"]}
    ],
    "constraints":{"max_components":38,"max_width_mm":80,"max_height_mm":60}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
