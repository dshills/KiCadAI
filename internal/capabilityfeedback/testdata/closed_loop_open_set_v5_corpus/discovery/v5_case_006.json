{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "juniper_orbit",
    "title": "Juniper Orbit Behavioral Study",
    "description": "Study of periodic and state-indicating output behavior under independent external controls."
  },
  "requirements": {
    "domains": [
      {"id": "wave_reference", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "wave_energy", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.09, "source": "external"}
    ],
    "ports": [
      {"id": "rate_control", "kind": "analog_voltage", "direction": "sink", "domain": "wave_reference", "electrical": {"min_voltage_v": 0.4, "nominal_voltage_v": 2.5, "max_voltage_v": 4.6, "input_impedance_min_ohm": 100000}},
      {"id": "depth_control", "kind": "analog_voltage", "direction": "sink", "domain": "wave_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1, "max_voltage_v": 2, "input_impedance_min_ohm": 100000}},
      {"id": "wave_output", "kind": "analog_voltage", "direction": "source", "domain": "wave_reference", "electrical": {"min_voltage_v": 0.2, "nominal_voltage_v": 2.5, "max_voltage_v": 4.8, "max_current_a": 0.006}},
      {"id": "phase_output", "kind": "digital", "direction": "source", "domain": "wave_reference", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5.5, "max_current_a": 0.004}}
    ],
    "operating_cases": [
      {
        "id": "low_rate",
        "conditions": [
          {"axis": "input_voltage", "target": "rate_control", "min": 0.5, "max": 1.5, "unit": "V"},
          {"axis": "input_voltage", "target": "depth_control", "min": 0, "max": 1, "unit": "V"},
          {"axis": "load_resistance", "target": "wave_output", "min": 10000, "max": 100000, "unit": "ohm"}
        ],
        "events": [
          {"id": "rate_change", "kind": "input_step", "target": "rate_control", "trigger_time_s": 0.02, "initial": 0.75, "applied": 1.25, "unit": "V"}
        ]
      },
      {
        "id": "high_rate",
        "conditions": [
          {"axis": "input_voltage", "target": "rate_control", "min": 3.5, "max": 4.5, "unit": "V"},
          {"axis": "input_voltage", "target": "depth_control", "min": 1, "max": 2, "unit": "V"},
          {"axis": "supply_voltage", "target": "wave_energy", "min": 4.5, "max": 5.5, "unit": "V"},
          {"axis": "ambient_temperature", "target": "wave_energy", "min": -10, "max": 70, "unit": "degC"}
        ],
        "events": [
          {"id": "depth_change", "kind": "input_step", "target": "depth_control", "trigger_time_s": 0.01, "initial": 1.1, "applied": 1.8, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "low_rate_frequency", "metric": "oscillation_frequency", "analysis": "transient", "excitation": {"kind": "port", "id": "rate_control"}, "observation": {"kind": "port", "id": "wave_output"}, "min": 800, "max": 4500, "unit": "Hz", "operating_cases": ["low_rate"]},
      {"id": "high_rate_frequency", "metric": "oscillation_frequency", "analysis": "transient", "excitation": {"kind": "port", "id": "rate_control"}, "observation": {"kind": "port", "id": "wave_output"}, "min": 12000, "max": 30000, "unit": "Hz", "operating_cases": ["high_rate"]},
      {"id": "wave_excursion", "metric": "output_swing", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "depth_control"}, "observation": {"kind": "port", "id": "wave_output"}, "min": 1, "max": 4.4, "unit": "V_pp", "operating_cases": ["low_rate", "high_rate"]},
      {"id": "wave_purity", "metric": "total_harmonic_distortion", "analysis": "distortion", "observation": {"kind": "port", "id": "wave_output"}, "max": 3, "unit": "%", "frequency_hz": 10000, "operating_cases": ["low_rate", "high_rate"]},
      {"id": "phase_balance", "metric": "duty_cycle", "analysis": "transient", "observation": {"kind": "port", "id": "phase_output"}, "min": 45, "max": 55, "unit": "%", "operating_cases": ["low_rate", "high_rate"]}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 44, "max_height_mm": 34}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
