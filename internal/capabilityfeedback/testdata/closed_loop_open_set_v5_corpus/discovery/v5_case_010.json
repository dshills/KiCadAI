{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"silver_reed","title":"Silver Reed","description":"Externally observable electrical behavior study over declared operating conditions."},
  "requirements":{
    "domains":[
      {"id":"data_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"data_rail","kind":"supply","min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.025,"source":"external"}
    ],
    "ports":[
      {"id":"serial_in","kind":"digital","direction":"sink","domain":"data_rail","electrical":{"min_voltage_v":0,"max_voltage_v":1.9,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"strobe_in","kind":"digital","direction":"sink","domain":"data_rail","electrical":{"min_voltage_v":0,"max_voltage_v":1.9,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"serial_out","kind":"digital","direction":"source","domain":"data_rail","electrical":{"min_voltage_v":0,"max_voltage_v":1.9,"max_current_a":0.004,"default_state":"low"}},
      {"id":"ready_out","kind":"digital","direction":"source","domain":"data_rail","electrical":{"min_voltage_v":0,"max_voltage_v":1.9,"max_current_a":0.004,"default_state":"low"}},
      {"id":"data_power","kind":"power","direction":"sink","domain":"data_rail","electrical":{"min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.025}}
    ],
    "operating_cases":[
      {"id":"active_exchange","conditions":[
        {"axis":"input_voltage","target":"serial_in","min":0,"max":1.8,"unit":"V"},
        {"axis":"input_voltage","target":"strobe_in","min":0,"max":1.8,"unit":"V"},
        {"axis":"load_capacitance","target":"serial_out","min":0.000000000005,"max":0.00000000004,"unit":"F"},
        {"axis":"supply_voltage","target":"data_rail","min":1.7,"max":1.9,"unit":"V"}
      ],"events":[{"id":"strobe_edge","kind":"input_step","target":"strobe_in","trigger_time_s":0.000001,"initial":0,"applied":1.8,"unit":"V"}]},
      {"id":"cold_start","conditions":[
        {"axis":"ambient_temperature","target":"data_return","min":-20,"max":70,"unit":"degC"},
        {"axis":"model_corner","target":"serial_out","min":-1,"max":1,"unit":"ratio"}
      ],"events":[{"id":"rail_start","kind":"startup","target":"data_power","trigger_time_s":0,"initial":0,"applied":1.8,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"serial_high","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"serial_out"},"min":1.45,"unit":"V","operating_cases":["active_exchange"]},
      {"id":"serial_low","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"serial_out"},"max":0.25,"unit":"V","operating_cases":["active_exchange"]},
      {"id":"serial_latency","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"serial_in"},"observation":{"kind":"port","id":"serial_out"},"max":0.00000008,"unit":"s","operating_cases":["active_exchange"]},
      {"id":"ready_latency","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"strobe_in"},"observation":{"kind":"port","id":"ready_out"},"max":0.00000015,"unit":"s","operating_cases":["active_exchange"]},
      {"id":"startup_level","metric":"startup_output_voltage","analysis":"startup","observation":{"kind":"port","id":"ready_out"},"max":0.25,"unit":"V","operating_cases":["cold_start"]},
      {"id":"idle_draw","metric":"quiescent_current","analysis":"dc_operating_point","observation":{"kind":"circuit","id":"assembly_supply_draw"},"max":0.0005,"unit":"A","operating_cases":["active_exchange","cold_start"]}
    ],
    "constraints":{"max_components":28,"max_width_mm":50,"max_height_mm":42}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
