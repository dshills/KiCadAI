{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"remote_current_interpreter","title":"Remote Current Interpretation Study","description":"Assess a bounded current-input measurement response under static range, frequency content, environmental variation, and abrupt excitation changes."},
  "requirements":{
    "domains":[{"id":"measurement_reference","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"measurement_energy","kind":"supply","min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.06,"source":"external"}],
    "ports":[{"id":"sensed_current","kind":"analog_current","direction":"sink","domain":"measurement_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0.2,"max_voltage_v":0.4,"max_current_a":0.000025}},{"id":"measurement_voltage","kind":"analog_voltage","direction":"source","domain":"measurement_reference","electrical":{"min_voltage_v":0.3,"nominal_voltage_v":2.5,"max_voltage_v":4.7,"max_current_a":0.004}},{"id":"measurement_feed","kind":"power","direction":"sink","domain":"measurement_energy","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.06}},{"id":"measurement_return","kind":"reference","direction":"bidirectional","domain":"measurement_reference","electrical":{"nominal_voltage_v":0}}],
    "operating_cases":[{"id":"full_range","conditions":[{"axis":"input_current","target":"sensed_current","min":0.000004,"max":0.00002,"unit":"A"},{"axis":"supply_voltage","target":"measurement_energy","min":4.5,"max":5.5,"unit":"V"},{"axis":"ambient_temperature","target":"measurement_reference","min":-30,"max":80,"unit":"degC"},{"axis":"load_resistance","target":"measurement_voltage","min":20000,"max":200000,"unit":"ohm"}]},{"id":"changing_signal","conditions":[{"axis":"input_current","target":"sensed_current","min":0.000006,"max":0.000018,"unit":"A"},{"axis":"load_capacitance","target":"measurement_voltage","min":0,"max":1e-8,"unit":"F"},{"axis":"tolerance_corner","target":"measurement_energy","min":-1,"max":1,"unit":"ratio"}],"events":[{"id":"current_rise","kind":"input_step","target":"sensed_current","trigger_time_s":0.002,"initial":0.000006,"applied":0.000018,"unit":"A"}]}],
    "behavioral_requirements":[{"id":"measurement_scale","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_voltage"},"min":220000,"max":230000,"unit":"V/A","operating_cases":["full_range"]},{"id":"low_current_output","metric":"output_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_voltage"},"min":0.9,"max":1.1,"unit":"V","operating_cases":["full_range"]},{"id":"high_current_output","metric":"output_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_voltage"},"min":4.35,"max":4.65,"unit":"V","operating_cases":["full_range"]},{"id":"measurement_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"measurement_voltage"},"max":0.006,"unit":"V_rms","frequency_hz":1000,"operating_cases":["full_range"]},{"id":"signal_bandwidth","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_voltage"},"min":120,"unit":"Hz","operating_cases":["changing_signal"]},{"id":"step_response","metric":"settling_time","analysis":"transient","observation":{"kind":"port","id":"measurement_voltage"},"max":0.008,"unit":"s","operating_cases":["changing_signal"]}],
    "constraints":{"max_components":20,"max_width_mm":45,"max_height_mm":32}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
