{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"portable_energy_regulator","title":"Portable Energy Regulation Study","description":"Evaluate bounded power transfer to a regulated external load during steady operation, startup, and changing demand."},
  "requirements":{
    "domains":[{"id":"return_reference","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"source_energy","kind":"supply","min_voltage_v":8,"nominal_voltage_v":12,"max_voltage_v":16,"max_current_a":2.2,"source":"external"}],
