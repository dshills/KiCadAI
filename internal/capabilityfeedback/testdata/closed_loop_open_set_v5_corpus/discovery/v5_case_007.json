{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "willow_span",
    "title": "Willow Span",
    "description": "Externally observable electrical behavior study over declared operating conditions."
  },
  "requirements": {
    "domains": [
      {"id":"signal_return","kind":"reference","nominal_voltage_v":0,"source":"external"},
      {"id":"service_rail","kind":"supply","min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.08,"source":"external"}
    ],
    "ports": [
      {"id":"sense_current","kind":"analog_current","direction":"sink","domain":"signal_return","electrical":{"min_voltage_v":-0.2,"max_voltage_v":0.2,"max_current_a":0.0002}},
      {"id":"signal_out","kind":"analog_voltage","direction":"source","domain":"signal_return","electrical":{"min_voltage_v":0.1,"nominal_voltage_v":2.5,"max_voltage_v":4.9,"max_current_a":0.005}},
      {"id":"power_in","kind":"power","direction":"sink","domain":"service_rail","electrical":{"min_voltage_v":4.75,"nominal_voltage_v":5,"max_voltage_v":5.25,"max_current_a":0.08}}
    ],
    "operating_cases": [
      {"id":"centered_range","conditions":[
        {"axis":"input_current","target":"sense_current","min":-0.0001,"max":0.0001,"unit":"A"},
        {"axis":"load_resistance","target":"signal_out","min":10000,"max":1000000,"unit":"ohm"},
        {"axis":"ambient_temperature","target":"signal_return","min":20,"max":30,"unit":"degC"}
      ],"events":[{"id":"polarity_change","kind":"input_step","target":"sense_current","trigger_time_s":0.001,"initial":-0.00005,"applied":0.00005,"unit":"A"}]},
      {"id":"environment_edges","conditions":[
        {"axis":"input_current","target":"sense_current","min":-0.0001,"max":0.0001,"unit":"A"},
        {"axis":"supply_voltage","target":"service_rail","min":4.75,"max":5.25,"unit":"V"},
        {"axis":"ambient_temperature","target":"signal_return","min":-20,"max":70,"unit":"degC"},
        {"axis":"tolerance_corner","target":"signal_out","min":-1,"max":1,"unit":"ratio"}
      ]}
    ],
    "behavioral_requirements": [
      {"id":"current_response","metric":"transimpedance","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"signal_out"},"min":8000,"max":12000,"unit":"V/A","operating_cases":["centered_range","environment_edges"]},
      {"id":"usable_span","metric":"output_swing","analysis":"dc_sweep","observation":{"kind":"port","id":"signal_out"},"min":1.5,"unit":"V_pp","operating_cases":["centered_range","environment_edges"]},
      {"id":"quiet_output","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"signal_out"},"max":0.001,"unit":"V_rms","frequency_hz":10000,"operating_cases":["centered_range"]},
      {"id":"response_band","metric":"bandwidth","analysis":"ac_sweep","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"signal_out"},"min":50000,"unit":"Hz","operating_cases":["centered_range"]},
      {"id":"step_recovery","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"sense_current"},"observation":{"kind":"port","id":"signal_out"},"max":0.0002,"unit":"s","operating_cases":["centered_range"]}
    ],
    "constraints":{"max_components":24,"max_width_mm":55,"max_height_mm":45}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
