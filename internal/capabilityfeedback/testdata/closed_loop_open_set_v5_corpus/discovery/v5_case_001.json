{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "amber_delta",
    "title": "Amber Delta Behavioral Study",
    "description": "Study of externally observable transfer behavior over declared operating envelopes."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "nominal_voltage_v": 0, "source": "external"},
      {"id": "primary_energy", "kind": "supply", "min_voltage_v": 4.5, "nominal_voltage_v": 5.0, "max_voltage_v": 5.5, "max_current_a": 0.08, "source": "external"}
    ],
    "ports": [
      {"id": "stimulus_current", "kind": "analog_current", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": -0.05, "max_voltage_v": 0.05, "max_current_a": 0.0001}},
      {"id": "response_voltage", "kind": "analog_voltage", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": 0.15, "nominal_voltage_v": 2.5, "max_voltage_v": 4.85, "max_current_a": 0.004}}
    ],
    "operating_cases": [
      {
        "id": "quiet_range",
        "conditions": [
          {"axis": "input_current", "target": "stimulus_current", "min": -0.00002, "max": 0.00002, "unit": "A"},
          {"axis": "load_resistance", "target": "response_voltage", "min": 10000, "max": 1000000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "primary_energy", "min": -20, "max": 70, "unit": "degC"}
        ]
      },
      {
        "id": "edge_range",
        "conditions": [
          {"axis": "input_current", "target": "stimulus_current", "min": -0.00004, "max": 0.00004, "unit": "A"},
          {"axis": "supply_voltage", "target": "primary_energy", "min": 4.5, "max": 5.5, "unit": "V"},
          {"axis": "model_corner", "target": "response_voltage", "min": -1, "max": 1, "unit": "ratio"}
        ],
        "events": [
          {"id": "current_transition", "kind": "input_step", "target": "stimulus_current", "trigger_time_s": 0.001, "initial": -0.00002, "applied": 0.00002, "unit": "A"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "transfer_ratio", "metric": "transimpedance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "stimulus_current"}, "observation": {"kind": "port", "id": "response_voltage"}, "min": 48000, "max": 52000, "unit": "V/A", "operating_cases": ["quiet_range", "edge_range"]},
      {"id": "usable_band", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "stimulus_current"}, "observation": {"kind": "port", "id": "response_voltage"}, "min": 18000, "unit": "Hz", "operating_cases": ["quiet_range"]},
      {"id": "integrated_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "response_voltage"}, "max": 0.0006, "unit": "V_rms", "frequency_hz": 20000, "operating_cases": ["quiet_range"]},
      {"id": "transition_settle", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "stimulus_current"}, "observation": {"kind": "port", "id": "response_voltage"}, "max": 0.00012, "unit": "s", "operating_cases": ["edge_range"]}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 45, "max_height_mm": 35}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
