{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "permissive_command_monitor",
    "title": "Permissive command monitor",
    "description": "A powered command interface shall expose distinct drive and inhibit indications from externally applied command states, including bounded startup behavior."
  },
  "requirements": {
    "domains": [
      {"id": "logic_return", "kind": "reference", "source": "external"},
      {"id": "logic_supply", "kind": "supply", "source": "external", "min_voltage_v": 3.0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.1}
    ],
    "ports": [
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "logic_return", "electrical": {"nominal_voltage_v": 0}},
      {"id": "power_input", "kind": "power", "direction": "sink", "domain": "logic_supply", "electrical": {"min_voltage_v": 3.0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.1}},
      {"id": "arming_command", "kind": "digital", "direction": "sink", "domain": "logic_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "input_impedance_min_ohm": 100000}},
      {"id": "permissive_input", "kind": "digital", "direction": "sink", "domain": "logic_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "input_impedance_min_ohm": 100000}},
      {"id": "drive_indication", "kind": "digital", "direction": "source", "domain": "logic_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.004, "default_state": "low"}},
      {"id": "inhibit_indication", "kind": "digital", "direction": "source", "domain": "logic_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.004, "default_state": "high"}}
    ],
    "operating_cases": [
      {
        "id": "enabled_permitted",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3.0, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "arming_command", "min": 2.4, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "permissive_input", "min": 0, "max": 3.6, "unit": "V"}
        ],
        "events": [
          {"id": "permissive_rises", "kind": "input_step", "target": "permissive_input", "trigger_time_s": 0.001, "initial": 0, "applied": 3.3, "unit": "V"}
        ]
      },
      {
        "id": "command_disarmed",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3.0, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "arming_command", "min": 0, "max": 0.4, "unit": "V"},
          {"axis": "input_voltage", "target": "permissive_input", "min": 2.4, "max": 3.6, "unit": "V"}
        ]
      },
      {
        "id": "permissive_absent",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3.0, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "arming_command", "min": 2.4, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "permissive_input", "min": 0, "max": 0.4, "unit": "V"}
        ]
      },
      {
        "id": "blocked_startup",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3.0, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "arming_command", "min": 2.4, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "permissive_input", "min": 0, "max": 0.4, "unit": "V"}
        ],
        "events": [
          {"id": "power_applied", "kind": "startup", "target": "power_input", "trigger_time_s": 0, "initial": 0, "applied": 3.0, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "drive_asserted_when_permitted", "metric": "output_high_voltage", "analysis": "transient", "observation": {"kind": "port", "id": "drive_indication"}, "min": 2.7, "unit": "V", "operating_cases": ["enabled_permitted"], "critical": true},
      {"id": "inhibit_released_when_permitted", "metric": "output_low_voltage", "analysis": "transient", "observation": {"kind": "port", "id": "inhibit_indication"}, "max": 0.3, "unit": "V", "operating_cases": ["enabled_permitted"]},
      {"id": "drive_blocked_when_disarmed", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "drive_indication"}, "max": 0.3, "unit": "V", "operating_cases": ["command_disarmed"]},
      {"id": "inhibit_present_when_disarmed", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "inhibit_indication"}, "min": 2.7, "unit": "V", "operating_cases": ["command_disarmed"]},
      {"id": "drive_blocked_without_permissive", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "drive_indication"}, "max": 0.3, "unit": "V", "operating_cases": ["permissive_absent"], "critical": true},
      {"id": "inhibit_present_without_permissive", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "inhibit_indication"}, "min": 2.7, "unit": "V", "operating_cases": ["permissive_absent"], "critical": true},
      {"id": "permissive_response_delay", "metric": "propagation_delay", "analysis": "transient", "excitation": {"kind": "port", "id": "permissive_input"}, "observation": {"kind": "port", "id": "drive_indication"}, "max": 0.000005, "unit": "s", "operating_cases": ["enabled_permitted"], "critical": true},
      {"id": "startup_drive_suppression", "metric": "startup_output_voltage", "analysis": "startup", "observation": {"kind": "port", "id": "drive_indication"}, "max": 0.3, "unit": "V", "operating_cases": ["blocked_startup"], "critical": true}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 35, "max_height_mm": 25}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
