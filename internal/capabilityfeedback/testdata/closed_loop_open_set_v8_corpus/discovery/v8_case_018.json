{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "disturbance_scale_observer",
    "title": "Disturbance scale observer",
    "description": "A powered analog assembly shall produce a larger bounded representation of a small biased voltage disturbance and recover predictably from a finite input excursion."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external"},
      {"id": "observer_supply", "kind": "supply", "source": "external", "min_voltage_v": 10.8, "nominal_voltage_v": 12.0, "max_voltage_v": 13.2, "max_current_a": 0.15}
    ],
    "ports": [
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "signal_return", "electrical": {"nominal_voltage_v": 0}},
      {"id": "power_input", "kind": "power", "direction": "sink", "domain": "observer_supply", "electrical": {"min_voltage_v": 10.8, "nominal_voltage_v": 12.0, "max_voltage_v": 13.2, "max_current_a": 0.15}},
      {"id": "disturbance_input", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.0, "max_voltage_v": 2.0, "input_impedance_min_ohm": 100000}},
      {"id": "scaled_output", "kind": "analog_voltage", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5.0, "max_voltage_v": 10.0, "max_current_a": 0.01}}
    ],
    "operating_cases": [
      {
        "id": "small_disturbance",
        "conditions": [
          {"axis": "supply_voltage", "target": "observer_supply", "min": 10.8, "max": 13.2, "unit": "V"},
          {"axis": "input_voltage", "target": "disturbance_input", "min": 0.98, "max": 1.02, "unit": "V"},
          {"axis": "ambient_temperature", "target": "scaled_output", "min": -20, "max": 70, "unit": "degC"},
          {"axis": "load_resistance", "target": "scaled_output", "min": 10000, "max": 1000000, "unit": "ohm"}
        ]
      },
      {
        "id": "frequency_envelope",
        "conditions": [
          {"axis": "supply_voltage", "target": "observer_supply", "min": 10.8, "max": 13.2, "unit": "V"},
          {"axis": "input_voltage", "target": "disturbance_input", "min": 0.9, "max": 1.1, "unit": "V"},
          {"axis": "load_capacitance", "target": "scaled_output", "min": 0, "max": 0.0000000001, "unit": "F"}
        ]
      },
      {
        "id": "positive_excursion",
        "conditions": [
          {"axis": "supply_voltage", "target": "observer_supply", "min": 10.8, "max": 13.2, "unit": "V"},
          {"axis": "input_voltage", "target": "disturbance_input", "min": 0, "max": 2.0, "unit": "V"},
          {"axis": "load_resistance", "target": "scaled_output", "min": 2000, "max": 10000, "unit": "ohm"}
        ],
        "events": [
          {"id": "bounded_input_rise", "kind": "input_step", "target": "disturbance_input", "trigger_time_s": 0.002, "initial": 1.0, "applied": 2.0, "unit": "V"}
        ]
      },
      {
        "id": "loaded_hot",
        "conditions": [
          {"axis": "supply_voltage", "target": "observer_supply", "min": 10.8, "max": 13.2, "unit": "V"},
          {"axis": "input_voltage", "target": "disturbance_input", "min": 0.95, "max": 1.05, "unit": "V"},
          {"axis": "load_resistance", "target": "scaled_output", "min": 1000, "max": 2000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "scaled_output", "min": 75, "max": 85, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "centered_output_bias", "metric": "dc_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "disturbance_input"}, "observation": {"kind": "port", "id": "scaled_output"}, "min": 4.8, "max": 5.2, "unit": "V", "operating_cases": ["small_disturbance"]},
      {"id": "disturbance_voltage_gain", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "disturbance_input"}, "observation": {"kind": "port", "id": "scaled_output"}, "min": 18, "max": 22, "unit": "ratio", "operating_cases": ["frequency_envelope"], "frequency_hz": 1000},
      {"id": "usable_frequency_span", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "disturbance_input"}, "observation": {"kind": "port", "id": "scaled_output"}, "min": 50000, "unit": "Hz", "operating_cases": ["frequency_envelope"]},
      {"id": "bounded_excursion_peak", "metric": "peak_voltage", "analysis": "transient", "excitation": {"kind": "port", "id": "disturbance_input"}, "observation": {"kind": "port", "id": "scaled_output"}, "max": 9.8, "unit": "V", "operating_cases": ["positive_excursion"]},
      {"id": "excursion_recovery_time", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "disturbance_input"}, "observation": {"kind": "port", "id": "scaled_output"}, "max": 0.0002, "unit": "s", "operating_cases": ["positive_excursion"]},
      {"id": "loaded_assembly_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "powered_assembly"}, "max": 115, "unit": "degC", "operating_cases": ["loaded_hot"]}
    ],
    "constraints": {"max_components": 16, "max_width_mm": 32, "max_height_mm": 24}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
