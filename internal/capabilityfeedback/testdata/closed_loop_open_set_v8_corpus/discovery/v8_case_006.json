{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "controlled_sample_reporting",
    "title": "Controlled sample reporting",
    "description": "Study how an external control state governs a bounded analog observation and its independent validity indication across signal and supply corners."
  },
  "requirements": {
    "domains": [
      {"id":"control_reference","kind":"reference","source":"external"},
      {"id":"logic_energy","kind":"supply","source":"external","min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"max_current_a":0.08}
    ],
    "ports": [
      {"id":"observed_input","kind":"analog_voltage","direction":"sink","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":1.0,"max_voltage_v":2.0,"input_impedance_min_ohm":100000.0}},
      {"id":"enable","kind":"digital","direction":"sink","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":0.0,"max_voltage_v":5.5,"input_impedance_min_ohm":100000.0,"default_state":"low"}},
      {"id":"sample_out","kind":"analog_voltage","direction":"source","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":1.0,"max_voltage_v":2.1,"max_current_a":0.005}},
      {"id":"valid","kind":"digital","direction":"source","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":0.0,"max_voltage_v":5.5,"max_current_a":0.002,"default_state":"low"}},
      {"id":"supply_in","kind":"power","direction":"sink","domain":"logic_energy","electrical":{"min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":5.5,"max_current_a":0.08}},
      {"id":"return","kind":"reference","direction":"bidirectional","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":0.0,"max_voltage_v":0.0,"max_current_a":0.08}}
    ],
    "operating_cases": [
      {
        "id": "disabled",
        "conditions": [
          {"axis":"supply_voltage","target":"logic_energy","min":2.7,"max":5.5,"unit":"V"},
          {"axis":"input_voltage","target":"observed_input","min":0.0,"max":2.0,"unit":"V"},
          {"axis":"input_voltage","target":"enable","min":0.0,"max":0.3,"unit":"V"},
          {"axis":"load_resistance","target":"sample_out","min":20000.0,"max":200000.0,"unit":"ohm"}
        ]
      },
      {
        "id": "enabled_range",
        "conditions": [
          {"axis":"supply_voltage","target":"logic_energy","min":2.7,"max":5.5,"unit":"V"},
          {"axis":"input_voltage","target":"observed_input","min":0.1,"max":2.0,"unit":"V"},
          {"axis":"input_voltage","target":"enable","min":2.4,"max":5.5,"unit":"V"},
          {"axis":"load_resistance","target":"sample_out","min":20000.0,"max":200000.0,"unit":"ohm"},
          {"axis":"ambient_temperature","target":"control_reference","min":-10.0,"max":70.0,"unit":"degC"}
        ]
      },
      {
        "id": "control_transition",
        "conditions": [
          {"axis":"supply_voltage","target":"logic_energy","min":3.0,"max":3.6,"unit":"V"},
          {"axis":"input_voltage","target":"observed_input","min":0.9,"max":1.1,"unit":"V"},
          {"axis":"load_resistance","target":"sample_out","min":20000.0,"max":50000.0,"unit":"ohm"}
        ],
        "events": [
          {"id":"enable_transition","kind":"input_step","target":"enable","trigger_time_s":0.001,"initial":0.0,"applied":3.3,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"a_disabled_sample","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"sample_out"},"max":0.05,"unit":"V","operating_cases":["disabled"]},
      {"id":"b_disabled_valid","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"valid"},"max":0.4,"unit":"V","operating_cases":["disabled"]},
      {"id":"c_enabled_transfer","metric":"voltage_gain","analysis":"dc_sweep","excitation":{"kind":"port","id":"observed_input"},"observation":{"kind":"port","id":"sample_out"},"min":0.95,"max":1.05,"unit":"ratio","operating_cases":["enabled_range"]},
      {"id":"d_enabled_valid","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"valid"},"min":2.4,"unit":"V","operating_cases":["enabled_range"]},
      {"id":"e_valid_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"enable"},"observation":{"kind":"port","id":"valid"},"max":0.00005,"unit":"s","operating_cases":["control_transition"]},
      {"id":"f_sample_settling","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"enable"},"observation":{"kind":"port","id":"sample_out"},"max":0.0002,"unit":"s","operating_cases":["control_transition"]}
    ],
    "constraints": {"max_components":20,"max_width_mm":60.0,"max_height_mm":40.0}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
