{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "sample_window_guard",
    "title": "Sample Window Guard",
    "description": "Accepts a bounded analog sample and exposes separate data-valid and range-state indications with defined steady and transition behavior."
  },
  "requirements": {
    "domains": [
      {"id":"signal_reference","kind":"reference","source":"external"},
      {"id":"logic_supply","kind":"supply","source":"external","min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.1}
    ],
    "ports": [
      {"id":"sample_input","kind":"analog_voltage","direction":"sink","domain":"signal_reference","electrical":{"min_voltage_v":-0.3,"nominal_voltage_v":1.65,"max_voltage_v":3.8,"input_impedance_min_ohm":100000}},
      {"id":"data_valid","kind":"digital","direction":"source","domain":"signal_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.008,"default_state":"low"}},
      {"id":"range_notice","kind":"digital","direction":"source","domain":"signal_reference","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.008,"default_state":"low"}},
      {"id":"external_return","kind":"reference","direction":"bidirectional","domain":"signal_reference","electrical":{"nominal_voltage_v":0,"max_current_a":0.1}},
      {"id":"logic_power","kind":"power","direction":"sink","domain":"logic_supply","electrical":{"min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.1}}
    ],
    "operating_cases": [
      {
        "id": "accepted_samples",
        "conditions": [
          {"axis":"supply_voltage","target":"logic_supply","min":3.0,"max":3.6,"unit":"V"},
          {"axis":"input_voltage","target":"sample_input","min":0.2,"max":3.1,"unit":"V"},
          {"axis":"ambient_temperature","target":"signal_reference","min":-10,"max":60,"unit":"degC"}
        ]
      },
      {
        "id": "upper_range_entry",
        "conditions": [
          {"axis":"supply_voltage","target":"logic_supply","min":3.0,"max":3.6,"unit":"V"},
          {"axis":"input_voltage","target":"sample_input","min":3.1,"max":3.8,"unit":"V"}
        ],
        "events": [
          {"id":"sample_rises_outside_window","kind":"input_step","target":"sample_input","trigger_time_s":0.001,"initial":2.0,"applied":3.7,"unit":"V"}
        ]
      },
      {
        "id": "range_recovery",
        "conditions": [
          {"axis":"supply_voltage","target":"logic_supply","min":3.0,"max":3.6,"unit":"V"},
          {"axis":"input_voltage","target":"sample_input","min":0.2,"max":3.8,"unit":"V"}
        ],
        "events": [
          {"id":"sample_returns_inside_window","kind":"input_step","target":"sample_input","trigger_time_s":0.001,"initial":3.7,"applied":1.5,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"a_range_notice_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"sample_input"},"observation":{"kind":"port","id":"range_notice"},"max":0.00002,"unit":"s","operating_cases":["upper_range_entry"]},
      {"id":"b_data_inhibit_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"sample_input"},"observation":{"kind":"port","id":"data_valid"},"max":0.00003,"unit":"s","operating_cases":["upper_range_entry"]},
      {"id":"c_range_clear_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"sample_input"},"observation":{"kind":"port","id":"range_notice"},"max":0.00005,"unit":"s","operating_cases":["range_recovery"]},
      {"id":"d_valid_high_level","metric":"output_high_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"sample_input"},"observation":{"kind":"port","id":"data_valid"},"min":2.4,"unit":"V","operating_cases":["accepted_samples"]},
      {"id":"e_notice_low_level","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"range_notice"},"max":0.3,"unit":"V","operating_cases":["accepted_samples"]}
    ],
    "constraints": {"max_components":20,"max_width_mm":45,"max_height_mm":35}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
