{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "scaled_monitor_output",
    "title": "Scaled monitor signal with overload indication",
    "description": "Study a bounded low-level input that is mapped to an enlarged analog output while a separate observable indication distinguishes inputs beyond the stated linear range."
  },
  "requirements": {
    "domains": [
      {
        "id": "measurement_reference",
        "kind": "reference",
        "source": "external",
        "min_voltage_v": 0,
        "nominal_voltage_v": 0,
        "max_voltage_v": 0
      },
      {
        "id": "measurement_supply",
        "kind": "supply",
        "source": "external",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.08
      }
    ],
    "ports": [
      {
        "id": "supply_input",
        "kind": "power",
        "direction": "sink",
        "domain": "measurement_supply",
        "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.08}
      },
      {
        "id": "reference_return",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "measurement_reference",
        "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "max_current_a": 0.08}
      },
      {
        "id": "sense_input",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "measurement_reference",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 0.35, "max_current_a": 0.00001, "input_impedance_min_ohm": 1000000}
      },
      {
        "id": "conditioned_output",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "measurement_reference",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 3.6, "max_current_a": 0.005}
      },
      {
        "id": "overload_output",
        "kind": "digital",
        "direction": "source",
        "domain": "measurement_reference",
        "electrical": {"min_voltage_v": 0, "max_voltage_v": 5.25, "max_current_a": 0.002, "default_state": "low"}
      }
    ],
    "operating_cases": [
      {
        "id": "linear_measurement_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_voltage", "target": "sense_input", "min": 0.02, "max": 0.2, "unit": "V"},
          {"axis": "load_resistance", "target": "conditioned_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "sense_input", "min": -10, "max": 65, "unit": "degC"},
          {"axis": "tolerance_corner", "target": "conditioned_output", "min": 0, "max": 1, "unit": "ratio"}
        ]
      },
      {
        "id": "bounded_overload_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_voltage", "target": "sense_input", "min": 0.26, "max": 0.35, "unit": "V"},
          {"axis": "load_resistance", "target": "overload_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "sense_input", "min": -10, "max": 65, "unit": "degC"}
        ]
      },
      {
        "id": "overload_transition",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 5, "max": 5, "unit": "V"},
          {"axis": "load_resistance", "target": "overload_output", "min": 22000, "max": 22000, "unit": "ohm"}
        ],
        "events": [
          {"id": "raise_sense_level", "kind": "input_step", "target": "sense_input", "trigger_time_s": 0.002, "initial": 0.18, "applied": 0.3, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "linear_scale_factor",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "sense_input"},
        "observation": {"kind": "port", "id": "conditioned_output"},
        "min": 9.7,
        "max": 10.3,
        "unit": "ratio",
        "operating_cases": ["linear_measurement_range"]
      },
      {
        "id": "linear_output_envelope",
        "metric": "output_voltage",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "sense_input"},
        "observation": {"kind": "port", "id": "conditioned_output"},
        "min": 0.19,
        "max": 2.06,
        "unit": "V",
        "operating_cases": ["linear_measurement_range"]
      },
      {
        "id": "normal_range_indication",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "excitation": {"kind": "port", "id": "sense_input"},
        "observation": {"kind": "port", "id": "overload_output"},
        "max": 0.5,
        "unit": "V",
        "operating_cases": ["linear_measurement_range"]
      },
      {
        "id": "overload_range_indication",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "excitation": {"kind": "port", "id": "sense_input"},
        "observation": {"kind": "port", "id": "overload_output"},
        "min": 4,
        "unit": "V",
        "operating_cases": ["bounded_overload_range"]
      },
      {
        "id": "overload_indication_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {"kind": "port", "id": "sense_input"},
        "observation": {"kind": "port", "id": "overload_output"},
        "max": 0.001,
        "unit": "s",
        "operating_cases": ["overload_transition"]
      }
    ],
    "constraints": {"max_components": 20, "max_width_mm": 42, "max_height_mm": 24}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
