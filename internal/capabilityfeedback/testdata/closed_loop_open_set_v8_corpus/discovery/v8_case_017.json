{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "low_current_observer",
    "title": "Low-current observer",
    "description": "An externally powered assembly shall map a bounded unipolar current stimulus to a quiet voltage output across supply, load, and ambient conditions."
  },
  "requirements": {
    "domains": [
      {"id": "instrument_return", "kind": "reference", "source": "external"},
      {"id": "instrument_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.75, "nominal_voltage_v": 5.0, "max_voltage_v": 5.25, "max_current_a": 0.08}
    ],
    "ports": [
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "instrument_return", "electrical": {"nominal_voltage_v": 0}},
      {"id": "power_input", "kind": "power", "direction": "sink", "domain": "instrument_supply", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5.0, "max_voltage_v": 5.25, "max_current_a": 0.08}},
      {"id": "measured_current", "kind": "analog_current", "direction": "sink", "domain": "instrument_return", "electrical": {"min_voltage_v": 0, "max_voltage_v": 0.25, "max_current_a": 0.025}},
      {"id": "measurement_voltage", "kind": "analog_voltage", "direction": "source", "domain": "instrument_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.4, "max_voltage_v": 2.6, "max_current_a": 0.002}}
    ],
    "operating_cases": [
      {
        "id": "zero_stimulus",
        "conditions": [
          {"axis": "supply_voltage", "target": "instrument_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_current", "target": "measured_current", "min": 0, "max": 0.00001, "unit": "A"},
          {"axis": "ambient_temperature", "target": "measurement_voltage", "min": 20, "max": 30, "unit": "degC"}
        ]
      },
      {
        "id": "full_scale_stimulus",
        "conditions": [
          {"axis": "supply_voltage", "target": "instrument_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_current", "target": "measured_current", "min": 0.0199, "max": 0.0201, "unit": "A"},
          {"axis": "load_current", "target": "measurement_voltage", "min": 0, "max": 0.001, "unit": "A"}
        ]
      },
      {
        "id": "midrange_hot",
        "conditions": [
          {"axis": "supply_voltage", "target": "instrument_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_current", "target": "measured_current", "min": 0.0099, "max": 0.0101, "unit": "A"},
          {"axis": "ambient_temperature", "target": "measurement_voltage", "min": 75, "max": 85, "unit": "degC"},
          {"axis": "load_capacitance", "target": "measurement_voltage", "min": 0, "max": 0.00000001, "unit": "F"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "zero_current_output", "metric": "output_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 0.38, "max": 0.42, "unit": "V", "operating_cases": ["zero_stimulus"]},
      {"id": "full_scale_output", "metric": "output_voltage", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 2.35, "max": 2.45, "unit": "V", "operating_cases": ["full_scale_stimulus"]},
      {"id": "current_to_voltage_slope", "metric": "transimpedance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 95, "max": 105, "unit": "V/A", "operating_cases": ["zero_stimulus", "full_scale_stimulus", "midrange_hot"]},
      {"id": "hot_midrange_output", "metric": "output_voltage", "analysis": "thermal", "excitation": {"kind": "port", "id": "measured_current"}, "observation": {"kind": "port", "id": "measurement_voltage"}, "min": 1.32, "max": 1.48, "unit": "V", "operating_cases": ["midrange_hot"]},
      {"id": "midrange_output_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "measurement_voltage"}, "max": 0.002, "unit": "V_rms", "operating_cases": ["midrange_hot"], "frequency_hz": 10000},
      {"id": "full_scale_load_regulation", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "measurement_voltage"}, "max": 1.0, "unit": "%", "operating_cases": ["full_scale_stimulus"]}
    ],
    "constraints": {"max_components": 14, "max_width_mm": 28, "max_height_mm": 22}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
