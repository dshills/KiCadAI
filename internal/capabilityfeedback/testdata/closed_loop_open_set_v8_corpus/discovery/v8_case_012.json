{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_observable_bias",
    "title": "Dual Observable Bias",
    "description": "Provide bounded current and voltage outputs when enabled, suppress both outputs when disabled, and limit response to a finite output fault."
  },
  "requirements": {
    "domains": [
      {"id":"bias_reference","kind":"reference","source":"external"},
      {"id":"bias_supply","kind":"supply","source":"external","min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.12}
    ],
    "ports": [
      {"id":"external_return","kind":"reference","direction":"bidirectional","domain":"bias_reference","electrical":{"nominal_voltage_v":0.0,"max_current_a":0.12}},
      {"id":"supply_input","kind":"power","direction":"sink","domain":"bias_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.12}},
      {"id":"bias_enable","kind":"digital","direction":"sink","domain":"bias_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.001,"default_state":"low"}},
      {"id":"current_bias","kind":"controlled_current","direction":"source","domain":"bias_reference","electrical":{"min_voltage_v":0.2,"nominal_voltage_v":2.5,"max_voltage_v":4.0,"max_current_a":0.012}},
      {"id":"voltage_reference","kind":"analog_voltage","direction":"source","domain":"bias_reference","electrical":{"min_voltage_v":2.4,"nominal_voltage_v":2.5,"max_voltage_v":2.6,"max_current_a":0.004}}
    ],
    "operating_cases": [
      {"id":"enabled_corners","conditions":[{"axis":"supply_voltage","target":"bias_supply","min":4.5,"max":5.5,"unit":"V"},{"axis":"load_resistance","target":"current_bias","min":100,"max":300,"unit":"ohm"},{"axis":"ambient_temperature","target":"bias_reference","min":-20,"max":75,"unit":"degC"}]},
      {"id":"disabled_state","conditions":[{"axis":"input_voltage","target":"bias_enable","min":0.0,"max":0.3,"unit":"V"},{"axis":"supply_voltage","target":"bias_supply","min":4.5,"max":5.5,"unit":"V"}]},
      {"id":"bounded_output_fault","conditions":[{"axis":"supply_voltage","target":"bias_supply","min":4.5,"max":5.5,"unit":"V"},{"axis":"ambient_temperature","target":"bias_reference","min":20,"max":60,"unit":"degC"}],"events":[{"id":"finite_short_event","kind":"short_circuit","target":"current_bias","trigger_time_s":0.003,"initial":200,"applied":0.5,"unit":"ohm"}]}
    ],
    "behavioral_requirements": [
      {"id":"a_bias_current","metric":"output_current","analysis":"dc_operating_point","excitation":{"kind":"port","id":"bias_enable"},"observation":{"kind":"port","id":"current_bias"},"min":0.0095,"max":0.0105,"unit":"A","operating_cases":["enabled_corners"],"critical":true},
      {"id":"b_reference_voltage","metric":"output_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"bias_enable"},"observation":{"kind":"port","id":"voltage_reference"},"min":2.45,"max":2.55,"unit":"V","operating_cases":["enabled_corners"]},
      {"id":"c_disabled_current","metric":"off_state_current","analysis":"dc_operating_point","excitation":{"kind":"port","id":"bias_enable"},"observation":{"kind":"port","id":"current_bias"},"max":0.00001,"unit":"A","operating_cases":["disabled_state"]},
      {"id":"d_fault_peak","metric":"peak_current","analysis":"transient","excitation":{"kind":"port","id":"current_bias"},"observation":{"kind":"port","id":"current_bias"},"max":0.025,"unit":"A","operating_cases":["bounded_output_fault"],"critical":true},
      {"id":"e_fault_temperature","metric":"junction_temperature","analysis":"thermal","observation":{"kind":"circuit","id":"bounded_fault_temperature"},"max":125,"unit":"degC","operating_cases":["bounded_output_fault"],"critical":true}
    ],
    "constraints": {"max_components":20,"max_width_mm":38,"max_height_mm":34}
  },
  "acceptance": {
    "require_primitive_only":true,
    "require_topology_search":true,
    "require_simulation":true,
    "require_all_corners":true,
    "require_model_provenance":true,
    "require_closed_loop_evidence":true,
    "require_complete_routing":true,
    "require_connectivity":true,
    "require_writer_correctness":true,
    "require_round_trip_zero_diff":true,
    "require_erc":true,
    "require_strict_drc":true,
    "require_deterministic_replay":true,
    "require_fail_closed":true
  }
}
