{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_rail_supervisor",
    "title": "Bounded Rail Supervisor",
    "description": "Observe an externally driven rail and provide an alarm plus a bounded recovery-load command across normal and excursion conditions."
  },
  "requirements": {
    "domains": [
      {"id":"signal_reference","kind":"reference","source":"external"},
      {"id":"monitor_supply","kind":"supply","source":"external","min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.08}
    ],
    "ports": [
      {"id":"supply_input","kind":"power","direction":"sink","domain":"monitor_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5.0,"max_voltage_v":5.5,"max_current_a":0.08}},
      {"id":"external_return","kind":"reference","direction":"bidirectional","domain":"signal_reference","electrical":{"nominal_voltage_v":0,"max_current_a":0.08}},
      {"id":"rail_sense","kind":"analog_voltage","direction":"sink","domain":"signal_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":3.3,"max_voltage_v":6.0,"input_impedance_min_ohm":100000}},
      {"id":"alarm_output","kind":"digital","direction":"source","domain":"signal_reference","electrical":{"min_voltage_v":0.0,"max_voltage_v":5.5,"max_current_a":0.01,"default_state":"low"}},
      {"id":"recovery_command","kind":"controlled_current","direction":"source","domain":"signal_reference","electrical":{"min_voltage_v":0.0,"max_voltage_v":6.0,"max_current_a":0.025,"default_state":"low"}}
    ],
    "operating_cases": [
      {
        "id": "normal_window",
        "conditions": [
          {"axis":"supply_voltage","target":"monitor_supply","min":4.5,"max":5.5,"unit":"V"},
          {"axis":"input_voltage","target":"rail_sense","min":3.0,"max":3.6,"unit":"V"},
          {"axis":"ambient_temperature","target":"signal_reference","min":-20,"max":70,"unit":"degC"}
        ]
      },
      {
        "id": "rising_excursion",
        "conditions": [
          {"axis":"supply_voltage","target":"monitor_supply","min":4.5,"max":5.5,"unit":"V"},
          {"axis":"input_voltage","target":"rail_sense","min":3.3,"max":5.8,"unit":"V"}
        ],
        "events": [
          {"id":"rail_rise","kind":"input_step","target":"rail_sense","trigger_time_s":0.002,"initial":3.3,"applied":5.2,"unit":"V"}
        ]
      },
      {
        "id": "falling_recovery",
        "conditions": [
          {"axis":"supply_voltage","target":"monitor_supply","min":4.5,"max":5.5,"unit":"V"},
          {"axis":"input_voltage","target":"rail_sense","min":3.0,"max":5.2,"unit":"V"}
        ],
        "events": [
          {"id":"rail_fall","kind":"input_step","target":"rail_sense","trigger_time_s":0.004,"initial":5.2,"applied":3.3,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"a_dynamic_alarm_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"rail_sense"},"observation":{"kind":"port","id":"alarm_output"},"max":0.0002,"unit":"s","operating_cases":["rising_excursion","falling_recovery"]},
      {"id":"alarm_asserted_level","metric":"output_high_voltage","analysis":"dc_sweep","observation":{"kind":"port","id":"alarm_output"},"min":4.0,"unit":"V","operating_cases":["rising_excursion"]},
      {"id":"alarm_normal_level","metric":"output_low_voltage","analysis":"dc_sweep","observation":{"kind":"port","id":"alarm_output"},"max":0.4,"unit":"V","operating_cases":["normal_window"]},
      {"id":"recovery_current_active","metric":"output_current","analysis":"dc_operating_point","observation":{"kind":"port","id":"recovery_command"},"min":0.012,"max":0.025,"unit":"A","operating_cases":["rising_excursion"]},
      {"id":"recovery_current_idle","metric":"off_state_current","analysis":"dc_operating_point","observation":{"kind":"port","id":"recovery_command"},"max":0.00005,"unit":"A","operating_cases":["normal_window","falling_recovery"]}
    ],
    "constraints": {"max_components":18,"max_width_mm":38,"max_height_mm":24}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
