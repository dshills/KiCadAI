{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_bias_delivery",
    "title": "Bounded current delivery across supply and load variation",
    "description": "Study a low-level current output that remains within a defined envelope while its external supply, load, temperature, and manufacturing conditions vary."
  },
  "requirements": {
    "domains": [
      {
        "id": "signal_reference",
        "kind": "reference",
        "source": "external",
        "min_voltage_v": 0,
        "nominal_voltage_v": 0,
        "max_voltage_v": 0
      },
      {
        "id": "bias_supply",
        "kind": "supply",
        "source": "external",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.02
      }
    ],
    "ports": [
      {
        "id": "supply_input",
        "kind": "power",
        "direction": "sink",
        "domain": "bias_supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.02
        }
      },
      {
        "id": "reference_return",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0,
          "max_current_a": 0.02
        }
      },
      {
        "id": "bias_output",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0.05,
          "max_voltage_v": 1.2,
          "max_current_a": 0.0011
        }
      }
    ],
    "operating_cases": [
      {
        "id": "steady_load_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "bias_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "load_resistance", "target": "bias_output", "min": 100, "max": 1000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "bias_output", "min": -20, "max": 70, "unit": "degC"},
          {"axis": "tolerance_corner", "target": "bias_output", "min": 0, "max": 1, "unit": "ratio"},
          {"axis": "model_corner", "target": "bias_output", "min": 0, "max": 1, "unit": "ratio"}
        ]
      },
      {
        "id": "energization_response",
        "conditions": [
          {"axis": "supply_voltage", "target": "bias_supply", "min": 3.3, "max": 3.3, "unit": "V"},
          {"axis": "load_resistance", "target": "bias_output", "min": 470, "max": 470, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "bias_output", "min": 20, "max": 30, "unit": "degC"}
        ],
        "events": [
          {"id": "apply_bias_supply", "kind": "startup", "target": "supply_input", "trigger_time_s": 0, "initial": 0, "applied": 3.3, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "delivered_current_accuracy",
        "metric": "output_current",
        "analysis": "dc_sweep",
        "observation": {"kind": "port", "id": "bias_output"},
        "min": 0.00095,
        "max": 0.00105,
        "unit": "A",
        "operating_cases": ["steady_load_range"]
      },
      {
        "id": "load_induced_current_change",
        "metric": "load_regulation",
        "analysis": "dc_sweep",
        "observation": {"kind": "port", "id": "bias_output"},
        "max": 2,
        "unit": "%",
        "operating_cases": ["steady_load_range"]
      },
      {
        "id": "supply_draw_limit",
        "metric": "quiescent_current",
        "analysis": "dc_operating_point",
        "observation": {"kind": "port", "id": "supply_input"},
        "max": 0.003,
        "unit": "A",
        "operating_cases": ["steady_load_range"]
      },
      {
        "id": "current_establishment_time",
        "metric": "settling_time",
        "analysis": "startup",
        "excitation": {"kind": "port", "id": "supply_input"},
        "observation": {"kind": "port", "id": "bias_output"},
        "max": 0.002,
        "unit": "s",
        "operating_cases": ["energization_response"]
      }
    ],
    "constraints": {
      "max_components": 12,
      "max_width_mm": 28,
      "max_height_mm": 18
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
