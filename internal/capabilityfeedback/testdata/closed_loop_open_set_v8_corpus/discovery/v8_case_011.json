{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "supply_excursion_guard",
    "title": "Supply Excursion Guard",
    "description": "Report a bounded supply excursion and command a protected state within a specified response interval while preserving a separate warning indication."
  },
  "requirements": {
    "domains": [
      {"id":"control_reference","kind":"reference","source":"external"},
      {"id":"logic_supply","kind":"supply","source":"external","min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04}
    ],
    "ports": [
      {"id":"external_return","kind":"reference","direction":"bidirectional","domain":"control_reference","electrical":{"nominal_voltage_v":0.0,"max_current_a":0.04}},
      {"id":"monitored_voltage","kind":"analog_voltage","direction":"sink","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":3.3,"max_voltage_v":4.0,"max_current_a":0.001,"input_impedance_min_ohm":100000}},
      {"id":"guard_enable","kind":"digital","direction":"sink","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.001,"default_state":"high"}},
      {"id":"protected_state","kind":"digital","direction":"source","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.004,"default_state":"low"}},
      {"id":"warning_state","kind":"digital","direction":"source","domain":"control_reference","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.004,"default_state":"low"}},
      {"id":"logic_power","kind":"power","direction":"sink","domain":"logic_supply","electrical":{"min_voltage_v":3.0,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.04}}
    ],
    "operating_cases": [
      {"id":"normal_window","conditions":[{"axis":"input_voltage","target":"monitored_voltage","min":3.0,"max":3.6,"unit":"V"},{"axis":"supply_voltage","target":"logic_supply","min":3.0,"max":3.6,"unit":"V"}]},
      {"id":"bounded_drop","conditions":[{"axis":"input_voltage","target":"monitored_voltage","min":1.7,"max":3.4,"unit":"V"},{"axis":"ambient_temperature","target":"control_reference","min":-20,"max":85,"unit":"degC"}],"events":[{"id":"drop_event","kind":"input_step","target":"monitored_voltage","trigger_time_s":0.002,"initial":3.3,"applied":1.8,"unit":"V"}]},
      {"id":"bounded_recovery","conditions":[{"axis":"input_voltage","target":"monitored_voltage","min":1.7,"max":3.4,"unit":"V"},{"axis":"tolerance_corner","target":"protected_state","min":-1,"max":1,"unit":"ratio"}],"events":[{"id":"recovery_event","kind":"input_step","target":"monitored_voltage","trigger_time_s":0.004,"initial":1.8,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements": [
      {"id":"a_fault_response_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"monitored_voltage"},"observation":{"kind":"port","id":"protected_state"},"max":0.00005,"unit":"s","operating_cases":["bounded_drop"],"critical":true},
      {"id":"b_protected_asserted","metric":"output_high_voltage","analysis":"transient","excitation":{"kind":"port","id":"monitored_voltage"},"observation":{"kind":"port","id":"protected_state"},"min":2.7,"unit":"V","operating_cases":["bounded_drop"],"critical":true},
      {"id":"c_warning_asserted","metric":"output_high_voltage","analysis":"transient","excitation":{"kind":"port","id":"monitored_voltage"},"observation":{"kind":"port","id":"warning_state"},"min":2.7,"unit":"V","operating_cases":["bounded_drop"]},
      {"id":"d_normal_clear","metric":"output_low_voltage","analysis":"dc_operating_point","excitation":{"kind":"port","id":"monitored_voltage"},"observation":{"kind":"port","id":"protected_state"},"max":0.35,"unit":"V","operating_cases":["normal_window"]},
      {"id":"e_release_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"monitored_voltage"},"observation":{"kind":"port","id":"warning_state"},"max":0.001,"unit":"s","operating_cases":["bounded_recovery"]}
    ],
    "constraints": {"max_components":22,"max_width_mm":42,"max_height_mm":38}
  },
  "acceptance": {
    "require_primitive_only":true,
    "require_topology_search":true,
    "require_simulation":true,
    "require_all_corners":true,
    "require_model_provenance":true,
    "require_closed_loop_evidence":true,
    "require_complete_routing":true,
    "require_connectivity":true,
    "require_writer_correctness":true,
    "require_round_trip_zero_diff":true,
    "require_erc":true,
    "require_strict_drc":true,
    "require_deterministic_replay":true,
    "require_fail_closed":true
  }
}
