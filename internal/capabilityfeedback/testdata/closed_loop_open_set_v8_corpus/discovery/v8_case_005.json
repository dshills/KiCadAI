{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "sequenced_dual_energy_outputs",
    "title": "Sequenced dual energy outputs",
    "description": "Study two externally loaded outputs through startup, steady input variation, temperature corners, and a bounded interruption."
  },
  "requirements": {
    "domains": [
      {"id":"power_return","kind":"reference","source":"external"},
      {"id":"source_energy","kind":"supply","source":"external","min_voltage_v":7.0,"nominal_voltage_v":12.0,"max_voltage_v":16.0,"max_current_a":3.0}
    ],
    "ports": [
      {"id":"supply_in","kind":"power","direction":"sink","domain":"source_energy","electrical":{"min_voltage_v":7.0,"nominal_voltage_v":12.0,"max_voltage_v":16.0,"max_current_a":3.0}},
      {"id":"main_out","kind":"analog_voltage","direction":"source","domain":"power_return","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":5.0,"max_voltage_v":5.3,"max_current_a":1.2}},
      {"id":"auxiliary_out","kind":"analog_voltage","direction":"source","domain":"power_return","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":3.1,"max_voltage_v":3.5,"max_current_a":0.2}},
      {"id":"return","kind":"reference","direction":"bidirectional","domain":"power_return","electrical":{"min_voltage_v":0.0,"nominal_voltage_v":0.0,"max_voltage_v":0.0,"max_current_a":3.0}}
    ],
    "operating_cases": [
      {
        "id": "cold_start",
        "conditions": [
          {"axis":"supply_voltage","target":"source_energy","min":7.0,"max":16.0,"unit":"V"},
          {"axis":"load_current","target":"main_out","min":0.05,"max":1.0,"unit":"A"},
          {"axis":"load_current","target":"auxiliary_out","min":0.02,"max":0.15,"unit":"A"},
          {"axis":"ambient_temperature","target":"power_return","min":-20.0,"max":25.0,"unit":"degC"}
        ],
        "events": [
          {"id":"energize","kind":"startup","target":"supply_in","trigger_time_s":0.0,"initial":0.0,"applied":12.0,"unit":"V"}
        ]
      },
      {
        "id": "steady_extremes",
        "conditions": [
          {"axis":"supply_voltage","target":"source_energy","min":7.0,"max":16.0,"unit":"V"},
          {"axis":"load_current","target":"main_out","min":0.05,"max":1.2,"unit":"A"},
          {"axis":"load_current","target":"auxiliary_out","min":0.02,"max":0.2,"unit":"A"},
          {"axis":"ambient_temperature","target":"power_return","min":-20.0,"max":85.0,"unit":"degC"},
          {"axis":"tolerance_corner","target":"main_out","min":-1.0,"max":1.0,"unit":"ratio"}
        ]
      },
      {
        "id": "bounded_interruption",
        "conditions": [
          {"axis":"supply_voltage","target":"source_energy","min":7.0,"max":16.0,"unit":"V"},
          {"axis":"load_current","target":"main_out","min":0.05,"max":0.8,"unit":"A"},
          {"axis":"load_current","target":"auxiliary_out","min":0.02,"max":0.1,"unit":"A"}
        ],
        "events": [
          {"id":"input_loss","kind":"rail_loss","target":"supply_in","trigger_time_s":0.01,"initial":12.0,"applied":0.0,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"a_main_startup_voltage","metric":"startup_output_voltage","analysis":"startup","excitation":{"kind":"port","id":"supply_in"},"observation":{"kind":"port","id":"main_out"},"min":4.7,"max":5.3,"unit":"V","operating_cases":["cold_start"],"critical":true},
      {"id":"b_auxiliary_startup_voltage","metric":"startup_output_voltage","analysis":"startup","excitation":{"kind":"port","id":"supply_in"},"observation":{"kind":"port","id":"auxiliary_out"},"min":2.7,"max":3.5,"unit":"V","operating_cases":["cold_start"]},
      {"id":"c_main_settling","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"supply_in"},"observation":{"kind":"port","id":"main_out"},"max":0.02,"unit":"s","operating_cases":["cold_start"]},
      {"id":"d_main_regulation","metric":"output_voltage","analysis":"dc_sweep","observation":{"kind":"port","id":"main_out"},"min":4.8,"max":5.2,"unit":"V","operating_cases":["steady_extremes"]},
      {"id":"e_auxiliary_regulation","metric":"output_voltage","analysis":"dc_sweep","observation":{"kind":"port","id":"auxiliary_out"},"min":2.8,"max":3.4,"unit":"V","operating_cases":["steady_extremes"]},
      {"id":"f_main_ripple","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"main_out"},"max":0.05,"unit":"V_pp","operating_cases":["steady_extremes"]},
      {"id":"g_interruption_peak","metric":"peak_voltage","analysis":"transient","excitation":{"kind":"port","id":"supply_in"},"observation":{"kind":"port","id":"main_out"},"max":5.5,"unit":"V","operating_cases":["bounded_interruption"],"critical":true},
      {"id":"h_efficiency","metric":"conversion_efficiency","analysis":"dc_operating_point","observation":{"kind":"circuit","id":"dual_output_energy_behavior"},"min":75.0,"max":100.0,"unit":"%","operating_cases":["steady_extremes"]}
    ],
    "constraints": {"max_components":30,"max_width_mm":85.0,"max_height_mm":55.0}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
