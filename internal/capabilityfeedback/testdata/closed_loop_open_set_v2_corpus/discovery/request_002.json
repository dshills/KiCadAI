{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "cedar_moon", "title": "Cedar Moon", "description": "A bounded external-behavior study designated Cedar Moon."},
  "requirements": {
    "domains": [
      {"id": "ref", "kind": "reference", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "source": "external"},
      {"id": "feed", "kind": "supply", "min_voltage_v": 8, "nominal_voltage_v": 9, "max_voltage_v": 10, "max_current_a": 0.05, "source": "external"}
    ],
    "ports": [
      {"id": "feed_in", "kind": "power", "direction": "sink", "domain": "feed", "electrical": {"min_voltage_v": 8, "nominal_voltage_v": 9, "max_voltage_v": 10, "max_current_a": 0.05}},
      {"id": "probe_in", "kind": "analog_current", "direction": "sink", "domain": "ref", "electrical": {"min_voltage_v": -0.3, "nominal_voltage_v": 0, "max_voltage_v": 0.3, "max_current_a": 0.00012}},
      {"id": "read_out", "kind": "analog_voltage", "direction": "source", "domain": "ref", "electrical": {"min_voltage_v": -3.5, "nominal_voltage_v": 0, "max_voltage_v": 3.5, "max_current_a": 0.002}}
    ],
    "operating_cases": [
      {"id": "quiet", "conditions": [
        {"axis": "supply_voltage", "target": "feed", "min": 8, "max": 10, "unit": "V"},
        {"axis": "input_current", "target": "probe_in", "min": -0.0001, "max": 0.0001, "unit": "A"},
        {"axis": "load_capacitance", "target": "read_out", "min": 0, "max": 0.0000000002, "unit": "F"},
        {"axis": "ambient_temperature", "target": "ref", "min": 0, "max": 55, "unit": "degC"}
      ]},
      {"id": "edge", "conditions": [
        {"axis": "supply_voltage", "target": "feed", "min": 8, "max": 8.5, "unit": "V"},
        {"axis": "input_current", "target": "probe_in", "min": -0.00008, "max": 0.00008, "unit": "A"},
        {"axis": "load_capacitance", "target": "read_out", "min": 0.0000000002, "max": 0.000000001, "unit": "F"},
        {"axis": "ambient_temperature", "target": "ref", "min": 55, "max": 85, "unit": "degC"}
      ], "events": [
        {"id": "stimulus_change", "kind": "input_step", "target": "probe_in", "trigger_time_s": 0.002, "initial": -0.00005, "applied": 0.00005, "unit": "A"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "conversion", "metric": "transimpedance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "probe_in"}, "observation": {"kind": "port", "id": "read_out"}, "min": 28000, "max": 32000, "unit": "V/A", "operating_cases": ["quiet", "edge"]},
      {"id": "rest_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "read_out"}, "max": 0.004, "unit": "V_rms", "frequency_hz": 10000, "operating_cases": ["quiet"]},
      {"id": "step_recovery", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "probe_in"}, "observation": {"kind": "port", "id": "read_out"}, "max": 0.0002, "unit": "s", "operating_cases": ["edge"]},
      {"id": "stable_phase", "metric": "phase_margin", "analysis": "stability", "excitation": {"kind": "port", "id": "probe_in"}, "observation": {"kind": "port", "id": "read_out"}, "min": 50, "unit": "deg", "operating_cases": ["quiet", "edge"]}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 48, "max_height_mm": 42}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
