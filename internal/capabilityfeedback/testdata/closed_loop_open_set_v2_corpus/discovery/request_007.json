{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"opal_field","title":"Opal Field","description":"A bounded external-behavior study designated Opal Field."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.02,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":3,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.02}},{"id":"pulse_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"default_state":"low"}},{"id":"pulse_out","kind":"digital","direction":"source","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"max_current_a":0.006,"default_state":"low"}}],
    "operating_cases":[
      {"id":"stream","conditions":[{"axis":"supply_voltage","target":"feed","min":3,"max":3.6,"unit":"V"},{"axis":"load_capacitance","target":"pulse_out","min":0.000000000005,"max":0.00000000008,"unit":"F"},{"axis":"ambient_temperature","target":"ref","min":-20,"max":85,"unit":"degC"}]},
      {"id":"first_edge","conditions":[{"axis":"supply_voltage","target":"feed","min":3.2,"max":3.4,"unit":"V"},{"axis":"load_capacitance","target":"pulse_out","min":0,"max":0.00000000003,"unit":"F"}],"events":[{"id":"edge","kind":"input_step","target":"pulse_in","trigger_time_s":0.00001,"initial":0,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"edge_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"pulse_in"},"observation":{"kind":"port","id":"pulse_out"},"max":0.0000002,"unit":"s","operating_cases":["first_edge"]},
      {"id":"rise_bound","metric":"rise_time","analysis":"transient","observation":{"kind":"port","id":"pulse_out"},"max":0.00000008,"unit":"s","operating_cases":["stream","first_edge"]},
      {"id":"fall_bound","metric":"fall_time","analysis":"transient","observation":{"kind":"port","id":"pulse_out"},"max":0.00000008,"unit":"s","operating_cases":["stream"]},
      {"id":"high_bound","metric":"output_high_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"pulse_out"},"min":2.7,"unit":"V","operating_cases":["stream"]},
      {"id":"low_bound","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"pulse_out"},"max":0.4,"unit":"V","operating_cases":["stream"]}
    ],
    "constraints":{"max_components":12,"max_width_mm":34,"max_height_mm":28}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
