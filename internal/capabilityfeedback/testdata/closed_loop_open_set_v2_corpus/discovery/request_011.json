{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"marble_tide","title":"Marble Tide","description":"A bounded external-behavior study designated Marble Tide."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":9,"nominal_voltage_v":10,"max_voltage_v":11,"max_current_a":0.12,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":9,"nominal_voltage_v":10,"max_voltage_v":11,"max_current_a":0.12}},{"id":"wave_in","kind":"analog_voltage","direction":"sink","domain":"ref","electrical":{"min_voltage_v":-1.5,"nominal_voltage_v":0,"max_voltage_v":1.5,"input_impedance_min_ohm":50000}},{"id":"gate_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5,"default_state":"low"}},{"id":"wave_out","kind":"analog_voltage","direction":"source","domain":"ref","electrical":{"min_voltage_v":-3.5,"nominal_voltage_v":0,"max_voltage_v":3.5,"max_current_a":0.008}}],
    "operating_cases":[
      {"id":"active","conditions":[{"axis":"supply_voltage","target":"feed","min":9,"max":11,"unit":"V"},{"axis":"input_voltage","target":"wave_in","min":-1.2,"max":1.2,"unit":"V"},{"axis":"load_resistance","target":"wave_out","min":5000,"max":100000,"unit":"ohm"},{"axis":"ambient_temperature","target":"ref","min":-10,"max":65,"unit":"degC"}]},
      {"id":"gated","conditions":[{"axis":"supply_voltage","target":"feed","min":9.5,"max":10.5,"unit":"V"},{"axis":"input_voltage","target":"wave_in","min":-1,"max":1,"unit":"V"}],"events":[{"id":"gate_change","kind":"input_step","target":"gate_in","trigger_time_s":0.002,"initial":0,"applied":5,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"active_gain","metric":"voltage_gain","analysis":"ac_sweep","excitation":{"kind":"port","id":"wave_in"},"observation":{"kind":"port","id":"wave_out"},"min":2.4,"max":2.8,"unit":"ratio","frequency_hz":1000,"operating_cases":["active"]},
      {"id":"active_distortion","metric":"total_harmonic_distortion","analysis":"distortion","excitation":{"kind":"port","id":"wave_in"},"observation":{"kind":"port","id":"wave_out"},"max":1.2,"unit":"%","frequency_hz":1000,"operating_cases":["active"]},
      {"id":"gate_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"gate_in"},"observation":{"kind":"port","id":"wave_out"},"max":0.00005,"unit":"s","operating_cases":["gated"]},
      {"id":"inactive_current","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"wave_out"},"max":0.00002,"unit":"A","operating_cases":["gated"],"critical":true},
      {"id":"active_stability","metric":"phase_margin","analysis":"stability","excitation":{"kind":"port","id":"wave_in"},"observation":{"kind":"port","id":"wave_out"},"min":48,"unit":"deg","operating_cases":["active"]}
    ],
    "constraints":{"max_components":23,"max_width_mm":58,"max_height_mm":44}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
