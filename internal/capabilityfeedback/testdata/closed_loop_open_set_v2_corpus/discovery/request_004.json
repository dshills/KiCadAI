{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"quiet_prairie","title":"Quiet Prairie","description":"A bounded external-behavior study designated Quiet Prairie."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":18,"nominal_voltage_v":24,"max_voltage_v":30,"max_current_a":0.9,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":18,"nominal_voltage_v":24,"max_voltage_v":30,"max_current_a":0.9}},{"id":"command_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5,"default_state":"low"}},{"id":"service_out","kind":"power","direction":"source","domain":"ref","electrical":{"min_voltage_v":8.6,"nominal_voltage_v":9,"max_voltage_v":9.4,"max_current_a":0.65}}],
    "operating_cases":[
      {"id":"normal","conditions":[{"axis":"supply_voltage","target":"feed","min":18,"max":30,"unit":"V"},{"axis":"load_current","target":"service_out","min":0.05,"max":0.6,"unit":"A"},{"axis":"ambient_temperature","target":"ref","min":-30,"max":65,"unit":"degC"}]},
      {"id":"limited","conditions":[{"axis":"supply_voltage","target":"feed","min":22,"max":26,"unit":"V"},{"axis":"load_resistance","target":"service_out","min":0.05,"max":0.5,"unit":"ohm"},{"axis":"ambient_temperature","target":"ref","min":20,"max":50,"unit":"degC"}],"events":[{"id":"brief_short","kind":"short_circuit","target":"service_out","trigger_time_s":0.01,"initial":20,"applied":0.1,"unit":"ohm"}]}
    ],
    "behavioral_requirements":[
      {"id":"service_level","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"service_out"},"min":8.7,"max":9.3,"unit":"V","operating_cases":["normal"]},
      {"id":"bounded_fault_current","metric":"peak_current","analysis":"transient","observation":{"kind":"port","id":"service_out"},"max":0.9,"unit":"A","operating_cases":["limited"],"critical":true},
      {"id":"survival_margin","metric":"soa_margin","analysis":"electrothermal","observation":{"kind":"port","id":"service_out"},"min":1.2,"unit":"ratio","operating_cases":["limited"],"critical":true},
      {"id":"recovery_time","metric":"settling_time","analysis":"transient","observation":{"kind":"port","id":"service_out"},"max":0.02,"unit":"s","operating_cases":["limited"],"critical":true},
      {"id":"heat_bound","metric":"junction_temperature","analysis":"thermal","observation":{"kind":"circuit","id":"assembly_thermal_state"},"max":120,"unit":"degC","operating_cases":["normal","limited"],"critical":true}
    ],
    "constraints":{"max_components":22,"max_width_mm":64,"max_height_mm":58}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
