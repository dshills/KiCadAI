{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"moss_cipher","title":"Moss Cipher","description":"A bounded external-behavior study designated Moss Cipher."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"low_feed","kind":"supply","min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.01,"source":"external"},{"id":"high_feed","kind":"supply","min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.02,"source":"external"}],
    "ports":[{"id":"low_in","kind":"power","direction":"sink","domain":"low_feed","electrical":{"min_voltage_v":1.7,"nominal_voltage_v":1.8,"max_voltage_v":1.9,"max_current_a":0.01}},{"id":"high_in","kind":"power","direction":"sink","domain":"high_feed","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.02}},{"id":"data_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0.9,"max_voltage_v":1.8,"default_state":"low"}},{"id":"data_out","kind":"digital","direction":"source","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5,"max_current_a":0.008,"default_state":"low"}}],
    "operating_cases":[
      {"id":"exchange","conditions":[{"axis":"supply_voltage","target":"low_feed","min":1.7,"max":1.9,"unit":"V"},{"axis":"supply_voltage","target":"high_feed","min":4.5,"max":5.5,"unit":"V"},{"axis":"load_capacitance","target":"data_out","min":0.00000000001,"max":0.00000000012,"unit":"F"},{"axis":"ambient_temperature","target":"ref","min":-10,"max":70,"unit":"degC"}]},
      {"id":"low_side_loss","conditions":[{"axis":"supply_voltage","target":"low_feed","min":1.75,"max":1.85,"unit":"V"},{"axis":"supply_voltage","target":"high_feed","min":4.8,"max":5.2,"unit":"V"}],"events":[{"id":"loss","kind":"rail_loss","target":"low_in","trigger_time_s":0.002,"initial":1.8,"applied":0,"unit":"V"}]}
    ],
    "behavioral_requirements":[
