      {"id":"low_level","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"data_out"},"max":0.5,"unit":"V","operating_cases":["exchange"]},
      {"id":"response_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"data_in"},"observation":{"kind":"port","id":"data_out"},"max":0.000001,"unit":"s","operating_cases":["exchange"]},
      {"id":"loss_current","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"data_in"},"max":0.00001,"unit":"A","operating_cases":["low_side_loss"],"critical":true},
      {"id":"loss_output","metric":"output_low_voltage","analysis":"transient","observation":{"kind":"port","id":"data_out"},"max":0.8,"unit":"V","operating_cases":["low_side_loss"],"critical":true}
