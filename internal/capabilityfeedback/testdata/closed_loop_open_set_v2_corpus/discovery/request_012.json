{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"saffron_brook","title":"Saffron Brook","description":"A bounded external-behavior study designated Saffron Brook."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":13,"nominal_voltage_v":15,"max_voltage_v":17,"max_current_a":0.7,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":13,"nominal_voltage_v":15,"max_voltage_v":17,"max_current_a":0.7}},{"id":"sense_in","kind":"analog_voltage","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.2,"max_voltage_v":2.4,"input_impedance_min_ohm":150000}},{"id":"permit_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"default_state":"low"}},{"id":"energy_out","kind":"power","direction":"source","domain":"ref","electrical":{"min_voltage_v":6.6,"nominal_voltage_v":7,"max_voltage_v":7.4,"max_current_a":0.45}},{"id":"notice_out","kind":"digital","direction":"source","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"max_current_a":0.003,"default_state":"low"}}],
    "operating_cases":[
      {"id":"regulated","conditions":[{"axis":"supply_voltage","target":"feed","min":13,"max":17,"unit":"V"},{"axis":"input_voltage","target":"sense_in","min":0.2,"max":2.2,"unit":"V"},{"axis":"load_current","target":"energy_out","min":0.05,"max":0.4,"unit":"A"},{"axis":"ambient_temperature","target":"ref","min":-20,"max":70,"unit":"degC"}]},
      {"id":"load_change","conditions":[{"axis":"supply_voltage","target":"feed","min":14.5,"max":15.5,"unit":"V"},{"axis":"input_voltage","target":"sense_in","min":0.8,"max":1.6,"unit":"V"},{"axis":"load_current","target":"energy_out","min":0.05,"max":0.4,"unit":"A"}],"events":[{"id":"demand","kind":"load_step","target":"energy_out","trigger_time_s":0.005,"initial":0.08,"applied":0.35,"unit":"A"}]}
    ],
    "behavioral_requirements":[
      {"id":"energy_level","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"energy_out"},"min":6.75,"max":7.25,"unit":"V","operating_cases":["regulated"]},
      {"id":"sense_threshold","metric":"threshold_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"sense_in"},"observation":{"kind":"port","id":"notice_out"},"min":1,"max":1.4,"unit":"V","operating_cases":["regulated"]},
      {"id":"load_recovery","metric":"settling_time","analysis":"transient","observation":{"kind":"port","id":"energy_out"},"max":0.003,"unit":"s","operating_cases":["load_change"],"critical":true},
      {"id":"ripple_bound","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"energy_out"},"max":0.12,"unit":"V_pp","operating_cases":["regulated","load_change"]},
      {"id":"heat_bound","metric":"junction_temperature","analysis":"electrothermal","observation":{"kind":"circuit","id":"assembly_thermal_state"},"max":110,"unit":"degC","operating_cases":["regulated","load_change"],"critical":true}
    ],
    "constraints":{"max_components":28,"max_width_mm":76,"max_height_mm":54}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
