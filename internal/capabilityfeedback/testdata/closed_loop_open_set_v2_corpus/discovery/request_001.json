{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "amber_hollow", "title": "Amber Hollow", "description": "A bounded external-behavior study designated Amber Hollow."},
  "requirements": {
    "domains": [
      {"id": "ref", "kind": "reference", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "source": "external"},
      {"id": "feed", "kind": "supply", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.08, "source": "external"}
    ],
    "ports": [
      {"id": "feed_in", "kind": "power", "direction": "sink", "domain": "feed", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.08}},
      {"id": "sense_in", "kind": "analog_voltage", "direction": "sink", "domain": "ref", "electrical": {"min_voltage_v": -1, "nominal_voltage_v": 0, "max_voltage_v": 1, "input_impedance_min_ohm": 100000}},
      {"id": "sense_out", "kind": "analog_voltage", "direction": "source", "domain": "ref", "electrical": {"min_voltage_v": -2.2, "nominal_voltage_v": 0, "max_voltage_v": 2.2, "max_current_a": 0.005}}
    ],
    "operating_cases": [
      {"id": "temperate", "conditions": [
        {"axis": "supply_voltage", "target": "feed", "min": 4.75, "max": 5.25, "unit": "V"},
        {"axis": "input_voltage", "target": "sense_in", "min": -1, "max": 1, "unit": "V"},
        {"axis": "load_resistance", "target": "sense_out", "min": 10000, "max": 1000000, "unit": "ohm"},
        {"axis": "ambient_temperature", "target": "ref", "min": -10, "max": 45, "unit": "degC"}
      ]},
      {"id": "warm", "conditions": [
        {"axis": "supply_voltage", "target": "feed", "min": 4.8, "max": 5.2, "unit": "V"},
        {"axis": "input_voltage", "target": "sense_in", "min": -0.8, "max": 0.8, "unit": "V"},
        {"axis": "load_resistance", "target": "sense_out", "min": 20000, "max": 200000, "unit": "ohm"},
        {"axis": "ambient_temperature", "target": "ref", "min": 45, "max": 70, "unit": "degC"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "transfer", "metric": "voltage_gain", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "sense_in"}, "observation": {"kind": "port", "id": "sense_out"}, "min": 1.8, "max": 2.2, "unit": "ratio", "operating_cases": ["temperate", "warm"]},
      {"id": "span", "metric": "output_swing", "analysis": "transient", "observation": {"kind": "port", "id": "sense_out"}, "min": 3.2, "unit": "V_pp", "operating_cases": ["temperate", "warm"]},
      {"id": "response_band", "metric": "bandwidth", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "sense_in"}, "observation": {"kind": "port", "id": "sense_out"}, "min": 20000, "unit": "Hz", "operating_cases": ["temperate", "warm"]},
      {"id": "purity", "metric": "total_harmonic_distortion", "analysis": "distortion", "excitation": {"kind": "port", "id": "sense_in"}, "observation": {"kind": "port", "id": "sense_out"}, "max": 1, "unit": "%", "frequency_hz": 1000, "operating_cases": ["temperate"]}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 55, "max_height_mm": 35}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
