{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {"name": "silver_reed", "title": "Silver Reed", "description": "A bounded external-behavior study designated Silver Reed."},
  "requirements": {
    "domains": [
      {"id": "ref", "kind": "reference", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "source": "external"},
      {"id": "feed", "kind": "supply", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 1.8, "source": "external"}
    ],
    "ports": [
      {"id": "feed_in", "kind": "power", "direction": "sink", "domain": "feed", "electrical": {"min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 1.8}},
      {"id": "permit_in", "kind": "digital", "direction": "sink", "domain": "ref", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.8, "max_voltage_v": 3.6, "default_state": "low"}},
      {"id": "energy_out", "kind": "power", "direction": "source", "domain": "ref", "electrical": {"min_voltage_v": 4.8, "nominal_voltage_v": 5, "max_voltage_v": 5.2, "max_current_a": 1.2}}
    ],
    "operating_cases": [
      {"id": "working", "conditions": [
        {"axis": "supply_voltage", "target": "feed", "min": 10, "max": 15, "unit": "V"},
        {"axis": "load_current", "target": "energy_out", "min": 0.1, "max": 1.2, "unit": "A"},
        {"axis": "ambient_temperature", "target": "ref", "min": -20, "max": 70, "unit": "degC"}
      ]},
      {"id": "awakening", "conditions": [
        {"axis": "supply_voltage", "target": "feed", "min": 11.5, "max": 12.5, "unit": "V"},
        {"axis": "load_current", "target": "energy_out", "min": 0.6, "max": 1, "unit": "A"},
        {"axis": "ambient_temperature", "target": "ref", "min": 20, "max": 45, "unit": "degC"}
      ], "events": [
        {"id": "feed_arrival", "kind": "startup", "target": "feed_in", "trigger_time_s": 0, "initial": 0, "applied": 12, "unit": "V"},
        {"id": "permission", "kind": "input_step", "target": "permit_in", "trigger_time_s": 0.01, "initial": 0, "applied": 3.3, "unit": "V"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "regulated_level", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "energy_out"}, "min": 4.85, "max": 5.15, "unit": "V", "operating_cases": ["working"]},
      {"id": "line_hold", "metric": "line_regulation", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "feed_in"}, "observation": {"kind": "port", "id": "energy_out"}, "max": 1.5, "unit": "%", "operating_cases": ["working"]},
      {"id": "load_hold", "metric": "load_regulation", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "energy_out"}, "observation": {"kind": "port", "id": "energy_out"}, "max": 2, "unit": "%", "operating_cases": ["working"]},
      {"id": "useful_ratio", "metric": "conversion_efficiency", "analysis": "electrothermal", "observation": {"kind": "port", "id": "energy_out"}, "min": 78, "unit": "%", "operating_cases": ["working"]},
      {"id": "arrival_peak", "metric": "startup_overshoot", "analysis": "startup", "observation": {"kind": "port", "id": "energy_out"}, "max": 0.3, "unit": "V", "operating_cases": ["awakening"], "critical": true},
      {"id": "temperature_limit", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "assembly_thermal_state"}, "max": 115, "unit": "degC", "operating_cases": ["working"], "critical": true}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {"require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true, "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true, "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true, "require_deterministic_replay": true, "require_fail_closed": true}
}
