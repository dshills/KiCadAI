{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"blue_quarry","title":"Blue Quarry","description":"A bounded external-behavior study designated Blue Quarry."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":7,"nominal_voltage_v":8,"max_voltage_v":9,"max_current_a":1.1,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":7,"nominal_voltage_v":8,"max_voltage_v":9,"max_current_a":1.1}},{"id":"start_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"default_state":"low"}},{"id":"energy_out","kind":"power","direction":"source","domain":"ref","electrical":{"min_voltage_v":3.1,"nominal_voltage_v":3.3,"max_voltage_v":3.5,"max_current_a":0.8}}],
    "operating_cases":[
      {"id":"delivery","conditions":[{"axis":"supply_voltage","target":"feed","min":7,"max":9,"unit":"V"},{"axis":"load_current","target":"energy_out","min":0.02,"max":0.75,"unit":"A"},{"axis":"ambient_temperature","target":"ref","min":-25,"max":75,"unit":"degC"}]},
      {"id":"cold_start","conditions":[{"axis":"supply_voltage","target":"feed","min":7,"max":7.5,"unit":"V"},{"axis":"load_current","target":"energy_out","min":0.4,"max":0.7,"unit":"A"},{"axis":"ambient_temperature","target":"ref","min":-25,"max":0,"unit":"degC"}],"events":[{"id":"arrival","kind":"power_step","target":"feed_in","trigger_time_s":0,"initial":0,"applied":7.2,"unit":"V"},{"id":"start","kind":"input_step","target":"start_in","trigger_time_s":0.006,"initial":0,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"delivery_level","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"energy_out"},"min":3.2,"max":3.4,"unit":"V","operating_cases":["delivery"]},
      {"id":"load_variation","metric":"load_regulation","analysis":"dc_sweep","observation":{"kind":"port","id":"energy_out"},"max":1.8,"unit":"%","operating_cases":["delivery"]},
      {"id":"start_current","metric":"startup_current","analysis":"startup","observation":{"kind":"port","id":"feed_in"},"max":1.05,"unit":"A","operating_cases":["cold_start"],"critical":true},
      {"id":"start_peak","metric":"startup_overshoot","analysis":"startup","observation":{"kind":"port","id":"energy_out"},"max":0.18,"unit":"V","operating_cases":["cold_start"],"critical":true},
      {"id":"thermal_bound","metric":"junction_temperature","analysis":"thermal","observation":{"kind":"port","id":"energy_out"},"max":108,"unit":"degC","operating_cases":["delivery"],"critical":true}
    ],
    "constraints":{"max_components":25,"max_width_mm":68,"max_height_mm":48}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
