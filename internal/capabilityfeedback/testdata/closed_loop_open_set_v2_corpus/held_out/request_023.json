{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"scarlet_fog","title":"Scarlet Fog","description":"A bounded external-behavior study designated Scarlet Fog."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":5.7,"nominal_voltage_v":6,"max_voltage_v":6.3,"max_current_a":0.2,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":5.7,"nominal_voltage_v":6,"max_voltage_v":6.3,"max_current_a":0.2}},{"id":"wave_in","kind":"analog_voltage","direction":"sink","domain":"ref","electrical":{"min_voltage_v":-0.8,"nominal_voltage_v":0,"max_voltage_v":0.8,"input_impedance_min_ohm":80000}},{"id":"gate_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"default_state":"low"}},{"id":"wave_out","kind":"analog_voltage","direction":"source","domain":"ref","electrical":{"min_voltage_v":-2.2,"nominal_voltage_v":0,"max_voltage_v":2.2,"max_current_a":0.015}}],
    "operating_cases":[
      {"id":"enabled","conditions":[{"axis":"supply_voltage","target":"feed","min":5.7,"max":6.3,"unit":"V"},{"axis":"input_voltage","target":"wave_in","min":-0.7,"max":0.7,"unit":"V"},{"axis":"load_resistance","target":"wave_out","min":200,"max":1000,"unit":"ohm"},{"axis":"ambient_temperature","target":"ref","min":-10,"max":65,"unit":"degC"}]},
      {"id":"switch","conditions":[{"axis":"supply_voltage","target":"feed","min":5.9,"max":6.1,"unit":"V"},{"axis":"input_voltage","target":"wave_in","min":-0.5,"max":0.5,"unit":"V"},{"axis":"load_resistance","target":"wave_out","min":300,"max":600,"unit":"ohm"}],"events":[{"id":"gate_change","kind":"input_step","target":"gate_in","trigger_time_s":0.002,"initial":0,"applied":3.3,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"enabled_gain","metric":"voltage_gain_at_frequency","analysis":"ac_sweep","excitation":{"kind":"port","id":"wave_in"},"observation":{"kind":"port","id":"wave_out"},"min":2.7,"max":3.1,"unit":"ratio","frequency_hz":2000,"operating_cases":["enabled"]},
      {"id":"output_power","metric":"output_power","analysis":"electrothermal","observation":{"kind":"port","id":"wave_out"},"min":0.005,"max":0.03,"unit":"W","operating_cases":["enabled"]},
      {"id":"switch_delay","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"gate_in"},"observation":{"kind":"port","id":"wave_out"},"max":0.00008,"unit":"s","operating_cases":["switch"]},
      {"id":"disabled_current","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"wave_out"},"max":0.00003,"unit":"A","operating_cases":["switch"],"critical":true},
      {"id":"temperature_bound","metric":"junction_temperature","analysis":"thermal","observation":{"kind":"port","id":"wave_out"},"max":112,"unit":"degC","operating_cases":["enabled"],"critical":true}
    ],
    "constraints":{"max_components":24,"max_width_mm":61,"max_height_mm":47}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
