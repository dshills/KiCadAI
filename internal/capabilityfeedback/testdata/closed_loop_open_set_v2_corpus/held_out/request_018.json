{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"rustic_echo","title":"Rustic Echo","description":"A bounded external-behavior study designated Rustic Echo."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":2.9,"nominal_voltage_v":3.3,"max_voltage_v":3.7,"max_current_a":0.022,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":2.9,"nominal_voltage_v":3.3,"max_voltage_v":3.7,"max_current_a":0.022}},{"id":"control_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"default_state":"low"}},{"id":"pulse_out","kind":"digital","direction":"source","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.65,"max_voltage_v":3.3,"max_current_a":0.004,"default_state":"low"}}],
    "operating_cases":[
      {"id":"enabled","conditions":[{"axis":"supply_voltage","target":"feed","min":2.9,"max":3.7,"unit":"V"},{"axis":"load_capacitance","target":"pulse_out","min":0.000000000005,"max":0.00000000006,"unit":"F"},{"axis":"ambient_temperature","target":"ref","min":-20,"max":70,"unit":"degC"}]},
      {"id":"disabled","conditions":[{"axis":"supply_voltage","target":"feed","min":3.1,"max":3.5,"unit":"V"},{"axis":"load_capacitance","target":"pulse_out","min":0,"max":0.00000000003,"unit":"F"}],"events":[{"id":"disable","kind":"input_step","target":"control_in","trigger_time_s":0.004,"initial":3.3,"applied":0,"unit":"V"}]},
      {"id":"feed_loss","conditions":[{"axis":"supply_voltage","target":"feed","min":3.2,"max":3.4,"unit":"V"}],"events":[{"id":"loss","kind":"rail_loss","target":"feed_in","trigger_time_s":0.006,"initial":3.3,"applied":0,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"pulse_rate","metric":"oscillation_frequency","analysis":"transient","observation":{"kind":"port","id":"pulse_out"},"min":900,"max":1100,"unit":"Hz","operating_cases":["enabled"]},
      {"id":"pulse_share","metric":"duty_cycle","analysis":"transient","observation":{"kind":"port","id":"pulse_out"},"min":45,"max":55,"unit":"%","operating_cases":["enabled"]},
      {"id":"disable_delay","metric":"fall_time","analysis":"transient","excitation":{"kind":"port","id":"control_in"},"observation":{"kind":"port","id":"pulse_out"},"max":0.002,"unit":"s","operating_cases":["disabled"]},
      {"id":"loss_leakage","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"pulse_out"},"max":0.000005,"unit":"A","operating_cases":["feed_loss"],"critical":true}
    ],
    "constraints":{"max_components":16,"max_width_mm":39,"max_height_mm":35}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
