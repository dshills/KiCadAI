{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"hushed_summit","title":"Hushed Summit","description":"A bounded external-behavior study designated Hushed Summit."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":28,"nominal_voltage_v":36,"max_voltage_v":44,"max_current_a":0.45,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":28,"nominal_voltage_v":36,"max_voltage_v":44,"max_current_a":0.45}},{"id":"permit_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5,"default_state":"low"}},{"id":"energy_out","kind":"power","direction":"source","domain":"ref","electrical":{"min_voltage_v":11.4,"nominal_voltage_v":12,"max_voltage_v":12.6,"max_current_a":0.35}}],
    "operating_cases":[
      {"id":"delivery","conditions":[{"axis":"supply_voltage","target":"feed","min":28,"max":44,"unit":"V"},{"axis":"load_current","target":"energy_out","min":0.04,"max":0.32,"unit":"A"},{"axis":"ambient_temperature","target":"ref","min":-15,"max":70,"unit":"degC"}]},
      {"id":"shorted","conditions":[{"axis":"supply_voltage","target":"feed","min":34,"max":38,"unit":"V"},{"axis":"load_resistance","target":"energy_out","min":0,"max":1,"unit":"ohm"},{"axis":"ambient_temperature","target":"ref","min":20,"max":50,"unit":"degC"}],"events":[{"id":"short","kind":"short_circuit","target":"energy_out","trigger_time_s":0.008,"initial":50,"applied":0.2,"unit":"ohm"}]}
    ],
    "behavioral_requirements":[
      {"id":"delivery_level","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"energy_out"},"min":11.7,"max":12.3,"unit":"V","operating_cases":["delivery"]},
      {"id":"efficiency_bound","metric":"conversion_efficiency","analysis":"electrothermal","observation":{"kind":"port","id":"energy_out"},"min":80,"unit":"%","operating_cases":["delivery"]},
      {"id":"fault_current","metric":"peak_current","analysis":"transient","observation":{"kind":"port","id":"energy_out"},"max":0.5,"unit":"A","operating_cases":["shorted"],"critical":true},
      {"id":"fault_margin","metric":"soa_margin","analysis":"electrothermal","observation":{"kind":"port","id":"energy_out"},"min":1.3,"unit":"ratio","operating_cases":["shorted"],"critical":true},
      {"id":"fault_temperature","metric":"junction_temperature","analysis":"thermal","observation":{"kind":"port","id":"energy_out"},"max":125,"unit":"degC","operating_cases":["shorted"],"critical":true}
    ],
    "constraints":{"max_components":27,"max_width_mm":82,"max_height_mm":60}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
