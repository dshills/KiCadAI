{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"plum_harbor","title":"Plum Harbor","description":"A bounded external-behavior study designated Plum Harbor."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":2.6,"nominal_voltage_v":3,"max_voltage_v":3.4,"max_current_a":0.025,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":2.6,"nominal_voltage_v":3,"max_voltage_v":3.4,"max_current_a":0.025}},{"id":"request_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":1.5,"max_voltage_v":3,"default_state":"high"}},{"id":"analog_out","kind":"analog_voltage","direction":"source","domain":"ref","electrical":{"min_voltage_v":0.2,"nominal_voltage_v":1.5,"max_voltage_v":2.8,"max_current_a":0.003}}],
    "operating_cases":[
      {"id":"asserted","conditions":[{"axis":"supply_voltage","target":"feed","min":2.6,"max":3.4,"unit":"V"},{"axis":"load_resistance","target":"analog_out","min":20000,"max":500000,"unit":"ohm"},{"axis":"ambient_temperature","target":"ref","min":-10,"max":75,"unit":"degC"}]},
      {"id":"request_change","conditions":[{"axis":"supply_voltage","target":"feed","min":2.9,"max":3.1,"unit":"V"},{"axis":"load_capacitance","target":"analog_out","min":0.00000000005,"max":0.0000000005,"unit":"F"}],"events":[{"id":"request","kind":"input_step","target":"request_in","trigger_time_s":0.003,"initial":0,"applied":3,"unit":"V"}]}
    ],
    "behavioral_requirements":[
      {"id":"declared_level","metric":"output_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"analog_out"},"min":1.42,"max":1.58,"unit":"V","operating_cases":["asserted"]},
      {"id":"level_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"analog_out"},"max":0.003,"unit":"V_rms","frequency_hz":10000,"operating_cases":["asserted"]},
      {"id":"request_settling","metric":"settling_time","analysis":"transient","excitation":{"kind":"port","id":"request_in"},"observation":{"kind":"port","id":"analog_out"},"max":0.0004,"unit":"s","operating_cases":["request_change"]},
      {"id":"output_current","metric":"output_current","analysis":"dc_operating_point","observation":{"kind":"port","id":"analog_out"},"max":0.002,"unit":"A","operating_cases":["asserted"]}
    ],
    "constraints":{"max_components":14,"max_width_mm":42,"max_height_mm":30}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
}
