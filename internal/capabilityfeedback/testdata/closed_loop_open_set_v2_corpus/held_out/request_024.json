{
  "schema":"kicadai.open-topology-requirement.v1","version":1,
  "project":{"name":"misty_arch","title":"Misty Arch","description":"A bounded external-behavior study designated Misty Arch."},
  "requirements":{
    "domains":[{"id":"ref","kind":"reference","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"source":"external"},{"id":"feed","kind":"supply","min_voltage_v":20,"nominal_voltage_v":24,"max_voltage_v":28,"max_current_a":1.3,"source":"external"}],
    "ports":[{"id":"feed_in","kind":"power","direction":"sink","domain":"feed","electrical":{"min_voltage_v":20,"nominal_voltage_v":24,"max_voltage_v":28,"max_current_a":1.3}},{"id":"set_in","kind":"analog_voltage","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0.3,"nominal_voltage_v":1.5,"max_voltage_v":2.7,"input_impedance_min_ohm":120000}},{"id":"permit_in","kind":"digital","direction":"sink","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5,"default_state":"low"}},{"id":"energy_out","kind":"power","direction":"source","domain":"ref","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":6,"max_voltage_v":7.5,"max_current_a":0.9}},{"id":"state_out","kind":"digital","direction":"source","domain":"ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5,"max_current_a":0.004,"default_state":"low"}}],
    "operating_cases":[
      {"id":"controlled","conditions":[{"axis":"supply_voltage","target":"feed","min":20,"max":28,"unit":"V"},{"axis":"input_voltage","target":"set_in","min":0.5,"max":2.5,"unit":"V"},{"axis":"load_current","target":"energy_out","min":0.1,"max":0.8,"unit":"A"},{"axis":"ambient_temperature","target":"ref","min":-20,"max":70,"unit":"degC"}]},
      {"id":"faulted","conditions":[{"axis":"supply_voltage","target":"feed","min":23,"max":25,"unit":"V"},{"axis":"input_voltage","target":"set_in","min":1,"max":2,"unit":"V"},{"axis":"load_resistance","target":"energy_out","min":0,"max":0.5,"unit":"ohm"}],"events":[{"id":"short","kind":"short_circuit","target":"energy_out","trigger_time_s":0.006,"initial":20,"applied":0.1,"unit":"ohm"}]}
    ],
    "behavioral_requirements":[
      {"id":"set_transfer","metric":"voltage_gain","analysis":"dc_sweep","excitation":{"kind":"port","id":"set_in"},"observation":{"kind":"port","id":"energy_out"},"min":2.8,"max":3.2,"unit":"ratio","operating_cases":["controlled"]},
      {"id":"state_threshold","metric":"threshold_voltage","analysis":"dc_sweep","excitation":{"kind":"port","id":"set_in"},"observation":{"kind":"port","id":"state_out"},"min":1.2,"max":1.8,"unit":"V","operating_cases":["controlled"]},
      {"id":"ripple_bound","metric":"output_ripple","analysis":"transient","observation":{"kind":"port","id":"energy_out"},"max":0.15,"unit":"V_pp","operating_cases":["controlled"]},
      {"id":"fault_current","metric":"peak_current","analysis":"transient","observation":{"kind":"port","id":"energy_out"},"max":1.1,"unit":"A","operating_cases":["faulted"],"critical":true},
      {"id":"fault_margin","metric":"soa_margin","analysis":"electrothermal","observation":{"kind":"port","id":"energy_out"},"min":1.35,"unit":"ratio","operating_cases":["faulted"],"critical":true},
      {"id":"fault_temperature","metric":"junction_temperature","analysis":"thermal","observation":{"kind":"port","id":"energy_out"},"max":118,"unit":"degC","operating_cases":["faulted"],"critical":true}
    ],
    "constraints":{"max_components":30,"max_width_mm":88,"max_height_mm":64}
  },
  "acceptance":{"require_primitive_only":true,"require_topology_search":true,"require_simulation":true,"require_all_corners":true,"require_model_provenance":true,"require_closed_loop_evidence":true,"require_complete_routing":true,"require_connectivity":true,"require_writer_correctness":true,"require_round_trip_zero_diff":true,"require_erc":true,"require_strict_drc":true,"require_deterministic_replay":true,"require_fail_closed":true}
