{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "windowed_logic_response",
    "title": "Windowed response",
    "description": "Study bounded output states and timing as two external levels vary with loading."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.08,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "level_a",
        "kind": "digital",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "input_impedance_min_ohm": 50000,
          "default_state": "floating"
        }
      },
      {
        "id": "level_b",
        "kind": "digital",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "input_impedance_min_ohm": 50000,
          "default_state": "floating"
        }
      },
      {
        "id": "state_out",
        "kind": "digital",
        "direction": "source",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.008,
          "default_state": "low"
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.08
        }
      }
    ],
    "operating_cases": [
      {
        "id": "static_levels",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "level_a",
            "min": 0,
            "max": 3.6,
            "unit": "V"
          },
          {
            "axis": "input_voltage",
            "target": "level_b",
            "min": 0,
            "max": 3.6,
            "unit": "V"
          },
          {
            "axis": "load_current",
            "target": "state_out",
            "min": 0,
            "max": 0.004,
            "unit": "A"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 3,
            "max": 3.6,
            "unit": "V"
          }
        ]
      },
      {
        "id": "timed_levels",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "state_out",
            "min": 0,
            "max": 5e-11,
            "unit": "F"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "tolerance_corner",
            "target": "state_out",
            "min": 0.98,
            "max": 1.02,
            "unit": "ratio"
          }
        ],
        "events": [
          {
            "id": "level_a_change",
            "kind": "input_step",
            "target": "level_a",
            "trigger_time_s": 0.0001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          },
          {
            "id": "level_b_change",
            "kind": "input_step",
            "target": "level_b",
            "trigger_time_s": 0.0002,
            "initial": 3.3,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "rising_boundary",
        "metric": "rising_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "level_a"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "min": 1.7,
        "max": 2.2,
        "unit": "V",
        "operating_cases": [
          "static_levels"
        ]
      },
      {
        "id": "high_level",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "level_b"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "min": 2.7,
        "max": 3.6,
        "unit": "V",
        "operating_cases": [
          "static_levels"
        ]
      },
      {
        "id": "transition_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "level_a"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "max": 2e-7,
        "unit": "s",
        "operating_cases": [
          "timed_levels"
        ]
      },
      {
        "id": "transition_duty",
        "metric": "duty_cycle",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "level_b"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "min": 0.45,
        "max": 0.55,
        "unit": "ratio",
        "operating_cases": [
          "timed_levels"
        ]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}

