{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "coordinated_dual_response",
    "title": "Coordinated dual response",
    "description": "Study a bounded level and a timed state produced from two independent external requests."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.12,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "level_request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.2,
          "max_voltage_v": 2.4,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "timing_request",
        "kind": "digital",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "input_impedance_min_ohm": 50000,
          "default_state": "low"
        }
      },
      {
        "id": "level_out",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.2,
          "max_voltage_v": 2.5,
          "max_current_a": 0.004
        }
      },
      {
        "id": "timed_out",
        "kind": "digital",
        "direction": "source",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.006,
          "default_state": "low"
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.12
        }
      }
    ],
    "operating_cases": [
      {
        "id": "active",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "level_request",
            "min": 0.2,
            "max": 2.2,
            "unit": "V"
          },
          {
            "axis": "load_resistance",
            "target": "level_out",
            "min": 5000,
            "max": 50000,
            "unit": "ohm"
          },
          {
            "axis": "load_capacitance",
            "target": "timed_out",
            "min": 0,
            "max": 8e-11,
            "unit": "F"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 3,
            "max": 3.6,
            "unit": "V"
          }
        ]
      },
      {
        "id": "start_and_step",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -20,
            "max": 75,
            "unit": "degC"
          },
          {
            "axis": "model_corner",
            "target": "level_out",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "timed_out",
            "min": 0.98,
            "max": 1.02,
            "unit": "ratio"
          }
        ],
        "events": [
          {
            "id": "supply_start",
            "kind": "startup",
            "target": "supply_entry",
            "trigger_time_s": 0,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          },
          {
            "id": "timing_change",
            "kind": "input_step",
            "target": "timing_request",
            "trigger_time_s": 0.002,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "level_accuracy",
        "metric": "output_voltage",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "level_request"
        },
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "min": 0.18,
        "max": 2.25,
        "unit": "V",
        "operating_cases": [
          "active",
          "start_and_step"
        ]
      },
      {
        "id": "timed_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "timing_request"
        },
        "observation": {
          "kind": "port",
          "id": "timed_out"
        },
        "max": 0.000001,
        "unit": "s",
        "operating_cases": [
          "start_and_step"
        ]
      },
      {
        "id": "level_noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "max": 0.003,
        "unit": "V_rms",
        "frequency_hz": 50000,
        "operating_cases": [
          "active"
        ]
      },
      {
        "id": "start_level",
        "metric": "startup_output_voltage",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "min": 0,
        "max": 2.5,
        "unit": "V",
        "operating_cases": [
          "start_and_step"
        ]
      },
      {
        "id": "timed_high",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "timing_request"
        },
        "observation": {
          "kind": "port",
          "id": "timed_out"
        },
        "min": 2.7,
        "max": 3.6,
        "unit": "V",
        "operating_cases": [
          "active"
        ]
      }
    ],
    "constraints": {
      "max_components": 28,
      "max_width_mm": 90,
      "max_height_mm": 65
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}

