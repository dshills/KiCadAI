{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "measured_level_translation",
    "title": "Measured level translation",
    "description": "Study a bounded measured level driven by independent voltage and current stimuli across temperature."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
      "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
      "max_voltage_v": 5.25,
        "max_current_a": 0.1,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "measured_voltage",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0.05,
          "nominal_voltage_v": 0.5,
          "max_voltage_v": 0.95,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "excitation_current",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.002
        }
      },
      {
        "id": "reported_level",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0.1,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 4.8,
          "max_current_a": 0.005
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 4.75,
          "nominal_voltage_v": 5,
          "max_voltage_v": 5.25,
          "max_current_a": 0.1
        }
      }
    ],
    "operating_cases": [
      {
        "id": "measurement_range",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "measured_voltage",
            "min": 0.1,
            "max": 0.9,
            "unit": "V"
          },
          {
            "axis": "input_current",
            "target": "excitation_current",
            "min": 0.0005,
            "max": 0.0015,
            "unit": "A"
          },
          {
            "axis": "load_resistance",
            "target": "reported_level",
            "min": 10000,
            "max": 100000,
            "unit": "ohm"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -40,
            "max": 85,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "measurement_corners",
        "conditions": [
          {
            "axis": "model_corner",
            "target": "reported_level",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "reported_level",
            "min": 0.98,
            "max": 1.02,
            "unit": "ratio"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "measured_change",
            "kind": "input_step",
            "target": "measured_voltage",
            "trigger_time_s": 0.001,
            "initial": 0.2,
            "applied": 0.8,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "reported_gain",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_voltage"
        },
        "observation": {
          "kind": "port",
          "id": "reported_level"
        },
        "min": 4.8,
        "max": 5.2,
        "unit": "ratio",
        "critical": true,
        "operating_cases": [
          "measurement_range",
          "measurement_corners"
        ]
      },
      {
        "id": "excitation_loading",
        "metric": "input_impedance",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "excitation_current"
        },
        "observation": {
          "kind": "port",
          "id": "measured_voltage"
        },
        "min": 100000,
        "unit": "ohm",
        "operating_cases": [
          "measurement_range",
          "measurement_corners"
        ]
      },
      {
        "id": "reported_noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "reported_level"
        },
        "max": 0.005,
        "unit": "V_rms",
        "frequency_hz": 10000,
        "operating_cases": [
          "measurement_range"
        ]
      },
      {
        "id": "step_settling",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "measured_voltage"
        },
        "observation": {
          "kind": "port",
          "id": "reported_level"
        },
        "max": 0.002,
        "unit": "s",
        "critical": true,
        "operating_cases": [
          "measurement_corners"
        ]
      }
    ],
    "constraints": {
      "max_components": 28,
      "max_width_mm": 90,
      "max_height_mm": 65
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
