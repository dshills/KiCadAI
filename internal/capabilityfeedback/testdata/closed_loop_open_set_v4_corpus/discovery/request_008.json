{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "convergent_level_control",
    "title": "Convergent level control",
    "description": "Study one externally observed level under three independent commands and environmental variation."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "control_supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.08,
        "source": "external"
      },
      {
        "id": "delivery_supply",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.15,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "mode_request",
        "kind": "digital",
        "direction": "sink",
        "domain": "control_supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "input_impedance_min_ohm": 50000,
          "default_state": "low"
        }
      },
      {
        "id": "reference_request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0.2,
          "nominal_voltage_v": 1,
          "max_voltage_v": 1.8,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "current_request",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.001
        }
      },
      {
        "id": "level_out",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 4.8,
          "max_current_a": 0.01
        }
      },
      {
        "id": "control_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "control_supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.08
        }
      },
      {
        "id": "delivery_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "delivery_supply",
        "electrical": {
          "min_voltage_v": 4.75,
          "nominal_voltage_v": 5,
          "max_voltage_v": 5.25,
          "max_current_a": 0.15
        }
      }
    ],
    "operating_cases": [
      {
        "id": "regulated",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "reference_request",
            "min": 0.3,
            "max": 1.7,
            "unit": "V"
          },
          {
            "axis": "input_current",
            "target": "current_request",
            "min": 0,
            "max": 0.0008,
            "unit": "A"
          },
          {
            "axis": "load_resistance",
            "target": "level_out",
            "min": 1000,
            "max": 20000,
            "unit": "ohm"
          },
          {
            "axis": "supply_voltage",
            "target": "delivery_supply",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          }
        ]
      },
      {
        "id": "wide_environment",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -30,
            "max": 85,
            "unit": "degC"
          },
          {
            "axis": "model_corner",
            "target": "level_out",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "level_out",
            "min": 0.97,
            "max": 1.03,
            "unit": "ratio"
          },
          {
            "axis": "supply_voltage",
            "target": "control_supply",
            "min": 3,
            "max": 3.6,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "mode_change",
            "kind": "input_step",
            "target": "mode_request",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "reference_effect",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "reference_request"
        },
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "min": 1.9,
        "max": 2.1,
        "unit": "ratio",
        "operating_cases": [
          "regulated",
          "wide_environment"
        ]
      },
      {
        "id": "current_effect",
        "metric": "transimpedance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "current_request"
        },
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "min": 950,
        "max": 1050,
        "unit": "V/A",
        "operating_cases": [
          "regulated",
          "wide_environment"
        ]
      },
      {
        "id": "mode_recovery",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "mode_request"
        },
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "max": 0.001,
        "unit": "s",
        "operating_cases": [
          "wide_environment"
        ]
      },
      {
        "id": "level_stability",
        "metric": "phase_margin",
        "analysis": "stability",
        "excitation": {
          "kind": "port",
          "id": "reference_request"
        },
        "observation": {
          "kind": "port",
          "id": "level_out"
        },
        "min": 50,
        "unit": "deg",
        "frequency_hz": 10000,
        "operating_cases": [
          "regulated",
          "wide_environment"
        ]
      },
      {
        "id": "temperature_limit",
        "metric": "junction_temperature",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "controlled_behavior"
        },
        "max": 120,
        "unit": "degC",
        "critical": true,
        "operating_cases": [
          "regulated",
          "wide_environment"
        ]
      }
    ],
    "constraints": {
      "max_components": 28,
      "max_width_mm": 90,
      "max_height_mm": 65
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}

