{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "cross_supply_state_transfer",
    "title": "Cross-supply state transfer",
    "description": "Study state amplitude, timing, and bounded behavior as independent external supplies change or disappear."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "input_supply",
        "kind": "supply",
        "min_voltage_v": 1.7,
        "nominal_voltage_v": 1.8,
        "max_voltage_v": 1.9,
        "max_current_a": 0.04,
        "source": "external"
      },
      {
        "id": "output_supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.08,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "data_level",
        "kind": "digital",
        "direction": "sink",
        "domain": "input_supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0.9,
          "max_voltage_v": 1.9,
          "input_impedance_min_ohm": 50000,
          "default_state": "low"
        }
      },
      {
        "id": "timing_level",
        "kind": "digital",
        "direction": "sink",
        "domain": "input_supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0.9,
          "max_voltage_v": 1.9,
          "input_impedance_min_ohm": 50000,
          "default_state": "low"
        }
      },
      {
        "id": "state_out",
        "kind": "digital",
        "direction": "source",
        "domain": "output_supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "max_current_a": 0.01,
          "default_state": "low"
        }
      },
      {
        "id": "input_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "input_supply",
        "electrical": {
          "min_voltage_v": 1.7,
          "nominal_voltage_v": 1.8,
          "max_voltage_v": 1.9,
          "max_current_a": 0.04
        }
      },
      {
        "id": "output_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "output_supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.08
        }
      }
    ],
    "operating_cases": [
      {
        "id": "both_present",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "input_supply",
            "min": 1.7,
            "max": 1.9,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "output_supply",
            "min": 3,
            "max": 3.6,
            "unit": "V"
          },
          {
            "axis": "load_capacitance",
            "target": "state_out",
            "min": 0,
            "max": 1e-10,
            "unit": "F"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -30,
            "max": 80,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "supply_interruption",
        "conditions": [
          {
            "axis": "model_corner",
            "target": "state_out",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "state_out",
            "min": 0.97,
            "max": 1.03,
            "unit": "ratio"
          }
        ],
        "events": [
          {
            "id": "data_change",
            "kind": "input_step",
            "target": "data_level",
            "trigger_time_s": 0.0001,
            "initial": 0,
            "applied": 1.8,
            "unit": "V"
          },
          {
            "id": "input_loss",
            "kind": "rail_loss",
            "target": "input_entry",
            "trigger_time_s": 0.0002,
            "initial": 1.8,
            "applied": 0,
            "unit": "V"
          },
          {
            "id": "output_restore",
            "kind": "startup",
            "target": "output_entry",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "valid_high",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "data_level"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "min": 2.7,
        "max": 3.6,
        "unit": "V",
        "critical": true,
        "operating_cases": [
          "both_present"
        ]
      },
      {
        "id": "valid_low",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "timing_level"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "min": 0,
        "max": 0.3,
        "unit": "V",
        "critical": true,
        "operating_cases": [
          "both_present",
          "supply_interruption"
        ]
      },
      {
        "id": "bounded_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "data_level"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "max": 5e-7,
        "unit": "s",
        "critical": true,
        "operating_cases": [
          "both_present"
        ]
      },
      {
        "id": "interruption_current",
        "metric": "peak_current",
        "analysis": "transient",
        "observation": {
          "kind": "port",
          "id": "input_entry"
        },
        "max": 0.04,
        "unit": "A",
        "critical": true,
        "operating_cases": [
          "supply_interruption"
        ]
      },
      {
        "id": "quiet_output",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "max": 0.01,
        "unit": "V_rms",
        "frequency_hz": 100000,
        "operating_cases": [
          "both_present"
        ]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}

