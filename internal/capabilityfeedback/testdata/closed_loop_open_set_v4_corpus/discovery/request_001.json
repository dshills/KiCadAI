{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "paired_quiet_scaling",
    "title": "Paired quiet scaling",
    "description": "Study two externally observed responses to one bounded command under load and environment variation."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.15,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "command",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0.1,
          "nominal_voltage_v": 0.5,
          "max_voltage_v": 0.9,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "response_main",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0.25,
          "nominal_voltage_v": 1.5,
          "max_voltage_v": 2.9,
          "max_current_a": 0.003
        }
      },
      {
        "id": "response_aux",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0.12,
          "nominal_voltage_v": 0.75,
          "max_voltage_v": 1.5,
          "max_current_a": 0.002
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 4.75,
          "nominal_voltage_v": 5,
          "max_voltage_v": 5.25,
          "max_current_a": 0.15
        }
      }
    ],
    "operating_cases": [
      {
        "id": "usual",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": 20,
            "max": 30,
            "unit": "degC"
          },
          {
            "axis": "input_voltage",
            "target": "command",
            "min": 0.2,
            "max": 0.8,
            "unit": "V"
          },
          {
            "axis": "load_resistance",
            "target": "response_main",
            "min": 10000,
            "max": 100000,
            "unit": "ohm"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          }
        ]
      },
      {
        "id": "extended",
        "conditions": [
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "tolerance_corner",
            "target": "response_aux",
            "min": 0.97,
            "max": 1.03,
            "unit": "ratio"
          },
          {
            "axis": "load_capacitance",
            "target": "response_aux",
            "min": 0,
            "max": 2e-9,
            "unit": "F"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "command_change",
            "kind": "input_step",
            "target": "command",
            "trigger_time_s": 0.001,
            "initial": 0.2,
            "applied": 0.8,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "main_scale",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "command"
        },
        "observation": {
          "kind": "port",
          "id": "response_main"
        },
        "min": 2.9,
        "max": 3.1,
        "unit": "ratio",
        "operating_cases": [
          "usual",
          "extended"
        ]
      },
      {
        "id": "aux_scale",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "command"
        },
        "observation": {
          "kind": "port",
          "id": "response_aux"
        },
        "min": 1.45,
        "max": 1.55,
        "unit": "ratio",
        "operating_cases": [
          "usual",
          "extended"
        ]
      },
      {
        "id": "main_quietness",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "observation": {
          "kind": "port",
          "id": "response_main"
        },
        "max": 0.002,
        "unit": "V_rms",
        "frequency_hz": 20000,
        "operating_cases": [
          "usual",
          "extended"
        ]
      },
      {
        "id": "aux_settling",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "command"
        },
        "observation": {
          "kind": "port",
          "id": "response_aux"
        },
        "max": 0.0002,
        "unit": "s",
        "operating_cases": [
          "extended"
        ]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}

