{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_mode_observation",
    "title": "Dual-mode observation",
    "description": "Study simultaneous continuous and state observations from independent bounded stimuli."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "positive_supply",
        "kind": "supply",
        "min_voltage_v": 7.5,
        "nominal_voltage_v": 8,
        "max_voltage_v": 8.5,
        "max_current_a": 0.15,
        "source": "external"
      },
      {
        "id": "negative_supply",
        "kind": "supply",
        "min_voltage_v": -8.5,
        "nominal_voltage_v": -8,
        "max_voltage_v": -7.5,
        "max_current_a": 0.15,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "wave_request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": -1,
          "nominal_voltage_v": 0,
          "max_voltage_v": 1,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "current_request",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.001
        }
      },
      {
        "id": "wave_out",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": -5,
          "nominal_voltage_v": 0,
          "max_voltage_v": 5,
          "max_current_a": 0.01
        }
      },
      {
        "id": "state_out",
        "kind": "digital",
        "direction": "source",
        "domain": "positive_supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 4,
          "max_voltage_v": 8,
          "max_current_a": 0.005,
          "default_state": "low"
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "positive_supply",
        "electrical": {
          "min_voltage_v": 7.5,
          "nominal_voltage_v": 8,
          "max_voltage_v": 8.5,
          "max_current_a": 0.15
        }
      }
    ],
    "operating_cases": [
      {
        "id": "frequency_response",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "wave_request",
            "min": -0.8,
            "max": 0.8,
            "unit": "V"
          },
          {
            "axis": "input_current",
            "target": "current_request",
            "min": 0,
            "max": 0.0008,
            "unit": "A"
          },
          {
            "axis": "load_resistance",
            "target": "wave_out",
            "min": 2000,
            "max": 20000,
            "unit": "ohm"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -10,
            "max": 60,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "wide_corners",
        "conditions": [
          {
            "axis": "model_corner",
            "target": "wave_out",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "state_out",
            "min": 0.98,
            "max": 1.02,
            "unit": "ratio"
          },
          {
            "axis": "supply_voltage",
            "target": "positive_supply",
            "min": 7.5,
            "max": 8.5,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "negative_supply",
            "min": -8.5,
            "max": -7.5,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "wave_change",
            "kind": "input_step",
            "target": "wave_request",
            "trigger_time_s": 0.001,
            "initial": -0.5,
            "applied": 0.5,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "wave_transfer",
        "metric": "voltage_gain_at_frequency",
        "analysis": "ac_sweep",
        "excitation": {
          "kind": "port",
          "id": "wave_request"
        },
        "observation": {
          "kind": "port",
          "id": "wave_out"
        },
        "min": 3.8,
        "max": 4.2,
        "unit": "ratio",
        "frequency_hz": 1000,
        "operating_cases": [
          "frequency_response",
          "wide_corners"
        ]
      },
      {
        "id": "current_transfer",
        "metric": "transimpedance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "current_request"
        },
        "observation": {
          "kind": "port",
          "id": "wave_out"
        },
        "min": 3900,
        "max": 4100,
        "unit": "V/A",
        "operating_cases": [
          "frequency_response",
          "wide_corners"
        ]
      },
      {
        "id": "state_high",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "wave_request"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "min": 6.5,
        "max": 8.5,
        "unit": "V",
        "operating_cases": [
          "frequency_response"
        ]
      },
      {
        "id": "wave_distortion",
        "metric": "total_harmonic_distortion",
        "analysis": "distortion",
        "excitation": {
          "kind": "port",
          "id": "wave_request"
        },
        "observation": {
          "kind": "port",
          "id": "wave_out"
        },
        "max": 1,
      "unit": "%",
        "frequency_hz": 1000,
        "operating_cases": [
          "frequency_response"
        ]
      },
      {
        "id": "state_delay",
        "metric": "propagation_delay",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "wave_request"
        },
        "observation": {
          "kind": "port",
          "id": "state_out"
        },
        "max": 0.0001,
        "unit": "s",
        "operating_cases": [
          "wide_corners"
        ]
      }
    ],
    "constraints": {
      "max_components": 28,
      "max_width_mm": 90,
      "max_height_mm": 65
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
