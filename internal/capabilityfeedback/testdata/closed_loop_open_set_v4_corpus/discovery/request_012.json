{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "guarded_command_delivery",
    "title": "Guarded command delivery",
    "description": "Study one bounded delivered level under three independent external controls and finite fault events."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "control_supply",
        "kind": "supply",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.08,
        "source": "external"
      },
      {
        "id": "delivery_supply",
        "kind": "supply",
        "min_voltage_v": 9,
        "nominal_voltage_v": 12,
        "max_voltage_v": 15,
        "max_current_a": 0.8,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "command_level",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1,
          "max_voltage_v": 2,
          "input_impedance_min_ohm": 50000
        }
      },
      {
        "id": "permission_state",
        "kind": "digital",
        "direction": "sink",
        "domain": "control_supply",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.65,
          "max_voltage_v": 3.6,
          "input_impedance_min_ohm": 50000,
          "default_state": "low"
        }
      },
      {
        "id": "limit_request",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.005
        }
      },
      {
        "id": "delivered_level",
        "kind": "power",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 4.9,
          "max_voltage_v": 10,
          "max_current_a": 0.5
        }
      },
      {
        "id": "delivery_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "delivery_supply",
        "electrical": {
          "min_voltage_v": 9,
          "nominal_voltage_v": 12,
          "max_voltage_v": 15,
          "max_current_a": 0.8
        }
      },
      {
        "id": "control_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "control_supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.08
        }
      }
    ],
    "operating_cases": [
      {
        "id": "permitted",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "command_level",
            "min": 0.2,
            "max": 1.6,
            "unit": "V"
          },
          {
            "axis": "input_current",
            "target": "limit_request",
            "min": 0.001,
            "max": 0.004,
            "unit": "A"
          },
          {
            "axis": "load_current",
            "target": "delivered_level",
            "min": 0.05,
            "max": 0.4,
            "unit": "A"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -20,
            "max": 70,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "interrupted",
        "conditions": [
          {
            "axis": "supply_voltage",
            "target": "delivery_supply",
            "min": 9,
            "max": 15,
            "unit": "V"
          },
          {
            "axis": "model_corner",
            "target": "delivered_level",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "delivered_level",
            "min": 0.97,
            "max": 1.03,
            "unit": "ratio"
          }
        ],
        "events": [
          {
            "id": "permission_change",
            "kind": "input_step",
            "target": "permission_state",
            "trigger_time_s": 0.001,
            "initial": 0,
            "applied": 3.3,
            "unit": "V"
          },
          {
            "id": "bounded_short",
            "kind": "short_circuit",
            "target": "delivered_level",
            "trigger_time_s": 0.01,
            "initial": 50,
            "applied": 0.25,
            "unit": "ohm"
          },
          {
            "id": "delivery_loss",
            "kind": "rail_loss",
            "target": "delivery_entry",
            "trigger_time_s": 0.02,
            "initial": 12,
            "applied": 0,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "command_transfer",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "command_level"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_level"
        },
        "min": 4.8,
        "max": 5,
        "unit": "ratio",
        "critical": true,
        "operating_cases": [
          "permitted"
        ]
      },
      {
        "id": "permission_recovery",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "permission_state"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_level"
        },
        "max": 0.002,
        "unit": "s",
        "critical": true,
        "operating_cases": [
          "permitted",
          "interrupted"
        ]
      },
      {
        "id": "limit_peak",
        "metric": "peak_current",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "limit_request"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_level"
        },
        "max": 0.5,
        "unit": "A",
        "critical": true,
        "operating_cases": [
          "interrupted"
        ]
      },
      {
        "id": "stability_margin",
        "metric": "phase_margin",
        "analysis": "stability",
        "excitation": {
          "kind": "port",
          "id": "command_level"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_level"
        },
        "min": 45,
        "unit": "deg",
        "frequency_hz": 5000,
        "critical": true,
        "operating_cases": [
          "permitted"
        ]
      },
      {
        "id": "thermal_margin",
        "metric": "soa_margin",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "guarded_behavior"
        },
        "min": 1.2,
        "unit": "ratio",
        "critical": true,
        "operating_cases": [
          "permitted",
          "interrupted"
        ]
      }
    ],
    "constraints": {
      "max_components": 28,
      "max_width_mm": 90,
      "max_height_mm": 65
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
