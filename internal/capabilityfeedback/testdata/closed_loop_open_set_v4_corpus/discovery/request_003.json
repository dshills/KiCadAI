{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_energy_delivery",
    "title": "Bounded energy delivery",
    "description": "Study regulated energy delivery and an independent auxiliary observation during demand and startup variation."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "primary_supply",
        "kind": "supply",
        "min_voltage_v": 9,
        "nominal_voltage_v": 12,
        "max_voltage_v": 14,
        "max_current_a": 1.2,
        "source": "external"
      },
      {
        "id": "auxiliary_supply",
        "kind": "supply",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.05,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "demand",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.9
        }
      },
      {
        "id": "delivered_power",
        "kind": "power",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 4.8,
          "nominal_voltage_v": 5,
          "max_voltage_v": 5.2,
          "max_current_a": 1
        }
      },
      {
        "id": "auxiliary_level",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 5,
          "max_current_a": 0.002
        }
      },
      {
        "id": "primary_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "primary_supply",
        "electrical": {
          "min_voltage_v": 9,
          "nominal_voltage_v": 12,
          "max_voltage_v": 14,
          "max_current_a": 1.2
        }
      }
    ],
    "operating_cases": [
      {
        "id": "steady_load",
        "conditions": [
          {
            "axis": "load_current",
            "target": "delivered_power",
            "min": 0.1,
            "max": 0.8,
            "unit": "A"
          },
          {
            "axis": "supply_voltage",
            "target": "primary_supply",
            "min": 9,
            "max": 14,
            "unit": "V"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -10,
            "max": 60,
            "unit": "degC"
          },
          {
            "axis": "tolerance_corner",
            "target": "delivered_power",
            "min": 0.98,
            "max": 1.02,
            "unit": "ratio"
          }
        ]
      },
      {
        "id": "dynamic_load",
        "conditions": [
          {
            "axis": "load_capacitance",
            "target": "delivered_power",
            "min": 0,
            "max": 0.00047,
            "unit": "F"
          },
          {
            "axis": "model_corner",
            "target": "delivered_power",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "supply_voltage",
            "target": "auxiliary_supply",
            "min": 4.75,
            "max": 5.25,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "energize",
            "kind": "startup",
            "target": "primary_entry",
            "trigger_time_s": 0,
            "initial": 0,
            "applied": 12,
            "unit": "V"
          },
          {
            "id": "demand_change",
            "kind": "load_step",
            "target": "demand",
            "trigger_time_s": 0.01,
            "initial": 0.1,
            "applied": 0.75,
            "unit": "A"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "delivered_level",
        "metric": "output_voltage",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "demand"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_power"
        },
        "min": 4.8,
        "max": 5.2,
        "unit": "V",
        "critical": true,
        "operating_cases": [
          "steady_load",
          "dynamic_load"
        ]
      },
      {
        "id": "delivered_current",
        "metric": "output_current",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "demand"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_power"
        },
        "min": 0.1,
        "max": 0.85,
        "unit": "A",
        "operating_cases": [
          "steady_load"
        ]
      },
      {
        "id": "delivered_watts",
        "metric": "output_power",
        "analysis": "electrothermal",
        "excitation": {
          "kind": "port",
          "id": "demand"
        },
        "observation": {
          "kind": "port",
          "id": "delivered_power"
        },
        "min": 0.48,
        "max": 4.42,
        "unit": "W",
        "critical": true,
        "operating_cases": [
          "steady_load",
          "dynamic_load"
        ]
      },
      {
        "id": "auxiliary_bounds",
        "metric": "output_voltage",
        "analysis": "dc_operating_point",
        "observation": {
          "kind": "port",
          "id": "auxiliary_level"
        },
        "min": 0.2,
        "max": 4.8,
        "unit": "V",
        "operating_cases": [
          "steady_load",
          "dynamic_load"
        ]
      },
      {
        "id": "startup_peak",
        "metric": "startup_current",
        "analysis": "startup",
        "observation": {
          "kind": "port",
          "id": "primary_entry"
        },
        "max": 1.1,
        "unit": "A",
        "critical": true,
        "operating_cases": [
          "dynamic_load"
        ]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
