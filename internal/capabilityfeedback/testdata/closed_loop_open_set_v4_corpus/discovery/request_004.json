{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "interrupted_limited_delivery",
    "title": "Interrupted limited delivery",
    "description": "Study bounded delivery during power changes, removal, and a bounded low-resistance load fault."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "supply",
        "kind": "supply",
        "min_voltage_v": 18,
        "nominal_voltage_v": 24,
        "max_voltage_v": 30,
        "max_current_a": 1.8,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "enable_request",
        "kind": "digital",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 5,
          "input_impedance_min_ohm": 20000,
          "default_state": "low"
        }
      },
      {
        "id": "delivery",
        "kind": "power",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 10,
          "max_voltage_v": 11,
          "max_current_a": 1.5
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "supply",
        "electrical": {
          "min_voltage_v": 18,
          "nominal_voltage_v": 24,
          "max_voltage_v": 30,
          "max_current_a": 1.8
        }
      },
      {
        "id": "fault_stimulus",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 1,
          "input_impedance_min_ohm": 10000
        }
      }
    ],
    "operating_cases": [
      {
        "id": "normal_delivery",
        "conditions": [
          {
            "axis": "load_current",
            "target": "delivery",
            "min": 0.05,
            "max": 1.2,
            "unit": "A"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": -20,
            "max": 70,
            "unit": "degC"
          },
          {
            "axis": "supply_voltage",
            "target": "supply",
            "min": 18,
            "max": 30,
            "unit": "V"
          },
          {
            "axis": "model_corner",
            "target": "delivery",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          }
        ]
      },
      {
        "id": "bounded_faults",
        "conditions": [
          {
            "axis": "load_inductance",
            "target": "delivery",
            "min": 0,
            "max": 0.0001,
            "unit": "H"
          },
          {
            "axis": "tolerance_corner",
            "target": "delivery",
            "min": 0.97,
            "max": 1.03,
            "unit": "ratio"
          }
        ],
        "events": [
          {
            "id": "input_power_change",
            "kind": "power_step",
            "target": "supply_entry",
            "trigger_time_s": 0.002,
            "initial": 20,
            "applied": 35,
            "unit": "W"
          },
          {
            "id": "supply_removal",
            "kind": "rail_loss",
            "target": "supply_entry",
            "trigger_time_s": 0.01,
            "initial": 24,
            "applied": 0,
            "unit": "V"
          },
          {
            "id": "limited_short",
            "kind": "short_circuit",
            "target": "delivery",
            "trigger_time_s": 0.02,
            "initial": 100,
            "applied": 0.1,
            "unit": "ohm"
          },
          {
            "id": "restart",
            "kind": "startup",
            "target": "supply_entry",
            "trigger_time_s": 0.05,
            "initial": 0,
            "applied": 24,
            "unit": "V"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "normal_voltage",
        "metric": "output_voltage",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "enable_request"
        },
        "observation": {
          "kind": "port",
          "id": "delivery"
        },
        "min": 9.5,
        "max": 10.5,
        "unit": "V",
        "critical": true,
        "operating_cases": [
          "normal_delivery"
        ]
      },
      {
        "id": "fault_peak",
        "metric": "peak_current",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "fault_stimulus"
        },
        "observation": {
          "kind": "port",
          "id": "delivery"
        },
        "max": 1.5,
        "unit": "A",
        "critical": true,
        "operating_cases": [
          "bounded_faults"
        ]
      },
      {
        "id": "thermal_ceiling",
        "metric": "junction_temperature",
        "analysis": "thermal",
        "observation": {
          "kind": "circuit",
          "id": "assembly_temperature"
        },
        "max": 125,
        "unit": "degC",
        "critical": true,
        "operating_cases": [
          "normal_delivery",
          "bounded_faults"
        ]
      },
      {
        "id": "inactive_draw",
        "metric": "quiescent_current",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "enable_request"
        },
        "observation": {
          "kind": "port",
          "id": "supply_entry"
        },
        "max": 0.01,
        "unit": "A",
        "operating_cases": [
          "normal_delivery"
        ]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
