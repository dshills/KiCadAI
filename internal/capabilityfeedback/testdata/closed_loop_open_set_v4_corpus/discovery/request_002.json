{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "guided_current_response",
    "title": "Guided current response",
    "description": "Study one bounded delivered current as three independent external stimuli vary across corners."
  },
  "requirements": {
    "domains": [
      {
        "id": "return",
        "kind": "reference",
        "source": "external"
      },
      {
        "id": "positive_supply",
        "kind": "supply",
        "min_voltage_v": 11.4,
        "nominal_voltage_v": 12,
        "max_voltage_v": 12.6,
        "max_current_a": 0.12,
        "source": "external"
      },
      {
        "id": "negative_supply",
        "kind": "supply",
        "min_voltage_v": -12.6,
        "nominal_voltage_v": -12,
        "max_voltage_v": -11.4,
        "max_current_a": 0.12,
        "source": "external"
      }
    ],
    "ports": [
      {
        "id": "level_request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0.5,
          "max_voltage_v": 1,
          "input_impedance_min_ohm": 50000
        }
      },
      {
        "id": "trim_request",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "min_voltage_v": -0.1,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0.1,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "load_request",
        "kind": "analog_current",
        "direction": "sink",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.002
        }
      },
      {
        "id": "delivered",
        "kind": "controlled_current",
        "direction": "source",
        "domain": "return",
        "electrical": {
          "max_current_a": 0.025
        }
      },
      {
        "id": "supply_entry",
        "kind": "power",
        "direction": "sink",
        "domain": "positive_supply",
        "electrical": {
          "min_voltage_v": 11.4,
          "nominal_voltage_v": 12,
          "max_voltage_v": 12.6,
          "max_current_a": 0.12
        }
      }
    ],
    "operating_cases": [
      {
        "id": "balanced",
        "conditions": [
          {
            "axis": "input_voltage",
            "target": "level_request",
            "min": 0.1,
            "max": 0.9,
            "unit": "V"
          },
          {
            "axis": "input_voltage",
            "target": "trim_request",
            "min": -0.05,
            "max": 0.05,
            "unit": "V"
          },
          {
            "axis": "load_resistance",
            "target": "delivered",
            "min": 200,
            "max": 500,
            "unit": "ohm"
          },
          {
            "axis": "ambient_temperature",
            "target": "return",
            "min": 15,
            "max": 40,
            "unit": "degC"
          }
        ]
      },
      {
        "id": "corners",
        "conditions": [
          {
            "axis": "model_corner",
            "target": "delivered",
            "min": 0,
            "max": 1,
            "unit": "ratio"
          },
          {
            "axis": "tolerance_corner",
            "target": "delivered",
            "min": 0.98,
            "max": 1.02,
            "unit": "ratio"
          },
          {
            "axis": "supply_voltage",
            "target": "positive_supply",
            "min": 11.4,
            "max": 12.6,
            "unit": "V"
          },
          {
            "axis": "supply_voltage",
            "target": "negative_supply",
            "min": -12.6,
            "max": -11.4,
            "unit": "V"
          }
        ],
        "events": [
          {
            "id": "load_change",
            "kind": "load_step",
            "target": "load_request",
            "trigger_time_s": 0.002,
            "initial": 0.0002,
            "applied": 0.0015,
            "unit": "A"
          }
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "level_transfer",
        "metric": "transconductance",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "level_request"
        },
        "observation": {
          "kind": "port",
          "id": "delivered"
        },
        "min": 0.019,
        "max": 0.021,
        "unit": "A/V",
        "operating_cases": [
          "balanced",
          "corners"
        ]
      },
      {
        "id": "trim_authority",
        "metric": "output_current",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "trim_request"
        },
        "observation": {
          "kind": "port",
          "id": "delivered"
        },
        "min": 0.001,
        "max": 0.022,
        "unit": "A",
        "operating_cases": [
          "balanced",
          "corners"
        ]
      },
      {
        "id": "load_recovery",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {
          "kind": "port",
          "id": "load_request"
        },
        "observation": {
          "kind": "port",
          "id": "delivered"
        },
        "max": 0.0005,
        "unit": "s",
        "operating_cases": [
          "corners"
        ]
      },
      {
        "id": "delivered_margin",
        "metric": "soa_margin",
        "analysis": "electrothermal",
        "observation": {
          "kind": "circuit",
          "id": "delivered_behavior"
        },
        "min": 1.25,
        "unit": "ratio",
        "critical": true,
        "operating_cases": [
          "balanced",
          "corners"
        ]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
