{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "commanded_current_response",
    "title": "Commanded Current Response Behavior",
    "description": "Evaluate the frequency response and bounded output current produced from an external command under varied supply and load conditions."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "input_supply", "kind": "supply", "source": "external", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 1}
    ],
    "ports": [
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "input_supply", "electrical": {"min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 1}},
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "max_current_a": 1}},
      {"id": "command_input", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 2, "max_voltage_v": 4, "max_current_a": 0.001, "input_impedance_min_ohm": 100000}},
      {"id": "current_output", "kind": "controlled_current", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 4, "max_voltage_v": 8, "max_current_a": 0.2}}
    ],
    "operating_cases": [
      {
        "id": "nominal_command_response",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 12, "max": 12, "unit": "V"},
          {"axis": "input_voltage", "target": "command_input", "min": 0.5, "max": 4, "unit": "V"},
          {"axis": "load_resistance", "target": "current_output", "min": 20, "max": 40, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": 20, "max": 30, "unit": "degC"}
        ]
      },
      {
        "id": "supply_load_edges",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 10, "max": 14, "unit": "V"},
          {"axis": "input_voltage", "target": "command_input", "min": 0.5, "max": 4, "unit": "V"},
          {"axis": "load_resistance", "target": "current_output", "min": 20, "max": 40, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": -10, "max": 60, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "a_command_bandwidth",
        "metric": "bandwidth",
        "analysis": "ac_sweep",
        "excitation": {"kind": "port", "id": "command_input"},
        "observation": {"kind": "port", "id": "current_output"},
        "min": 2000,
        "max": 20000,
        "unit": "Hz",
        "operating_cases": ["nominal_command_response", "supply_load_edges"]
      },
      {
        "id": "b_command_transconductance",
        "metric": "transconductance",
        "analysis": "ac_sweep",
        "excitation": {"kind": "port", "id": "command_input"},
        "observation": {"kind": "port", "id": "current_output"},
        "min": 0.045,
        "max": 0.055,
        "unit": "A/V",
        "operating_cases": ["nominal_command_response", "supply_load_edges"],
        "frequency_hz": 100
      },
      {
        "id": "c_output_current_range",
        "metric": "output_current",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "command_input"},
        "observation": {"kind": "port", "id": "current_output"},
        "min": 0.02,
        "max": 0.2,
        "unit": "A",
        "operating_cases": ["nominal_command_response", "supply_load_edges"],
        "critical": true
      },
      {
        "id": "d_command_settling",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {"kind": "port", "id": "command_input"},
        "observation": {"kind": "port", "id": "current_output"},
        "max": 0.001,
        "unit": "s",
        "operating_cases": ["nominal_command_response", "supply_load_edges"],
        "critical": true
      }
    ],
    "constraints": {"max_components": 30, "max_width_mm": 55, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
