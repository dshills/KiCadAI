{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_signal_scaling",
    "title": "Bounded Signal Scaling",
    "description": "Study bounded signal scaling across external supply, temperature, load, and a finite output-fault envelope."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external", "nominal_voltage_v": 0},
      {"id": "measurement_supply", "kind": "supply", "source": "external", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 0.2}
    ],
    "ports": [
      {"id": "supply_in", "kind": "power", "direction": "sink", "domain": "measurement_supply", "electrical": {"min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 0.2}},
      {"id": "signal_in", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": -0.1, "nominal_voltage_v": 0, "max_voltage_v": 0.1, "input_impedance_min_ohm": 1000000}},
      {"id": "signal_out", "kind": "analog_voltage", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": -5, "nominal_voltage_v": 0, "max_voltage_v": 5, "max_current_a": 0.03}}
    ],
    "operating_cases": [
      {"id": "normal_measurement", "conditions": [
        {"axis": "supply_voltage", "target": "measurement_supply", "min": 9, "max": 15, "unit": "V"},
        {"axis": "input_voltage", "target": "signal_in", "min": -0.05, "max": 0.05, "unit": "V"},
        {"axis": "load_resistance", "target": "signal_out", "min": 10000, "max": 100000, "unit": "ohm"},
        {"axis": "ambient_temperature", "target": "signal_return", "min": -20, "max": 70, "unit": "degC"}
      ]},
      {"id": "bounded_output_fault", "conditions": [
        {"axis": "supply_voltage", "target": "measurement_supply", "min": 9, "max": 15, "unit": "V"},
        {"axis": "input_voltage", "target": "signal_in", "min": -0.02, "max": 0.02, "unit": "V"},
        {"axis": "ambient_temperature", "target": "signal_return", "min": 70, "max": 85, "unit": "degC"}
      ], "events": [
        {"id": "finite_output_fault", "kind": "short_circuit", "target": "signal_out", "trigger_time_s": 0.01, "initial": 10000, "applied": 100, "unit": "ohm"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "static_scaling", "metric": "voltage_gain", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "signal_in"}, "observation": {"kind": "port", "id": "signal_out"}, "min": 39, "max": 41, "unit": "ratio", "operating_cases": ["normal_measurement"], "critical": true},
      {"id": "normal_output_span", "metric": "output_swing", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "signal_out"}, "min": 3.8, "max": 4.2, "unit": "V_pp", "operating_cases": ["normal_measurement"]},
      {"id": "bounded_assembly_temperature", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "assembly_temperature"}, "max": 125, "unit": "degC", "operating_cases": ["normal_measurement", "bounded_output_fault"], "critical": true},
      {"id": "fault_peak_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "signal_out"}, "max": 0.03, "unit": "A", "operating_cases": ["bounded_output_fault"], "critical": true}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
