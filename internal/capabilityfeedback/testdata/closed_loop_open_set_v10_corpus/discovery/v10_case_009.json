{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_state_observation_response",
    "title": "Dual externally observed response study",
    "description": "Study two externally observable responses to a bounded input over supply, load, and ambient ranges."
  },
  "requirements": {
    "domains": [
      {
        "id": "signal_reference",
        "kind": "reference",
        "source": "external",
        "min_voltage_v": -0.05,
        "nominal_voltage_v": 0,
        "max_voltage_v": 0.05
      },
      {
        "id": "logic_supply",
        "kind": "supply",
        "source": "external",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.1
      }
    ],
    "ports": [
      {
        "id": "signal_return",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": -0.05,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0.05,
          "max_current_a": 0.1
        }
      },
      {
        "id": "sensed_input",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.25,
          "max_voltage_v": 2.5,
          "max_current_a": 0.001,
          "input_impedance_min_ohm": 100000
        }
      },
      {
        "id": "measurement_output",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.25,
          "max_voltage_v": 2.5,
          "max_current_a": 0.005
        }
      },
      {
        "id": "state_output",
        "kind": "digital",
        "direction": "source",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 3.6,
          "max_current_a": 0.004,
          "default_state": "low"
        }
      },
      {
        "id": "supply_input",
        "kind": "power",
        "direction": "sink",
        "domain": "logic_supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.1
        }
      }
    ],
    "operating_cases": [
      {
        "id": "low_input_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "sensed_input", "min": 0.25, "max": 0.75, "unit": "V"},
          {"axis": "ambient_temperature", "target": "signal_reference", "min": -20, "max": 60, "unit": "degC"},
          {"axis": "load_resistance", "target": "measurement_output", "min": 10000, "max": 1000000, "unit": "ohm"},
          {"axis": "load_current", "target": "state_output", "min": 0, "max": 0.002, "unit": "A"}
        ]
      },
      {
        "id": "high_input_hot_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "sensed_input", "min": 1.75, "max": 2.25, "unit": "V"},
          {"axis": "ambient_temperature", "target": "signal_reference", "min": 60, "max": 85, "unit": "degC"},
          {"axis": "load_resistance", "target": "measurement_output", "min": 10000, "max": 1000000, "unit": "ohm"},
          {"axis": "load_current", "target": "state_output", "min": 0, "max": 0.002, "unit": "A"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "bounded_assembly_temperature",
        "metric": "junction_temperature",
        "analysis": "thermal",
        "observation": {"kind": "circuit", "id": "assembly_thermal_response"},
        "max": 110,
        "unit": "degC",
        "operating_cases": ["low_input_range", "high_input_hot_range"],
        "critical": true
      },
      {
        "id": "measurement_tracking",
        "metric": "voltage_gain",
        "analysis": "dc_operating_point",
        "excitation": {"kind": "port", "id": "sensed_input"},
        "observation": {"kind": "port", "id": "measurement_output"},
        "min": 0.97,
        "max": 1.03,
        "unit": "ratio",
        "operating_cases": ["low_input_range", "high_input_hot_range"]
      },
      {
        "id": "low_state_level",
        "metric": "output_low_voltage",
        "analysis": "dc_operating_point",
        "observation": {"kind": "port", "id": "state_output"},
        "max": 0.35,
        "unit": "V",
        "operating_cases": ["low_input_range"]
      },
      {
        "id": "high_state_level",
        "metric": "output_high_voltage",
        "analysis": "dc_operating_point",
        "observation": {"kind": "port", "id": "state_output"},
        "min": 2.7,
        "unit": "V",
        "operating_cases": ["high_input_hot_range"]
      },
      {
        "id": "measurement_line_stability",
        "metric": "line_regulation",
        "analysis": "dc_sweep",
        "observation": {"kind": "port", "id": "measurement_output"},
        "max": 0.5,
        "unit": "%",
        "operating_cases": ["low_input_range", "high_input_hot_range"]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 80,
      "max_height_mm": 60
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
