{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "commanded_output_envelope",
    "title": "Commanded Output Envelope",
    "description": "Study a bounded output under asserted command, rated loading, ambient extremes, and a finite external fault."
  },
  "requirements": {
    "domains": [
      {"id": "control_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "source_supply", "kind": "supply", "source": "external", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 2.5}
    ],
    "ports": [
      {"id": "source_input", "kind": "power", "direction": "sink", "domain": "source_supply", "electrical": {"min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 2.5}},
      {"id": "source_return", "kind": "reference", "direction": "bidirectional", "domain": "control_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "command_input", "kind": "digital", "direction": "sink", "domain": "control_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 5, "max_current_a": 0.001, "input_impedance_min_ohm": 100000, "default_state": "low"}},
      {"id": "controlled_output", "kind": "analog_voltage", "direction": "source", "domain": "control_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5.3, "max_current_a": 2}}
    ],
    "operating_cases": [
      {
        "id": "asserted_rated_load",
        "conditions": [
          {"axis": "supply_voltage", "target": "source_supply", "min": 10, "max": 14, "unit": "V"},
          {"axis": "input_voltage", "target": "command_input", "min": 3, "max": 5, "unit": "V"},
          {"axis": "load_current", "target": "controlled_output", "min": 0.1, "max": 1.5, "unit": "A"},
          {"axis": "ambient_temperature", "target": "source_supply", "min": -20, "max": 85, "unit": "degC"}
        ]
      },
      {
        "id": "bounded_output_fault",
        "conditions": [
          {"axis": "supply_voltage", "target": "source_supply", "min": 10, "max": 14, "unit": "V"},
          {"axis": "input_voltage", "target": "command_input", "min": 3, "max": 5, "unit": "V"},
          {"axis": "ambient_temperature", "target": "source_supply", "min": -20, "max": 50, "unit": "degC"}
        ],
        "events": [
          {"id": "finite_short_application", "kind": "short_circuit", "target": "controlled_output", "trigger_time_s": 0.01, "initial": 5, "applied": 0.1, "unit": "ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "rated_output_voltage", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "controlled_output"}, "min": 4.8, "max": 5.2, "unit": "V", "operating_cases": ["asserted_rated_load"], "critical": true},
      {"id": "rated_junction_limit", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "assembly_temperature"}, "max": 110, "unit": "degC", "operating_cases": ["asserted_rated_load"], "critical": true},
      {"id": "fault_junction_limit", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "fault_temperature"}, "max": 140, "unit": "degC", "operating_cases": ["bounded_output_fault"], "critical": true},
      {"id": "fault_peak_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "controlled_output"}, "max": 2.4, "unit": "A", "operating_cases": ["bounded_output_fault"], "critical": true},
      {"id": "fault_safe_area_margin", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "fault_operating_margin"}, "min": 1.15, "unit": "ratio", "operating_cases": ["bounded_output_fault"], "critical": true}
    ],
    "constraints": {"max_components": 28, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
