{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bidirectional_limit_response",
    "title": "Bidirectional Limit Response",
    "description": "Study of externally observable state transitions for bounded rising and falling excursions."
  },
  "requirements": {
    "domains": [
      {"id":"signal_ref","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.05},
      {"id":"operating_supply","kind":"supply","source":"external","min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.05}
    ],
    "ports": [
      {"id":"monitored_in","kind":"analog_voltage","direction":"sink","domain":"signal_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":2.5,"max_voltage_v":5.5,"max_current_a":0.001,"input_impedance_min_ohm":100000}},
      {"id":"trip_out","kind":"digital","direction":"source","domain":"signal_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":5.5,"max_current_a":0.01,"default_state":"low"}},
      {"id":"supply_in","kind":"power","direction":"sink","domain":"operating_supply","electrical":{"min_voltage_v":4.5,"nominal_voltage_v":5,"max_voltage_v":5.5,"max_current_a":0.05}},
      {"id":"signal_return","kind":"reference","direction":"bidirectional","domain":"signal_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.05}}
    ],
    "operating_cases": [
      {
        "id": "rising_excursion",
        "conditions": [
          {"axis":"ambient_temperature","target":"signal_ref","min":-20,"max":85,"unit":"degC"},
          {"axis":"input_voltage","target":"monitored_in","min":0,"max":5.5,"unit":"V"},
          {"axis":"load_capacitance","target":"trip_out","min":0,"max":0.000000002,"unit":"F"},
          {"axis":"supply_voltage","target":"operating_supply","min":4.5,"max":5.5,"unit":"V"}
        ],
        "events": [
          {"id":"rise_across_limit","kind":"input_step","target":"monitored_in","trigger_time_s":0.001,"initial":2,"applied":4,"unit":"V"}
        ]
      },
      {
        "id": "falling_excursion",
        "conditions": [
          {"axis":"ambient_temperature","target":"signal_ref","min":-20,"max":85,"unit":"degC"},
          {"axis":"input_voltage","target":"monitored_in","min":0,"max":5.5,"unit":"V"},
          {"axis":"load_capacitance","target":"trip_out","min":0,"max":0.000000002,"unit":"F"},
          {"axis":"supply_voltage","target":"operating_supply","min":4.5,"max":5.5,"unit":"V"}
        ],
        "events": [
          {"id":"fall_across_limit","kind":"input_step","target":"monitored_in","trigger_time_s":0.001,"initial":4,"applied":2,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"rise_response_time","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"monitored_in"},"observation":{"kind":"port","id":"trip_out"},"max":0.000005,"unit":"s","operating_cases":["rising_excursion"],"critical":true},
      {"id":"fall_response_time","metric":"propagation_delay","analysis":"transient","excitation":{"kind":"port","id":"monitored_in"},"observation":{"kind":"port","id":"trip_out"},"max":0.000005,"unit":"s","operating_cases":["falling_excursion"],"critical":true},
      {"id":"rising_limit","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"monitored_in"},"observation":{"kind":"port","id":"trip_out"},"min":2.8,"max":3.2,"unit":"V","operating_cases":["rising_excursion"]},
      {"id":"falling_limit","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"monitored_in"},"observation":{"kind":"port","id":"trip_out"},"min":2.4,"max":2.8,"unit":"V","operating_cases":["falling_excursion"]},
      {"id":"limit_separation","metric":"hysteresis","analysis":"dc_sweep","excitation":{"kind":"port","id":"monitored_in"},"observation":{"kind":"port","id":"trip_out"},"min":0.1,"max":0.8,"unit":"V","operating_cases":["rising_excursion","falling_excursion"]},
      {"id":"asserted_output","metric":"output_high_voltage","analysis":"transient","observation":{"kind":"port","id":"trip_out"},"min":4,"max":5.5,"unit":"V","operating_cases":["rising_excursion"]},
      {"id":"deasserted_output","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"trip_out"},"min":0,"max":0.4,"unit":"V","operating_cases":["falling_excursion"]}
    ],
    "constraints": {"max_components":18,"max_width_mm":50,"max_height_mm":40}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
