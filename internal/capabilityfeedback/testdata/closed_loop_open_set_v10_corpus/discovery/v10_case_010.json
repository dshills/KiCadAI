{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "selectable_reference_response",
    "title": "Selectable bounded response study",
    "description": "Study a bounded output response controlled by external reference and selection inputs across load and supply conditions."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": -0.05, "nominal_voltage_v": 0, "max_voltage_v": 0.05},
      {"id": "analog_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.2}
    ],
    "ports": [
      {"id": "signal_return", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": -0.05, "nominal_voltage_v": 0, "max_voltage_v": 0.05, "max_current_a": 0.2}},
      {"id": "reference_input", "kind": "analog_voltage", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": 0.2, "nominal_voltage_v": 1.5, "max_voltage_v": 3, "max_current_a": 0.001, "input_impedance_min_ohm": 200000}},
      {"id": "selection_input", "kind": "digital", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.001, "input_impedance_min_ohm": 100000, "default_state": "low"}},
      {"id": "response_output", "kind": "analog_voltage", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.5, "max_voltage_v": 3.2, "max_current_a": 0.02}},
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "analog_supply", "electrical": {"min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.2}}
    ],
    "operating_cases": [
      {
        "id": "active_low_reference",
        "conditions": [
          {"axis": "supply_voltage", "target": "analog_supply", "min": 4.5, "max": 5.5, "unit": "V"},
          {"axis": "input_voltage", "target": "reference_input", "min": 0.25, "max": 0.75, "unit": "V"},
          {"axis": "input_voltage", "target": "selection_input", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "load_capacitance", "target": "response_output", "min": 0.000000001, "max": 0.0000001, "unit": "F"},
          {"axis": "load_resistance", "target": "response_output", "min": 1000, "max": 100000, "unit": "ohm"}
        ]
      },
      {
        "id": "active_high_reference",
        "conditions": [
          {"axis": "supply_voltage", "target": "analog_supply", "min": 4.5, "max": 5.5, "unit": "V"},
          {"axis": "input_voltage", "target": "reference_input", "min": 2.5, "max": 3, "unit": "V"},
          {"axis": "input_voltage", "target": "selection_input", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "load_capacitance", "target": "response_output", "min": 0.000000001, "max": 0.0000001, "unit": "F"},
          {"axis": "load_resistance", "target": "response_output", "min": 1000, "max": 100000, "unit": "ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "closed_response_phase_margin", "metric": "phase_margin", "analysis": "stability", "excitation": {"kind": "port", "id": "reference_input"}, "observation": {"kind": "port", "id": "response_output"}, "min": 55, "unit": "deg", "operating_cases": ["active_low_reference", "active_high_reference"], "frequency_hz": 100000, "critical": true},
      {"id": "reference_tracking", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "excitation": {"kind": "port", "id": "reference_input"}, "observation": {"kind": "port", "id": "response_output"}, "min": 0.98, "max": 1.02, "unit": "ratio", "operating_cases": ["active_low_reference", "active_high_reference"], "frequency_hz": 1000},
      {"id": "settled_selection_response", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "selection_input"}, "observation": {"kind": "port", "id": "response_output"}, "max": 0.0002, "unit": "s", "operating_cases": ["active_low_reference", "active_high_reference"]},
      {"id": "bounded_output_swing", "metric": "output_swing", "analysis": "stability", "excitation": {"kind": "port", "id": "reference_input"}, "observation": {"kind": "port", "id": "response_output"}, "min": 0.2, "max": 3.1, "unit": "V", "operating_cases": ["active_low_reference", "active_high_reference"], "critical": true}
    ],
    "constraints": {"max_components": 28, "max_width_mm": 90, "max_height_mm": 70}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
