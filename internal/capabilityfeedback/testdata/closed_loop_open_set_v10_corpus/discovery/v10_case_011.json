{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_excursion_indication",
    "title": "Bounded excursion response study",
    "description": "Study an externally observable state response to normal, excursion, and finite output-load conditions."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": -0.05, "nominal_voltage_v": 0, "max_voltage_v": 0.05},
      {"id": "logic_supply", "kind": "supply", "source": "external", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.1}
    ],
    "ports": [
      {"id": "signal_return", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": -0.05, "nominal_voltage_v": 0, "max_voltage_v": 0.05, "max_current_a": 0.1}},
      {"id": "monitored_input", "kind": "analog_voltage", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1.5, "max_voltage_v": 3.6, "max_current_a": 0.001, "input_impedance_min_ohm": 100000}},
      {"id": "indication_output", "kind": "digital", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 3.6, "max_current_a": 0.02, "default_state": "low"}},
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "logic_supply", "electrical": {"min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.1}}
    ],
    "operating_cases": [
      {
        "id": "normal_window",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "monitored_input", "min": 0.5, "max": 2.5, "unit": "V"},
          {"axis": "ambient_temperature", "target": "signal_reference", "min": -20, "max": 70, "unit": "degC"},
          {"axis": "load_current", "target": "indication_output", "min": 0, "max": 0.004, "unit": "A"}
        ]
      },
      {
        "id": "upper_excursion",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "monitored_input", "min": 3.2, "max": 3.6, "unit": "V"},
          {"axis": "ambient_temperature", "target": "signal_reference", "min": -20, "max": 70, "unit": "degC"},
          {"axis": "load_current", "target": "indication_output", "min": 0, "max": 0.004, "unit": "A"}
        ],
        "events": [
          {"id": "bounded_input_excursion", "kind": "input_step", "target": "monitored_input", "trigger_time_s": 0.001, "initial": 1.5, "applied": 3.4, "unit": "V"}
        ]
      },
      {
        "id": "finite_output_overload",
        "conditions": [
          {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "monitored_input", "min": 3.2, "max": 3.6, "unit": "V"},
          {"axis": "ambient_temperature", "target": "signal_reference", "min": 20, "max": 70, "unit": "degC"}
        ],
        "events": [
          {"id": "bounded_output_short", "kind": "short_circuit", "target": "indication_output", "trigger_time_s": 0.002, "initial": 100000, "applied": 20, "unit": "ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "normal_state_level", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "indication_output"}, "max": 0.35, "unit": "V", "operating_cases": ["normal_window"]},
      {"id": "excursion_state_level", "metric": "output_high_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "indication_output"}, "min": 2.7, "unit": "V", "operating_cases": ["upper_excursion"]},
      {"id": "upper_transition_point", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "indication_output"}, "min": 2.75, "max": 3.1, "unit": "V", "operating_cases": ["normal_window", "upper_excursion"]},
      {"id": "excursion_response_delay", "metric": "propagation_delay", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "monitored_input"}, "observation": {"kind": "port", "id": "indication_output"}, "max": 0.00005, "unit": "s", "operating_cases": ["upper_excursion"]},
      {"id": "overload_peak_current", "metric": "peak_current", "analysis": "transient", "observation": {"kind": "port", "id": "indication_output"}, "max": 0.02, "unit": "A", "operating_cases": ["finite_output_overload"]}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 70, "max_height_mm": 50}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
