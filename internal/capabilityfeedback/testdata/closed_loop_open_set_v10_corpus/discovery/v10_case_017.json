{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_excitation_outputs",
    "title": "Dual Excitation Output Behavior",
    "description": "Evaluate two independently loaded excitation outputs over bounded supply and ambient conditions."
  },
  "requirements": {
    "domains": [
      {
        "id": "signal_return",
        "kind": "reference",
        "source": "external",
        "min_voltage_v": 0,
        "nominal_voltage_v": 0,
        "max_voltage_v": 0
      },
      {
        "id": "input_supply",
        "kind": "supply",
        "source": "external",
        "min_voltage_v": 4.75,
        "nominal_voltage_v": 5,
        "max_voltage_v": 5.25,
        "max_current_a": 0.1
      }
    ],
    "ports": [
      {
        "id": "supply_input",
        "kind": "power",
        "direction": "sink",
        "domain": "input_supply",
        "electrical": {
          "min_voltage_v": 4.75,
          "nominal_voltage_v": 5,
          "max_voltage_v": 5.25,
          "max_current_a": 0.1
        }
      },
      {
        "id": "return_terminal",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "signal_return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0,
          "max_current_a": 0.1
        }
      },
      {
        "id": "voltage_excitation",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "signal_return",
        "electrical": {
          "min_voltage_v": 2.4,
          "nominal_voltage_v": 2.5,
          "max_voltage_v": 2.6,
          "max_current_a": 0.02
        }
      },
      {
        "id": "current_excitation",
        "kind": "analog_current",
        "direction": "source",
        "domain": "signal_return",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1,
          "max_voltage_v": 2,
          "max_current_a": 0.002
        }
      }
    ],
    "operating_cases": [
      {
        "id": "nominal_loading",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 5, "max": 5, "unit": "V"},
          {"axis": "load_current", "target": "voltage_excitation", "min": 0.001, "max": 0.01, "unit": "A"},
          {"axis": "load_resistance", "target": "current_excitation", "min": 200, "max": 1000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": 20, "max": 30, "unit": "degC"}
        ]
      },
      {
        "id": "supply_and_temperature_edges",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "load_current", "target": "voltage_excitation", "min": 0.001, "max": 0.01, "unit": "A"},
          {"axis": "load_resistance", "target": "current_excitation", "min": 200, "max": 1000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": -20, "max": 70, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "a_voltage_excitation_level",
        "metric": "output_voltage",
        "analysis": "dc_operating_point",
        "observation": {"kind": "port", "id": "voltage_excitation"},
        "min": 2.45,
        "max": 2.55,
        "unit": "V",
        "operating_cases": ["nominal_loading", "supply_and_temperature_edges"]
      },
      {
        "id": "b_current_excitation_level",
        "metric": "output_current",
        "analysis": "dc_operating_point",
        "observation": {"kind": "port", "id": "current_excitation"},
        "min": 0.00095,
        "max": 0.00105,
        "unit": "A",
        "operating_cases": ["nominal_loading", "supply_and_temperature_edges"]
      },
      {
        "id": "c_voltage_load_regulation",
        "metric": "load_regulation",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "supply_input"},
        "observation": {"kind": "port", "id": "voltage_excitation"},
        "max": 1.5,
        "unit": "%",
        "operating_cases": ["nominal_loading", "supply_and_temperature_edges"]
      },
      {
        "id": "d_current_load_regulation",
        "metric": "output_current",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "supply_input"},
        "observation": {"kind": "port", "id": "current_excitation"},
        "min": 0.00094,
        "max": 0.00106,
        "unit": "A",
        "operating_cases": ["nominal_loading", "supply_and_temperature_edges"]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 45,
      "max_height_mm": 35
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
