{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_startup_status",
    "title": "Bounded Startup Status",
    "description": "Produce a valid external status after bounded supply application while limiting startup delay, overshoot, and supply draw."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "monitored_supply", "kind": "supply", "source": "external", "min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 0.1},
      {"id": "status_supply", "kind": "supply", "source": "external", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.05}
    ],
    "ports": [
      {"id": "return_ref", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "monitored_power_in", "kind": "power", "direction": "sink", "domain": "monitored_supply", "electrical": {"min_voltage_v": 9, "nominal_voltage_v": 12, "max_voltage_v": 15, "max_current_a": 0.1}},
      {"id": "status_power_in", "kind": "power", "direction": "sink", "domain": "status_supply", "electrical": {"min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.05}},
      {"id": "sense_in", "kind": "analog_voltage", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 12, "max_voltage_v": 15, "input_impedance_min_ohm": 100000}},
      {"id": "status_out", "kind": "digital", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.01, "default_state": "low"}}
    ],
    "operating_cases": [
      {
        "id": "nominal_start",
        "conditions": [
          {"axis": "supply_voltage", "target": "status_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "sense_in", "min": 11.5, "max": 15, "unit": "V"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": -20, "max": 70, "unit": "degC"}
        ],
        "events": [
          {"id": "apply_monitored_rail", "kind": "startup", "target": "monitored_power_in", "trigger_time_s": 0, "initial": 0, "applied": 12, "unit": "V"}
        ]
      },
      {
        "id": "low_rail_start",
        "conditions": [
          {"axis": "supply_voltage", "target": "status_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "sense_in", "min": 9, "max": 10, "unit": "V"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": -20, "max": 70, "unit": "degC"}
        ],
        "events": [
          {"id": "apply_low_monitored_rail", "kind": "startup", "target": "monitored_power_in", "trigger_time_s": 0, "initial": 0, "applied": 9, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "valid_status_level", "metric": "startup_output_voltage", "analysis": "startup", "excitation": {"kind": "port", "id": "monitored_power_in"}, "observation": {"kind": "port", "id": "status_out"}, "min": 2.4, "max": 3.6, "unit": "V", "operating_cases": ["nominal_start"]},
      {"id": "low_rail_status_level", "metric": "startup_output_voltage", "analysis": "startup", "excitation": {"kind": "port", "id": "monitored_power_in"}, "observation": {"kind": "port", "id": "status_out"}, "min": 0, "max": 0.4, "unit": "V", "operating_cases": ["low_rail_start"], "critical": true},
      {"id": "status_startup_delay", "metric": "settling_time", "analysis": "startup", "excitation": {"kind": "port", "id": "monitored_power_in"}, "observation": {"kind": "port", "id": "status_out"}, "max": 0.02, "unit": "s", "operating_cases": ["nominal_start", "low_rail_start"]},
      {"id": "status_overshoot", "metric": "startup_overshoot", "analysis": "startup", "excitation": {"kind": "port", "id": "monitored_power_in"}, "observation": {"kind": "port", "id": "status_out"}, "max": 0.25, "unit": "V", "operating_cases": ["nominal_start", "low_rail_start"]},
      {"id": "startup_supply_draw", "metric": "startup_current", "analysis": "startup", "excitation": {"kind": "port", "id": "monitored_power_in"}, "observation": {"kind": "port", "id": "status_power_in"}, "max": 0.04, "unit": "A", "operating_cases": ["nominal_start", "low_rail_start"]}
    ],
    "constraints": {"max_components": 20, "max_width_mm": 40, "max_height_mm": 30}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
