{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "coordinated_reference_outputs",
    "title": "Coordinated Reference Outputs",
    "description": "Study two independently observed outputs over bounded supply, loading, and ambient conditions."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "input_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.05}
    ],
    "ports": [
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "input_supply", "electrical": {"min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.05}},
      {"id": "supply_return", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "voltage_output", "kind": "analog_voltage", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": 2.4, "nominal_voltage_v": 2.5, "max_voltage_v": 2.6, "max_current_a": 0.01}},
      {"id": "current_output", "kind": "analog_current", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": 0.2, "nominal_voltage_v": 1.5, "max_voltage_v": 3, "max_current_a": 0.0011}}
    ],
    "operating_cases": [
      {
        "id": "nominal_loads",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 4.9, "max": 5.1, "unit": "V"},
          {"axis": "load_current", "target": "voltage_output", "min": 0, "max": 0.005, "unit": "A"},
          {"axis": "load_resistance", "target": "current_output", "min": 500, "max": 2000, "unit": "ohm"}
        ]
      },
      {
        "id": "supply_temperature_corners",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 4.5, "max": 5.5, "unit": "V"},
          {"axis": "ambient_temperature", "target": "input_supply", "min": -20, "max": 70, "unit": "degC"},
          {"axis": "load_current", "target": "voltage_output", "min": 0, "max": 0.005, "unit": "A"},
          {"axis": "load_resistance", "target": "current_output", "min": 500, "max": 2000, "unit": "ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "voltage_output_accuracy", "metric": "dc_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "voltage_output"}, "min": 2.45, "max": 2.55, "unit": "V", "operating_cases": ["nominal_loads"]},
      {"id": "voltage_output_corner_bound", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "voltage_output"}, "min": 2.4, "max": 2.6, "unit": "V", "operating_cases": ["supply_temperature_corners"]},
      {"id": "current_output_accuracy", "metric": "dc_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "current_output"}, "min": 0.00095, "max": 0.00105, "unit": "A", "operating_cases": ["nominal_loads"]},
      {"id": "current_output_corner_bound", "metric": "output_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "current_output"}, "min": 0.0009, "max": 0.0011, "unit": "A", "operating_cases": ["supply_temperature_corners"]},
      {"id": "input_current_limit", "metric": "quiescent_current", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "supply_input"}, "max": 0.02, "unit": "A", "operating_cases": ["nominal_loads", "supply_temperature_corners"]}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 45, "max_height_mm": 35}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
