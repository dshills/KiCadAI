{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_signal_transfer",
    "title": "Bounded Signal Transfer",
    "description": "Study a single externally observed signal response across a bounded frequency range and finite output load."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "energy_input", "kind": "supply", "source": "external", "min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 0.25}
    ],
    "ports": [
      {"id": "power_input", "kind": "power", "direction": "sink", "domain": "energy_input", "electrical": {"min_voltage_v": 10, "nominal_voltage_v": 12, "max_voltage_v": 14, "max_current_a": 0.25}},
      {"id": "common_return", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": -0.1, "nominal_voltage_v": 0, "max_voltage_v": 0.1, "max_current_a": 0.0001, "input_impedance_min_ohm": 100000}},
      {"id": "signal_output", "kind": "analog_voltage", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": -4, "nominal_voltage_v": 0, "max_voltage_v": 4, "max_current_a": 0.02}}
    ],
    "operating_cases": [
      {
        "id": "nominal_frequency_response",
        "conditions": [
          {"axis": "supply_voltage", "target": "energy_input", "min": 11.8, "max": 12.2, "unit": "V"},
          {"axis": "input_voltage", "target": "signal_input", "min": -0.05, "max": 0.05, "unit": "V"},
          {"axis": "load_resistance", "target": "signal_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "load_capacitance", "target": "signal_output", "min": 0, "max": 0.0000000001, "unit": "F"}
        ]
      },
      {
        "id": "supply_model_corners",
        "conditions": [
          {"axis": "supply_voltage", "target": "energy_input", "min": 10, "max": 14, "unit": "V"},
          {"axis": "model_corner", "target": "signal_output", "min": -1, "max": 1, "unit": "ratio"},
          {"axis": "tolerance_corner", "target": "signal_input", "min": -1, "max": 1, "unit": "ratio"},
          {"axis": "load_resistance", "target": "signal_output", "min": 10000, "max": 100000, "unit": "ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "midband_transfer", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "observation": {"kind": "port", "id": "signal_output"}, "min": 9.5, "max": 10.5, "unit": "ratio", "operating_cases": ["nominal_frequency_response"], "frequency_hz": 1000},
      {"id": "corner_transfer", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "observation": {"kind": "port", "id": "signal_output"}, "min": 8.5, "max": 11.5, "unit": "ratio", "operating_cases": ["supply_model_corners"], "frequency_hz": 1000},
      {"id": "transfer_bandwidth", "metric": "bandwidth", "analysis": "ac_sweep", "observation": {"kind": "port", "id": "signal_output"}, "min": 100000, "max": 2000000, "unit": "Hz", "operating_cases": ["nominal_frequency_response", "supply_model_corners"]},
      {"id": "output_excursion", "metric": "output_swing", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "signal_output"}, "min": 6, "max": 8, "unit": "V_pp", "operating_cases": ["nominal_frequency_response"]},
      {"id": "integrated_output_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "signal_output"}, "max": 0.0005, "unit": "V_rms", "operating_cases": ["nominal_frequency_response"]}
    ],
    "constraints": {"max_components": 24, "max_width_mm": 60, "max_height_mm": 45}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
