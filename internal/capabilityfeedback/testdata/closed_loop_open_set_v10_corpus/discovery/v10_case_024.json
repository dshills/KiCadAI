{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_energization_response",
    "title": "Bounded Energization Response",
    "description": "Study a bounded output during external energization and steady loading across the declared supply range."
  },
  "requirements": {
    "domains": [
      {"id": "power_return", "kind": "reference", "source": "external", "nominal_voltage_v": 0},
      {"id": "input_supply", "kind": "supply", "source": "external", "min_voltage_v": 6, "nominal_voltage_v": 12, "max_voltage_v": 18, "max_current_a": 3}
    ],
    "ports": [
      {"id": "power_in", "kind": "power", "direction": "sink", "domain": "input_supply", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 12, "max_voltage_v": 18, "max_current_a": 3}},
      {"id": "regulated_out", "kind": "analog_voltage", "direction": "source", "domain": "power_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 1}}
    ],
    "operating_cases": [
      {"id": "nominal_energization", "conditions": [
        {"axis": "supply_voltage", "target": "input_supply", "min": 9, "max": 18, "unit": "V"},
        {"axis": "load_current", "target": "regulated_out", "min": 0.05, "max": 0.6, "unit": "A"},
        {"axis": "ambient_temperature", "target": "power_return", "min": -20, "max": 70, "unit": "degC"}
      ], "events": [
        {"id": "nominal_start", "kind": "startup", "target": "power_in", "trigger_time_s": 0, "initial": 0, "applied": 12, "unit": "V"}
      ]},
      {"id": "low_rail_loaded_start", "conditions": [
        {"axis": "supply_voltage", "target": "input_supply", "min": 6, "max": 9, "unit": "V"},
        {"axis": "load_current", "target": "regulated_out", "min": 0.6, "max": 0.8, "unit": "A"},
        {"axis": "ambient_temperature", "target": "power_return", "min": -20, "max": 70, "unit": "degC"}
      ], "events": [
        {"id": "loaded_start", "kind": "startup", "target": "power_in", "trigger_time_s": 0, "initial": 0, "applied": 6, "unit": "V"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "startup_output_band", "metric": "startup_output_voltage", "analysis": "startup", "excitation": {"kind": "port", "id": "power_in"}, "observation": {"kind": "port", "id": "regulated_out"}, "min": 4.75, "max": 5.25, "unit": "V", "operating_cases": ["nominal_energization", "low_rail_loaded_start"]},
      {"id": "startup_overshoot_bound", "metric": "startup_overshoot", "analysis": "startup", "excitation": {"kind": "port", "id": "power_in"}, "observation": {"kind": "port", "id": "regulated_out"}, "max": 0.25, "unit": "V", "operating_cases": ["nominal_energization", "low_rail_loaded_start"]},
      {"id": "startup_settling_bound", "metric": "settling_time", "analysis": "startup", "excitation": {"kind": "port", "id": "power_in"}, "observation": {"kind": "port", "id": "regulated_out"}, "max": 0.02, "unit": "s", "operating_cases": ["nominal_energization", "low_rail_loaded_start"]},
      {"id": "steady_output_band", "metric": "output_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "regulated_out"}, "min": 4.75, "max": 5.25, "unit": "V", "operating_cases": ["nominal_energization", "low_rail_loaded_start"]}
    ],
    "constraints": {"max_components": 28, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
