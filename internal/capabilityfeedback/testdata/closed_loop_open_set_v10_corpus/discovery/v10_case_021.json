{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_window_indications",
    "title": "Bounded Window Indications",
    "description": "Study two independently observable indication outputs over a bounded input range and external supply range."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external", "nominal_voltage_v": 0},
      {"id": "logic_supply", "kind": "supply", "source": "external", "min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 5.5, "max_current_a": 0.05}
    ],
    "ports": [
      {"id": "supply_in", "kind": "power", "direction": "sink", "domain": "logic_supply", "electrical": {"min_voltage_v": 3, "nominal_voltage_v": 3.3, "max_voltage_v": 5.5, "max_current_a": 0.05}},
      {"id": "monitor_in", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5.5, "input_impedance_min_ohm": 100000}},
      {"id": "low_indication", "kind": "digital", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5.5, "max_current_a": 0.005, "default_state": "low"}},
      {"id": "high_indication", "kind": "digital", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "max_voltage_v": 5.5, "max_current_a": 0.005, "default_state": "low"}}
    ],
    "operating_cases": [
      {"id": "complete_input_sweep", "conditions": [
        {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 5.5, "unit": "V"},
        {"axis": "input_voltage", "target": "monitor_in", "min": 0, "max": 5.5, "unit": "V"},
        {"axis": "ambient_temperature", "target": "signal_return", "min": -20, "max": 70, "unit": "degC"}
      ]},
      {"id": "interior_window", "conditions": [
        {"axis": "supply_voltage", "target": "logic_supply", "min": 3, "max": 5.5, "unit": "V"},
        {"axis": "input_voltage", "target": "monitor_in", "min": 2.1, "max": 2.9, "unit": "V"},
        {"axis": "ambient_temperature", "target": "signal_return", "min": -20, "max": 70, "unit": "degC"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "low_boundary", "metric": "falling_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitor_in"}, "observation": {"kind": "port", "id": "low_indication"}, "min": 1.1, "max": 1.3, "unit": "V", "operating_cases": ["complete_input_sweep"], "critical": true},
      {"id": "high_boundary", "metric": "rising_threshold", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "monitor_in"}, "observation": {"kind": "port", "id": "high_indication"}, "min": 3.9, "max": 4.2, "unit": "V", "operating_cases": ["complete_input_sweep"], "critical": true},
      {"id": "low_output_inactive_level", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "low_indication"}, "max": 0.4, "unit": "V", "operating_cases": ["interior_window"]},
      {"id": "high_output_inactive_level", "metric": "output_low_voltage", "analysis": "dc_operating_point", "observation": {"kind": "port", "id": "high_indication"}, "max": 0.4, "unit": "V", "operating_cases": ["interior_window"]}
    ],
    "constraints": {"max_components": 16, "max_width_mm": 50, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
