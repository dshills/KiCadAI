{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "temperature_bounded_signal_delivery",
    "title": "Temperature-Bounded Signal Delivery",
    "description": "Deliver a bounded output response from an external input while maintaining electrical and temperature margins during normal loading and a finite output fault."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "positive_supply", "kind": "supply", "source": "external", "min_voltage_v": 12, "nominal_voltage_v": 15, "max_voltage_v": 18, "max_current_a": 1},
      {"id": "negative_supply", "kind": "supply", "source": "external", "min_voltage_v": -18, "nominal_voltage_v": -15, "max_voltage_v": -12, "max_current_a": 1}
    ],
    "ports": [
      {"id": "return_ref", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "positive_power_in", "kind": "power", "direction": "sink", "domain": "positive_supply", "electrical": {"min_voltage_v": 12, "nominal_voltage_v": 15, "max_voltage_v": 18, "max_current_a": 1}},
      {"id": "negative_power_in", "kind": "power", "direction": "sink", "domain": "negative_supply", "electrical": {"min_voltage_v": -18, "nominal_voltage_v": -15, "max_voltage_v": -12, "max_current_a": 1}},
      {"id": "signal_in", "kind": "analog_voltage", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": -0.6, "nominal_voltage_v": 0, "max_voltage_v": 0.6, "input_impedance_min_ohm": 100000}},
      {"id": "signal_out", "kind": "analog_voltage", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": -8, "nominal_voltage_v": 0, "max_voltage_v": 8, "max_current_a": 0.5}}
    ],
    "operating_cases": [
      {
        "id": "normal_load",
        "conditions": [
          {"axis": "supply_voltage", "target": "positive_supply", "min": 12, "max": 18, "unit": "V"},
          {"axis": "supply_voltage", "target": "negative_supply", "min": -18, "max": -12, "unit": "V"},
          {"axis": "input_voltage", "target": "signal_in", "min": -0.5, "max": 0.5, "unit": "V"},
          {"axis": "load_resistance", "target": "signal_out", "min": 100, "max": 2000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": -20, "max": 70, "unit": "degC"}
        ]
      },
      {
        "id": "bounded_output_fault",
        "conditions": [
          {"axis": "supply_voltage", "target": "positive_supply", "min": 12, "max": 18, "unit": "V"},
          {"axis": "supply_voltage", "target": "negative_supply", "min": -18, "max": -12, "unit": "V"},
          {"axis": "input_voltage", "target": "signal_in", "min": -0.2, "max": 0.2, "unit": "V"},
          {"axis": "load_resistance", "target": "signal_out", "min": 100, "max": 100, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": 25, "max": 70, "unit": "degC"}
        ],
        "events": [
          {"id": "finite_resistance_fault", "kind": "short_circuit", "target": "signal_out", "trigger_time_s": 0.01, "initial": 100, "applied": 1, "unit": "ohm"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "loaded_voltage_gain", "metric": "voltage_gain", "analysis": "electrothermal", "excitation": {"kind": "port", "id": "signal_in"}, "observation": {"kind": "port", "id": "signal_out"}, "min": 9.5, "max": 10.5, "unit": "ratio", "operating_cases": ["normal_load"]},
      {"id": "thermal_ceiling", "metric": "junction_temperature", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "temperature_margin"}, "max": 125, "unit": "degC", "operating_cases": ["normal_load", "bounded_output_fault"], "critical": true},
      {"id": "normal_operating_margin", "metric": "soa_margin", "analysis": "electrothermal", "observation": {"kind": "circuit", "id": "electrical_margin"}, "min": 1.5, "unit": "ratio", "operating_cases": ["normal_load", "bounded_output_fault"], "critical": true},
      {"id": "normal_output_excursion", "metric": "output_swing", "analysis": "electrothermal", "excitation": {"kind": "port", "id": "signal_in"}, "observation": {"kind": "port", "id": "signal_out"}, "min": 9, "max": 12, "unit": "V_pp", "operating_cases": ["normal_load"]},
      {"id": "fault_peak_limit", "metric": "peak_current", "analysis": "electrothermal", "excitation": {"kind": "port", "id": "signal_out"}, "observation": {"kind": "port", "id": "signal_out"}, "max": 0.5, "unit": "A", "operating_cases": ["bounded_output_fault"], "critical": true}
    ],
    "constraints": {"max_components": 32, "max_width_mm": 65, "max_height_mm": 45}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
