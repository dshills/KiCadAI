{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "low_noise_signal_transfer",
    "title": "Low-Noise Signal Transfer Behavior",
    "description": "Evaluate bounded signal transfer and output noise across supply, source, and ambient operating conditions."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "input_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.08}
    ],
    "ports": [
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "input_supply", "electrical": {"min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.08}},
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "max_current_a": 0.08}},
      {"id": "signal_input", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0.1, "nominal_voltage_v": 1, "max_voltage_v": 2, "max_current_a": 0.001, "input_impedance_min_ohm": 100000}},
      {"id": "conditioned_output", "kind": "analog_voltage", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0.1, "nominal_voltage_v": 1, "max_voltage_v": 2, "max_current_a": 0.01}}
    ],
    "operating_cases": [
      {
        "id": "nominal_transfer",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 5, "max": 5, "unit": "V"},
          {"axis": "input_voltage", "target": "signal_input", "min": 0.2, "max": 1.8, "unit": "V"},
          {"axis": "load_resistance", "target": "conditioned_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": 20, "max": 30, "unit": "degC"}
        ]
      },
      {
        "id": "supply_and_source_edges",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 4.5, "max": 5.5, "unit": "V"},
          {"axis": "input_voltage", "target": "signal_input", "min": 0.1, "max": 2, "unit": "V"},
          {"axis": "load_resistance", "target": "conditioned_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": -10, "max": 65, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "a_output_noise",
        "metric": "output_noise_rms",
        "analysis": "noise",
        "excitation": {"kind": "port", "id": "signal_input"},
        "observation": {"kind": "port", "id": "conditioned_output"},
        "max": 0.002,
        "unit": "V_rms",
        "operating_cases": ["nominal_transfer", "supply_and_source_edges"],
        "frequency_hz": 20000
      },
      {
        "id": "b_transfer_gain",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "signal_input"},
        "observation": {"kind": "port", "id": "conditioned_output"},
        "min": 0.98,
        "max": 1.02,
        "unit": "ratio",
        "operating_cases": ["nominal_transfer", "supply_and_source_edges"]
      },
      {
        "id": "c_signal_bandwidth",
        "metric": "bandwidth",
        "analysis": "ac_sweep",
        "excitation": {"kind": "port", "id": "signal_input"},
        "observation": {"kind": "port", "id": "conditioned_output"},
        "min": 20000,
        "unit": "Hz",
        "operating_cases": ["nominal_transfer", "supply_and_source_edges"]
      },
      {
        "id": "d_output_swing",
        "metric": "output_swing",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "signal_input"},
        "observation": {"kind": "port", "id": "conditioned_output"},
        "min": 1.7,
        "unit": "V_pp",
        "operating_cases": ["nominal_transfer", "supply_and_source_edges"]
      }
    ],
    "constraints": {"max_components": 28, "max_width_mm": 50, "max_height_mm": 35}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
