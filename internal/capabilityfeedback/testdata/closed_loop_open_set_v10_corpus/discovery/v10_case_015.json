{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_threshold_transfer",
    "title": "Bounded Threshold Transfer",
    "description": "Study of externally observable threshold and output-state behavior during bounded input and supply conditions."
  },
  "requirements": {
    "domains": [
      {"id":"logic_ref","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.05},
      {"id":"logic_supply","kind":"supply","source":"external","min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.05}
    ],
    "ports": [
      {"id":"control_in","kind":"digital","direction":"sink","domain":"logic_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.001,"input_impedance_min_ohm":100000,"default_state":"low"}},
      {"id":"control_out","kind":"digital","direction":"source","domain":"logic_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":3.6,"max_current_a":0.01,"default_state":"low"}},
      {"id":"supply_in","kind":"power","direction":"sink","domain":"logic_supply","electrical":{"min_voltage_v":2.7,"nominal_voltage_v":3.3,"max_voltage_v":3.6,"max_current_a":0.05}},
      {"id":"logic_return","kind":"reference","direction":"bidirectional","domain":"logic_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.05}}
    ],
    "operating_cases": [
      {
        "id": "normal_sweep",
        "conditions": [
          {"axis":"ambient_temperature","target":"logic_ref","min":-20,"max":70,"unit":"degC"},
          {"axis":"input_voltage","target":"control_in","min":0,"max":3.6,"unit":"V"},
          {"axis":"load_capacitance","target":"control_out","min":0,"max":0.000000001,"unit":"F"},
          {"axis":"supply_voltage","target":"logic_supply","min":3,"max":3.6,"unit":"V"}
        ]
      },
      {
        "id": "bounded_rail_loss",
        "conditions": [
          {"axis":"ambient_temperature","target":"logic_ref","min":25,"max":85,"unit":"degC"},
          {"axis":"input_voltage","target":"control_in","min":2.4,"max":3.6,"unit":"V"},
          {"axis":"load_capacitance","target":"control_out","min":0,"max":0.000000001,"unit":"F"},
          {"axis":"supply_voltage","target":"logic_supply","min":2.7,"max":3.6,"unit":"V"}
        ],
        "events": [
          {"id":"remove_supply","kind":"rail_loss","target":"supply_in","trigger_time_s":0.01,"initial":3.3,"applied":0,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"rising_trip_level","metric":"rising_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"control_in"},"observation":{"kind":"port","id":"control_out"},"min":1.5,"max":2.2,"unit":"V","operating_cases":["normal_sweep"]},
      {"id":"falling_trip_level","metric":"falling_threshold","analysis":"dc_sweep","excitation":{"kind":"port","id":"control_in"},"observation":{"kind":"port","id":"control_out"},"min":0.7,"max":1.4,"unit":"V","operating_cases":["normal_sweep"]},
      {"id":"threshold_separation","metric":"hysteresis","analysis":"dc_sweep","excitation":{"kind":"port","id":"control_in"},"observation":{"kind":"port","id":"control_out"},"min":0.1,"max":1,"unit":"V","operating_cases":["normal_sweep"]},
      {"id":"asserted_level","metric":"output_high_voltage","analysis":"dc_sweep","observation":{"kind":"port","id":"control_out"},"min":2.4,"max":3.6,"unit":"V","operating_cases":["normal_sweep"]},
      {"id":"deasserted_level","metric":"output_low_voltage","analysis":"dc_operating_point","observation":{"kind":"port","id":"control_out"},"min":0,"max":0.4,"unit":"V","operating_cases":["normal_sweep"]},
      {"id":"rail_loss_deassertion","metric":"fall_time","analysis":"transient","excitation":{"kind":"port","id":"supply_in"},"observation":{"kind":"port","id":"control_out"},"max":0.00001,"unit":"s","operating_cases":["bounded_rail_loss"],"critical":true},
      {"id":"unpowered_output_current","metric":"off_state_current","analysis":"transient","observation":{"kind":"port","id":"control_out"},"max":0.0001,"unit":"A","operating_cases":["bounded_rail_loss"],"critical":true}
    ],
    "constraints": {"max_components":16,"max_width_mm":45,"max_height_mm":35}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
