{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "low_distortion_driven_output",
    "title": "Low-Distortion Driven Output",
    "description": "Produce a commanded alternating output into a bounded external load with specified waveform quality, delivered power, gain, and efficiency."
  },
  "requirements": {
    "domains": [
      {"id": "signal_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "energy_supply", "kind": "supply", "source": "external", "min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 30, "max_current_a": 3}
    ],
    "ports": [
      {"id": "return_ref", "kind": "reference", "direction": "bidirectional", "domain": "signal_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "energy_in", "kind": "power", "direction": "sink", "domain": "energy_supply", "electrical": {"min_voltage_v": 18, "nominal_voltage_v": 24, "max_voltage_v": 30, "max_current_a": 3}},
      {"id": "command_in", "kind": "analog_voltage", "direction": "sink", "domain": "signal_reference", "electrical": {"min_voltage_v": -2, "nominal_voltage_v": 0, "max_voltage_v": 2, "input_impedance_min_ohm": 20000}},
      {"id": "delivered_out", "kind": "analog_voltage", "direction": "source", "domain": "signal_reference", "electrical": {"min_voltage_v": -14, "nominal_voltage_v": 0, "max_voltage_v": 14, "max_current_a": 2}}
    ],
    "operating_cases": [
      {
        "id": "nominal_delivery",
        "conditions": [
          {"axis": "supply_voltage", "target": "energy_supply", "min": 22, "max": 26, "unit": "V"},
          {"axis": "input_voltage", "target": "command_in", "min": -1, "max": 1, "unit": "V"},
          {"axis": "load_resistance", "target": "delivered_out", "min": 8, "max": 16, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": 0, "max": 50, "unit": "degC"}
        ]
      },
      {
        "id": "wide_delivery",
        "conditions": [
          {"axis": "supply_voltage", "target": "energy_supply", "min": 18, "max": 30, "unit": "V"},
          {"axis": "input_voltage", "target": "command_in", "min": -1.5, "max": 1.5, "unit": "V"},
          {"axis": "load_resistance", "target": "delivered_out", "min": 6, "max": 20, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": -10, "max": 60, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "waveform_distortion", "metric": "total_harmonic_distortion", "analysis": "distortion", "excitation": {"kind": "port", "id": "command_in"}, "observation": {"kind": "port", "id": "delivered_out"}, "max": 1, "unit": "%", "operating_cases": ["nominal_delivery", "wide_delivery"], "frequency_hz": 1000},
      {"id": "delivered_gain", "metric": "voltage_gain_at_frequency", "analysis": "distortion", "excitation": {"kind": "port", "id": "command_in"}, "observation": {"kind": "port", "id": "delivered_out"}, "min": 7.5, "max": 8.5, "unit": "ratio", "operating_cases": ["nominal_delivery", "wide_delivery"], "frequency_hz": 1000},
      {"id": "delivered_power", "metric": "output_power", "analysis": "distortion", "excitation": {"kind": "port", "id": "command_in"}, "observation": {"kind": "port", "id": "delivered_out"}, "min": 4, "max": 24, "unit": "W", "operating_cases": ["nominal_delivery", "wide_delivery"], "frequency_hz": 1000},
      {"id": "energy_efficiency", "metric": "conversion_efficiency", "analysis": "dc_operating_point", "excitation": {"kind": "port", "id": "energy_in"}, "observation": {"kind": "port", "id": "delivered_out"}, "min": 55, "max": 95, "unit": "%", "operating_cases": ["nominal_delivery", "wide_delivery"]}
    ],
    "constraints": {"max_components": 36, "max_width_mm": 75, "max_height_mm": 55}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
