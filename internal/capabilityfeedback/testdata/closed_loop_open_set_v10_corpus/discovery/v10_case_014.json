{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "bounded_waveform_measurement",
    "title": "Bounded Waveform Measurement",
    "description": "Study of an externally observed measurement response to a bounded periodic excitation across defined loading and environmental conditions."
  },
  "requirements": {
    "domains": [
      {"id":"signal_ref","kind":"reference","source":"external","min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.1},
      {"id":"energy_supply","kind":"supply","source":"external","min_voltage_v":18,"nominal_voltage_v":24,"max_voltage_v":30,"max_current_a":0.1}
    ],
    "ports": [
      {"id":"sensed_current","kind":"analog_current","direction":"sink","domain":"signal_ref","electrical":{"min_voltage_v":-0.2,"nominal_voltage_v":0,"max_voltage_v":0.2,"max_current_a":10}},
      {"id":"measurement_out","kind":"analog_voltage","direction":"source","domain":"signal_ref","electrical":{"min_voltage_v":-2,"nominal_voltage_v":0,"max_voltage_v":2,"max_current_a":0.005}},
      {"id":"supply_in","kind":"power","direction":"sink","domain":"energy_supply","electrical":{"min_voltage_v":18,"nominal_voltage_v":24,"max_voltage_v":30,"max_current_a":0.1}},
      {"id":"signal_return","kind":"reference","direction":"bidirectional","domain":"signal_ref","electrical":{"min_voltage_v":0,"nominal_voltage_v":0,"max_voltage_v":0,"max_current_a":0.1}}
    ],
    "operating_cases": [
      {
        "id": "moderate_level",
        "conditions": [
          {"axis":"ambient_temperature","target":"signal_ref","min":0,"max":50,"unit":"degC"},
          {"axis":"input_current","target":"sensed_current","min":0.2,"max":5,"unit":"A"},
          {"axis":"load_resistance","target":"measurement_out","min":10000,"max":1000000,"unit":"ohm"},
          {"axis":"supply_voltage","target":"energy_supply","min":18,"max":30,"unit":"V"}
        ]
      },
      {
        "id": "high_level_hot",
        "conditions": [
          {"axis":"ambient_temperature","target":"signal_ref","min":50,"max":85,"unit":"degC"},
          {"axis":"input_current","target":"sensed_current","min":5,"max":10,"unit":"A"},
          {"axis":"load_resistance","target":"measurement_out","min":10000,"max":100000,"unit":"ohm"},
          {"axis":"supply_voltage","target":"energy_supply","min":18,"max":30,"unit":"V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id":"waveform_distortion","metric":"total_harmonic_distortion","analysis":"distortion","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_out"},"max":0.5,"unit":"%","operating_cases":["moderate_level","high_level_hot"],"frequency_hz":1000},
      {"id":"measurement_ratio","metric":"transimpedance","analysis":"distortion","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_out"},"min":0.095,"max":0.105,"unit":"V/A","operating_cases":["moderate_level","high_level_hot"],"frequency_hz":1000},
      {"id":"measurement_bandwidth","metric":"bandwidth","analysis":"distortion","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_out"},"min":20000,"unit":"Hz","operating_cases":["moderate_level"]},
      {"id":"measurement_noise","metric":"output_noise_rms","analysis":"noise","observation":{"kind":"port","id":"measurement_out"},"max":0.01,"unit":"V_rms","operating_cases":["moderate_level","high_level_hot"]},
      {"id":"measurement_swing","metric":"output_swing","analysis":"dc_sweep","excitation":{"kind":"port","id":"sensed_current"},"observation":{"kind":"port","id":"measurement_out"},"min":1.8,"unit":"V_pp","operating_cases":["high_level_hot"]},
      {"id":"thermal_limit","metric":"junction_temperature","analysis":"electrothermal","observation":{"kind":"circuit","id":"thermal_state"},"max":125,"unit":"degC","operating_cases":["moderate_level","high_level_hot"]}
    ],
    "constraints": {"max_components":20,"max_width_mm":65,"max_height_mm":45}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
