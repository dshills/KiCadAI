{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "dual_reporting_response",
    "title": "Dual Reporting Response",
    "description": "Provide two independently observable responses to a bounded external measurement input across supply and ambient corners."
  },
  "requirements": {
    "domains": [
      {
        "id": "signal_reference",
        "kind": "reference",
        "source": "external",
        "min_voltage_v": 0,
        "nominal_voltage_v": 0,
        "max_voltage_v": 0
      },
      {
        "id": "measurement_supply",
        "kind": "supply",
        "source": "external",
        "min_voltage_v": 3,
        "nominal_voltage_v": 3.3,
        "max_voltage_v": 3.6,
        "max_current_a": 0.1
      }
    ],
    "ports": [
      {
        "id": "return_ref",
        "kind": "reference",
        "direction": "bidirectional",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 0,
          "max_voltage_v": 0
        }
      },
      {
        "id": "supply_in",
        "kind": "power",
        "direction": "sink",
        "domain": "measurement_supply",
        "electrical": {
          "min_voltage_v": 3,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.1
        }
      },
      {
        "id": "measured_in",
        "kind": "analog_voltage",
        "direction": "sink",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": -0.2,
          "nominal_voltage_v": 1.25,
          "max_voltage_v": 2.8,
          "input_impedance_min_ohm": 1000000
        }
      },
      {
        "id": "level_out",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 1.25,
          "max_voltage_v": 2.8,
          "max_current_a": 0.01
        }
      },
      {
        "id": "window_out",
        "kind": "analog_voltage",
        "direction": "source",
        "domain": "signal_reference",
        "electrical": {
          "min_voltage_v": 0,
          "nominal_voltage_v": 3.3,
          "max_voltage_v": 3.6,
          "max_current_a": 0.01
        }
      }
    ],
    "operating_cases": [
      {
        "id": "nominal_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "measured_in", "min": 0, "max": 2.5, "unit": "V"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": 0, "max": 50, "unit": "degC"}
        ]
      },
      {
        "id": "edge_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "input_voltage", "target": "measured_in", "min": -0.1, "max": 2.7, "unit": "V"},
          {"axis": "ambient_temperature", "target": "return_ref", "min": -20, "max": 70, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "level_tracking",
        "metric": "voltage_gain",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_in"
        },
        "observation": {"kind": "port", "id": "level_out"},
        "min": 0.95,
        "max": 1.05,
        "unit": "ratio",
        "operating_cases": ["nominal_range", "edge_range"]
      },
      {
        "id": "measurement_loading",
        "metric": "input_impedance",
        "analysis": "dc_operating_point",
        "excitation": {
          "kind": "port",
          "id": "measured_in"
        },
        "observation": {"kind": "port", "id": "measured_in"},
        "min": 1000000,
        "unit": "ohm",
        "operating_cases": ["nominal_range", "edge_range"]
      },
      {
        "id": "window_lower_boundary",
        "metric": "lower_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_in"
        },
        "observation": {"kind": "port", "id": "window_out"},
        "min": 0.7,
        "max": 0.9,
        "unit": "V",
        "operating_cases": ["nominal_range", "edge_range"]
      },
      {
        "id": "window_upper_boundary",
        "metric": "upper_threshold",
        "analysis": "dc_sweep",
        "excitation": {
          "kind": "port",
          "id": "measured_in"
        },
        "observation": {"kind": "port", "id": "window_out"},
        "min": 1.9,
        "max": 2.1,
        "unit": "V",
        "operating_cases": ["nominal_range", "edge_range"]
      }
    ],
    "constraints": {
      "max_components": 24,
      "max_width_mm": 45,
      "max_height_mm": 35
    }
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
