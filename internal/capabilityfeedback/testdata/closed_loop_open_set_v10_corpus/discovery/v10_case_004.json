{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "gated_measurement_response",
    "title": "Gated Measurement Response",
    "description": "Study a single bounded measurement output while an external gate changes state under finite source and load conditions."
  },
  "requirements": {
    "domains": [
      {"id": "measurement_reference", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "measurement_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1}
    ],
    "ports": [
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "measurement_supply", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1}},
      {"id": "measurement_return", "kind": "reference", "direction": "bidirectional", "domain": "measurement_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0}},
      {"id": "measured_input", "kind": "analog_voltage", "direction": "sink", "domain": "measurement_reference", "electrical": {"min_voltage_v": 0.1, "nominal_voltage_v": 1, "max_voltage_v": 2, "max_current_a": 0.0001, "input_impedance_min_ohm": 100000}},
      {"id": "gate_input", "kind": "digital", "direction": "sink", "domain": "measurement_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 3.3, "max_voltage_v": 3.6, "max_current_a": 0.001, "input_impedance_min_ohm": 100000, "default_state": "low"}},
      {"id": "measurement_output", "kind": "analog_voltage", "direction": "source", "domain": "measurement_reference", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 2.5, "max_voltage_v": 4.5, "max_current_a": 0.005}}
    ],
    "operating_cases": [
      {
        "id": "enabled_measurement",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_voltage", "target": "measured_input", "min": 0.1, "max": 2, "unit": "V"},
          {"axis": "input_voltage", "target": "gate_input", "min": 3, "max": 3.6, "unit": "V"},
          {"axis": "load_capacitance", "target": "measurement_output", "min": 0, "max": 0.000000002, "unit": "F"}
        ]
      },
      {
        "id": "gate_transition",
        "conditions": [
          {"axis": "supply_voltage", "target": "measurement_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_voltage", "target": "measured_input", "min": 0.8, "max": 1.2, "unit": "V"},
          {"axis": "load_capacitance", "target": "measurement_output", "min": 0, "max": 0.000000002, "unit": "F"}
        ],
        "events": [
          {"id": "gate_assertion", "kind": "input_step", "target": "gate_input", "trigger_time_s": 0.001, "initial": 0, "applied": 3.3, "unit": "V"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "closed_loop_phase_margin", "metric": "phase_margin", "analysis": "stability", "observation": {"kind": "circuit", "id": "measurement_response"}, "min": 60, "unit": "deg", "operating_cases": ["enabled_measurement"], "critical": true},
      {"id": "enabled_transfer_accuracy", "metric": "voltage_gain_at_frequency", "analysis": "ac_sweep", "observation": {"kind": "port", "id": "measurement_output"}, "min": 1.98, "max": 2.02, "unit": "ratio", "operating_cases": ["enabled_measurement"], "frequency_hz": 100},
      {"id": "gate_settling_time", "metric": "settling_time", "analysis": "transient", "observation": {"kind": "port", "id": "measurement_output"}, "max": 0.0002, "unit": "s", "operating_cases": ["gate_transition"]},
      {"id": "gate_output_overshoot", "metric": "peak_voltage", "analysis": "transient", "observation": {"kind": "port", "id": "measurement_output"}, "max": 4.8, "unit": "V", "operating_cases": ["gate_transition"], "critical": true},
      {"id": "measurement_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "measurement_output"}, "max": 0.001, "unit": "V_rms", "operating_cases": ["enabled_measurement"]}
    ],
    "constraints": {"max_components": 30, "max_width_mm": 65, "max_height_mm": 50}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
