{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "current_to_voltage_observation",
    "title": "Current-to-Voltage Observation Behavior",
    "description": "Evaluate a bounded current stimulus represented as an output voltage over thermal corners and a finite over-range event."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external", "min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0},
      {"id": "input_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1}
    ],
    "ports": [
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "input_supply", "electrical": {"min_voltage_v": 4.75, "nominal_voltage_v": 5, "max_voltage_v": 5.25, "max_current_a": 0.1}},
      {"id": "return_terminal", "kind": "reference", "direction": "bidirectional", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0, "max_voltage_v": 0, "max_current_a": 0.1}},
      {"id": "measured_current", "kind": "analog_current", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 0.05, "max_voltage_v": 0.15, "max_current_a": 0.04}},
      {"id": "measurement_output", "kind": "analog_voltage", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "nominal_voltage_v": 1, "max_voltage_v": 3.2, "max_current_a": 0.01}}
    ],
    "operating_cases": [
      {
        "id": "measurement_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_current", "target": "measured_current", "min": 0.001, "max": 0.02, "unit": "A"},
          {"axis": "load_resistance", "target": "measurement_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": -20, "max": 70, "unit": "degC"}
        ]
      },
      {
        "id": "bounded_overrange_step",
        "conditions": [
          {"axis": "supply_voltage", "target": "input_supply", "min": 4.75, "max": 5.25, "unit": "V"},
          {"axis": "input_current", "target": "measured_current", "min": 0.01, "max": 0.03, "unit": "A"},
          {"axis": "load_resistance", "target": "measurement_output", "min": 10000, "max": 100000, "unit": "ohm"},
          {"axis": "ambient_temperature", "target": "return_terminal", "min": -20, "max": 70, "unit": "degC"}
        ],
        "events": [
          {"id": "overrange_current_applied", "kind": "input_step", "target": "measured_current", "trigger_time_s": 0.001, "initial": 0.01, "applied": 0.03, "unit": "A"}
        ]
      }
    ],
    "behavioral_requirements": [
      {
        "id": "a_assembly_temperature",
        "metric": "junction_temperature",
        "analysis": "thermal",
        "observation": {"kind": "circuit", "id": "complete_assembly"},
        "max": 105,
        "unit": "degC",
        "operating_cases": ["measurement_range", "bounded_overrange_step"],
        "critical": true
      },
      {
        "id": "b_current_conversion_ratio",
        "metric": "transimpedance",
        "analysis": "dc_sweep",
        "excitation": {"kind": "port", "id": "measured_current"},
        "observation": {"kind": "port", "id": "measurement_output"},
        "min": 95,
        "max": 105,
        "unit": "V/A",
        "operating_cases": ["measurement_range"],
        "critical": true
      },
      {
        "id": "c_overrange_peak_voltage",
        "metric": "peak_voltage",
        "analysis": "transient",
        "excitation": {"kind": "port", "id": "measured_current"},
        "observation": {"kind": "port", "id": "measurement_output"},
        "max": 3.2,
        "unit": "V",
        "operating_cases": ["bounded_overrange_step"],
        "critical": true
      },
      {
        "id": "d_overrange_settling",
        "metric": "settling_time",
        "analysis": "transient",
        "excitation": {"kind": "port", "id": "measured_current"},
        "observation": {"kind": "port", "id": "measurement_output"},
        "max": 0.002,
        "unit": "s",
        "operating_cases": ["bounded_overrange_step"],
        "critical": true
      }
    ],
    "constraints": {"max_components": 28, "max_width_mm": 50, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true,
    "require_topology_search": true,
    "require_simulation": true,
    "require_all_corners": true,
    "require_model_provenance": true,
    "require_closed_loop_evidence": true,
    "require_complete_routing": true,
    "require_connectivity": true,
    "require_writer_correctness": true,
    "require_round_trip_zero_diff": true,
    "require_erc": true,
    "require_strict_drc": true,
    "require_deterministic_replay": true,
    "require_fail_closed": true
  }
}
