{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "quiet_bounded_output",
    "title": "Quiet bounded output study",
    "description": "Study a continuously available external output across finite supply, load, temperature, and frequency ranges."
  },
  "requirements": {
    "domains": [
      {"id": "output_reference", "kind": "reference", "source": "external", "min_voltage_v": -0.05, "nominal_voltage_v": 0, "max_voltage_v": 0.05},
      {"id": "source_supply", "kind": "supply", "source": "external", "min_voltage_v": 7.2, "nominal_voltage_v": 8, "max_voltage_v": 8.8, "max_current_a": 0.2}
    ],
    "ports": [
      {"id": "output_return", "kind": "reference", "direction": "bidirectional", "domain": "output_reference", "electrical": {"min_voltage_v": -0.05, "nominal_voltage_v": 0, "max_voltage_v": 0.05, "max_current_a": 0.2}},
      {"id": "bounded_output", "kind": "analog_voltage", "direction": "source", "domain": "output_reference", "electrical": {"min_voltage_v": 2.4, "nominal_voltage_v": 2.5, "max_voltage_v": 2.6, "max_current_a": 0.01}},
      {"id": "supply_input", "kind": "power", "direction": "sink", "domain": "source_supply", "electrical": {"min_voltage_v": 7.2, "nominal_voltage_v": 8, "max_voltage_v": 8.8, "max_current_a": 0.2}}
    ],
    "operating_cases": [
      {
        "id": "nominal_load_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "source_supply", "min": 7.2, "max": 8.8, "unit": "V"},
          {"axis": "load_current", "target": "bounded_output", "min": 0.001, "max": 0.005, "unit": "A"},
          {"axis": "ambient_temperature", "target": "output_reference", "min": -20, "max": 60, "unit": "degC"}
        ]
      },
      {
        "id": "hot_full_load_range",
        "conditions": [
          {"axis": "supply_voltage", "target": "source_supply", "min": 7.2, "max": 8.8, "unit": "V"},
          {"axis": "load_current", "target": "bounded_output", "min": 0.005, "max": 0.01, "unit": "A"},
          {"axis": "ambient_temperature", "target": "output_reference", "min": 60, "max": 85, "unit": "degC"}
        ]
      }
    ],
    "behavioral_requirements": [
      {"id": "integrated_output_noise", "metric": "output_noise_rms", "analysis": "noise", "observation": {"kind": "port", "id": "bounded_output"}, "max": 0.0002, "unit": "V_rms", "operating_cases": ["nominal_load_range", "hot_full_load_range"], "frequency_hz": 20000, "critical": true},
      {"id": "bounded_dc_level", "metric": "output_voltage", "analysis": "noise", "observation": {"kind": "port", "id": "bounded_output"}, "min": 2.45, "max": 2.55, "unit": "V", "operating_cases": ["nominal_load_range", "hot_full_load_range"]},
      {"id": "supply_range_variation", "metric": "line_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "bounded_output"}, "max": 0.25, "unit": "%", "operating_cases": ["nominal_load_range", "hot_full_load_range"]},
      {"id": "load_range_variation", "metric": "load_regulation", "analysis": "dc_sweep", "observation": {"kind": "port", "id": "bounded_output"}, "max": 0.35, "unit": "%", "operating_cases": ["nominal_load_range", "hot_full_load_range"]},
      {"id": "hot_load_temperature", "metric": "junction_temperature", "analysis": "thermal", "observation": {"kind": "circuit", "id": "bounded_output_assembly"}, "max": 110, "unit": "degC", "operating_cases": ["hot_full_load_range"]}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 60, "max_height_mm": 50}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
