{
  "schema": "kicadai.open-topology-requirement.v1",
  "version": 1,
  "project": {
    "name": "controlled_current_response",
    "title": "Controlled Current Response",
    "description": "Study a bounded current output controlled by an external command, including its steady transfer and step response."
  },
  "requirements": {
    "domains": [
      {"id": "signal_return", "kind": "reference", "source": "external", "nominal_voltage_v": 0},
      {"id": "source_supply", "kind": "supply", "source": "external", "min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.05}
    ],
    "ports": [
      {"id": "supply_in", "kind": "power", "direction": "sink", "domain": "source_supply", "electrical": {"min_voltage_v": 4.5, "nominal_voltage_v": 5, "max_voltage_v": 5.5, "max_current_a": 0.05}},
      {"id": "command_in", "kind": "analog_voltage", "direction": "sink", "domain": "signal_return", "electrical": {"min_voltage_v": 0.5, "nominal_voltage_v": 1, "max_voltage_v": 2.5, "input_impedance_min_ohm": 100000}},
      {"id": "current_out", "kind": "controlled_current", "direction": "source", "domain": "signal_return", "electrical": {"min_voltage_v": 0, "max_voltage_v": 3, "max_current_a": 0.003}}
    ],
    "operating_cases": [
      {"id": "command_range", "conditions": [
        {"axis": "supply_voltage", "target": "source_supply", "min": 4.5, "max": 5.5, "unit": "V"},
        {"axis": "input_voltage", "target": "command_in", "min": 0.5, "max": 2.5, "unit": "V"},
        {"axis": "load_resistance", "target": "current_out", "min": 100, "max": 1000, "unit": "ohm"}
      ]},
      {"id": "command_transition", "conditions": [
        {"axis": "supply_voltage", "target": "source_supply", "min": 4.5, "max": 5.5, "unit": "V"},
        {"axis": "load_resistance", "target": "current_out", "min": 100, "max": 1000, "unit": "ohm"}
      ], "events": [
        {"id": "command_step", "kind": "input_step", "target": "command_in", "trigger_time_s": 0.001, "initial": 0.5, "applied": 2, "unit": "V"}
      ]}
    ],
    "behavioral_requirements": [
      {"id": "command_to_current_ratio", "metric": "transconductance", "analysis": "dc_sweep", "excitation": {"kind": "port", "id": "command_in"}, "observation": {"kind": "port", "id": "current_out"}, "min": 0.0009, "max": 0.0011, "unit": "A/V", "operating_cases": ["command_range"], "critical": true},
      {"id": "bounded_output_current", "metric": "output_current", "analysis": "transient", "observation": {"kind": "port", "id": "current_out"}, "min": 0.00045, "max": 0.00275, "unit": "A", "operating_cases": ["command_range"]},
      {"id": "command_step_settling", "metric": "settling_time", "analysis": "transient", "excitation": {"kind": "port", "id": "command_in"}, "observation": {"kind": "port", "id": "current_out"}, "max": 0.0001, "unit": "s", "operating_cases": ["command_transition"], "critical": true},
      {"id": "command_step_peak", "metric": "peak_current", "analysis": "transient", "excitation": {"kind": "port", "id": "command_in"}, "observation": {"kind": "port", "id": "current_out"}, "max": 0.0024, "unit": "A", "operating_cases": ["command_transition"]}
    ],
    "constraints": {"max_components": 18, "max_width_mm": 55, "max_height_mm": 40}
  },
  "acceptance": {
    "require_primitive_only": true, "require_topology_search": true, "require_simulation": true, "require_all_corners": true,
    "require_model_provenance": true, "require_closed_loop_evidence": true, "require_complete_routing": true, "require_connectivity": true,
    "require_writer_correctness": true, "require_round_trip_zero_diff": true, "require_erc": true, "require_strict_drc": true,
    "require_deterministic_replay": true, "require_fail_closed": true
  }
}
